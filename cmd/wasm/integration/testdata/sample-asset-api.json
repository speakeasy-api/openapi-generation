{
  "openapi": "3.0.3",
  "info": {
    "title": "Example Asset API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "security": [
    {
      "token": []
    }
  ],
  "paths": {
    "/assets": {
      "get": {
        "operationId": "listAssets",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Asset"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAsset",
        "x-speakeasy-name-override": "create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewAsset"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          }
        }
      }
    },
    "/assets/{assetId}": {
      "get": {
        "operationId": "getAsset",
        "parameters": [
          {
            "name": "assetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "asset-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "token": {
        "type": "http",
        "scheme": "bearer",
        "x-speakeasy-example": "EXAMPLE_ASSET_API_KEY"
      }
    },
    "schemas": {
      "NewAsset": {
        "type": "object",
        "required": [
          "name",
          "source",
          "sizes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Sample image"
          },
          "source": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/image.png"
          },
          "sizes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetSize"
            },
            "example": [
              {
                "width": 320,
                "height": 240
              },
              {
                "width": 640,
                "height": 480
              }
            ]
          }
        }
      },
      "AssetSize": {
        "type": "object",
        "required": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Asset": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NewAsset"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "example": "asset-001"
              }
            }
          }
        ]
      }
    }
  }
}
