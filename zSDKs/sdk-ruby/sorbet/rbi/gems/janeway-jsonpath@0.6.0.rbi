  # source://janeway-jsonpath//lib/janeway/interpreters/index_selector_deleter.rb#14
  def interpret(input, _parent, _root, _path); end
end

# Interprets an index selector, returns results or forwards them to next selector
#
# Filter the input by returning the array element with the given index.
# Return empty list if input is not an array, or if array does not contain index.
#
# Output is an array because all selectors must return node lists, even if
# they only select a single element.
#
# @param input [Array]
# @param selector [IndexSelector]
# @return [Array]
#
# source://janeway-jsonpath//lib/janeway/interpreters/index_selector_interpreter.rb#18
class Janeway::Interpreters::IndexSelectorInterpreter < ::Janeway::Interpreters::Base
  # Interpret an index selector on the given input.
  # NOTHING is selected, and it is not an error, if the index lies outside the range of the array.
  # NOTHING is selected from a value that is not an array.
  #
  # @param input [Array, Hash] the results of processing so far
  # @param path [Array<String>] elements of normalized path to the current input
  # @param root [Array, Hash] the entire input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/index_selector_interpreter.rb#28
  def interpret(input, _parent, root, path); end

  # source://janeway-jsonpath//lib/janeway/interpreters/index_selector_interpreter.rb#19
  def selector; end
end

# Mixin for interpreter classes that yield to a block
#
# source://janeway-jsonpath//lib/janeway/interpreters/iteration_helper.rb#8
module Janeway::Interpreters::IterationHelper
  # Returns a Proc that yields the correct number of parameters to a block
  #
  # block.arity is -1 when no block is given, and an enumerator is being returned
  #
  # @return [Proc] which takes 3 parameters
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/iteration_helper.rb#13
  def make_yield_proc(&block); end

  # Convert the list of path elements into a normalized query string.
  #
  # This form uses a subset of jsonpath that unambiguously points to a value
  # using only name and index selectors.
  # Name selectors must use bracket notation, not shorthand.
  #
  # @param components [Array<String, Integer>]
  # @return [String]
  # @see https://www.rfc-editor.org/rfc/rfc9535.html#name-normalized-paths
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/iteration_helper.rb#37
  def normalized_path(components); end
end

