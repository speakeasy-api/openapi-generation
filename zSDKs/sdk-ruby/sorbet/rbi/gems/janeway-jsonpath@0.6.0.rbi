  # @param _root [Array, Hash] the entire input
  # @param input [Array, Hash] the results of processing so far
  # @param path [Array<String>] elements of normalized path to the current input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/index_selector_delete_if.rb#26
  def interpret(input, _parent, _root, path); end
end

# Interprets an index selector, and deletes the matched value.
#
# source://janeway-jsonpath//lib/janeway/interpreters/index_selector_deleter.rb#8
class Janeway::Interpreters::IndexSelectorDeleter < ::Janeway::Interpreters::IndexSelectorInterpreter
  # Interpret selector on the given input.
