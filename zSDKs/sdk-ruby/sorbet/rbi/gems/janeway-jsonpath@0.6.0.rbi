  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/ast/number.rb#16
  def literal?; end

  # source://janeway-jsonpath//lib/janeway/ast/number.rb#10
  def to_s; end
end

# Every JSONPath query (except those inside filter expressions; see Section
# 2.3.5) MUST begin with the root identifier $.
#
# The root identifier $ represents the root node of the query argument and produces
# a nodelist consisting of that root node.
#
# The root identifier may also be used in the filter selectors.
#
# @example:
#   $(? $.key1 == $.key2 )
#
# source://janeway-jsonpath//lib/janeway/ast/root_node.rb#16
class Janeway::AST::RootNode < ::Janeway::AST::Expression
  # Subsequent expression that modifies the output of this expression
  #
  # source://janeway-jsonpath//lib/janeway/ast/root_node.rb#18
  def next; end

  # Subsequent expression that modifies the output of this expression
  #
  # source://janeway-jsonpath//lib/janeway/ast/root_node.rb#18
  def next=(_arg0); end

  # True if this is the root of a singular-query.
  #
  # @return [Boolean]
  # @see https://www.rfc-editor.org/rfc/rfc9535.html#name-well-typedness-of-function-
  #
  # source://janeway-jsonpath//lib/janeway/ast/root_node.rb#28
  def singular_query?; end

  # source://janeway-jsonpath//lib/janeway/ast/root_node.rb#20
  def to_s; end

  # @param level [Integer]
  # @return [Array]
  #
  # source://janeway-jsonpath//lib/janeway/ast/root_node.rb#44
  def tree(level = T.unsafe(nil)); end
end

# Represent a selector, which is an expression that filters nodes from a list based on a predicate.
#
# https://www.rfc-editor.org/rfc/rfc9535.html#name-selectors
# Selectors:
#
# A name selector, e.g. 'name', selects a named child of an object.
#
# An index selector, e.g. 3, selects an indexed child of an array.
#
# A wildcard * in the expression [*] selects all children of a node and in
# the expression ..[*] selects all descendants of a node.
#
# An array slice start:end:step selects a series of elements from an array,
# giving a start position, an end position, and an optional step value that
# moves the position from the start to the end.
#
# Filter expressions ?<logical-expr> select certain children of an object or array, as in:
#     $.store.book[?@.price < 10].title
#
# source://janeway-jsonpath//lib/janeway/ast/selector.rb#25
class Janeway::AST::Selector < ::Janeway::AST::Expression
  # source://janeway-jsonpath//lib/janeway/ast/selector.rb#29
  def ==(other); end

  # Subsequent expression that modifies the result of this selector list.
  #
  # source://janeway-jsonpath//lib/janeway/ast/selector.rb#27
  def next; end

  # Subsequent expression that modifies the result of this selector list.
  #
  # source://janeway-jsonpath//lib/janeway/ast/selector.rb#27
  def next=(_arg0); end
end

# Represents a string literal within a filter expression.
# May be used within a comparison or a jsonpath function call.
#
# source://janeway-jsonpath//lib/janeway/ast/string_type.rb#7
class Janeway::AST::StringType < ::Janeway::AST::Expression
  # Return true if this is a literal expression
  #
  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/ast/string_type.rb#18
  def literal?; end

  # source://janeway-jsonpath//lib/janeway/ast/string_type.rb#8
  def to_s; end
end

# Represent unary operators "!", "-"
#
# source://janeway-jsonpath//lib/janeway/ast/unary_operator.rb#6
class Janeway::AST::UnaryOperator < ::Janeway::AST::Expression
  # @return [UnaryOperator] a new instance of UnaryOperator
  #
  # source://janeway-jsonpath//lib/janeway/ast/unary_operator.rb#9
  def initialize(operator, operand = T.unsafe(nil)); end

  # Returns the value of attribute name.
  #
  # source://janeway-jsonpath//lib/janeway/ast/unary_operator.rb#7
  def name; end

  # Sets the attribute name
  #
  # @param value the value to set the attribute name to.
  #
  # source://janeway-jsonpath//lib/janeway/ast/unary_operator.rb#7
  def name=(_arg0); end

  # Returns the value of attribute operand.
  #
  # source://janeway-jsonpath//lib/janeway/ast/unary_operator.rb#7
  def operand; end

  # Sets the attribute operand
  #
  # @param value the value to set the attribute operand to.
  #
  # source://janeway-jsonpath//lib/janeway/ast/unary_operator.rb#7
  def operand=(_arg0); end

  # source://janeway-jsonpath//lib/janeway/ast/unary_operator.rb#15
  def to_s; end

  # @param level [Integer]
  # @return [Array]
  #
  # source://janeway-jsonpath//lib/janeway/ast/unary_operator.rb#21
  def tree(level); end
end

# A wildcard selector selects the nodes of all children of an object
# or array. The order in which the children of an object appear in
# the resultant nodelist is not stipulated, since JSON objects are
# unordered. Children of an array appear in array order in the
# resultant nodelist.
#
# Note that the children of an object are its member values, not its member names/keys.
#
# The wildcard selector selects nothing from a primitive JSON value (ie. a number, a string, true, false, or null).
#
# It has only one possible value: '*'
# @example: $.store.book[*]
#
# source://janeway-jsonpath//lib/janeway/ast/wildcard_selector.rb#19
class Janeway::AST::WildcardSelector < ::Janeway::AST::Selector
  # @return [WildcardSelector] a new instance of WildcardSelector
  #
  # source://janeway-jsonpath//lib/janeway/ast/wildcard_selector.rb#20
  def initialize; end

  # @return [String]
  #
  # source://janeway-jsonpath//lib/janeway/ast/wildcard_selector.rb#26
  def to_s(brackets: T.unsafe(nil), dot_prefix: T.unsafe(nil)); end

  # @param level [Integer]
  # @return [Array]
  #
  # source://janeway-jsonpath//lib/janeway/ast/wildcard_selector.rb#38
  def tree(level); end
end

# Enumerator combines a JSONPath query with input.
# It provides methods for running queries on the input and enumerating over the results.
#
# source://janeway-jsonpath//lib/janeway/enumerator.rb#8
class Janeway::Enumerator
  include ::Enumerable

  # @param input [Array, Hash]
  # @param query [Janeway::Query]
  # @raise [ArgumentError]
  # @return [Enumerator] a new instance of Enumerator
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#16
  def initialize(query, input); end

  # Delete values from the input that are matched by the JSONPath query.
  #
  # @return [Array] deleted values
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#45
  def delete; end

  # Delete values from the input that are matched by the JSONPath query and also return a truthy value
  # from the block.
  #
  # @return [Array] deleted values
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#52
  def delete_if(&block); end

  # Iterate through each value matched by the JSONPath query.
  #
  # @return [void]
  # @yieldparam hash [String, Integer] key or array index of the value within the parent object
  # @yieldparam normalized [String] jsonpath that uniqely points to this value
  # @yieldparam parent [Array, Hash] object that contains the value
  # @yieldparam value [Object] matched by query
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#37
  def each(&block); end

  # Insert `value` into the input at a location specified by a singular query.
  #
  # This has restrictions:
  #   * Only for singular queries
  #     (no wildcards, filter expressions, child segments, etc.)
  #   * The "parent" node must exist
  #     eg. for $.a[1].name, the path $.a[1] must exist and be a Hash
  #   * Cannot create array index N unless the array
  #     already has exactly N-1 elements
  #   * If query path already exists, the block is called if provided.
  #     Otherwise an exception is raised.
  #
  # Optionally, pass in a block to be called when there is already a value at the
  # specified array index / hash key. The parent object and the array index
  # or hash key will be yielded to the block.
  #
  # @yieldparam array [Intgeer, String] index or hash key
  # @yieldparam parent [Array, Hash] object
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#102
  def insert(value, &block); end

  # @return [Janeway::Query]
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#12
  def query; end

  # Assign the given value at every query match.
  #
  # @param replacement [Object]
  # @return [void]
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#59
  def replace(replacement = T.unsafe(nil), &block); end

  # Return a list of values from the input data that match the jsonpath query
  #
  # @return [Array] all matched objects
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#26
  def search; end

  private

  # Find the 'parent' of the object pointed to by the query. For singular query only.
  #
  # @return [Object, Object, String] parent object (Hash / Array), key/index (String / Integer), path to parent
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#127
  def find_parent; end

  # Insert value into array at the given index
  #
  # @param array [Array]
  # @param index [Integer]
  # @param path [String] jsonpath singular query to parent
  # @param value [Object]
  # @raise [Error]
  # @yieldparam array [Integer] index
  # @yieldparam parent [Array] object
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#175
  def insert_into_array(array, index, value, path, &block); end

  # Insert value into hash at the given key
  #
  # @param hash [Hash]
  # @param key [String]
  # @param path [String] jsonpath singular query to parent
  # @param value [Object]
  # @yieldparam hash [String] key
  # @yieldparam parent [Hash] object
  #
  # source://janeway-jsonpath//lib/janeway/enumerator.rb#152
  def insert_into_hash(hash, key, value, path, &block); end
end

# Error class for Janeway.
# Contains a copy of the jsonpath query string.
# Lexer errors may also include the index into the query string that
# points at which token was being lexed at the time of the error.
#
# source://janeway-jsonpath//lib/janeway/error.rb#10
class Janeway::Error < ::StandardError
  # @param location [Location] location of error
  # @param msg [String] error message
  # @param query [String] entire query string
  # @return [Error] a new instance of Error
  #
  # source://janeway-jsonpath//lib/janeway/error.rb#22
  def initialize(msg, query = T.unsafe(nil), location = T.unsafe(nil)); end

  # For lexer errors, this is the index on the query string where the error was encountered
  #
  # @return [Location, nil]
  #
  # source://janeway-jsonpath//lib/janeway/error.rb#17
  def location; end

  # JSONPath query
  #
  # @return [String]
  #
  # source://janeway-jsonpath//lib/janeway/error.rb#13
  def query; end
end

# Mixin to provide JSONPath function handlers for Parser
#
# source://janeway-jsonpath//lib/janeway/functions.rb#7
module Janeway::Functions
  # The count() function extension provides a way to obtain the number of
  # nodes in a nodelist and make that available for further processing in
  # the filter expression:
  #
  # Its only argument is a nodelist. The result is a value (an unsigned
  # integer) that gives the number of nodes in the nodelist.
  #
  # Notes:
  #   * There is no deduplication of the nodelist.
  #   * The number of nodes in the nodelist is counted independent of
  #     their values or any children they may have, e.g., the count of a
  #     non-empty singular nodelist such as count(@) is always 1.
  #
  # @example $[?count(@.*.author) >= 5]
  # @raise [Error]
  #
  # source://janeway-jsonpath//lib/janeway/functions/count.rb#20
  def parse_function_count; end

  # The length() function extension provides a way to compute the length of a value
  # and make that available for further processing in the filter expression:
  #
  # JSONPath return type: ValueType
  #
  # source://janeway-jsonpath//lib/janeway/functions/length.rb#10
  def parse_function_length; end

  # The match() function extension provides a way to check whether (the
  # entirety of; see Section 2.4.7) a given string matches a given regular
  # expression, which is in the form described in [RFC9485].
  #
  # Its arguments are instances of ValueType (possibly taken from a
  # singular query, as for the first argument in the example above). If the
  # first argument is not a string or the second argument is not a string
  # conforming to [RFC9485], the result is LogicalFalse. Otherwise, the
  # string that is the first argument is matched against the I-Regexp
  # contained in the string that is the second argument; the result is
  # LogicalTrue if the string matches the I-Regexp and is LogicalFalse
  # otherwise.
  #
  #
  # The regexp dialect is called "I-Regexp" and is defined in RFC9485.
  #
  # Fortunately a shortcut is availalble, that RFC contains instructions
  # for converting an I-Regexp to ruby's regexp format.
  # The instructions are:
  #   * For any unescaped dots (.) outside character classes (first
  #     alternative of charClass production), replace the dot with [^\n\r].
  #   * Enclose the regexp in \A(?: and )\z.
  #
  # tl;dr: How is this different from the search function?
  # "match" must match the entire string, "search" matches a substring.
  #
  # @example $[?match(@.date, "1974-05-..")]
  # @raise [Error]
  # @see https://www.rfc-editor.org/rfc/rfc9485.html#name-pcre-re2-and-ruby-regexps
  #
  # source://janeway-jsonpath//lib/janeway/functions/match.rb#35
  def parse_function_match; end

  # All jsonpath function parameters are one of these accepted types.
  # Parse the function parameter and return the result.
  #
  # @return [String, AST::CurrentNode, AST::RootNode]
  #
  # source://janeway-jsonpath//lib/janeway/functions.rb#42
  def parse_function_parameter; end

  # 2.4.7. search() Function Extension
  # Parameters:
  #   1. ValueType (string)
  #   2. ValueType (string conforming to [RFC9485])
  # Result:
  #     LogicalType
  #
  # The search() function extension provides a way to check whether a given
  # string contains a substring that matches a given regular expression,
  # which is in the form described in [RFC9485].
  #
  # $[?search(@.author, "[BR]ob")]
  #
  # Its arguments are instances of ValueType (possibly taken from a singular
  # query, as for the first argument in the example above). If the first
  # argument is not a string or the second argument is not a string
  # conforming to [RFC9485], the result is LogicalFalse. Otherwise, the
  # string that is the first argument is searched for a substring that
  # matches the I-Regexp contained in the string that is the second argument;
  # the result is LogicalTrue if at least one such substring exists and is
  # LogicalFalse otherwise.
  #
  # tl;dr: How is this different from the match function?
  # "match" must match the entire string, "search" matches a substring.
  #
  # @raise [Error]
  #
  # source://janeway-jsonpath//lib/janeway/functions/search.rb#30
  def parse_function_search; end

  # Parameters:
  #   1. NodesType
  # Result:
  #   ValueType
  #
  # The value() function extension provides a way to convert an instance of
  # NodesType to a value and make that available for further processing in
  # the filter expression:
  #
  # Its only argument is an instance of NodesType (possibly taken from a
  # filter-query, as in the example above). The result is an instance of
  # ValueType.
  #
  # If the argument contains a single node, the result is the value of the node.
  #
  # If the argument is the empty nodelist or contains multiple nodes, the result is Nothing.
  #
  # Note: A singular query may be used anywhere where a ValueType is
  # expected, so there is no need to use the value() function extension with a singular query.
  #
  # @example $[?value(@..color) == "red"]
  # @raise [Error]
  #
  # source://janeway-jsonpath//lib/janeway/functions/value.rb#29
  def parse_function_value; end

  # Convert IRegexp format to ruby regexp equivalent, following the instructions in rfc9485.
  #
  # @param anchor [Boolean] add anchors to match the string start and end
  # @param iregex [String]
  # @return [Regexp]
  # @see https://www.rfc-editor.org/rfc/rfc9485.html#name-pcre-re2-and-ruby-regexps
  #
  # source://janeway-jsonpath//lib/janeway/functions.rb#13
  def translate_iregex_to_ruby_regex(iregex, anchor: T.unsafe(nil)); end
end

# Tree-walk interpreter to apply the operations from the abstract syntax tree to the input.
#
# This is not intended to be thread-safe, so create this inside a thread as needed.
# It should be created for a single query and then discarded.
#
# source://janeway-jsonpath//lib/janeway/interpreter.rb#12
class Janeway::Interpreter
  include ::Janeway::Interpreters

  # @param query [Query] abstract syntax tree of the jsonpath query
  # @raise [ArgumentError]
  # @return [Interpreter] a new instance of Interpreter
  #
  # source://janeway-jsonpath//lib/janeway/interpreter.rb#27
  def initialize(query, as: T.unsafe(nil), &block); end

  # @param input [Array, Hash] object to be searched
  # @return [Object]
  #
  # source://janeway-jsonpath//lib/janeway/interpreter.rb#52
  def interpret(input); end

  # Returns the value of attribute jsonpath.
  #
  # source://janeway-jsonpath//lib/janeway/interpreter.rb#13
  def jsonpath; end

  # Returns the value of attribute output.
  #
  # source://janeway-jsonpath//lib/janeway/interpreter.rb#13
  def output; end

  # Return multiline JSON string describing the interpreter tree.
  #
  # This is not used for parsing / interpretation.
  # It is intended to represent the interpreter tree to help with debugging.
  # This format makes the tree structure much clearer than the #inspect output does.
  #
  # @return [String]
  #
  # source://janeway-jsonpath//lib/janeway/interpreter.rb#46
  def to_json(options = T.unsafe(nil)); end

  private

  # Return an Interpreter::Error with the specified message, include the query.
  #
  # @param msg [String] error message
  # @return [Parser::Error]
  #
  # source://janeway-jsonpath//lib/janeway/interpreter.rb#131
  def err(msg); end

  # Make a DeleteIf that will delete the results matched by a Selector,
  # after yielding to a block for approval.
  #
  # @param interpreter [Interpreters::Base] interpeter subclass
  #
  # source://janeway-jsonpath//lib/janeway/interpreter.rb#123
  def make_delete_if(interpreter, &block); end

  # Make a Deleter that will delete the results matched by a Selector.
  #
  # @param interpreter [Interpreters::Base] interpeter subclass
  #
  # source://janeway-jsonpath//lib/janeway/interpreter.rb#115
  def make_deleter(interpreter); end

  # Build a tree of interpreter classes based on the query's abstract syntax tree.
  #
  # Child segments require special handling.
  # See the detailed explanation at the end of this file.
  #
  # @return [Interpreters::RootNodeInterpreter]
  #
  # source://janeway-jsonpath//lib/janeway/interpreter.rb#73
  def query_to_interpreter_tree(query, &block); end

  class << self
    # Interpret a query on the given input, return result
    #
    # @param input [Hash, Array]
    # @param query [String]
    #
    # source://janeway-jsonpath//lib/janeway/interpreter.rb#20
    def interpret(input, query); end
  end
end

# Interpreters module contains interpreter classes which correspond to each
# type of AST::Node.
#
# source://janeway-jsonpath//lib/janeway/interpreters/base.rb#8
module Janeway::Interpreters; end

# Delete values that match the array slice selector and yield true from the block
#
# source://janeway-jsonpath//lib/janeway/interpreters/array_slice_selector_delete_if.rb#9
class Janeway::Interpreters::ArraySliceSelectorDeleteIf < ::Janeway::Interpreters::ArraySliceSelectorInterpreter
  include ::Janeway::Interpreters::IterationHelper

  # @param node [AST::Expression]
  # @return [ArraySliceSelectorDeleteIf] a new instance of ArraySliceSelectorDeleteIf
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/array_slice_selector_delete_if.rb#13
  def initialize(node, &block); end

  # Delete values at the indices matched by the array slice selector
  #
  # @param _parent [Array, Hash] parent of the input object
  # @param _root [Array, Hash] the entire input
  # @param input [Array, Hash] the results of processing so far
  # @param path [Array<String>] elements of normalized path to the current input
  # @return [Array]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/array_slice_selector_delete_if.rb#28
  def interpret(input, _parent, _root, path); end
end

# Interprets array slice selector and deletes matching values
#
# source://janeway-jsonpath//lib/janeway/interpreters/array_slice_selector_deleter.rb#8
class Janeway::Interpreters::ArraySliceSelectorDeleter < ::Janeway::Interpreters::ArraySliceSelectorInterpreter
  # Delete values matched by the array slice selector
  #
  # @param _parent [Array, Hash] parent of the input object
  # @param _path [Array<String>] elements of normalized path to the current input
  # @param _root [Array, Hash] the entire input
  # @param input [Array, Hash] the results of processing so far
  # @return [Array]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/array_slice_selector_deleter.rb#16
  def interpret(input, _parent, _root, _path); end
end

# Interprets array slice selector on the given input
#
# source://janeway-jsonpath//lib/janeway/interpreters/array_slice_selector_interpreter.rb#8
class Janeway::Interpreters::ArraySliceSelectorInterpreter < ::Janeway::Interpreters::Base
  # @return [Hash]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/array_slice_selector_interpreter.rb#44
  def as_json; end

  # Filter the input by applying the array slice selector.
  #
  # @param _parent [Array, Hash] parent of the input object
  # @param input [Array, Hash] the results of processing so far
  # @param path [Array<String>] elements of normalized path to the current input
  # @param root [Array, Hash] the entire input
  # @return [Array]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/array_slice_selector_interpreter.rb#18
  def interpret(input, _parent, root, path); end

  # source://janeway-jsonpath//lib/janeway/interpreters/array_slice_selector_interpreter.rb#9
  def selector; end
end

# Base class for interpreters.
#
# source://janeway-jsonpath//lib/janeway/interpreters/base.rb#10
class Janeway::Interpreters::Base
  # @return [Base] a new instance of Base
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/base.rb#26
  def initialize(node); end

  # Return hash representation of this selector interpreter
  #
  # @return [Hash]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/base.rb#49
  def as_json; end

  # Interpret the input, return result or forward to next node.
  #
  # @param _input [Array, Hash] the results of processing so far
  # @param _root [Array, Hash] the entire input
  # @raise [NotImplementedError]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/base.rb#38
  def interpret(_input, _root); end

  # Subsequent expression interpreter that filters the output of this one
  #
  # @return [Interpreters::Base, nil]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/base.rb#21
  def next; end

  # Subsequent expression interpreter that filters the output of this one
  #
  # @return [Interpreters::Base, nil]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/base.rb#21
  def next=(_arg0); end

  # @return [AST::Expression]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/base.rb#24
  def node; end

  # @return [AST::Selector] AST node containing this interpreter's data
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/base.rb#58
  def selector; end

  # @return [String]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/base.rb#43
  def to_s; end

  # source://janeway-jsonpath//lib/janeway/interpreters/base.rb#62
  def type; end
end

# The special result NOTHING represents the absence of a JSON value and
# is distinct from any JSON value, including null.
# It represents:
#  * object keys referred to by name that do not exist in the input
#  * array values referred to by index that are out of range
#  * return value of function calls with an invalid input data type
#
# source://janeway-jsonpath//lib/janeway/interpreters/base.rb#17
Janeway::Interpreters::Base::NOTHING = T.let(T.unsafe(nil), Symbol)

# Interprets a binary operator within filter selector.
#
# source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#8
class Janeway::Interpreters::BinaryOperatorInterpreter < ::Janeway::Interpreters::Base
  # Set up the internal interpreter chain for the BinaryOperator.
  #
  # @return [BinaryOperatorInterpreter] a new instance of BinaryOperatorInterpreter
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#12
  def initialize(operator); end

  # The binary operators are all comparison operators that test equality.
  #
  #  * boolean values specified in the query
  #  * JSONPath expressions which must be evaluated
  #
  # After a JSONPath expression is evaluated, it results in a node list.
  # This may contain literal values or nodes, whose value must be extracted before comparison.
  #
  # @param _path [Array] ignored
  # @param input [Array, Hash] the results of processing so far
  # @param parent [Array, Hash] parent of the input object
  # @param root [Array, Hash] the entire input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#30
  def interpret(input, parent, root, _path = T.unsafe(nil)); end

  # Interpret && operator
  # May receive node lists, in which case empty node list == false
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#93
  def interpret_and(lhs, rhs); end

  # @param boolean [AST::Boolean]
  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#143
  def interpret_boolean(boolean, _input); end

  # @param lhs [String, Numeric, Symbol, nil] string/number/null or NOTHING
  # @param rhs [String, Numeric, Symbol, nil] string/number/null or NOTHING
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#82
  def interpret_equal(lhs, rhs); end

  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#127
  def interpret_greater_than(lhs, rhs); end

  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#133
  def interpret_greater_than_or_equal(lhs, rhs); end

  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#109
  def interpret_less_than(lhs, rhs); end

  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#115
  def interpret_less_than_or_equal(lhs, rhs); end

  # Interpret != operator
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#87
  def interpret_not_equal(lhs, rhs); end

  # @param _input [Object] ignored
  # @param _null [AST::Null] ignored
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#161
  def interpret_null(_null, _input); end

  # @param number [AST::Number]
  # @return [Integer, Float]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#149
  def interpret_number(number, _input); end

  # Interpret || operator
  # May receive node lists, in which case empty node list == false
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#102
  def interpret_or(lhs, rhs); end

  # @param string [AST::StringType]
  # @return [String]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#155
  def interpret_string_type(string, _input); end

  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#9
  def operator; end

  # Convert an expression result into a single value suitable for use by a comparison operator.
  # Expression result may already ba single value (ie. from a literal like AST::String)
  # or it may be a node list from a singular query.
  #
  # Any node list is guaranteed not to contain multiple values because the expression that
  # produce it was already verified to be a singular query.
  #
  # @param result [Object] node list, or single value of basic type
  # @return [String, Integer, nil]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/binary_operator_interpreter.rb#62
  def to_single_value(result); end
end

# Child segment interpreter with selectors that delete matching elements if
# the given block yields a truthy value
#
# source://janeway-jsonpath//lib/janeway/interpreters/child_segment_delete_if.rb#9
class Janeway::Interpreters::ChildSegmentDeleteIf < ::Janeway::Interpreters::ChildSegmentInterpreter
  # @param child_segment [AST::ChildSegment]
  # @return [ChildSegmentDeleteIf] a new instance of ChildSegmentDeleteIf
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/child_segment_delete_if.rb#11
  def initialize(child_segment, &block); end
end

# Child segment interpreter with selectors that delete matching elements
#
# source://janeway-jsonpath//lib/janeway/interpreters/child_segment_deleter.rb#8
class Janeway::Interpreters::ChildSegmentDeleter < ::Janeway::Interpreters::ChildSegmentInterpreter
  # @param child_segment [AST::ChildSegment]
  # @return [ChildSegmentDeleter] a new instance of ChildSegmentDeleter
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/child_segment_deleter.rb#10
  def initialize(child_segment); end
end

# For each node in the input nodelist, the resulting nodelist of a child
# segment is the concatenation of the nodelists from each of its
# selectors in the order that the selectors appear in the list. Note: Any
# node matched by more than one selector is kept as many times in the nodelist.
#
# A child segment can only contain selectors according to the RFC's ABNF grammar, so it
# cannot contain another child segment, or a new expression starting with the root identifier.
#
# source://janeway-jsonpath//lib/janeway/interpreters/child_segment_interpreter.rb#14
class Janeway::Interpreters::ChildSegmentInterpreter < ::Janeway::Interpreters::Base
  # @param child_segment [AST::ChildSegment]
  # @return [ChildSegmentInterpreter] a new instance of ChildSegmentInterpreter
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/child_segment_interpreter.rb#16
  def initialize(child_segment); end

  # Return hash representation of this interpreter
  #
  # @return [Hash]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/child_segment_interpreter.rb#60
  def as_json; end

  # Interpret a set of 2 or more selectors, seperated by the union operator.
  # All selectors are sent identical input, the results are combined.
  #
  # @param input [Array, Hash] the results of processing so far
  # @param parent [Array, Hash] parent of the input object
  # @param path [Array<String>] elements of normalized path to the current input
  # @param root [Array, Hash] the entire input
  # @return [Array]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/child_segment_interpreter.rb#48
  def interpret(input, parent, root, path); end

  # Append an interpreter onto each of the selector branches
  #
  # @param node [Interpreters::Base]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/child_segment_interpreter.rb#26
  def push(node); end

  private

  # Find the last descendant of the given selector (ie. first one with no "next" selector)
  #
  # @param selector [Interpreters::Base]
  # @return [Interpreters::Base]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/child_segment_interpreter.rb#73
  def find_last(selector); end
end

# Interpets current node identifier.
# This applies the following selector to the input.
#
# source://janeway-jsonpath//lib/janeway/interpreters/current_node_interpreter.rb#9
class Janeway::Interpreters::CurrentNodeInterpreter < ::Janeway::Interpreters::Base
  # source://janeway-jsonpath//lib/janeway/interpreters/current_node_interpreter.rb#10
  def current_node; end

  # Apply selector to each value in the current node and return result.
  #
  # The result is an Array containing all results of evaluating the CurrentNode's selector (if any.)
  #
  # If the selector extracted values from nodes such as strings, numbers or nil/null,
  # these will be included in the array.
  # If the selector did not match any node, the array may be empty.
  # If there was no selector, then the current input node is returned in the array.
  #
  # @param _path [Array] ignored
  # @param input [Array, Hash] the results of processing so far
  # @param parent [Array, Hash] parent of the input object
  # @param root [Array, Hash] the entire input
  # @return [Array] Node List containing all results from evaluating this node's selectors.
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/current_node_interpreter.rb#26
  def interpret(input, parent, root, _path); end
end

# Find all descendants of the current input that match the selector in the DescendantSegment
#
# source://janeway-jsonpath//lib/janeway/interpreters/descendant_segment_interpreter.rb#8
class Janeway::Interpreters::DescendantSegmentInterpreter < ::Janeway::Interpreters::Base
  # source://janeway-jsonpath//lib/janeway/interpreters/descendant_segment_interpreter.rb#9
  def descendant_segment; end

  # Find all descendants of the current input that match the selector in the DescendantSegment
  #
  # @param input [Array, Hash] the results of processing so far
  # @param parent [Array, Hash] parent of the input object
  # @param path [Array<String>] elements of normalized path to the current input
  # @param root [Array, Hash] the entire input
  # @return [Array<AST::Expression>] node list
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/descendant_segment_interpreter.rb#18
  def interpret(input, parent, root, path); end

  # Visit all descendants of `input`.
  # Return results of applying `action` on each.
  #
  # @param input [Array, Hash] the results of processing so far
  # @param parent [Array, Hash] parent of the input object
  # @param path [Array<String>] elements of normalized path to the current input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/descendant_segment_interpreter.rb#29
  def visit(input, parent, path, &block); end
end

# Interprets a filter selector by deleting matching values for which the block returns a truthy value
#
