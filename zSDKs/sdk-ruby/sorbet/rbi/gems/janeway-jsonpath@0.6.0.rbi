# Interprets a name selector, returns results or forwards them to next selector
#
# Filters the input by returning the key that has the given name.
#
# Must differentiate between a null value of a key that exists (nil)
# and a key that does not exist ([])
#
# source://janeway-jsonpath//lib/janeway/interpreters/name_selector_interpreter.rb#13
class Janeway::Interpreters::NameSelectorInterpreter < ::Janeway::Interpreters::Base
  # @param selector [AST::NameSelector]
  # @return [NameSelectorInterpreter] a new instance of NameSelectorInterpreter
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/name_selector_interpreter.rb#18
  def initialize(selector); end

  # Return hash representation of this interpreter
  #
  # @return [Hash]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/name_selector_interpreter.rb#40
  def as_json; end

  # Interpret selector on the given input.
  #
  # @param _parent [Array, Hash] parent of the input object
  # @param input [Array, Hash] the results of processing so far
  # @param path [Array<String>] elements of normalized path to the current input
  # @param root [Array, Hash] the entire input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/name_selector_interpreter.rb#28
  def interpret(input, _parent, root, path); end

  # Returns the value of attribute name.
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/name_selector_interpreter.rb#15
  def name; end

  # source://janeway-jsonpath//lib/janeway/interpreters/name_selector_interpreter.rb#14
  def selector; end
end

# Interprets the root node for deletion
#
# source://janeway-jsonpath//lib/janeway/interpreters/root_node_delete_if.rb#8
class Janeway::Interpreters::RootNodeDeleter < ::Janeway::Interpreters::RootNodeInterpreter
  # Delete all values from the root node.
  #
  # TODO: unclear, for deletion is there a difference between queries '$' and '$.*'?
  #
  # @param _input [Array, Hash] the results of processing so far
  # @param _parent [Array, Hash] parent of the input object
  # @param _path [Array<String>] elements of normalized path to the current input
  # @param root [Array, Hash] the entire input
  # @return [Array] deleted elements
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/root_node_delete_if.rb#18
  def interpret(_input, _parent, root, _path); end
end

# Interprets the root identifer, returns results or forwards them to next selector.
#
# This is required at the beginning of every jsonpath query.
# It may also be used within filter selector expressions.
#
# source://janeway-jsonpath//lib/janeway/interpreters/root_node_interpreter.rb#11
class Janeway::Interpreters::RootNodeInterpreter < ::Janeway::Interpreters::Base
  # Start an expression chain using the entire, unfiltered input.
  #
  # @param _input [Array, Hash] the results of processing so far
  # @param _parent [Array, Hash] parent of the input object
  # @param _path [Array<String>] elements of normalized path to the current input
  # @param root [Array, Hash] the entire input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/root_node_interpreter.rb#18
  def interpret(_input, _parent, root, _path = T.unsafe(nil)); end
end

# Constructs a tree of interpreter objects.
#
# It is used when an iterator method such as #each has been called to
# construct the chain of interpreter objects to handle the query.
#
# source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#11
module Janeway::Interpreters::TreeConstructor
  class << self
    # Return a DeleteIf interpreter for the given AST node.
    # This interpreter deletes matched values, but only after
    # yielding to a block that returns a truthy value.
    #
    # @param expr [AST::Expression]
    # @return [Interprteters::Base]
    #
    # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#73
    def ast_node_to_delete_if(expr, &block); end

    # Return a Deleter interpreter for the given AST node.
    # This interpreter deletes matched values.
    #
    # @param expr [AST::Expression]
    # @return [Interprteters::Base]
    #
    # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#52
    def ast_node_to_deleter(expr); end

    # Return an interpreter for the given AST node.
    # This interpreter forwards matcheed values to the next interpreter, or
    # returns them if there is no next interpreter.
    #
    # @param expr [AST::Expression]
    # @return [Interprteters::Base]
    #
    # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#26
    def ast_node_to_interpreter(expr); end
  end
end

# Fake interpreter which just returns the given value
#
# source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#13
class Janeway::Interpreters::TreeConstructor::Literal < ::Struct
  # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#14
  def interpret(*_arg0); end

  # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#17
  def node(*_arg0); end

  # Returns the value of attribute value
  #
  # @return [Object] the current value of value
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#13
  def value; end

  # Sets the attribute value
  #
  # @param value [Object] the value to set the attribute value to.
  # @return [Object] the newly set value
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#13
  def value=(_); end

  class << self
    # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#13
    def [](*_arg0); end

    # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#13
    def inspect; end

    # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#13
    def keyword_init?; end

    # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#13
    def members; end

    # source://janeway-jsonpath//lib/janeway/interpreters/tree_constructor.rb#13
    def new(*_arg0); end
  end
end

# Interprets the "not" operator within a filter selector logical expression.
