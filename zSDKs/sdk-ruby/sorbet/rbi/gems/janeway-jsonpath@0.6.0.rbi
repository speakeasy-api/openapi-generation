  # @param input [Array, Hash] the results of processing so far
  # @param parent [Array, Hash] parent of the input object
  # @param path [Array<String, Integer>] components of normalized path to the current input
  # @return [Object] input as node list
  # @yieldparam matched [Object] value
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/yielder.rb#30
  def interpret(input, parent, _root, path); end

  # Dummy method from Interpreters::Base, allow child segment interpreter to disable the
  # non-exist 'next' link.
  #
  # @return [void]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/yielder.rb#38
  def next=(*_arg0); end
end

# Transforms source code into tokens
#
# source://janeway-jsonpath//lib/janeway/lexer.rb#9
class Janeway::Lexer
  # @return [Lexer] a new instance of Lexer
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#67
  def initialize(source); end

  # source://janeway-jsonpath//lib/janeway/lexer.rb#509
  def after_source_end_location; end

  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#113
  def alpha_numeric?(lexeme); end

  # source://janeway-jsonpath//lib/janeway/lexer.rb#158
  def consume; end

  # source://janeway-jsonpath//lib/janeway/lexer.rb#164
  def consume_digits; end

  # Read escape char literals, and transform them into the described character
  #
  # @return [String] single character (possibly multi-byte)
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#213
  def consume_escape_sequence; end

  # Consume and return 4 hex digits from the source. Either upper or lower case is accepted.
  # No judgment is made here on whether the resulting sequence is valid,
  # as long as it is 4 hex digits.
  #
  # @return [String]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#318
  def consume_four_hex_digits; end

  # Consume a unicode escape that matches this ABNF grammar:
  # https://www.rfc-editor.org/rfc/rfc9535.html#section-2.3.1.1-2
  #
  #     hexchar             = non-surrogate / (high-surrogate "\" %x75 low-surrogate)
  #     non-surrogate       = ((DIGIT / "A"/"B"/"C" / "E"/"F") 3HEXDIG) /
  #                           ("D" %x30-37 2HEXDIG )
  #     high-surrogate      = "D" ("8"/"9"/"A"/"B") 2HEXDIG
  #     low-surrogate       = "D" ("C"/"D"/"E"/"F") 2HEXDIG
  #
  #     HEXDIG              = DIGIT / "A" / "B" / "C" / "D" / "E" / "F"
  #
  # Both lower and uppercase are allowed. The grammar does now show this here
  # but clarifies that in a following note.
  #
  # The preceding `\u` prefix has already been consumed.
  #
  # @return [String] single character (possibly multi-byte)
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#250
  def consume_unicode_escape_sequence; end

  # Convert a valid UTF-16 surrogate pair into a UTF-8 string containing a single code point.
  #
  # @param high_surrogate_hex [String] string of hex digits, eg. "D83D"
  # @param low_surrogate_hex [String] string of hex digits, eg. "DE09"
  # @return [String] UTF-8 string containing a single multi-byte unicode character, eg. "😉"
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#286
  def convert_surrogate_pair_to_codepoint(high_surrogate_hex, low_surrogate_hex); end

  # source://janeway-jsonpath//lib/janeway/lexer.rb#505
  def current_location; end

  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#109
  def digit?(lexeme); end

  # Return a Lexer::Error with the specified message, include the query and location
  #
  # @param msg [String] error message
  # @return [Lexer::Error]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#517
  def err(msg); end

  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#430
  def escapable?(char); end

  # Return true if the given 4 char hex string is "high-surrogate"
  #
  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#300
  def high_surrogate?(hex_digits); end

  # @param delimiter [String] eg. ' or "
  # @return [Token] string token
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#170
  def lex_delimited_string(delimiter); end

  # Consume an alphanumeric string.
  # If `ignore_keywords`, the result is always an :identifier token.
  # Otherwise, keywords and function names will be recognized and tokenized as those types.
  #
  # @param ignore_keywords [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#380
  def lex_identifier(ignore_keywords: T.unsafe(nil)); end

  # Lex a member name that is found within dot notation.
  #
  # Recognize keywords and given them the correct type.
  #
  # @param ignore_keywords [Boolean]
  # @return [Token]
  # @see https://www.rfc-editor.org/rfc/rfc9535.html#section-2.5.1.1-3
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#479
  def lex_member_name_shorthand(ignore_keywords: T.unsafe(nil)); end

  # Consume a numeric string. May be an integer, fractional, or exponent.
  #   number = (int / "-0") [ frac ] [ exp ] ; decimal number
  #   frac   = "." 1*DIGIT                   ; decimal fraction
  #   exp    = "e" [ "-" / "+" ] 1*DIGIT     ; decimal exponent
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#339
  def lex_number; end

  # Parse an identifier string which is not within delimiters.
  # The standard set of unicode code points are allowed.
  # No character escapes are allowed.
  # Keywords and function names are ignored in this context.
  #
  # @return [Token]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#401
  def lex_unescaped_identifier; end

  # Returns the value of attribute lexeme_start_p.
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#53
  def lexeme_start_p; end

  # Sets the attribute lexeme_start_p
  #
  # @param value the value to set the attribute lexeme_start_p to.
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#53
  def lexeme_start_p=(_arg0); end

  # source://janeway-jsonpath//lib/janeway/lexer.rb#117
  def lookahead(offset = T.unsafe(nil)); end

  # Return true if the given 4 char hex string is "low-surrogate"
  #
  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#307
  def low_surrogate?(hex_digits); end

  # True if character is acceptable in a name selector using shorthand notation (ie. no bracket notation.)
  # This is the same set as #name_first_char? except that it also allows numbers
  #
  # @param char [String] single character, possibly multi-byte
  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#465
  def name_char?(char); end

  # True if character is suitable as the first character in a name selector
  # using shorthand notation (ie. no bracket notation.)
  #
  # Defined in RFC9535 by this ABNF grammar:
  # name-first    = ALPHA /
  #                 "_"   /
  #                 %x80-D7FF /
  #                    ; skip surrogate code points
  #                 %xE000-10FFFF
  #
  # @param char [String] single character, possibly multi-byte
  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#455
  def name_first_char?(char); end

  # Returns the value of attribute next_p.
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#53
  def next_p; end

  # Sets the attribute next_p
  #
  # @param value the value to set the attribute next_p to.
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#53
  def next_p=(_arg0); end

  # Returns the value of attribute source.
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#52
  def source; end

  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#497
  def source_completed?; end

  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#501
  def source_uncompleted?; end

  # source://janeway-jsonpath//lib/janeway/lexer.rb#74
  def start_tokenization; end

  # source://janeway-jsonpath//lib/janeway/lexer.rb#124
  def token_from_one_char_lex(lexeme); end

  # Consumes an operator that could be either 1 or 2 chars in length
  #
  # @return [Token]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#134
  def token_from_one_or_two_char_lex(lexeme); end

  # Consumes a 2 char operator
  #
  # @return [Token]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#150
  def token_from_two_char_lex(lexeme); end

  # Read a token from the @source, increment the pointers.
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#84
  def tokenize; end

  # Returns the value of attribute tokens.
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#52
  def tokens; end

  # Return true if string matches the definition of "unescaped" from RFC9535:
  # unescaped     = %x20-21 /        ; see RFC 8259
  #                    ; omit 0x22 "
  #                 %x23-26 /
  #                    ; omit 0x27 '
  #                 %x28-5B /
  #                    ; omit 0x5C \
  #                 %x5D-D7FF /
  #                    ; skip surrogate code points
  #                 %xE000-10FFFF
  #
  # @param char [String] single character, possibly multi-byte
  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/lexer.rb#418
  def unescaped?(char); end

  class << self
    # Tokenize and return the token list.
    #
    # @param query [String] jsonpath query
    # @raise [ArgumentError]
    # @return [Array<Token>]
    #
    # source://janeway-jsonpath//lib/janeway/lexer.rb#59
    def lex(query); end
  end
end

# faster to check membership in a string than an array of char (benchmarked ruby 3.1.2)
#
# source://janeway-jsonpath//lib/janeway/lexer.rb#46
Janeway::Lexer::ALPHABET = T.let(T.unsafe(nil), String)

# source://janeway-jsonpath//lib/janeway/lexer.rb#47
Janeway::Lexer::DIGITS = T.let(T.unsafe(nil), String)

# source://janeway-jsonpath//lib/janeway/lexer.rb#10
class Janeway::Lexer::Error < ::Janeway::Error; end

# source://janeway-jsonpath//lib/janeway/lexer.rb#43
Janeway::Lexer::FUNCTIONS = T.let(T.unsafe(nil), Array)

# source://janeway-jsonpath//lib/janeway/lexer.rb#42
Janeway::Lexer::KEYWORD = T.let(T.unsafe(nil), Array)

# chars that may be used as the first letter of member-name-shorthand
#
# source://janeway-jsonpath//lib/janeway/lexer.rb#50
Janeway::Lexer::NAME_FIRST = T.let(T.unsafe(nil), String)

# source://janeway-jsonpath//lib/janeway/lexer.rb#36
Janeway::Lexer::ONE_CHAR_LEX = T.let(T.unsafe(nil), Array)

# source://janeway-jsonpath//lib/janeway/lexer.rb#39
Janeway::Lexer::ONE_OR_TWO_CHAR_LEX = T.let(T.unsafe(nil), Array)

# source://janeway-jsonpath//lib/janeway/lexer.rb#12
Janeway::Lexer::OPERATORS = T.let(T.unsafe(nil), Hash)

# source://janeway-jsonpath//lib/janeway/lexer.rb#37
Janeway::Lexer::TWO_CHAR_LEX = T.let(T.unsafe(nil), Array)

# source://janeway-jsonpath//lib/janeway/lexer.rb#38
Janeway::Lexer::TWO_CHAR_LEX_FIRST = T.let(T.unsafe(nil), Array)

# source://janeway-jsonpath//lib/janeway/lexer.rb#41
Janeway::Lexer::WHITESPACE = T.let(T.unsafe(nil), String)

# Converts index and name selector values to normalized path components.
#
# This implements the normalized path description in RFC 9535:
# This does a lot of escaping, and much of it is the inverse of Lexer code that does un-escaping.
#
# @see https://www.rfc-editor.org/rfc/rfc9535.html#name-normalized-paths
#
# source://janeway-jsonpath//lib/janeway/normalized_path.rb#10
module Janeway::NormalizedPath
  class << self
    # source://janeway-jsonpath//lib/janeway/normalized_path.rb#35
    def escape(str); end

    # Escape or hex-encode the given character
    #
    # @param char [String] single character, possibly multi-byte
    # @return [String]
    #
    # source://janeway-jsonpath//lib/janeway/normalized_path.rb#46
    def escape_char(char); end

    # Hex-encode the given character
    #
    # @param char [String] single character, possibly multi-byte
    # @return [String]
    #
    # source://janeway-jsonpath//lib/janeway/normalized_path.rb#62
    def hex_encode_char(char); end

    # source://janeway-jsonpath//lib/janeway/normalized_path.rb#14
    def normalize(value); end

    # @param index [Integer] index selector value
    # @return [String] eg. "[1]"
    #
    # source://janeway-jsonpath//lib/janeway/normalized_path.rb#25
    def normalize_index(index); end

    # @param name [Integer] name selector value
    # @return [String] eg. "['']"
    #
    # source://janeway-jsonpath//lib/janeway/normalized_path.rb#31
    def normalize_name(name); end
  end
end

# Characters that do not need escaping, defined by hexadecimal range
#
# source://janeway-jsonpath//lib/janeway/normalized_path.rb#12
Janeway::NormalizedPath::NORMAL_UNESCAPED_RANGES = T.let(T.unsafe(nil), Array)

# Transform a list of tokens into an Abstract Syntax Tree
#
# source://janeway-jsonpath//lib/janeway/parser.rb#11
class Janeway::Parser
  include ::Janeway::Functions

  # @param jsonpath [String] original jsonpath query string
  # @param tokens [Array<Token>]
  # @return [Parser] a new instance of Parser
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#44
  def initialize(tokens, jsonpath); end

  # Parse the token list and create an Abstract Syntax Tree
  #
  # @return [Query]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#52
  def parse; end

  # Returns the value of attribute tokens.
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#12
  def tokens; end

  private

  # Make "next" token become "current" by moving the pointer
  #
  # @return [Token] consumed token
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#78
  def consume(offset = T.unsafe(nil)); end

  # source://janeway-jsonpath//lib/janeway/parser.rb#90
  def consume_if_next_is(token_type); end

  # source://janeway-jsonpath//lib/janeway/parser.rb#104
  def current; end

  # Return literal of current token. Consume.
  #
  # @return [String, Integer] literal value of token that is `current` when function is called.
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#86
  def current_literal_and_consume; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#119
  def current_precedence; end

  # @return [nil, Symbol]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#163
  def determine_infix_function(token = T.unsafe(nil)); end

  # source://janeway-jsonpath//lib/janeway/parser.rb#137
  def determine_parsing_function; end

  # Return a Parser::Error with the specified message, include the query.
  #
  # @param msg [String] error message
  # @return [Parser::Error]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#575
  def err(msg); end

  # source://janeway-jsonpath//lib/janeway/parser.rb#112
  def lookahead(offset = T.unsafe(nil)); end

  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#72
  def next_not_terminator?; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#123
  def next_precedence; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#108
  def next_token; end

  # Extract the number from an array slice selector.
  # Consume up to and including the next : token.
  # If no number is found, return nil.
  #
  # @return [Number, nil] nil if the start is implicit
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#455
  def parse_array_slice_component; end

  # An array slice start:end:step selects a series of elements from
  # an array, giving a start position, an end position, and an optional step
  # value that moves the position from the start to the end.
  #
  # @example
  #   $[1:3]
  #   $[5:]
  #   $[1:5:2]
  #   $[5:1:-2]
  #   $[::-1]
  # @return [AST::ArraySliceSelector]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#441
  def parse_array_slice_selector; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#526
  def parse_binary_operator(left); end

  # @return [AST::Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#218
  def parse_boolean; end

  # Parse one or more selectors surrounded by parentheses.
  #
  # More than 1 selector may be within the parentheses, as long as they are separated by commas.
  # If multiple selectors are given, then their results will be combined during the
  # interpretation stage.
  #
  # The selectors may be any of these types:
  #   * name selector, eg. 'name', selects a named child of an object.
  #   * index selector, eg. 3, selects an indexed child of an array.
  #   * wildcard selector, eg. * selects all children of a node and in the expression ..[*]
  #     selects all descendants of a node.
  #   * array slice selector selects a series of elements from an array, giving a start position,
  #     an end position, and an optional step value that moves the position from the start to the end.
  #   * filter expressions select certain children of an object or array, as in:
  #
  # When there is only a single selector in the list, parse and return that selector only.
  # When there are multiple selectors, create a ChildSegment that contains all the selectors.
  #
  # This is not just a speed optimization. Serial selectors that feed into
  # each other have different behaviour than serial child segments.
  #
  # @return [AST::ChildSegment]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#346
  def parse_child_segment; end

  # Parse the current node operator "@", and any subsequent selector
  #
  # @return [AST::CurrentNode]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#318
  def parse_current_node; end

  # Parse a selector which is inside brackets
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#397
  def parse_current_selector; end

  # Parse a descendant segment.
  #
  # The descendant segment consists of a double dot "..", followed by
  # a child segment (using bracket notation).
  #
  #  Shorthand notations are also provided that correspond to the shorthand forms of the child segment.
  #
  #    descendant-segment  = ".." (bracketed-selection /
  #                                wildcard-selector /
  #                                member-name-shorthand)
  #  ..*, the descendant-segment directly built from a
  #  wildcard-selector, is shorthand for ..[*].
  #
  #  ..<member-name>, a descendant-segment built from a
  #  member-name-shorthand, is shorthand for ..['<member-name>'].
  #  Note: as with the similar shorthand of a child-segment, this can
  #  only be used with member names that are composed of certain
  #  characters, as specified in the ABNF rule member-name-shorthand.
  #
  #  Note: .. on its own is not a valid segment.
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#242
  def parse_descendant_segment; end

  # Dot notation represents a name selector, and is an alternative to bracket notation.
  # These examples are equivalent:
  #   $.store
  #   $[store]
  #
  # RFC9535 grammar specifies that the dot may be followed by only 2 selector types:
  #   * WildCardSelector ("*")
  #   * member name (with only certain chars useable. For example, names containing dots are not allowed here.)
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#270
  def parse_dot_notation; end

  # Parse an expression
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#543
  def parse_expr; end

  # Parse an expression which may contain binary operators and varying expression precedence.
  # This is only needed within a filter expression.
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#552
  def parse_expr_recursively(precedence = T.unsafe(nil)); end

  # @return [AST::Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#580
  def parse_false; end

  # Feed tokens to the FilterSelector until hitting a terminator
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#482
  def parse_filter_selector; end

  # Parse a JSONPath function call
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#537
  def parse_function; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#295
  def parse_grouped_expr; end

  # A non-delimited word that is not a keyword within a jsonpath query is not allowed.
  # eg. $[?@==foo]
  #
  # @raise
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#172
  def parse_identifier; end

  # Consume minus operator and apply it to the (expected) number token following it.
  # Don't consume the number token. The minus operator does not end up in the AST.
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#186
  def parse_minus_operator; end

  # Parse a name selector.
  # The name selector may have been in dot notation or parentheses, that part is already parsed.
  # Next token is the name.
  #
  # @return [AST::NameSelector]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#475
  def parse_name_selector; end

  # Parse a selector and return it.
  #
  # @return [Selector, ChildSegment, nil] nil if no more selectors to use
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#387
  def parse_next_selector; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#519
  def parse_not_operator; end

  # @return [AST::Null]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#213
  def parse_null; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#180
  def parse_number; end

  # Parse the root identifier "$", and any subsequent selector
  #
  # @return [AST::RootNode]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#310
  def parse_root; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#176
  def parse_string; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#304
  def parse_terminator; end

  # @return [AST::Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#579
  def parse_true; end

  # @return [AST::UnaryOperator, AST::Number]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#508
  def parse_unary_operator; end

  # Parse wildcard selector and any following selector
  #
  # @return [AST::WildcardSelector]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#422
  def parse_wildcard_selector; end

  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/parser.rb#68
  def pending_tokens?; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#100
  def previous; end

  # source://janeway-jsonpath//lib/janeway/parser.rb#127
  def unexpected_token_error(expected_type = T.unsafe(nil)); end

  class << self
    # @param jsonpath [String] jsonpath query to be lexed and parsed
    # @raise [ArgumentError]
    # @return [Query]
    #
    # source://janeway-jsonpath//lib/janeway/parser.rb#35
    def parse(jsonpath); end
  end
end

# source://janeway-jsonpath//lib/janeway/parser.rb#17
Janeway::Parser::BINARY_OPERATORS = T.let(T.unsafe(nil), Array)

# source://janeway-jsonpath//lib/janeway/parser.rb#18
Janeway::Parser::LOGICAL_OPERATORS = T.let(T.unsafe(nil), Array)

# source://janeway-jsonpath//lib/janeway/parser.rb#19
Janeway::Parser::LOWEST_PRECEDENCE = T.let(T.unsafe(nil), Integer)

# source://janeway-jsonpath//lib/janeway/parser.rb#20
Janeway::Parser::OPERATOR_PRECEDENCE = T.let(T.unsafe(nil), Hash)

# source://janeway-jsonpath//lib/janeway/parser.rb#16
Janeway::Parser::UNARY_OPERATORS = T.let(T.unsafe(nil), Array)

# Query holds the abstract syntax tree created by parsing the query.
# This can be frozen and passed to multiple threads or ractors for simultaneous use.
# No instance members are modified during the interpretation stage.
#
# source://janeway-jsonpath//lib/janeway/query.rb#7
class Janeway::Query
  # @param jsonpath [String]
  # @param root_node [AST::Root]
  # @raise [ArgumentError]
  # @return [Query] a new instance of Query
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#17
  def initialize(root_node, jsonpath); end

  # Queries are considered equal if their ASTs evaluate to the same JSONPath string.
  #
  # The string output is generated from the AST and should be considered a "normalized"
  # form of the query. It may have different whitespace and parentheses than the original
  # input but will be semantically equivalent.
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#67
  def ==(other); end

  # Deep copy the query
  #
  # @return [Query]
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#81
  def dup; end

  # Combine this query with input to make an Enumerator.
  # This can be used to iterate over results with #each, #map, etc.
  #
  # @return [Janeway::Enumerator]
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#29
  def enum_for(input); end

  # The original jsonpath query, for use in error messages
  #
  # @return [String]
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#10
  def jsonpath; end

  # Return a list of the nodes in the AST.
  # The AST of a jsonpath query is a straight line, so this is expressible as an array.
  # The only part of the AST with branches is inside a filter selector, but that doesn't show up here.
  #
  # @return [Array<Expression>]
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#50
  def node_list; end

  # Delete the last element from the chain of selectors.
  # For a singular query, this makes the query point to the match's parent instead of the match itself.
  #
  # Don't do this for a non-singular query, those may contain child segments and
  # descendant segments which would lead to different results.
  #
  # @return [AST::Selector]
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#92
  def pop; end

  # @return [AST::Root]
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#13
  def root; end

  # Return true if this query can only possibly match 0 or 1 elements in any input.
  # Such a query must be composed exclusively of the root identifier followed by
  # name selectors and / or index selectors.
  #
  # @return [Boolean]
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#42
  def singular_query?; end

  # @return [String]
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#34
  def to_s; end

  # Print AST in tree format
  # Every AST class prints a 1-line representation of self, with children on separate lines
  #
  # source://janeway-jsonpath//lib/janeway/query.rb#73
  def tree; end
end

# Tokens are produced by the lexer, they represent jsonpath query elements in a low-level, non-hierarchical way.
#
# source://janeway-jsonpath//lib/janeway/token.rb#7
class Janeway::Token
  extend ::Forwardable

  # @return [Token] a new instance of Token
  #
  # source://janeway-jsonpath//lib/janeway/token.rb#17
  def initialize(type, lexeme, literal, location); end

  # source://janeway-jsonpath//lib/janeway/token.rb#28
  def ==(other); end

  # source://janeway-jsonpath//lib/janeway/token.rb#15
  def col(*args, **_arg1, &block); end

  # source://janeway-jsonpath//lib/janeway/token.rb#15
  def length(*args, **_arg1, &block); end

  # Returns the value of attribute lexeme.
  #
  # source://janeway-jsonpath//lib/janeway/token.rb#10
  def lexeme; end

  # source://janeway-jsonpath//lib/janeway/token.rb#15
  def line(*args, **_arg1, &block); end

  # write-access so '-' operator can modify number value
  #
  # source://janeway-jsonpath//lib/janeway/token.rb#13
  def literal; end

  # write-access so '-' operator can modify number value
  #
  # source://janeway-jsonpath//lib/janeway/token.rb#13
  def literal=(_arg0); end

  # Returns the value of attribute location.
  #
  # source://janeway-jsonpath//lib/janeway/token.rb#10
  def location; end

  # source://janeway-jsonpath//lib/janeway/token.rb#24
  def to_s; end

  # Returns the value of attribute type.
  #
  # source://janeway-jsonpath//lib/janeway/token.rb#10
  def type; end
end

# source://janeway-jsonpath//lib/janeway/location.rb#3
class Location < ::Struct
  # Returns the value of attribute col
  #
  # @return [Object] the current value of col
  #
  # source://janeway-jsonpath//lib/janeway/location.rb#3
  def col; end

  # Sets the attribute col
  #
  # @param value [Object] the value to set the attribute col to.
  # @return [Object] the newly set value
  #
  # source://janeway-jsonpath//lib/janeway/location.rb#3
  def col=(_); end

  # Returns the value of attribute length
  #
  # @return [Object] the current value of length
  #
  # source://janeway-jsonpath//lib/janeway/location.rb#3
  def length; end

  # Sets the attribute length
  #
  # @param value [Object] the value to set the attribute length to.
  # @return [Object] the newly set value
  #
  # source://janeway-jsonpath//lib/janeway/location.rb#3
  def length=(_); end

  class << self
    # source://janeway-jsonpath//lib/janeway/location.rb#3
    def [](*_arg0); end

    # source://janeway-jsonpath//lib/janeway/location.rb#3
    def inspect; end

    # source://janeway-jsonpath//lib/janeway/location.rb#3
    def keyword_init?; end

    # source://janeway-jsonpath//lib/janeway/location.rb#3
    def members; end

    # source://janeway-jsonpath//lib/janeway/location.rb#3
    def new(*_arg0); end
  end
end
