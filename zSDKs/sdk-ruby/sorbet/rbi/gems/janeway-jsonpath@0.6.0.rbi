  # source://janeway-jsonpath//lib/janeway/interpreters/wildcard_selector_interpreter.rb#28
  def interpret_hash(input, root, path); end

  # source://janeway-jsonpath//lib/janeway/interpreters/wildcard_selector_interpreter.rb#9
  def selector; end
