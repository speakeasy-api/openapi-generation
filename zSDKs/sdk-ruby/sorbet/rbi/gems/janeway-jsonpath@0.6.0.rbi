  # @param root [Array, Hash] the entire input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/filter_selector_delete_if.rb#25
  def interpret_hash(input, root, path); end
end

# Interprets a filter selector, and deletes matching values
#
