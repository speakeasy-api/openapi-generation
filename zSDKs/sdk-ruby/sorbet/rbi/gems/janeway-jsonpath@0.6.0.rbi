  # @param path [Array] elements of normalized path to the current input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/name_selector_delete_if.rb#28
  def interpret(input, _parent, _root, path); end
end

# Interprets a name selector, and deletes the matched values.
#
# source://janeway-jsonpath//lib/janeway/interpreters/name_selector_deleter.rb#8
class Janeway::Interpreters::NameSelectorDeleter < ::Janeway::Interpreters::NameSelectorInterpreter
