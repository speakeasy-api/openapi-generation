# Interprets a filter selector, returns results or forwards them to next selector
#
# source://janeway-jsonpath//lib/janeway/interpreters/filter_selector_interpreter.rb#8
class Janeway::Interpreters::FilterSelectorInterpreter < ::Janeway::Interpreters::Base
  # Set up the internal interpreter chain for the FilterSelector.
  #
  # @param selector [AST::FilterSelector]
  # @return [FilterSelectorInterpreter] a new instance of FilterSelectorInterpreter
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/filter_selector_interpreter.rb#13
  def initialize(selector); end

  # @return [Hash]
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/filter_selector_interpreter.rb#98
  def as_json; end

  # Interpret selector on the input.
  #
  # @param _parent [Array, Hash] parent of the input object
  # @param input [Array, Hash] the results of processing so far
  # @param path [Array<String>] elements of normalized path to the current input
  # @param root [Array, Hash] the entire input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/filter_selector_interpreter.rb#33
  def interpret(input, _parent, root, path); end

  # Interpret selector on the input.
  #
  # @param input [Array] the results of processing so far
  # @param path [Array<String>] elements of normalized path to the current input
  # @param root [Array, Hash] the entire input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/filter_selector_interpreter.rb#73
  def interpret_array(input, root, path); end

  # Interpret selector on the input.
  #
  # @param input [Hash] the results of processing so far
  # @param path [Array<String>] elements of normalized path to the current input
  # @param root [Array, Hash] the entire input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/filter_selector_interpreter.rb#45
  def interpret_hash(input, root, path); end

  # source://janeway-jsonpath//lib/janeway/interpreters/filter_selector_interpreter.rb#9
  def selector; end

  class << self
    # FIXME: should this be combined with similar func in Interpreter?
    # FIXME: move this to a separate module?
    #
    # Set up a tree of interpreters which can process input for the filter expression.
    # For a jsonpath query like '$.a[?@.b == $.x]', this sets up interpreters for '@.b == $.x'.
    #
    # @return [Interpreters::Base] root of the filter expression
    #
    # source://janeway-jsonpath//lib/janeway/interpreters/filter_selector_interpreter.rb#24
    def setup_interpreter_tree(selector); end
  end
end

# Interprets a jsonpath function call within a filter selector.
#
# source://janeway-jsonpath//lib/janeway/interpreters/function_interpreter.rb#8
class Janeway::Interpreters::FunctionInterpreter < ::Janeway::Interpreters::Base
  # @param function [AST::Function]
  # @return [FunctionInterpreter] a new instance of FunctionInterpreter
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/function_interpreter.rb#22
  def initialize(function); end

  # Prepare a value to be passed to as a parameter with type ValueType.
  # Singular queries (see RFC) produce a node list containing one value.
  # Return the value.
  #
  # Implements this part of the RFC:
  #   > When the declared type of the parameter is ValueType and
  #     the argument is one of the following:
  #   > ...
  #   >
  #   > A singular query. In this case:
  #   > * If the query results in a nodelist consisting of a single node,
  #       the argument is the value of the node.
  #   > * If the query results in an empty nodelist, the argument is
  #       the special result Nothing.
  #
  # @param input [Object] usually an array - sometimes a basic type like String, Numeric
  # @return [Object] basic type -- string or number
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/function_interpreter.rb#87
  def deconstruct(input); end

  # source://janeway-jsonpath//lib/janeway/interpreters/function_interpreter.rb#9
  def function; end

  # @param _parent [Array, Hash] parent of the input object
  # @param _path [Array<String>] elements of normalized path to the current input
  # @param input [Array, Hash] the results of processing so far
  # @param root [Array, Hash] the entire input
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/function_interpreter.rb#31
  def interpret(input, _parent, root, _path); end

  # Evaluate the expressions in the parameter list to make the parameter values
  # to pass in to a JsonPath function.
  #
  # The node lists returned by a singular query must be deconstructed into a single value for
  # parameters of ValueType, this is done here.
  # For explanation:
  #
  # @param input [Object]
  # @param parameters [Array] parameters before evaluation
  # @param root [Array, Hash] the entire input
  # @return [Array] parameters after evaluation
  # @see https://www.rfc-editor.org/rfc/rfc9535.html#name-well-typedness-of-function-
  #
  # source://janeway-jsonpath//lib/janeway/interpreters/function_interpreter.rb#48
  def interpret_function_parameters(parameters, input, root); end
end

# Specify the parameter types that built-in JsonPath functions require
#
# @return [Hash<Symbol, Array<Symbol>] function name => list of parameter types] Hash<Symbol, Array<Symbol>] function name => list of parameter types
#
# source://janeway-jsonpath//lib/janeway/interpreters/function_interpreter.rb#13
Janeway::Interpreters::FunctionInterpreter::FUNCTION_PARAMETER_TYPES = T.let(T.unsafe(nil), Hash)

