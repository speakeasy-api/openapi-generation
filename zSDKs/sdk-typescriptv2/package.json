{
  "name": "openapi",
  "version": "0.0.1",
  "author": "Speakeasy",
  "license": "UNLICENSED",
  "type": "module",
  "tshy": {
    "compiler": "tsgo",
    "sourceDialects": [
      "openapi/source"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json",
      "./types": "./src/types/index.ts",
      "./models": "./src/models/index.ts",
      "./react-query": "./src/react-query/index.ts",
      "./*.js": "./src/*.ts",
      "./*": "./src/*.ts"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/speakeasy-sdks/test-sdk"
  },
  "scripts": {
    "test": "vitest run src --reporter=junit --outputFile=.speakeasy/reports/tests.xml --reporter=default",
    "check": "npm run test && npm run lint",
    "lint": "oxlint --max-warnings=0 --deny-warnings --no-error-on-unmatched-pattern src",
    "build": "tshy",
    "prepublishOnly": "npm run build",
    "echo": "echo Hello, World!"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.61.4",
    "@types/node": "^18.19.3",
    "@types/react": "^18.3.12",
    "@typescript/native-preview": "7.0.0-dev.20260302.1",
    "oxlint": "^1.60.0",
    "tshy": "^3.3.2",
    "typescript": "~5.8.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "uuid": "^11.1.1",
    "zod": "^3.25.65 || ^4.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "openapi/source": "./src/index.ts",
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./types": {
      "import": {
        "openapi/source": "./src/types/index.ts",
        "types": "./dist/esm/types/index.d.ts",
        "default": "./dist/esm/types/index.js"
      },
      "require": {
        "types": "./dist/commonjs/types/index.d.ts",
        "default": "./dist/commonjs/types/index.js"
      }
    },
    "./models": {
      "import": {
        "openapi/source": "./src/models/index.ts",
        "types": "./dist/esm/models/index.d.ts",
        "default": "./dist/esm/models/index.js"
      },
      "require": {
        "types": "./dist/commonjs/models/index.d.ts",
        "default": "./dist/commonjs/models/index.js"
      }
    },
    "./react-query": {
      "import": {
        "openapi/source": "./src/react-query/index.ts",
        "types": "./dist/esm/react-query/index.d.ts",
        "default": "./dist/esm/react-query/index.js"
      },
      "require": {
        "types": "./dist/commonjs/react-query/index.d.ts",
        "default": "./dist/commonjs/react-query/index.js"
      }
    },
    "./*.js": {
      "import": {
        "openapi/source": "./src/*.ts",
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "require": {
        "types": "./dist/commonjs/*.d.ts",
        "default": "./dist/commonjs/*.js"
      }
    },
    "./*": {
      "import": {
        "openapi/source": "./src/*.ts",
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "require": {
        "types": "./dist/commonjs/*.d.ts",
        "default": "./dist/commonjs/*.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js"
}
