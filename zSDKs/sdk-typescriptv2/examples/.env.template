# openapi SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: SPEAKEASY_
#
# Security environment variables:
SPEAKEASY_USERNAME=your_username_here
SPEAKEASY_PASSWORD=your_password_here
SPEAKEASY_BEARER_AUTH=your_bearerauth_here
SPEAKEASY_MY_API_KEY=your_myapikey_here
SPEAKEASY_OAUTH2=your_oauth2_here
SPEAKEASY_APP_ID=your_appid_here
SPEAKEASY_SECRET=your_secret_here
SPEAKEASY_MOBILE_AUTH=your_mobileauth_here
SPEAKEASY_CLIENT_ID=your_client_id_here
SPEAKEASY_CLIENT_SECRET=your_client_secret_here
SPEAKEASY_TOKEN_URL=https://example.com/oauth/token

# Debug Configuration
# Enable HTTP request/response logging for debugging
SPEAKEASY_DEBUG=true
