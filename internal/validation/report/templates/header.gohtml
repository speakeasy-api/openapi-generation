{{ define "header"}}
    <head>
        <title>Speakeasy Linting Report</title>
        <!-- this file has been autogenerated by vacuum https://quobix.com/vacuum -->
        <meta charset="UTF-8">
        <meta name="description" content="report generated by Speakeasy">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {{- if not .TestMode -}}
        <script>
            {{ .BundledJS }}
        </script>
        {{- else -}}
        <script src="http://localhost:8080/js/vacuumReport.js"></script>
        {{- end -}}
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap')
        </style>
        <style>
            :root {
                --global-font-size: 17px;
                --global-line-height: 1.4em;
                --global-space: 10px;
                --sans-font-stack: 'Inter', sans-serif;
                --font-stack: Menlo, Monaco, Lucida Console, Liberation Mono,
                DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace,
                serif;
                --mono-font-stack: Menlo, Monaco, Lucida Console, Liberation Mono,
                DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace,
                serif;
                --background-color: #191919;
                --background-color-with-opacity: rgba(25, 25, 25, 0.6);
                --page-width: 100vw;
                --font-color: #e8e9ed;
                --invert-font-color: #0a0a0a;
                --secondary-color: #666666;
                --secondary-color-lowalpha: rgba(102, 102, 102, 0.5);
                --secondary-color-x-lowalpha: rgba(102, 102, 102, 0.2);
                --tertiary-color: #9ca3af;
                --primary-color: rgb(14, 165, 233);
                --primary-color-lowalpha: rgba(14, 165, 233, 0.76);
                --error-color: rgb(229, 77, 46);
                --error-color-lowalpha: rgba(229, 77, 46, 0.14);
                --warn-400: #ff6a00;
                --warn-400-lowalpha: rgba(255, 106, 0, 0.15);
                --warn-300: #ff9900;
                --warn-300-lowalpha: rgba(255, 153, 0, 0.05);
                --warn-200: #ffb700;
                --warn-200-lowalpha: rgba(255, 183, 0, 0.15);
                --warn-color: #ffd500;
                --warn-color-lowalpha: rgba(255, 213, 0, 0.15);
                --ok-400: #f7ff00;
                --ok-400-lowalpha: rgba(230, 255, 0, 0.15);
                --ok-300: #d0ff00;
                --ok-300-lowalpha: rgba(208, 255, 0, 0.15);
                --ok-200: #aaff00;
                --ok-200-lowalpha: rgba(170, 255, 0, 0.15);
                --ok-color: #1aff00;
                --ok-color-lowalpha: rgba(170, 255, 0, 0.15);
                --progress-bar-background: #3f3f44;
                --progress-bar-fill: rgb(14, 165, 233);
                --code-bg-color: #1e1e1e;
                --input-style: solid;
                --display-h1-decoration: none;
                --bold-text: rgb(14, 165, 233);
                --terminal-green: #00FF00FF;
                --hrcolor: #222222;
                --code-border: #222222;
                --card-bgcolor: rgba(30, 30, 30, 0.3);
                --card-bordercolor: #222222;
                --sl-font-sans: var(--font-stack);
                --sl-font-mono: var(--font-stack);
                --sl-font-size-small: 16px;
                --sl-font-size-xx-small: 10px;
                --sl-font-size-x-small: 12px;
                --rule-font-size: 0.8rem;
                --sl-color-primary-50: rgb(240 249 255);
                --sl-color-primary-100: rgb(224 242 254);
                --sl-color-primary-200: rgb(186 230 253);
                --sl-color-primary-300: rgb(125 211 252);
                --sl-color-primary-400: rgb(56 189 248);
                --sl-color-primary-500: rgb(14 165 233);
                --sl-color-primary-600: rgb(2 132 199);
                --sl-color-primary-700: rgb(3 105 161);
                --sl-color-primary-800: rgb(7 89 133);
                --sl-color-primary-900: rgb(12 74 110);
                --sl-color-primary-950: rgb(8 47 73);
                --global-padding: 20px;
                --global-margin: 20px;
            }

            body {
                background-color: var(--background-color);
                font-feature-settings: "salt" on;
            }
            body::-webkit-scrollbar {
                width: 10px;
            }
            body::-webkit-scrollbar-track {
                background-color: #1a1a1a;
            }

            body::-webkit-scrollbar-thumb {
                background: rgba(156, 163, 175, 0.15);
                border-radius: 9999px;
            }

            body::-webkit-scrollbar-thumb:hover {
                background: rgba(156, 163, 175, 0.5);
            }

            {{- .ReportCSS -}}
        </style>
    </head>
{{ end}}
