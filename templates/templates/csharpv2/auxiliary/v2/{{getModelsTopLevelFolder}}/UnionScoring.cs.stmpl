#nullable enable
namespace {{getModelNamespace ""}}
{
    using System;
    using System.Collections.Concurrent;
    using System.Collections.Generic;
    using System.Text.Json;
    using System.Text.Json.Serialization.Metadata;

    /// <summary>
    /// Structural fit of a JSON payload against a candidate union variant, expressed as two
    /// counts: <see cref="Overflow"/> — JSON properties the variant does not declare — and
    /// <see cref="Missing"/> — variant properties absent from the JSON. Both are minimized when
    /// ranking, so the variant whose shape most tightly matches the payload wins. Overflow alone
    /// cannot separate two variants that both cover every JSON key (e.g. a narrow variant and a
    /// wider one that merely declares extra optional fields); Missing breaks that tie in favor of
    /// the narrower variant, matching the v1 smart-union ranking. <see cref="Unknown"/> counts
    /// nested open-union values that would read as Unknown, and ranks before both.
    /// </summary>
    internal readonly struct UnionScore
    {
        public readonly int Overflow;
        public readonly int Missing;
        public readonly int Unknown;

        public UnionScore(int overflow, int missing, int unknown = 0)
        {
            Overflow = overflow;
            Missing = missing;
            Unknown = unknown;
        }

        public static readonly UnionScore Zero = new UnionScore(0, 0);

        public static UnionScore operator +(UnionScore a, UnionScore b) =>
            new UnionScore(a.Overflow + b.Overflow, a.Missing + b.Missing, a.Unknown + b.Unknown);

        // Lower is a better fit: fewer unknown first, then fewer overflow, then fewer missing.
        public int CompareTo(UnionScore other)
        {
            int c = Unknown.CompareTo(other.Unknown);
            if (c != 0)
            {
                return c;
            }
            c = Overflow.CompareTo(other.Overflow);
            if (c != 0)
            {
                return c;
            }
            return Missing.CompareTo(other.Missing);
        }
    }

    /// <summary>
    /// Structural scoring helper for undiscriminated-union deserialization. Recurses through
    /// nested objects and array/collection elements, accumulating a <see cref="UnionScore"/>
    /// against a candidate variant's source-generated metadata. Lower scores mean a tighter fit,
    /// so the widest structural match wins instead of the first-declared variant that merely
    /// tolerates the extra fields (System.Text.Json ignores unmatched properties on read).
    /// </summary>
    internal static class UnionScoring
    {
        // Maps a union CLR type to its variant CLR types, so a nested union (whose own
        // JsonTypeInfo is converter-based, not Object-kind) can be scored by its variants.
        // Populated by each union's converter factory.
        private static readonly ConcurrentDictionary<Type, Type[]> UnionVariants =
            new ConcurrentDictionary<Type, Type[]>();

        // Non-nullable open unions, which read JSON null as Unknown.
        private static readonly ConcurrentDictionary<Type, bool> NullReadsAsUnknown =
            new ConcurrentDictionary<Type, bool>();

        public static void RegisterUnion(Type unionType, Type[] variantTypes)
        {
            UnionVariants[unionType] = variantTypes;
        }

        public static void RegisterNullAsUnknown(Type unionType)
        {
            NullReadsAsUnknown[unionType] = true;
        }

        public static UnionScore Score(
            JsonElement element,
            JsonTypeInfo? typeInfo,
            JsonSerializerOptions options
        )
        {
            return Score(element, typeInfo, options, 0);
        }

        private static UnionScore Score(
            JsonElement element,
            JsonTypeInfo? typeInfo,
            JsonSerializerOptions options,
            int depth
        )
        {
            // Depth cap guards against pathological self-referential metadata graphs.
            if (typeInfo == null || depth > 10)
            {
                return UnionScore.Zero;
            }

            if (element.ValueKind == JsonValueKind.Null && NullReadsAsUnknown.ContainsKey(typeInfo.Type))
            {
                return new UnionScore(0, 0, 1);
            }

            // Nested union: score by its tightest-fitting variant, not its opaque metadata.
            if (UnionVariants.TryGetValue(typeInfo.Type, out var variantTypes))
            {
                UnionScore? best = null;
                foreach (var variantType in variantTypes)
                {
                    var score = Score(
                        element,
                        ResolveTypeInfo(variantType, options),
                        options,
                        depth + 1
                    );
                    if (best == null || score.CompareTo(best.Value) < 0)
                    {
                        best = score;
                    }
                }
                return best ?? UnionScore.Zero;
            }

            switch (element.ValueKind)
            {
                case JsonValueKind.Object:
                    if (typeInfo.Kind == JsonTypeInfoKind.Dictionary)
                    {
                        var valueType = GetDictionaryValueType(typeInfo.Type);
                        if (valueType == null)
                        {
                            return UnionScore.Zero;
                        }
                        var valueTypeInfo = ResolveTypeInfo(valueType, options);
                        var valuesScore = UnionScore.Zero;
                        foreach (var entry in element.EnumerateObject())
                        {
                            valuesScore += Score(entry.Value, valueTypeInfo, options, depth + 1);
                        }
                        return valuesScore;
                    }

                    // Only object-shaped metadata yields a property-fit signal.
                    // Dictionary / freeform objects declare no properties and must not
                    // be penalized — they legitimately accept arbitrary keys.
                    if (typeInfo.Kind != JsonTypeInfoKind.Object || typeInfo.Properties.Count == 0)
                    {
                        return UnionScore.Zero;
                    }

                    var known = new Dictionary<string, JsonPropertyInfo>(
                        StringComparer.OrdinalIgnoreCase
                    );
                    foreach (var prop in typeInfo.Properties)
                    {
                        known[prop.Name] = prop;
                    }

                    var matched = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    var result = UnionScore.Zero;
                    foreach (var jsonProp in element.EnumerateObject())
                    {
                        if (known.TryGetValue(jsonProp.Name, out var propInfo))
                        {
                            matched.Add(propInfo.Name);
                            result += Score(
                                jsonProp.Value,
                                ResolveTypeInfo(propInfo.PropertyType, options),
                                options,
                                depth + 1
                            );
                        }
                        else
                        {
                            result += new UnionScore(1, 0);
                        }
                    }

                    // Variant properties the JSON never supplied — penalizes a wider variant
                    // that merely tolerates the payload over a narrower exact-shape variant.
                    int missing = 0;
                    foreach (var prop in typeInfo.Properties)
                    {
                        if (!matched.Contains(prop.Name))
                        {
                            missing++;
                        }
                    }
                    return result + new UnionScore(0, missing);

                case JsonValueKind.Array:
                    var elementType = GetElementType(typeInfo.Type);
                    if (elementType == null)
                    {
                        return UnionScore.Zero;
                    }
                    var elementTypeInfo = ResolveTypeInfo(elementType, options);
                    var sum = UnionScore.Zero;
                    foreach (var item in element.EnumerateArray())
                    {
                        sum += Score(item, elementTypeInfo, options, depth + 1);
                    }
                    return sum;

                default:
                    return UnionScore.Zero;
            }
        }

        private static JsonTypeInfo? ResolveTypeInfo(Type type, JsonSerializerOptions options)
        {
            try
            {
                return options.GetTypeInfo(type);
            }
            catch (Exception)
            {
                return null;
            }
        }

        private static Type? GetDictionaryValueType(Type type)
        {
            if (type.IsGenericType)
            {
                var args = type.GetGenericArguments();
                if (args.Length == 2)
                {
                    return args[1];
                }
            }
            return null;
        }

        // JsonTypeInfo exposes no element type, so derive it from the CLR type.
        // Metadata-only reflection (IsArray / generic type arguments) is trim/AOT-safe.
        private static Type? GetElementType(Type type)
        {
            if (type.IsArray)
            {
                return type.GetElementType();
            }
            if (type.IsGenericType)
            {
                var args = type.GetGenericArguments();
                if (args.Length == 1)
                {
                    return args[0];
                }
            }
            return null;
        }
    }
}
