#nullable enable
namespace {{getScopeNamespace "utils"}}
{
    using System;
    using System.Collections;
    using System.Collections.Generic;
    using System.Globalization;
    using System.Net;
    using System.Net.Http;
    using System.Text;
    using System.Text.Json;
    using System.Text.Json.Serialization.Metadata;

    internal static class URLBuilder
    {
        public static string ReplacePathParam(string url, string name, object? value, string style, bool explode, bool allowReserved = false)
        {
            if (value == null) return url.Replace("{" + name + "}", "");
            var serialized = SerializePathParam(name, value, style, explode);
            var escaped = allowReserved ? EscapeExceptReserved(serialized) : Uri.EscapeDataString(serialized);
            return url.Replace("{" + name + "}", escaped);
        }

        public static string ReplacePathParamJson<T>(string url, string name, T? value, JsonTypeInfo<T> typeInfo) where T : class
        {
            if (value is null) return url.Replace("{" + name + "}", "");
            var serialized = JsonSerializer.Serialize(value, typeInfo);
            return url.Replace("{" + name + "}", Uri.EscapeDataString(serialized));
        }

        public static void AppendQueryParam(List<string> qs, string name, object? value, string style, bool explode, bool allowEmpty, bool allowReserved = false)
        {
            if (value == null)
            {
                if (allowEmpty) qs.Add(name + "=");
                return;
            }

            if (value is IList emptyList && !(value is string) && emptyList.Count == 0)
            {
                if (allowEmpty) qs.Add(name + "=");
                return;
            }

            switch (style)
            {
                case "form":
                    AppendFormQueryParam(qs, name, value, explode, ",", allowReserved);
                    break;
                case "pipeDelimited":
                    AppendFormQueryParam(qs, name, value, explode, "|", allowReserved);
                    break;
                case "deepObject":
                    AppendDeepObjectQueryParam(qs, name, value, allowReserved);
                    break;
                default:
                    throw new NotSupportedException($"Unsupported query param style: {style}");
            }
        }

        public static void AppendQueryParamJson<T>(List<string> qs, string name, T? value, JsonTypeInfo<T> typeInfo) where T : class
        {
            if (value is null) return;
            var serialized = JsonSerializer.Serialize(value, typeInfo);
            qs.Add(name + "=" + WebUtility.UrlEncode(serialized));
        }

        public static string Finalize(string url, List<string> qs)
            => qs.Count == 0 ? url : url + "?" + string.Join("&", qs);

        public static void AppendHeader(HttpRequestMessage request, string name, object? value, string style, bool explode)
        {
            if (value == null) return;
            var serialized = SerializeHeader(value, explode);
            if (string.IsNullOrEmpty(serialized)) return;
            request.Headers.Add(name, serialized);
        }

        // ── private serializers ─────────────────────────────────────────────

        private static string SerializePathParam(string name, object value, string style, bool explode)
        {
            if (style != "simple")
                throw new NotSupportedException($"Unsupported path param style: {style}");

            if (value is IList list && !(value is string))
            {
                var items = new List<string>(list.Count);
                foreach (var item in list) items.Add(Utilities.ToString(item));
                return string.Join(",", items);
            }

            if (value is IDictionary dict)
            {
                var sep = explode ? "," : ",";
                var pairs = new List<string>();
                foreach (DictionaryEntry e in dict)
                {
                    var k = Utilities.ToString(e.Key);
                    var v = Utilities.ToString(e.Value);
                    pairs.Add(explode ? $"{k}={v}" : $"{k},{v}");
                }
                return string.Join(",", pairs);
            }

            return Utilities.ToString(value);
        }

        private static void AppendFormQueryParam(List<string> qs, string name, object value, bool explode, string sep, bool allowReserved)
        {
            if (value is IList list && !(value is string))
            {
                if (explode)
                {
                    foreach (var item in list)
                        qs.Add(name + "=" + EscapeQueryValue(Utilities.ToString(item), allowReserved));
                }
                else
                {
                    var items = new List<string>(list.Count);
                    foreach (var item in list) items.Add(Utilities.ToString(item));
                    qs.Add(name + "=" + EscapeQueryValue(string.Join(sep, items), allowReserved));
                }
                return;
            }

            if (value is IDictionary dict)
            {
                if (explode)
                {
                    foreach (DictionaryEntry e in dict)
                        qs.Add(WebUtility.UrlEncode(Utilities.ToString(e.Key)) + "=" + EscapeQueryValue(Utilities.ToString(e.Value), allowReserved));
                }
                else
                {
                    var items = new List<string>();
                    foreach (DictionaryEntry e in dict)
                    {
                        items.Add(Utilities.ToString(e.Key));
                        items.Add(Utilities.ToString(e.Value));
                    }
                    qs.Add(name + "=" + EscapeQueryValue(string.Join(sep, items), allowReserved));
                }
                return;
            }

            qs.Add(name + "=" + EscapeQueryValue(Utilities.ToString(value), allowReserved));
        }

        private static void AppendDeepObjectQueryParam(List<string> qs, string name, object value, bool allowReserved)
        {
            if (value is IDictionary dict)
            {
                foreach (DictionaryEntry e in dict)
                {
                    var k = Utilities.ToString(e.Key);
                    var v = e.Value;
                    if (v is IList vl && !(v is string))
                    {
                        foreach (var item in vl)
                            qs.Add(name + "[" + WebUtility.UrlEncode(k) + "]=" + EscapeQueryValue(Utilities.ToString(item), allowReserved));
                    }
                    else
                    {
                        qs.Add(name + "[" + WebUtility.UrlEncode(k) + "]=" + EscapeQueryValue(Utilities.ToString(v), allowReserved));
                    }
                }
                return;
            }

            // Object shapes need per-field emission at template time (see urlbuilder.ts).
            // Falling through means caller passed a non-dict object — likely a generation gap.
            throw new NotSupportedException(
                $"deepObject query param '{name}' on object of type {value.GetType().FullName} requires template-time per-field emission");
        }

        private static string EscapeQueryValue(string value, bool allowReserved)
            => allowReserved ? EscapeExceptReserved(value) : WebUtility.UrlEncode(value);

        internal static string EscapeExceptReserved(string value)
        {
            const string reservedChars = ":/?#[]@!$&'()*+,;=";
            var sb = new StringBuilder(value.Length);
            foreach (var b in Encoding.UTF8.GetBytes(value))
            {
                var isUnreserved =
                    (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z') || (b >= '0' && b <= '9')
                    || b == '-' || b == '.' || b == '_' || b == '~';
                if (isUnreserved || reservedChars.IndexOf((char)b) >= 0)
                {
                    sb.Append((char)b);
                }
                else
                {
                    sb.Append('%').Append(b.ToString("X2"));
                }
            }
            return sb.ToString();
        }

        private static string SerializeHeader(object value, bool explode)
        {
            if (value is IList list && !(value is string))
            {
                var items = new List<string>(list.Count);
                foreach (var item in list) items.Add(Utilities.ToString(item));
                return string.Join(",", items);
            }

            if (value is IDictionary dict)
            {
                var pairs = new List<string>();
                foreach (DictionaryEntry e in dict)
                {
                    var k = Utilities.ToString(e.Key);
                    var v = Utilities.ToString(e.Value);
                    pairs.Add(explode ? $"{k}={v}" : $"{k},{v}");
                }
                return string.Join(",", pairs);
            }

            return Utilities.ToString(value);
        }
    }
}
