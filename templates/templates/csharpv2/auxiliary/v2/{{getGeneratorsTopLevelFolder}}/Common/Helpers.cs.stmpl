#nullable enable
using Microsoft.CodeAnalysis;

namespace {{getGeneratorsPackageId}};

internal static class Helpers
{
    private const int IndentSize = 4;
    private const string GlobalPrefix = "global::";

    public static string Indent(int level) => new string(' ', level * IndentSize);

    /// <summary>Returns the file-scoped namespace declaration for <paramref name="ns"/>,
    /// e.g. <c>"namespace Foo.Bar;\n\n"</c>, or an empty string for the global namespace.</summary>
    public static string NamespaceDeclaration(INamespaceSymbol ns) =>
        ns.IsGlobalNamespace ? "" : $"namespace {ns.ToDisplayString()};\n\n";

    /// <summary>Returns the <c>AddSource</c> hint name for the emitted class <paramref name="fullyQualifiedTypeName"/>,
    /// without <c>global::</c>: hint names must be unique per generator and cannot contain <c>':'</c>.</summary>
    public static string HintName(string fullyQualifiedTypeName) =>
        (fullyQualifiedTypeName.StartsWith(GlobalPrefix, System.StringComparison.Ordinal)
            ? fullyQualifiedTypeName.Substring(GlobalPrefix.Length)
            : fullyQualifiedTypeName) + ".g.cs";
}
