#nullable enable
using System.Collections.Generic;
using System.Linq;
using Microsoft.CodeAnalysis;
using static {{getGeneratorsPackageId}}.Helpers;

namespace {{getGeneratorsPackageId}}.Union;

[Generator]
public class DiscriminatedUnionGenerator : UnionGeneratorBase
{
    private const string AttributeName =
        "{{getGeneratorsPackageId}}.Union.GenerateDiscriminatedUnionConverterAttribute";

    protected override string AttributeFullName => AttributeName;

    // Excludes the Type property in addition to Index because Type is the discriminator
    // field itself, not a variant container.
    protected override IEnumerable<IPropertySymbol> FilterProperties(INamedTypeSymbol classSymbol)
    {
        return classSymbol
            .GetMembers()
            .OfType<IPropertySymbol>()
            .Where(p =>
                p.Type.NullableAnnotation == NullableAnnotation.Annotated
                && p.Name != "Index"
                && p.Name != "Type"{{if schemaValidationLenient}}
                && !IsJsonIgnored(p){{end}}
            );
    }

    private protected override string GenerateReadVariantLogic(UnionModel model)
    {
        var switchCasesList = model.Properties
            .SelectMany(prop =>
            {
                var values = prop.DiscriminatorValues.Length > 0
                    ? (System.Collections.Generic.IEnumerable<string>)prop.DiscriminatorValues
                    : new[] { prop.Name.ToLowerInvariant() };

                return values.Select((discriminatorValue, i) =>
                {
                    var factory = i < prop.DiscriminatorFactories.Length ? prop.DiscriminatorFactories[i] : "";
                    var methodName = factory.Length > 0
                        ? factory
                        : prop.FactoryMethodName ?? $"Create{prop.Name}";
{{- if schemaValidationLenient}}
                    if (!prop.IsValueType)
                        return $"\"{discriminatorValue}\" => ReadVariant(jsonText, root, _ti{prop.Name}, {model.FullyQualifiedName}.{methodName}),";
{{- end}}
                    return $"\"{discriminatorValue}\" => {model.FullyQualifiedName}.{methodName}(System.Text.Json.JsonSerializer.Deserialize(jsonText, _ti{prop.Name})!),";
                });
            })
            .ToList();

        var switchCases = string.Join($"\n{Indent(2)}", switchCasesList);
{{- if schemaValidationLenient}}
        var readVariant = model.Properties.Any(p => !p.IsValueType) ? GenerateLenientReadVariant(model) : "";
{{- end}}

        if (model.Open)
        {
            // clang-format off
            return $$"""
                var readerCopy = reader;
                using var jsonDoc = System.Text.Json.JsonDocument.ParseValue(ref readerCopy);
                reader = readerCopy;
                var root = jsonDoc.RootElement;
                if (root.ValueKind != System.Text.Json.JsonValueKind.Object
                    || !root.TryGetProperty("{{interp "model.DiscriminatorField"}}", out var discriminatorProp)
                    || discriminatorProp.ValueKind != System.Text.Json.JsonValueKind.String)
                {
                    return {{interp "model.FullyQualifiedName"}}.CreateUnknown(root.Clone());
                }
                var discriminator = discriminatorProp.GetString();
                var jsonText = root.GetRawText();

                return discriminator switch
                {
                    {{interp "switchCases"}}
                    _ => {{interp "model.FullyQualifiedName"}}.CreateUnknown(root.Clone())
                };
{{- if schemaValidationLenient}}

                {{interp "readVariant"}}
{{- end}}
                """;
            // clang-format on
        }

        // Snapshot the reader into a JsonDocument to extract the discriminator field,
        // then re-deserialize the full JSON text into the matching variant type.
        // clang-format off
        return $$"""
            var readerCopy = reader;
            using var jsonDoc = System.Text.Json.JsonDocument.ParseValue(ref readerCopy);
            var root = jsonDoc.RootElement;
            if (root.ValueKind != System.Text.Json.JsonValueKind.Object
                || !root.TryGetProperty("{{interp "model.DiscriminatorField"}}", out var discriminatorProp)
                || discriminatorProp.ValueKind != System.Text.Json.JsonValueKind.String)
            {
                throw new System.Text.Json.JsonException("Missing or non-string discriminator property: {{interp "model.DiscriminatorField"}}");
            }
            var discriminator = discriminatorProp.GetString();
            var jsonText = root.GetRawText();

            reader = readerCopy;
            return discriminator switch
            {
                {{interp "switchCases"}}
                _ => throw new System.Text.Json.JsonException($"Unknown discriminator value: {discriminator}")
            };
{{- if schemaValidationLenient}}

            {{interp "readVariant"}}
{{- end}}
            """;
        // clang-format on
    }
{{- if schemaValidationLenient}}

    private static string GenerateLenientReadVariant(UnionModel model)
    {
        var exception = model.HasValidationFailure ? " ex" : "";
        var recordFailure = model.HasValidationFailure
            ? "var result = create(value);\n        result.ValidationFailure = ex;\n        return result;"
            : "return create(value);";

        // clang-format off
        return $$"""
            static {{interp "model.FullyQualifiedName"}} ReadVariant<TVariant>(string jsonText, System.Text.Json.JsonElement root, System.Text.Json.Serialization.Metadata.JsonTypeInfo<TVariant> typeInfo, System.Func<TVariant, {{interp "model.FullyQualifiedName"}}> create)
            {
                try
                {
                    return create(System.Text.Json.JsonSerializer.Deserialize(jsonText, typeInfo)!);
                }
                catch (System.Exception{{interp "exception"}})
                {
                    if (!global::{{getModelNamespace ""}}.ResponseBodyDeserializer.TryConstructUnvalidated(root, typeInfo, out var value))
                    {
                        throw;
                    }
                    {{interp "recordFailure"}}
                }
            }
            """;
        // clang-format on
    }
{{- end}}
}
