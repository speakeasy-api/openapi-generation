#nullable enable

using System;
using System.Collections.Generic;
using System.Net.Http;
using System.Numerics;
{{- if requiresNodatime}}
using NodaTime;
{{- end}}
using System.Text.Json;
using System.Text.Json.Serialization;
using System.Text.Json.Serialization.Metadata;

namespace {{.Local.Namespace}};

internal static class JsonOptions
{
    private static readonly ObjectJsonConverter _objectConverter = new ObjectJsonConverter();

    // Source-gen contexts bake STJ's built-in ObjectConverter into every
    // JsonTypeInfo whose property type is `object`. That converter reads JSON
    // as `JsonElement`, bypassing the runtime `ObjectJsonConverter` registered
    // in SerializerOptions.Converters. WithAddedModifier walks each TypeInfo
    // returned by the chain and swaps the per-property CustomConverter for
    // `object`-typed slots, restoring native CLR type round-trips under AOT.
    private static readonly IJsonTypeInfoResolver _baseResolverChain =
        JsonTypeInfoResolver.Combine(
{{- if .Local.AdditionalPropertiesTypes}}
            global::{{getScopeNamespace "utils" true}}.AdditionalProperties.Resolver,
{{- end}}
            {{.Local.Resolvers}}
        ).WithAddedModifier(static typeInfo =>
        {
            foreach (var prop in typeInfo.Properties)
            {
                if (prop.PropertyType == typeof(object) && prop.CustomConverter is null)
                {
                    prop.CustomConverter = _objectConverter;
                }
            }
        }){{if .Local.AdditionalPropertiesTypes}}.WithAddedModifier(InstallAdditionalProperties){{end}};

    private static readonly IJsonTypeInfoResolver _resolverChain =
        _baseResolverChain.WithAddedModifier(RejectExplicitNull);

    internal static readonly JsonSerializerOptions SerializerOptions = new JsonSerializerOptions
    {
        TypeInfoResolver = _resolverChain,
        NumberHandling = JsonNumberHandling.{{.Local.NumberHandling}},
        Converters =
        {
{{- range .Local.Converters}}
            {{.}},
{{- end}}
        }
    };
{{- if schemaValidationLenient}}

    internal static readonly JsonSerializerOptions LenientSerializerOptions =
        global::{{getModelNamespace ""}}.ResponseBodyDeserializer.RegisterLenientOptions(
            SerializerOptions,
            new JsonSerializerOptions(SerializerOptions)
            {
                TypeInfoResolver = _baseResolverChain.WithAddedModifier(ClearRequired).WithAddedModifier(IgnoreExplicitNull),
            });

    private static void ClearRequired(JsonTypeInfo typeInfo)
    {
        foreach (var prop in typeInfo.Properties)
        {
            prop.IsRequired = false;
        }
    }
{{- end}}

    private static readonly Dictionary<Type, (string JsonName, bool Required)[]> _nullCheckedFields =
        new Dictionary<Type, (string JsonName, bool Required)[]>
        {
{{- range .Local.NullCheckedTypes}}
            [typeof({{.Type}})] = new[] { {{- range $i, $f := .Fields}}{{if $i}},{{end}} ("{{$f.JsonName}}", {{$f.Required}}){{end}} },
{{- end}}
        };

    internal static readonly Dictionary<Type, (string JsonName, JsonElement Value, string? IntegralToken)[]> ConstFields =
        new Dictionary<Type, (string JsonName, JsonElement Value, string? IntegralToken)[]>
        {
{{- range .Local.ConstFieldsTypes}}
            [typeof({{.Type}})] = new (string, JsonElement, string?)[] { {{- range $i, $f := .Fields}}{{if $i}},{{end}} ("{{$f.JsonName}}", ConstValue("{{$f.Value}}"), {{$f.IntegralToken}}){{end}} },
{{- end}}
        };

{{- if .Local.AdditionalPropertiesTypes}}

    private static readonly Dictionary<Type, Action<JsonTypeInfo>> _additionalProperties =
        new Dictionary<Type, Action<JsonTypeInfo>>
        {
{{- range .Local.AdditionalPropertiesTypes}}
            [typeof({{.Type}})] = static typeInfo => global::{{getScopeNamespace "utils" true}}.AdditionalProperties.Install(typeInfo, "{{.Member}}", static ({{.Type}} model) => model.{{.Member}}, static (model, value) => model.{{.Member}} = value{{if .ValueConverterFactory}}, {{.ValueConverterFactory}}{{end}}),
{{- end}}
        };

    private static void InstallAdditionalProperties(JsonTypeInfo typeInfo)
    {
        if (_additionalProperties.TryGetValue(typeInfo.Type, out var install))
        {
            install(typeInfo);
        }
    }
{{- end}}

    private static JsonElement ConstValue(string json)
    {
        using var document = JsonDocument.Parse(json);
        return document.RootElement.Clone();
    }

    private static void RejectExplicitNull(JsonTypeInfo typeInfo) => GuardExplicitNull(typeInfo, reject: true);
{{- if schemaValidationLenient}}

    private static void IgnoreExplicitNull(JsonTypeInfo typeInfo) => GuardExplicitNull(typeInfo, reject: false);
{{- end}}

    private static void GuardExplicitNull(JsonTypeInfo typeInfo, bool reject)
    {
        if (!_nullCheckedFields.TryGetValue(typeInfo.Type, out var fields)) return;
        foreach (var prop in typeInfo.Properties)
        {
            if (prop.Set is not { } set) continue;
            if (prop.PropertyType.IsValueType && Nullable.GetUnderlyingType(prop.PropertyType) is null) continue;
            foreach (var (jsonName, required) in fields)
            {
                if (prop.Name != jsonName) continue;
                var message = required
                    ? $"Required property '{jsonName}' expects a value but got null."
                    : $"Required property '{jsonName}' expects a non-null value.";
                prop.Set = (obj, value) =>
                {
                    if (IsJsonNull(value))
                    {
                        if (reject) throw new JsonException(message);
                        return;
                    }
                    set(obj, value);
                };
                break;
            }
        }
    }

    private static bool IsJsonNull(object? value) =>
        value is null
{{- if .Local.HasOpenUnion}}
        || value is global::{{getModelNamespace ""}}.IOpenUnion union && union.GetUnknownRaw() is { ValueKind: JsonValueKind.Null }
{{- end}};
}
