{{- $name := .Local.Name}}
{{- $type := or (index .Local "QualifiedName") $name}}
{{- $int := index .Local "Int"}}
{{- $valueType := "string"}}
{{- if $int}}{{$valueType = "long"}}{{end}}
    public static class {{$name}}Extension
    {
        public static {{$valueType}} Value(this {{$type}} value)
        {
            return value switch
            {
        {{- range $index, $scope := .Local.Scopes }}
                {{$type}}.{{index $.Local.DedupNames $index}} => {{if $int}}{{$scope.Name}}{{else}}{{templateStringLiteral $scope.Name}}{{end}},
        {{- end}}
                _ => throw new global::System.ArgumentOutOfRangeException(nameof(value), value, null),
            };
        }

        public static {{$type}} ToEnum(this {{$valueType}} value)
        {
            return value switch
            {
        {{- range $index, $scope := .Local.Scopes }}
                {{if $int}}{{templateIntPattern $scope.Name}}{{else}}{{templateStringLiteral $scope.Name}}{{end}} => {{$type}}.{{index $.Local.DedupNames $index}},
        {{- end}}
                _ => throw new global::System.Exception($"Unknown value {value} for enum {{$name}}"),
            };
        }
    }