{{- recurse 1 -}}
{{- $globalSDK := .Global.AST.MainSDK -}}
{{- $globalSecurity := $globalSDK.Security }}
{{- $serverVariables := and $globalSDK.Servers (gt (len $globalSDK.Servers.GetVariables) 0) -}}
{{- $serverMap := (and $globalSDK.Servers $globalSDK.Servers.ServerMap) -}}
{{- $usageLocation := "mcp-server" }}
{{- $coreName := sanitizeCoreSDKName }}
{{- $hasServerExtensionFile := fileExists "src/mcp-server/server.extensions.ts" }}
{{- $hasServers := (and $globalSDK.Servers $globalSDK.Servers.HasAbsoluteURL) -}}
import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { {{$coreName}} } from "../core.js";
import type { ConsoleLogger } from "./console-logger.js"; 
import { MCPScope } from "./scopes.js";
{{ genImports }}

{{ addImport "./tools.js" "MCPToolAnnotationFilter" }}
export function createMCPServer(deps: {
  logger: ConsoleLogger;
  allowedTools?: string[] | undefined;
  dynamic?: boolean | undefined;
  scopes?: MCPScope[] | undefined;
  annotationFilter?: MCPToolAnnotationFilter | undefined;
  getSDK?: () => {{ $coreName }};
  {{- if $hasServers }}
  serverURL?: string | undefined;
  {{- else }}
  serverURL: string;
  {{- end}}
  {{- if $globalSecurity }}
  {{-   if and (eq (len $globalSecurity.Type.Fields) 1) .Global.Config.FlattenGlobalSecurit }}
  {{-     addImport "../lib/config.js" "SDKOptions" }}
  {{-     $fieldName := sanitizeFieldName (first $globalSecurity.Type.Fields).Name }}
  {{      $fieldName}}?: SDKOptions["{{$fieldName}}"] | undefined;
  {{-   else }}
  {{-     addImport "../lib/config.js" "SDKOptions" }}
  security?: SDKOptions["security"] | undefined;
  {{-   end }}
  {{- end }}{{/* if $globalSecurity */}}
  {{- if (ne $globalSDK.Globals nil)}}
  {{-   range $globalSDK.Globals.Fields}}
  {{-     $fieldName := templateGlobalFieldName .Name}}
  {{-     addImport "../lib/config.js" "SDKOptions" }}
  {{      $fieldName }}?: SDKOptions["{{$fieldName}}"] | undefined;
  {{-   end }}
  {{- end }}{{/* if (ne $globalSDK.Globals nil) */}}
  {{- if $globalSDK.Servers }}
  {{-   if $serverMap }}
  {{-     addImport "../lib/config.js" "SDKOptions" }}
  server?: SDKOptions["server"] | undefined;
  {{-   else}}
  {{-     addImport "../lib/config.js" "SDKOptions" }}
  serverIdx?: SDKOptions["serverIdx"] | undefined;
  {{-   end }}
  {{-   range $variable := $globalSDK.Servers.GetVariables}}
  {{-     $name := $variable.Name }}
  {{-     $fieldName := sanitizeFieldName $name }}
  {{-     addImport "../lib/config.js" "SDKOptions" }}
  {{      $fieldName }}?: SDKOptions["{{ $fieldName }}"] | undefined;
  {{-   end }}
  {{- end }}
}) {
  const server = new McpServer({
    name: "{{ sanitizeMCPServerName }}",
    version: "{{ .Global.Config.SDKVersion }}",
  });

  const getClient = deps.getSDK || (() => new {{ $coreName }}({
    {{- if $globalSecurity}}
    {{-   if and (eq (len $globalSecurity.Type.Fields) 1) .Global.Config.FlattenGlobalSecurity }}
    {{-     addImport "../lib/config.js" "SDKOptions" }}
    {{-     $fieldName := sanitizeFieldName (first $globalSecurity.Type.Fields).Name }}
    {{      $fieldName}}: {{ sanitizeAccessor "deps" $fieldName }},
    {{-   else }}
    {{-     addImport "../lib/config.js" "SDKOptions" }}
    security: deps.security,
    {{-   end }}
    {{- end }}
    {{- if (ne $globalSDK.Globals nil) }}
    {{-   range $globalSDK.Globals.Fields }}
    {{-     $fieldName := templateGlobalFieldName .Name }}
    {{      $fieldName }}: deps.{{ $fieldName }},
    {{-   end }}
    {{- end }}
    serverURL: deps.serverURL,
    {{- if $globalSDK.Servers}}
    {{-   if $serverMap}}
    server: deps.server,
    {{-   else}}
    serverIdx: deps.serverIdx,
    {{-   end}}
    {{-   range $variable := $globalSDK.Servers.GetVariables }}
    {{-     $name := $variable.Name }}
    {{-     $fieldName := sanitizeFieldName $name }}
    {{      $fieldName }}: deps.{{ $fieldName }},
    {{-   end }}
    {{- end }}
    debugLogger: deps.logger.level === "debug" ? {
        log: (...args) => console.log(...args),
        group: (...args) => console.group(...args),
        groupEnd: (...args) => console.groupEnd(...args),
      } : undefined
  }));
  
  const scopes = new Set(deps.scopes);

  {{ addImport "./tools.js" "createRegisterTool" }}
  {{- addImport "./resources.js" "createRegisterResource" }}
  {{- addImport "./resources.js" "createRegisterResourceTemplate" }}
  {{- addImport "./prompts.js" "createRegisterPrompt" }}
  const allowedTools = deps.allowedTools && new Set(deps.allowedTools);
  const [ tool, tools, toolMap ] = createRegisterTool(deps.logger, server, getClient, scopes, allowedTools, deps.dynamic, deps.annotationFilter);
  const resource = createRegisterResource(deps.logger, server, getClient, scopes);
  const resourceTemplate = createRegisterResourceTemplate(deps.logger, server, getClient, scopes);
  const prompt = createRegisterPrompt(deps.logger, server, getClient, scopes);
  const register = { tool, resource, resourceTemplate, prompt };
  void register; // suppress unused warnings

  {{ range $op := .Local.Tools }}
  {{-   $tool := sanitizeMCPPrimitiveExport $op }}
  {{-   addMCPPrimitiveImport $op $usageLocation }}
  {{-   $hasArgs := gt (len $op.Arguments.Sorted) 0 }}
  tool({{ $tool }});
  {{- end }}

  if (deps.dynamic) {
    {{ addImport "./tools.js" "registerDynamicTools" }}
    registerDynamicTools(deps.logger, server, getClient, toolMap, scopes);
  }

  {{  range $op := .Local.Resources }}
  {{-   $resource := sanitizeMCPPrimitiveExport $op }}
  {{-   addMCPPrimitiveImport $op $usageLocation }}
  {{-   if isResourceTemplate $op }}
  resourceTemplate({{ $resource }});
  {{-   else }}
  resource({{ $resource }});
  {{-   end }}
  {{  end }}

  {{- if $hasServerExtensionFile }}
  {{-   addImport "./server.extensions.js" "registerMCPExtensions" }}
  {{-   addImport "./extensions.js" "Register" }}
  registerMCPExtensions(register satisfies Register);
  {{- end}}

  return { server, tools };
}
