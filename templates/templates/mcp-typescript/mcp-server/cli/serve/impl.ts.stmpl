{{- recurse 1 -}}
{{- $globalSDK := .Global.AST.MainSDK -}}
{{- $globalSecurity := $globalSDK.Security -}}
{{- $usageLocation := "mcp-server/cli/serve" -}}
{{- $serverMap := (and $globalSDK.Servers $globalSDK.Servers.ServerMap) -}}
{{- $hasServers := (and $globalSDK.Servers $globalSDK.Servers.HasAbsoluteURL) -}}
import { toNodeHandler } from "@modelcontextprotocol/node";
import { createMcpHandler } from "@modelcontextprotocol/server";
import express from "express";
import { LocalContext } from "../../cli.js";
import {
  ConsoleLoggerLevel,
  createConsoleLogger,
} from "../../console-logger.js";
import { MCPServerFlags } from "../../flags.js";
import { createMCPServer } from "../../server.js";
import { buildAnnotationFilter } from "../../tools.js";
{{ if $globalSecurity -}}
import { buildSDK } from "../../tools.js";
{{- end }}
{{ genImports }}
import { landingPageExpress } from "../../../landing-page.js";

interface ServeCommandFlags extends MCPServerFlags {
  readonly port: number;
  readonly "disable-static-auth": boolean;
  readonly "log-level": ConsoleLoggerLevel;
  readonly env?: [string, string][];
}

export async function main(this: LocalContext, flags: ServeCommandFlags) {
  flags.env?.forEach(([key, value]) => {
    process.env[key] = value;
  });

  await startStreamableHTTP(flags);
}

async function startStreamableHTTP(cliFlags: ServeCommandFlags) {
  const logger = createConsoleLogger(cliFlags["log-level"]);
  const app = express();

  // Enable CORS for cross-origin requests
  app.use((req, res, next) => {
    res.header("Access-Control-Allow-Origin", "*");
    res.header("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
    res.header("Access-Control-Allow-Headers", "*");
    if (req.method === "OPTIONS") {
      res.sendStatus(204);
      return;
    }
    next();
  });

  app.use(express.json());

  const handler = createMcpHandler(({{ if $globalSecurity }}{ requestInfo }{{ end }}) => {
{{- if $globalSecurity }}
    const headers = requestInfo?.headers ?? new Headers();
{{- end }}

    const { server: mcpServer } = createMCPServer({
      logger,
      allowedTools: cliFlags.tool,
      dynamic: cliFlags.mode === "dynamic",
      annotationFilter: buildAnnotationFilter(cliFlags["tool-annotations"]),
{{- if gt (len .Local.Scopes) 0 }}
      scopes: cliFlags.scope,
{{- end }}
      serverURL: cliFlags["server-url"],
{{- if $globalSecurity }}
      getSDK: () => buildSDK(headers, cliFlags, cliFlags["disable-static-auth"], logger),
{{- end }}
{{- if ne $globalSDK.Globals nil }}
{{-   range $field := $globalSDK.Globals.Fields }}
{{-     $fieldName := templateGlobalFieldName $field.Name }}
      {{ $fieldName }}: {{ mcpflag "cliFlags" $fieldName }},
{{-   end }}
{{- end }}
{{- if $globalSDK.Servers }}
{{-   if $serverMap }}
      server: cliFlags.server,
{{-   else }}
      serverIdx: cliFlags["server-index"],
{{-   end }}
{{-   range $variable := $globalSDK.Servers.GetVariables }}
{{-     $name := $variable.Name }}
      {{ sanitizeFieldName $name }}: {{ mcpflag "cliFlags" $name }},
{{-   end }}
{{- end }}
    });

    mcpServer.server.onerror = (error) => {
      logger.error("MCP protocol error", {
        error: error instanceof Error ? error.message : String(error),
        stack: error instanceof Error ? error.stack : undefined,
      });
    };

    return mcpServer;
  });
  const nodeHandler = toNodeHandler(handler);
  app.all("/mcp", (req, res) => nodeHandler(req, res, req.body));

  app.get("/", landingPageExpress);

  const httpServer = app.listen(cliFlags.port, "0.0.0.0", () => {
    const ha = httpServer.address();
    const host = typeof ha === "string" ? ha : `${ha?.address}:${ha?.port}`;
    logger.info("MCP Streamable HTTP server started", { host });
  });

  const shutdown = async () => {
    logger.info("Shutting down HTTP server");

    const timer = setTimeout(() => {
      logger.info("Forcing shutdown");
      process.exit(1);
    }, 5000);

    await handler.close();
    httpServer.close(() => {
      clearTimeout(timer);
      logger.info("Graceful shutdown complete");
      process.exit(0);
    });
  };

  process.on("SIGTERM", shutdown);
  process.on("SIGINT", shutdown);
}
