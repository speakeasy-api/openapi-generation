{{- recurse 1 -}}
{{- $globalSDK := .Global.AST.MainSDK -}}
{{- $globalSecurity := $globalSDK.Security }}
{{- $serverMap := (and $globalSDK.Servers $globalSDK.Servers.ServerMap) -}}
{{- $hasServers := (and $globalSDK.Servers $globalSDK.Servers.HasAbsoluteURL) -}}
// DO NOT EDIT: This file is auto-generated by Speakeasy.
// Gram deployment wrapper for MCP server.
import { withGram } from "@gram-ai/functions/mcp";
import { createConsoleLogger } from "./console-logger.js";
import { MCPServerFlags } from "./flags.js";
import { createMCPServer } from "./server.js";
import { buildAnnotationFilter } from "./tools.js";
{{ genImports }}

const logger = createConsoleLogger("info");

// Build flags object from environment variables (Gram injects these)
const flags: MCPServerFlags = {
  mode: process.env["MODE"] === "dynamic" ? "dynamic" : undefined,
  {{- /* Security fields */}}
  {{- if $globalSecurity }}
  {{-   range $field := unnestSecurityEnvFields $globalSecurity.Type }}
  "{{ sanitizeMCPCLIFlag $field.Name }}": process.env["{{ templateSecurityEnvVars $field }}"],
  {{-   end }}
  {{- end }}
  {{- /* Server URL */}}
  "server-url": process.env["SERVER_URL"],
  {{- /* Server selection */}}
  {{- if $globalSDK.Servers }}
  {{-   if $serverMap }}
  server: process.env["SERVER"],
  {{-   else }}
  "server-index": process.env["SERVER_INDEX"] ? parseInt(process.env["SERVER_INDEX"], 10) : undefined,
  {{-   end }}
  {{-   range $variable := $globalSDK.Servers.GetVariables }}
  {{-     $envVarName := upper (snake $variable.Name) }}
  {{-     if eq $variable.Type.Type "enum" }}
  {{-       $zodSchemaName := sanitizeZodName $variable.Type.Name }}
  {{-       addImport "../lib/config.js" $zodSchemaName }}
  "{{ sanitizeMCPCLIFlag $variable.Name }}": {{ $zodSchemaName }}.optional().parse(process.env["{{ $envVarName }}"]),
  {{-     else }}
  "{{ sanitizeMCPCLIFlag $variable.Name }}": process.env["{{ $envVarName }}"],
  {{-     end }}
  {{-   end }}
  {{- end }}
  {{- /* Globals */}}
  {{- if (ne $globalSDK.Globals nil) }}
  {{-   range $field := $globalSDK.Globals.Fields }}
  {{-     if $field.Type.IsPrimitive }}
  "{{ sanitizeMCPCLIFlag $field.Name }}": process.env["{{ templateSecurityEnvVars $field }}"],
  {{-     end }}
  {{-   end }}
  {{- end }}
  {{- /* Annotation filters */}}
  "tool-annotations": process.env["TOOL_ANNOTATIONS"]
    ? process.env["TOOL_ANNOTATIONS"].split(",").map(s => s.trim())
    : undefined,
};

// Reuse existing createMCPServer template - it reads from `flags`
const { server } = {{ templateString "mcp-server/create-mcp-server.ts.stmpl" .Local }};

export default await withGram(server, {
  variables: {
    {{- /* Security variables */}}
    {{- if $globalSecurity }}
    {{-   range $field := unnestSecurityEnvFields $globalSecurity.Type }}
    {{ templateSecurityEnvVars $field }}: {
      description: `{{ if and $field.Comments $field.Comments.Description }}{{ $field.Comments.Description }}{{ else }}{{ $field.Name }}{{ end }}`,
    },
    {{-   end }}
    {{- end }}
    {{- /* Global variables */}}
    {{- if (ne $globalSDK.Globals nil) }}
    {{-   range $field := $globalSDK.Globals.Fields }}
    {{-     if $field.Type.IsPrimitive }}
    {{ templateSecurityEnvVars $field }}: {
      description: `{{ if and $field.Comments $field.Comments.Description }}{{ $field.Comments.Description }}{{ else }}{{ $field.Name }}{{ end }}`,
    },
    {{-   end }}
    {{-   end }}
    {{- end }}
    {{- /* Server variables */}}
    {{- if $hasServers }}
    {{-   if $serverMap }}
    SERVER: {
      description: "The server to connect to",
    },
    {{-   else if and $globalSDK.Servers (gt (len $globalSDK.Servers.Servers) 1) }}
    SERVER_INDEX: {
      description: "The index of the server to connect to",
    },
    {{-   end }}
    {{-   range $variable := $globalSDK.Servers.GetVariables }}
    {{-     $envVarName := upper (snake $variable.Name) }}
    {{ $envVarName }}: {
      description: `{{ if and $variable.Type $variable.Type.Comments $variable.Type.Comments.Description }}{{ $variable.Type.Comments.Description }}{{ else }}{{ $variable.Name }}{{ end }}`,
    },
    {{-   end }}
    {{- else }}
    SERVER_URL: {
      description: "The URL of the server to connect to",
      required: true,
    },
    {{- end }}
  },
});
