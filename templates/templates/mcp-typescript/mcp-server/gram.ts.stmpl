{{- recurse 1 -}}
{{- $globalSDK := .Global.AST.MainSDK -}}
{{- $globalSecurity := $globalSDK.Security }}
{{- $serverMap := (and $globalSDK.Servers $globalSDK.Servers.ServerMap) -}}
{{- $hasServers := (and $globalSDK.Servers $globalSDK.Servers.HasAbsoluteURL) -}}
// DO NOT EDIT: This file is auto-generated by Speakeasy.
// Gram deployment wrapper for MCP server.
import type { Manifest, ManifestVariables } from "@gram-ai/functions";
import type { WrappedMCPServer } from "@gram-ai/functions/mcp";
import { Client, ProtocolError, ProtocolErrorCode } from "@modelcontextprotocol/client";
import { InMemoryTransport, McpServer } from "@modelcontextprotocol/server";
import { createConsoleLogger } from "./console-logger.js";
import { MCPServerFlags } from "./flags.js";
import { createMCPServer } from "./server.js";
import { buildAnnotationFilter } from "./tools.js";
{{ genImports }}

export async function wrapGramServer<Variables extends ManifestVariables>(
  server: McpServer,
  options?: { variables?: Variables },
): Promise<WrappedMCPServer> {
  const client = new Client({ name: "gram-functions-mcp", version: "0.0.0" });
  const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();
  try {
    await server.connect(serverTransport);
    await client.connect(clientTransport);
    const capabilities = client.getServerCapabilities();
    const listedTools = capabilities?.tools
      ? await client.listTools().catch((error: unknown) => {
          if (error instanceof ProtocolError && error.code === ProtocolErrorCode.MethodNotFound) {
            return { tools: [] };
          }
          throw error;
        })
      : { tools: [] };
    const listedResources = capabilities?.resources
      ? await client.listResources().catch((error: unknown) => {
          if (error instanceof ProtocolError && error.code === ProtocolErrorCode.MethodNotFound) {
            return { resources: [] };
          }
          throw error;
        })
      : { resources: [] };
    const variables = options?.variables;
    const tools: NonNullable<Manifest["tools"]> = listedTools.tools.map((tool) => ({
      name: tool.name,
      ...(tool.description === undefined ? {} : { description: tool.description }),
      inputSchema: tool.inputSchema,
      ...(tool.annotations === undefined ? {} : {
        annotations: {
          ...(tool.annotations.title === undefined ? {} : { title: tool.annotations.title }),
          ...(tool.annotations.readOnlyHint === undefined ? {} : { readOnlyHint: tool.annotations.readOnlyHint }),
          ...(tool.annotations.destructiveHint === undefined ? {} : { destructiveHint: tool.annotations.destructiveHint }),
          ...(tool.annotations.idempotentHint === undefined ? {} : { idempotentHint: tool.annotations.idempotentHint }),
          ...(tool.annotations.openWorldHint === undefined ? {} : { openWorldHint: tool.annotations.openWorldHint }),
        },
      }),
      ...(variables === undefined ? {} : { variables }),
      meta: { ...tool._meta, "gram.ai/kind": "mcp-passthrough" },
    }));
    const resources: NonNullable<Manifest["resources"]> = listedResources.resources.map((resource) => ({
      name: resource.name,
      description: resource.description,
      uri: resource.uri,
      mimeType: resource.mimeType,
      title: resource.title,
      ...(variables === undefined ? {} : { variables }),
      meta: { ...resource._meta, "gram.ai/kind": "mcp-passthrough" },
    }));

    return {
      manifest: () => ({ version: "0.0.0", tools, resources }),
      async handleToolCall(call) {
        const response = await client.callTool({
          name: call.name,
          ...(call.input === undefined ? {} : { arguments: call.input }),
          ...(call._meta === undefined ? {} : { _meta: call._meta }),
        });
        return new Response(JSON.stringify(response), {
          status: 200,
          headers: { "Content-Type": "application/json; mcp=tools_call" },
        });
      },
      async handleResources(call) {
        const response = await client.readResource({
          uri: call.uri,
          ...(call._meta === undefined ? {} : { _meta: call._meta }),
        });
        return new Response(JSON.stringify(response), {
          status: 200,
          headers: { "Content-Type": "application/json" },
        });
      },
    };
  } catch (error) {
    await client.close();
    await server.close();
    throw error;
  }
}

const logger = createConsoleLogger("info");

// Build flags object from environment variables (Gram injects these)
const flags: MCPServerFlags = {
  mode: process.env["MODE"] === "dynamic" ? "dynamic" : undefined,
  {{- /* Security fields */}}
  {{- if $globalSecurity }}
  {{-   range $field := unnestSecurityEnvFields $globalSecurity.Type }}
  "{{ sanitizeMCPCLIFlag $field.Name }}": process.env["{{ templateSecurityEnvVars $field }}"],
  {{-   end }}
  {{- end }}
  {{- /* Server URL */}}
  "server-url": process.env["SERVER_URL"],
  {{- /* Server selection */}}
  {{- if $globalSDK.Servers }}
  {{-   if $serverMap }}
  server: process.env["SERVER"],
  {{-   else }}
  "server-index": process.env["SERVER_INDEX"] ? parseInt(process.env["SERVER_INDEX"], 10) : undefined,
  {{-   end }}
  {{-   range $variable := $globalSDK.Servers.GetVariables }}
  {{-     $envVarName := upper (snake $variable.Name) }}
  {{-     if eq $variable.Type.Type "enum" }}
  {{-       $zodSchemaName := sanitizeZodName $variable.Type.Name }}
  {{-       addImport "../lib/config.js" $zodSchemaName }}
  "{{ sanitizeMCPCLIFlag $variable.Name }}": {{ $zodSchemaName }}.optional().parse(process.env["{{ $envVarName }}"]),
  {{-     else }}
  "{{ sanitizeMCPCLIFlag $variable.Name }}": process.env["{{ $envVarName }}"],
  {{-     end }}
  {{-   end }}
  {{- end }}
  {{- /* Globals */}}
  {{- if (ne $globalSDK.Globals nil) }}
  {{-   range $field := $globalSDK.Globals.Fields }}
  {{-     if $field.Type.IsPrimitive }}
  "{{ sanitizeMCPCLIFlag $field.Name }}": process.env["{{ templateSecurityEnvVars $field }}"],
  {{-     end }}
  {{-   end }}
  {{- end }}
  {{- /* Annotation filters */}}
  "tool-annotations": process.env["TOOL_ANNOTATIONS"]
    ? process.env["TOOL_ANNOTATIONS"].split(",").map(s => s.trim())
    : undefined,
};

// Reuse existing createMCPServer template - it reads from `flags`
const { server } = {{ templateString "mcp-server/create-mcp-server.ts.stmpl" .Local }};

export default await wrapGramServer(server, {
  variables: {
    {{- /* Security variables */}}
    {{- if $globalSecurity }}
    {{-   range $field := unnestSecurityEnvFields $globalSecurity.Type }}
    {{ templateSecurityEnvVars $field }}: {
      description: `{{ if and $field.Comments $field.Comments.Description }}{{ $field.Comments.Description }}{{ else }}{{ $field.Name }}{{ end }}`,
    },
    {{-   end }}
    {{- end }}
    {{- /* Global variables */}}
    {{- if (ne $globalSDK.Globals nil) }}
    {{-   range $field := $globalSDK.Globals.Fields }}
    {{-     if $field.Type.IsPrimitive }}
    {{ templateSecurityEnvVars $field }}: {
      description: `{{ if and $field.Comments $field.Comments.Description }}{{ $field.Comments.Description }}{{ else }}{{ $field.Name }}{{ end }}`,
    },
    {{-   end }}
    {{-   end }}
    {{- end }}
    {{- /* Server variables */}}
    {{- if $hasServers }}
    {{-   if $serverMap }}
    SERVER: {
      description: "The server to connect to",
    },
    {{-   else if and $globalSDK.Servers (gt (len $globalSDK.Servers.Servers) 1) }}
    SERVER_INDEX: {
      description: "The index of the server to connect to",
    },
    {{-   end }}
    {{-   range $variable := $globalSDK.Servers.GetVariables }}
    {{-     $envVarName := upper (snake $variable.Name) }}
    {{ $envVarName }}: {
      description: `{{ if and $variable.Type $variable.Type.Comments $variable.Type.Comments.Description }}{{ $variable.Type.Comments.Description }}{{ else }}{{ $variable.Name }}{{ end }}`,
    },
    {{-   end }}
    {{- else }}
    SERVER_URL: {
      description: "The URL of the server to connect to",
      required: true,
    },
    {{- end }}
  },
});
