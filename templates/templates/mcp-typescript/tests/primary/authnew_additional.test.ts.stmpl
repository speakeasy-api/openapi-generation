test("Authnew Multiple Mixed Scheme Auth", async () => {
  recordTest("auth-multiple-mixed-scheme-auth");

  const testHttpClient = createTestHTTPClient("multipleMixedSchemeAuth");
  const sdk = new SDK({ httpClient: testHttpClient });

  const result = await authNewMultipleMixedSchemeAuth(
    sdk,
    {
      apiKeyAuthNew: "test_api_key",
      basicAuth: {
        password: "testPass",
        username: "testUser",
      },
    },
    {
      basicAuth: {
        password: "testPass",
        username: "testUser",
      },
      headerAuth: [
        {
          expectedValue: "test_api_key",
          headerName: "x-api-key",
        },
      ],
    },
  );

  if (!result.ok) throw result.error;
{{- if isStrictMCPServer }}
  expect(result.value.StatusCode).toBe(200);
{{- else }}
  expect(result.value.status).toBe(200);
{{- end }}
});

