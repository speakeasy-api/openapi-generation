test("Authnew Multiple Options With Mixed Schemes Auth Second Option", async () => {
  recordTest("auth-multiple-options-with-mixed-schemes-auth-second-option");

  const testHttpClient = createTestHTTPClient(
    "multipleOptionsWithMixedSchemesAuth",
  );
  const sdk = new SDK({ httpClient: testHttpClient });

  const result = await authNewMultipleOptionsWithMixedSchemesAuth(
    sdk,
    {
      Option2: {
        apiKeyAuthNew: "test_api_key",
        basicAuth: {
          password: "testPass",
          username: "testUser",
        },
      },
    },
    {
      basicAuth: {
        password: "testPass",
        username: "testUser",
      },
      headerAuth: [
        {
          expectedValue: "test_api_key",
          headerName: "x-api-key",
        },
      ],
    },
  );

  if (!result.ok) throw result.error;
{{- if isStrictMCPServer }}
  expect(result.value.StatusCode).toBe(200);
{{- else }}
  expect(result.value.status).toBe(200);
{{- end }}
});

test("Requestbodies Request Body Put String With Params", async () => {
  recordTest("request-bodies-put-string-with-params");

  const testHttpClient = createTestHTTPClient("requestBodyPutStringWithParams");
  const sdk = new SDK({ httpClient: testHttpClient });

  const result = await requestBodiesRequestBodyPutStringWithParams(sdk, {
    RequestBody: "Hello world",
    queryStringParam: "test param",
  });

  if (!result.ok) throw result.error;
{{- if isStrictMCPServer }}
  expect(result.value.StatusCode).toBe(200);
  expect(result.value.res).toBeDefined();
  expect(result.value.res).toEqual({
    args: {
      queryStringParam: "test param",
    },
    data: "Hello world",
  });
{{- else }}
  expect(result.value.status).toBe(200);
{{- end }}
});

test("Requestbodies Request Body Put Bytes With Params", async () => {
  recordTest("request-bodies-put-bytes-with-params");

  const testHttpClient = createTestHTTPClient("requestBodyPutBytesWithParams");
  const sdk = new SDK({ httpClient: testHttpClient });

  const result = await requestBodiesRequestBodyPutBytesWithParams(sdk, {
    RequestBody: await fileToBase64(".speakeasy/testfiles/testUpload.json"),
    queryStringParam: "test param",
  });

  if (!result.ok) throw result.error;
{{- if isStrictMCPServer }}
  expect(result.value.StatusCode).toBe(200);
  expect(result.value.res).toBeDefined();
  expect(result.value.res).toEqual({
    args: {
      queryStringParam: "test param",
    },
    data: await filesToString(".speakeasy/testfiles/testUpload.json"),
  });
{{- else }}
  expect(result.value.status).toBe(200);
{{- end }}
});
