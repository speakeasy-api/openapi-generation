import { createDeepObject, createSimpleObject } from "./primary_helpers.js";
import { expect, test } from "vitest";
import { SDKCore as SDK } from "../core.js";
import { {{ if isStrictMCPServer }}HTTPBIN_URL, {{ end }}recordTest } from "./common_helpers.js";
{{- if isStrictMCPServer }}
import { sortQueryParameters } from "./helpers.js";
{{- end }}
import { parametersPathParameterJson } from "../funcs/parametersPathParameterJson.js";
import { parametersJsonQueryParamsObject } from "../funcs/parametersJsonQueryParamsObject.js";
import { parametersMixedQueryParams } from "../funcs/parametersMixedQueryParams.js";
import { parametersHeaderParamsNil } from "../funcs/parametersHeaderParamsNil.js";
{{ if isStrictMCPServer }}
const roundTrip = (v: unknown) => JSON.parse(JSON.stringify(v));
{{- end }}

test("Test Path Parameter JSON", async () => {
  recordTest("parameters-path-parameter-json");

  const sdk = new SDK({});

  const result = await parametersPathParameterJson(sdk, {
    jsonObj: createSimpleObject(),
  });

  if (!result.ok) throw result.error;

{{- if isStrictMCPServer }}
  expect(result.value.StatusCode).toBe(200);
  expect(result.value.res?.url).toBe(
    `${HTTPBIN_URL}/anything/pathParams/json/{"any":"any","bool":true,"boolOpt":true,"date":"2020-01-01","dateTime":"2020-01-01T00:00:00.001Z","enum":"one","float32":1.1,"int":1,"int32":1,"int32Enum":55,"intEnum":2,"num":1.1,"str":"test","strOpt":"testOptional"}`,
  );
{{- else }}
  expect(result.value.status).toBe(200);
{{- end }}
});

test("Test JSON Query Params Object", async () => {
  recordTest("parameters-json-query-params-object");

  const sdk = new SDK({});

  const simpleObj = createSimpleObject();
  const deepObject = createDeepObject();

  const result = await parametersJsonQueryParamsObject(sdk, {
    deepObjParam: deepObject,
    simpleObjParam: simpleObj,
  });

  if (!result.ok) throw result.error;

{{- if isStrictMCPServer }}
  expect(result.value.StatusCode).toBe(200);
  expect(sortQueryParameters(result.value.res?.url)).toBe(
    `${HTTPBIN_URL}/anything/queryParams/json/obj?deepObjParam={"any"%3A"any"%2C"bool"%3Atrue%2C"boolOpt"%3Atrue%2C"date"%3A"2020-01-01"%2C"dateTime"%3A"2020-01-01T00%3A00%3A00.001Z"%2C"enum"%3A"one"%2C"float32"%3A1.1%2C"int"%3A1%2C"int32"%3A1%2C"int32Enum"%3A55%2C"intEnum"%3A2%2C"num"%3A1.1%2C"str"%3A"test"%2C"strOpt"%3A"testOptional"}%2C"arr"%3A[{"any"%3A"any"%2C"bool"%3Atrue%2C"boolOpt"%3Atrue%2C"date"%3A"2020-01-01"%2C"dateTime"%3A"2020-01-01T00%3A00%3A00.001Z"%2C"enum"%3A"one"%2C"float32"%3A1.1%2C"int"%3A1%2C"int32"%3A1%2C"int32Enum"%3A55%2C"intEnum"%3A2%2C"num"%3A1.1%2C"str"%3A"test"%2C"strOpt"%3A"testOptional"}%2C{"any"%3A"any"%2C"bool"%3Atrue%2C"boolOpt"%3Atrue%2C"date"%3A"2020-01-01"%2C"dateTime"%3A"2020-01-01T00%3A00%3A00.001Z"%2C"enum"%3A"one"%2C"float32"%3A1.1%2C"int"%3A1%2C"int32"%3A1%2C"int32Enum"%3A55%2C"intEnum"%3A2%2C"num"%3A1.1%2C"str"%3A"test"%2C"strOpt"%3A"testOptional"}]%2C"bool"%3Atrue%2C"int"%3A1%2C"map"%3A{"key"%3A{"any"%3A"any"%2C"bool"%3Atrue%2C"boolOpt"%3Atrue%2C"date"%3A"2020-01-01"%2C"dateTime"%3A"2020-01-01T00%3A00%3A00.001Z"%2C"enum"%3A"one"%2C"float32"%3A1.1%2C"int"%3A1%2C"int32"%3A1%2C"int32Enum"%3A55%2C"intEnum"%3A2%2C"num"%3A1.1%2C"str"%3A"test"%2C"strOpt"%3A"testOptional"}}%2C"num"%3A1.1%2C"obj"%3A{"any"%3A"any"%2C"bool"%3Atrue%2C"boolOpt"%3Atrue%2C"date"%3A"2020-01-01"%2C"dateTime"%3A"2020-01-01T00%3A00%3A00.001Z"%2C"enum"%3A"one"%2C"float32"%3A1.1%2C"int"%3A1%2C"int32"%3A1%2C"int32Enum"%3A55%2C"intEnum"%3A2%2C"num"%3A1.1%2C"str"%3A"test"%2C"strOpt"%3A"testOptional"}%2C"str"%3A"test"}&simpleObjParam={"any"%3A"any"%2C"bool"%3Atrue%2C"boolOpt"%3Atrue%2C"date"%3A"2020-01-01"%2C"dateTime"%3A"2020-01-01T00%3A00%3A00.001Z"%2C"enum"%3A"one"%2C"float32"%3A1.1%2C"int"%3A1%2C"int32"%3A1%2C"int32Enum"%3A55%2C"intEnum"%3A2%2C"num"%3A1.1%2C"str"%3A"test"%2C"strOpt"%3A"testOptional"}`,
  );

  expect(JSON.parse(result.value.res?.args.simpleObjParam || "")).toEqual(
    roundTrip(simpleObj),
  );
  expect(JSON.parse(result.value.res?.args.deepObjParam || "")).toEqual(
    roundTrip(deepObject),
  );
{{- else }}
  expect(result.value.status).toBe(200);
{{- end }}
});

test("Test Mixed Query Params", async () => {
  recordTest("parameters-mixed-query-params");

  const sdk = new SDK({});

  const obj = createSimpleObject();

  const result = await parametersMixedQueryParams(sdk, {
    deepObjectParam: obj,
    formParam: obj,
    jsonParam: obj,
  });

  if (!result.ok) throw result.error;

{{- if isStrictMCPServer }}
  expect(result.value.StatusCode).toBe(200);
  expect(sortQueryParameters(result.value.res?.url)).toBe(
    `${HTTPBIN_URL}/anything/queryParams/mixed?any=any&bool=true&boolOpt=true&date=2020-01-01&dateTime=2020-01-01T00%3A00%3A00.001Z&deepObjectParam[any]=any&deepObjectParam[boolOpt]=true&deepObjectParam[bool]=true&deepObjectParam[dateTime]=2020-01-01T00%3A00%3A00.001Z&deepObjectParam[date]=2020-01-01&deepObjectParam[enum]=one&deepObjectParam[float32]=1.1&deepObjectParam[int32Enum]=55&deepObjectParam[int32]=1&deepObjectParam[intEnum]=2&deepObjectParam[int]=1&deepObjectParam[num]=1.1&deepObjectParam[strOpt]=testOptional&deepObjectParam[str]=test&enum=one&float32=1.1&int=1&int32=1&int32Enum=55&intEnum=2&jsonParam={"any"%3A"any"%2C"bool"%3Atrue%2C"boolOpt"%3Atrue%2C"date"%3A"2020-01-01"%2C"dateTime"%3A"2020-01-01T00%3A00%3A00.001Z"%2C"enum"%3A"one"%2C"float32"%3A1.1%2C"int"%3A1%2C"int32"%3A1%2C"int32Enum"%3A55%2C"intEnum"%3A2%2C"num"%3A1.1%2C"str"%3A"test"%2C"strOpt"%3A"testOptional"}&num=1.1&str=test&strOpt=testOptional`,
  );

  const actual: Record<string, unknown> = result.value.res?.args ?? {};
  if (typeof actual["jsonParam"] === "string") {
    actual["jsonParam"] = JSON.parse(actual["jsonParam"]);
  }

  expect(actual).toEqual({
    any: "any",
    bool: "true",
    boolOpt: "true",
    date: "2020-01-01",
    dateTime: "2020-01-01T00:00:00.001Z",
    "deepObjectParam[any]": "any",
    "deepObjectParam[boolOpt]": "true",
    "deepObjectParam[bool]": "true",
    "deepObjectParam[dateTime]": "2020-01-01T00:00:00.001Z",
    "deepObjectParam[date]": "2020-01-01",
    "deepObjectParam[enum]": "one",
    "deepObjectParam[float32]": "1.1",
    "deepObjectParam[int32]": "1",
    "deepObjectParam[int]": "1",
    "deepObjectParam[int32Enum]": "55",
    "deepObjectParam[intEnum]": "2",
    "deepObjectParam[num]": "1.1",
    "deepObjectParam[strOpt]": "testOptional",
    "deepObjectParam[str]": "test",
    enum: "one",
    float32: "1.1",
    int: "1",
    int32: "1",
    int32Enum: "55",
    intEnum: "2",
    jsonParam: roundTrip(obj),
    num: "1.1",
    str: "test",
    strOpt: "testOptional",
  });
{{- else }}
  expect(result.value.status).toBe(200);
{{- end }}
});

test("Test Parameters Header Params Nil", async () => {
  recordTest("parameters-header-params-nil");

  const sdk = new SDK();

  const result = await parametersHeaderParamsNil(sdk, {
    nullableHeader: null,
  });

  if (!result.ok) throw result.error;

{{- if isStrictMCPServer }}
  expect(result.value.StatusCode).toBe(200);

  const headers = new Headers(result.value.res?.headers);
  expect(headers.get("Nullable-Header")).toBeNull();
  expect(headers.get("Optional-Header")).toBeNull();
  expect(headers.get("Optional-Nullable-Header")).toBeNull();
{{- else }}
  expect(result.value.status).toBe(200);
{{- end }}
});
