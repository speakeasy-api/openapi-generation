test("Debug env var false keeps logging off", async () => {
  recordTest("debug-env-var-false-keeps-logging-off");

  const group = vi.spyOn(console, "group").mockImplementation(() => {});
  vi.spyOn(console, "log").mockImplementation(() => {});
  vi.spyOn(console, "groupEnd").mockImplementation(() => {});

  for (const value of ["false", "0", "off", "no", "", "debug", "FALSE"]) {
    resetEnv();
    vi.stubEnv("SPEAKEASY_DEBUG", value);

    const sdk = new SDK({ globalQueryParam: "test" });
    const result = await globalsGlobalsQueryParameterGet(sdk);

    if (!result.ok) throw result.error;

    expect(group).not.toHaveBeenCalled();
  }

  for (const value of ["true", "1", "yes", "on", "TRUE", "Yes", " on "]) {
    group.mockClear();
    resetEnv();
    vi.stubEnv("SPEAKEASY_DEBUG", value);

    const sdk = new SDK({ globalQueryParam: "test" });
    const result = await globalsGlobalsQueryParameterGet(sdk);

    if (!result.ok) throw result.error;

    expect(group).toHaveBeenCalled();
  }

  for (const value of [true, 1]) {
    expect(envSchema.parse({ SPEAKEASY_DEBUG: value }).SPEAKEASY_DEBUG).toBe(true);
  }

  for (const value of [false, 0]) {
    expect(envSchema.parse({ SPEAKEASY_DEBUG: value }).SPEAKEASY_DEBUG).toBe(false);
  }
});
