import { expect, test } from "vitest";
import { SDKCore as SDK } from "../core.js";
import { recordTest } from "./common_helpers.js";
import { createSimpleObject } from "./primary_helpers.js";
import { flatteningComponentBodyAndParamNoConflict } from "../funcs/flatteningComponentBodyAndParamNoConflict.js";
import { flatteningComponentBodyAndParamConflict } from "../funcs/flatteningComponentBodyAndParamConflict.js";
import { flatteningInlineBodyAndParamConflict } from "../funcs/flatteningInlineBodyAndParamConflict.js";
import { flatteningInlineBodyAndParamNoConflict } from "../funcs/flatteningInlineBodyAndParamNoConflict.js";
import { flatteningConflictingParams } from "../funcs/flatteningConflictingParams.js";
import { flatteningRequiredBodyAllOptional } from "../funcs/flatteningRequiredBodyAllOptional.js";

test("Test Component Body and Param No Conflict", async () => {
  recordTest("flattening-component-body-and-param-no-conflict");

  const s = new SDK();
  const obj = createSimpleObject();
  const result = await flatteningComponentBodyAndParamNoConflict(s, {
    paramStr: "param test",
    simpleObject: obj,
  });
  if (!result.ok) throw result.error;
{{- if isStrictMCPServer }}
  expect(result.value.StatusCode).toBe(200);
  expect(result.value.res).toBeDefined();
  expect(result.value.res!.args["paramStr"]).toEqual("param test");
  expect(result.value.res!.json).toEqual(obj);
{{- else }}
  expect(result.value.status).toBe(200);
{{- end }}
});

test("Test Component Body and Param Conflict", async () => {
