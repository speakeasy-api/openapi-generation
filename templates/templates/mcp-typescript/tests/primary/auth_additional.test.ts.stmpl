import { expect, test } from "vitest";

import { SDKCore } from "../core.js";
import { recordTest } from "./common_helpers.js";
import { authGlobalSecurityBasicHttp } from "../funcs/authGlobalSecurityBasicHttp.js";
import { authHoistedSecurityAccessTokenOnly } from "../funcs/authHoistedSecurityAccessTokenOnly.js";
import { authHoistedSecurityAccessTokenFirst } from "../funcs/authHoistedSecurityAccessTokenFirst.js";
import { authHoistedSecurityApiKeyFirst } from "../funcs/authHoistedSecurityApiKeyFirst.js";
import { authHoistedSecurityBasicHttpOnly } from "../funcs/authHoistedSecurityBasicHttpOnly.js";
import type { MCPServerFlags } from "../mcp-server/flags.js";
import { buildSDK } from "../mcp-server/tools.js";

const quietLogger = { level: "error" };

function resolvedOptions(headers: Record<string, string>, flags: Partial<MCPServerFlags>, disableStaticAuth = false) {
  const sdk = buildSDK(new Headers(headers), flags as MCPServerFlags, disableStaticAuth, quietLogger);
  return sdk._options as { security?: Record<string, unknown>; globalHeaderParam?: boolean };
}

test("MCP server resolves unset credentials to empty strings and leaves other options undefined", () => {
  const options = resolvedOptions({}, {});
  expect(options.security?.["accessToken"]).toBe("");
  expect(options.security?.["basicHttp"]).toBeUndefined();
  expect(options.globalHeaderParam).toBeUndefined();
});

test.each([false, true])("MCP server applies schema defaults to absent settings (static auth disabled=%s)", (disableStaticAuth) => {
  const options = resolvedOptions({ "client-id": "client", "client-secret": "secret" }, {}, disableStaticAuth);
  expect(options.security?.["clientCredentials"]).toMatchObject({
    clientID: "client",
    clientSecret: "secret",
    tokenURL: "/clientcredentials/token?expires_in=90",
  });
  expect(options.security?.["basicHttp"]).toBeUndefined();
  expect(options.globalHeaderParam).toBeUndefined();
});

test("MCP server preserves header and flag precedence over schema defaults", () => {
  const credentials = { "client-id": "client", "client-secret": "secret" };
  const flags = { "token-url": "https://example.com/static-token" };
  expect(resolvedOptions(credentials, flags).security?.["clientCredentials"]).toMatchObject({
    tokenURL: "https://example.com/static-token",
  });
  expect(resolvedOptions({ ...credentials, "token-url": "https://example.com/header-token" }, flags).security?.["clientCredentials"]).toMatchObject({
    tokenURL: "https://example.com/header-token",
  });
  expect(resolvedOptions(credentials, flags, true).security?.["clientCredentials"]).toMatchObject({
    tokenURL: "/clientcredentials/token?expires_in=90",
  });
});

test("MCP server uses static credentials from flags", () => {
  const options = resolvedOptions({}, { "access-token": "static-token", username: "user", password: "pass" });
  expect(options.security?.["accessToken"]).toBe("static-token");
  expect(options.security?.["basicHttp"]).toEqual({ username: "user", password: "pass" });
});

test("MCP server request headers override static credentials", () => {
  const options = resolvedOptions({ "access-token": "header-token" }, { "access-token": "static-token" });
  expect(options.security?.["accessToken"]).toBe("header-token");
});

test("MCP server ignores static credentials when static auth is disabled", () => {
  const options = resolvedOptions({}, { "access-token": "static-token" }, true);
  expect(options.security?.["accessToken"]).toBe("");
});

test("MCP server validates enum request headers", () => {
  expect(resolvedOptions({ "global-header-param": "true" }, {}).globalHeaderParam).toBe(true);
  expect(() => resolvedOptions({ "global-header-param": "maybe" }, {})).toThrow();
});

test("Global Security Fields Ordering", async () => {
  recordTest("auth-global-security-fields-ordering");

  // When `maintainOpenApiOrder: false` is set, security fields are sorted in alphabetical order.
  // Since the first non-nil field is selected ApiKeyAuth takes precedence over BasicHttp,
  // which is not valid authentication for this endpoint.
  const sdk = new SDKCore({
    security: {
      apiKeyAuth: "testApiKey",
      basicHttp: {
        username: "testUser",
        password: "testPass",
      },
    },
  });

  const res = await authGlobalSecurityBasicHttp(sdk);
  if (!res.ok) throw res.error;


{{- if isStrictMCPServer }}
  expect(res.value.StatusCode).toBe(401);
{{- else }}
  expect(res.value.status).toBe(401);
{{- end }}
});

test("Hoisted Security Access Token Only", async () => {
  recordTest("auth-hoisted-security-access-token-only");

  const sdk = new SDKCore({
    security: {
      apiKeyAuth: "testApiKey",
      basicHttp: {
        username: "testUser",
        password: "testPass",
      },
      accessToken: "Bearer ghp_xxxx",
    },
  });

  const res = await authHoistedSecurityAccessTokenOnly(sdk);
  if (!res.ok) throw res.error;

{{- if isStrictMCPServer }}
  expect(res.value.StatusCode).toBe(200);
  expect(res.value.token).toBeDefined();
  expect(res.value.token!.token).toBe("Bearer ghp_xxxx");
{{- else }}
  expect(res.value.status).toBe(200);
{{- end }}
});

