{{- recurse 1 -}}
{{- if and .Global .Global.Config .Global.Config.CloudflareEnabled -}}
{{- $globalSDK := .Global.AST.MainSDK -}}
{{- $coreName := sanitizeCoreSDKName }}
{{- $mcpServerName := print (sanitizeClassName .Global.Config.PackageName) "MCP" }}
import { McpAgent } from "agents/mcp";
import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { {{ $coreName }} } from "../core.js";
import { createConsoleLogger } from "../mcp-server/console-logger.js";
import { createMCPServer } from "../mcp-server/server.js";
import type { Env } from "../../worker-configuration.js";
import { landingPage } from "../landing-page.js"

interface State { }

type Props = Record<string, string>;

export class {{ $mcpServerName }} extends McpAgent<Env, State, Props> {
  server!: McpServer;

  async init() {
    const { server } = createMCPServer({
      logger: createConsoleLogger('debug'),
      getSDK: () => this.getSDK(),
    });

    this.server = server
  }

  getSDK() {
  {{- if $globalSDK.Security }}
    const getHeader = (name: string) => this.props?.[name] ?? ''
  {{- end }}

    const sdk = new {{ $coreName }}({
      debugLogger: {
        log: (...args) => console.log(...args),
        group: (...args) => console.group(...args),
        groupEnd: (...args) => console.groupEnd(...args),
      },
  {{- if $globalSDK.Security }}
      security: async () => ({{templateRemoteServerHeaders $globalSDK.Security.Type}})
  {{- end }}
    });
    return sdk;
  }
}


export default {
  async fetch(request: Request, env: Env, ctx: any) {
    const url = new URL(request.url);

    // Pass auth headers through to the MCP agent
    const headers: Record<string, string> = {};
    for (const [key, value] of request.headers.entries()) {
      headers[key.toLowerCase()] = value;
    }
    ctx.props = headers;

    if (url.pathname === "/sse" || url.pathname.startsWith("/sse/")) {
      return {{ $mcpServerName }}.serveSSE("/sse", { binding: "{{sanitizeEnvVarName .Global.Config.PackageName}}_MCP" }).fetch(
        request,
        env,
        ctx
      );
    }

    if (url.pathname === "/mcp") {
      return {{ $mcpServerName }}.serve("/mcp", { binding: "{{sanitizeEnvVarName .Global.Config.PackageName}}_MCP" }).fetch(
        request,
        env,
        ctx
      );
    }

    // Landing page
    if (url.pathname === "/") {
      return landingPage(request);
    }

    // NOTE: we renamed .dxt extension to .mcpb; redirect for backwards compatibility
    if (url.pathname.endsWith('.dxt')) {
      const newPath = url.pathname.replace(/\.dxt$/, '.mcpb');
      const newUrl = new URL(url);
      newUrl.pathname = newPath;
      return Response.redirect(newUrl.toString(), 301);
    }

    // Fallback to serving static assets
    const response = await env.ASSETS.fetch(request);

        // Only modify headers if asset was found successfully
    if (response.ok) {
      // Clone the response to modify headers
      return new Response(response.body, {
        headers: {
              'Content-Type': 'application/octet-stream',
              'Content-Disposition': 'attachment; filename="mcp-server.mcpb"',
              'Cache-Control': 'public, max-age=3600',
            },
      });
    }

    // Return the original response (including 404s) as-is
    return response;
  },
};
{{- end -}}
