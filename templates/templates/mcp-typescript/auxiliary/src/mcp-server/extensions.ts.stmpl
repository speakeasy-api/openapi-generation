{{- recurse 1 -}}
{{ genImports }}
{{- addImport "zod" "z" "aliasImport" }}
{{- addImport "./tools.js" "ToolDefinition" }}
{{- addImport "./prompts.js" "PromptDefinition" }}
{{- addImport "./resources.js" "ResourceDefinition" }}
{{- addImport "./resources.js" "ResourceTemplateDefinition" }}

export type Register = {
  tool: <A extends z.ZodRawShape | undefined>(def: ToolDefinition<A>) => void;
  resource: (def: ResourceDefinition) => void;
  resourceTemplate: (def: ResourceTemplateDefinition) => void;
  prompt: <A extends z.ZodRawShape | undefined>(prompt: PromptDefinition<A>) => void;
}
