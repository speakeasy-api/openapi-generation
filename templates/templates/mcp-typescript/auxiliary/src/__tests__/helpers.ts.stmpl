{{if sdkHasTests .Global.AST}}{{if not (empty .Global.AST.MainSDK.TestGroup)}}
export function sortSerializedMaps(
  input: any,
  regex: string,
  delim: string,
): any {
  switch (typeof input) {
    case "object":
      if (Array.isArray(input)) {
        if (input.length === 0) {
          return [];
        }
        if (typeof input[0] !== "string") {
          throw new Error(`Unsupported type: array of ${typeof input[0]}`);
        }

        return input.map((v) => sortMapString(v, regex, delim));
      } else {
        const output: Record<string, any> = {};
        Object.keys(input).forEach((key) => {
          if (typeof input[key] !== "string") {
            throw new Error(
              `Unsupported type: object with ${typeof input[key]}`,
            );
          }

          output[key] = sortMapString(input[key], regex, delim);
        });
        return output;
      }
    case "string":
      return sortMapString(input, regex, delim);
    default:
      throw new Error(`Unsupported type: ${typeof input}`);
  }
}

export function sortQueryParameters(url: string | undefined): string {
  if (!url) {
    return "";
  }

  const parts = url.split("?");

  if (parts.length == 1) {
    return url;
  }

  const query = parts[1];
  const params = query?.split("&");

  params?.sort((a, b) => {
    const aKey = a.split("=")[0] as string;
    const bKey = b.split("=")[0] as string;

    if (aKey < bKey) {
      return -1;
    } else if (aKey > bKey) {
      return 1;
    } else {
      return 0;
    }
  });

  return parts[0] + "?" + params?.join("&");
}

export function sortJSONObjectKeys(input: any, fields: string[]): any {
  switch (typeof input) {
    case "object":
      if (Array.isArray(input)) {
        throw new Error(`Unsupported type: array`);
      } else {
        if (fields.length >= 1) {
          for (const field of fields) {
            if (!input[field]) {
              throw new Error(`Field ${field} not found in object`);
            }

            input[field] = sortKeys(input[field]);
          }
        } else {
          input = sortKeys(input);
        }
      }
      break;
    case "string":
      return sortKeys(input);
    default:
      throw new Error(`Unsupported type: ${typeof input}`);
  }

  return input;
}

function sortMapString(input: string, regex: string, delim: string): string {
  return input.replace(new RegExp(regex, "g"), (m, ...args: any[]) => {
    let result = m;

    for (let i = 0; i < args.length - 2; i++) {
      let match = args[i] as string;

      let pairs: string[] = [];

      if (match.includes("=")) {
        pairs = match.split(delim);

        pairs.sort((a, b) => {
          const aKey = a.split("=")[0] as string;
          const bKey = b.split("=")[0] as string;

          if (aKey < bKey) {
            return -1;
          } else if (aKey > bKey) {
            return 1;
          } else {
            return 0;
          }
        });
      } else {
        const values = match.split(delim);

        if (values.length == 1) {
          pairs = values;
        } else {
          for (let j = 0; j < values.length; j += 2) {
            pairs[j / 2] = values[j] + delim + values[j + 1];
          }
        }

        pairs.sort((a, b) => {
          const aKey = a.split(delim)[0] as string;
          const bKey = b.split(delim)[0] as string;

          if (aKey < bKey) {
            return -1;
          } else if (aKey > bKey) {
            return 1;
          } else {
            return 0;
          }
        });
      }

      match = pairs.join(delim);

      result = result.replace(args[i], match);
    }

    return result;
  });
}

function sortKeys(input: any): any {
  const asString = typeof input === "string";

  let obj = asString ? JSON.parse(input) : input;

  switch (typeof obj) {
    case "object":
      if (Array.isArray(obj)) {
        obj = obj.map((v) => {
          if (typeof v === "object" && !Array.isArray(v)) {
            return sortKeys(v);
          }
          return v;
        });
      } else {
        const keys = Object.keys(obj);
        keys.sort();
        const sortedObj: Record<string, any> = {};
        for (const key of keys) {
          let value = obj[key];

          switch (true) {
            case typeof value === "object" && Array.isArray(value):
              value = value.map((v) => {
                if (typeof v === "object" && !Array.isArray(v)) {
                  return sortKeys(v);
                }
                return v;
              });
              break;
            case typeof value === "object" && !Array.isArray(value):
              value = sortKeys(value);
              break;
          }
          sortedObj[key] = value;
        }
        obj = sortedObj;
      }
      break;
    default:
      throw new Error(`Unsupported type: ${typeof obj}`);
  }

  if (asString) {
    return JSON.stringify(obj);
  }

  return obj;
}
