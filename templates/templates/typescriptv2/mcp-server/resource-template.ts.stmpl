{{- recurse 1 -}}
{{- $op := .Local.Operation }}
{{- $usageLocation := "mcp-server/resources" }}
{{- $funcName := sanitizeFuncName $op }}
{{- $customPath := printf "%s/%s.custom.ts" .Local.Dir .Local.Filename }}
{{- $hasCustomFile := fileExists $customPath }}
{{- $isTemplate := isResourceTemplate $op }}
{{ genImports }}
{{- addImport "../resources.js" "ResourceTemplateDefinition" }}
{{- addImport "../resources.js" "formatResult" }}
{{- addImport "@modelcontextprotocol/sdk/server/mcp.js" "ResourceTemplate" }}

{{- if $hasCustomFile }}
{{- addImport (printf "./%s.custom.js" .Local.Filename) "customizer" "aliasImport" }}
{{- end }}

{{- addZodPackageImport }}
export const varsSchema = z.object({
  {{- range $paramDef := getVisiblePathParams $op }}
  {{-   $zod := resolveURISchema $paramDef.Field $usageLocation }}
  {{    sanitizeFieldName $paramDef.Field.Name }}: {{$zod}},
  {{- end}}
  {{- range $paramDef := getVisibleQueryParams $op }}
  {{-   $zod := resolveURISchema $paramDef.Field $usageLocation }}
  {{    sanitizeFieldName $paramDef.Field.Name }}: {{$zod}},
  {{- end}}
}); 

export const {{sanitizeMCPPrimitiveExport $op}}: ResourceTemplateDefinition = {
  name: "{{ sanitizeMCPPrimitiveName $op }}",
  description: `{{ sanitizeMCPPrimitiveDescription $op }}`,
  {{- if and $op.Extensions.MCP $op.Extensions.MCP.Scope }}
  scopes: {{ $op.Extensions.MCP.Scopes | toJson }},
  {{- end }}
  resource: new ResourceTemplate("{{ resourceURITemplate $op }}", { list: undefined }),
  read: async (client, uri, vars, extra) => {
    const input = varsSchema.parse(vars);

    {{- addFuncImport $op $usageLocation }}
    const [result, apiCall] = await {{$funcName}}(
      client,
      {{- range $field := $op.Arguments.Sorted }}
      {{-   if hasAnnotation $field "opSecurity" }}
      {{-     continue }}
      {{-   else if hasAnnotation $field "requestWrapper" }}
      input,
      {{-   else }}
      {{      sanitizeFieldName .Name }},
      {{-   end }}
      {{- end }}
      { {{constants.fetchOptions}}: { signal: extra.signal } },
    ).$inspect();

    if (!result.ok) {
      throw result.error;
    }

    {{- if $hasCustomFile }}

    if ("formatResult" in customizer) {
      return customizer.formatResult(result.value, uri, {response: apiCall.response});
    }
    {{- end }}

    return formatResult(result.value, uri, {response: apiCall.response});
  }
}
