{{- recurse 1 -}}
{{- genImports -}}
{{- addZodPackageImport -}}
{{- addImport "../lib/base64.js" "bytesToBase64" -}}
{{- addImport "zod-to-json-schema" "zodToJsonSchema" -}}
{{- addImport "@modelcontextprotocol/server" "StandardSchemaWithJSON" -}}

import type { ServerContext } from "@modelcontextprotocol/server";
import type { RequestHandlerExtra } from "@modelcontextprotocol/sdk/shared/protocol.js";
import type { ServerRequest, ServerNotification } from "@modelcontextprotocol/sdk/types.js";
import { ErrorCode, McpError } from "@modelcontextprotocol/sdk/types.js";

export type MCPServerContext = ServerContext & RequestHandlerExtra<ServerRequest, ServerNotification>;

export function mcpServerContext(ctx: ServerContext): MCPServerContext {
  return {
    ...ctx,
    signal: ctx.mcpReq.signal,
    requestId: ctx.mcpReq.id,
    ...(ctx.mcpReq._meta ? { _meta: ctx.mcpReq._meta } : {}),
    ...(ctx.http?.authInfo ? { authInfo: ctx.http.authInfo } : {}),
    ...(ctx.http?.req ? { requestInfo: { headers: Object.fromEntries(ctx.http.req.headers), url: new URL(ctx.http.req.url) } } : {}),
    ...(ctx.http?.closeSSE ? { closeSSEStream: ctx.http.closeSSE } : {}),
    ...(ctx.http?.closeStandaloneSSE ? { closeStandaloneSSEStream: ctx.http.closeStandaloneSSE } : {}),
    sendNotification: async (notification) => {
      if (!ctx.mcpReq.signal.aborted) await ctx.mcpReq.notify(notification);
    },
    sendRequest: async (request, resultSchema, options) => {
      if (ctx.mcpReq.signal.aborted) throw new McpError(ErrorCode.ConnectionClosed, "Request was cancelled");
      return (ctx.mcpReq.send as MCPServerContext["sendRequest"])(request, resultSchema, options);
    },
  };
}

export function mcpSchema<A extends z.ZodRawShape>(
  shape: A,
): StandardSchemaWithJSON<z.input<z.ZodObject<A>>, z.output<z.ZodObject<A>>> {
  const schema = z.object(shape);
  const jsonSchema = (direction: "input" | "output"): Record<string, unknown> => JSON.parse(JSON.stringify(
    zodToJsonSchema(schema, {
      pipeStrategy: direction,
      effectStrategy: direction === "output" ? "any" : "input",
      strictUnions: direction === "input",
    }),
    (_key, value) => typeof value === "bigint" ? value.toString() : value,
  ));

  return {
    "~standard": {
      version: 1,
      vendor: "zod",
      jsonSchema: { input: () => jsonSchema("input"), output: () => jsonSchema("output") },
      validate: async (value) => {
        const result = await schema.safeParseAsync(value);
        return result.success
          ? { value: result.data }
          : { issues: result.error.issues };
      },
    },
  };
}

type BinaryData =
  | Uint8Array
  | ArrayBuffer
  | Blob
  | ReadableStream
  | Response
  | string;

export async function consumeStream(
  stream: ReadableStream<Uint8Array>
): Promise<Uint8Array> {
  const reader = stream.getReader();
  const chunks: ArrayBuffer[] = [];

  try {
    while (true) {
      const { done, value } = await reader.read();
      if (value != null) chunks.push(new Uint8Array(value).buffer);
      if (done) break;
    }
  } finally {
    reader.releaseLock();
  }

  return new Uint8Array(await new Blob(chunks).arrayBuffer());
}

export function isAsyncIterable(
  value: unknown
): value is AsyncIterable<string> {
  return (
    typeof value === "object" && value != null && Symbol.asyncIterator in value
  );
}

export function isBinaryData(value: unknown): value is BinaryData {
  return (
    value instanceof Uint8Array ||
    value instanceof ArrayBuffer ||
    value instanceof Blob ||
    value instanceof ReadableStream ||
    value instanceof Response ||
    typeof value === "string"
  );
}

const base64Schema = z.string().base64();

export async function valueToBase64(
  value: BinaryData | null | undefined
): Promise<string | null> {
  if (value == null) {
    return null;
  } else if (value instanceof Uint8Array) {
    return bytesToBase64(value);
  } else if (value instanceof ArrayBuffer) {
    return bytesToBase64(new Uint8Array(value));
  } else if (value instanceof Response || value instanceof Blob) {
    return bytesToBase64(new Uint8Array(await value.arrayBuffer()));
  } else if (value instanceof ReadableStream) {
    return bytesToBase64(await consumeStream(value));
  } else if (typeof value === "string") {
    return base64Schema.parse(value);
  } else {
    value satisfies never;
    throw new Error(`Unsupported image value type: ${typeof value}`);
  }
}
