{{- recurse 1 -}}
{{- $globalSDK := .Global.AST.MainSDK -}}
{{- $globalSecurity := $globalSDK.Security -}}
{{- $usageLocation := "mcp-server/cli/start" -}}
{{- $hasServers := (and $globalSDK.Servers $globalSDK.Servers.HasAbsoluteURL) -}}
{{- $serverVariables := and $globalSDK.Servers (gt (len $globalSDK.Servers.GetVariables) 0) -}}
{{- $serverMap := (and $globalSDK.Servers $globalSDK.Servers.ServerMap) -}}
import { SSEServerTransport } from "@modelcontextprotocol/sdk/server/sse.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
import express from "express";
import { LocalContext } from "../../cli.js";
import {
  ConsoleLoggerLevel,
  createConsoleLogger,
} from "../../console-logger.js";
import { createMCPServer } from "../../server.js";
{{- if gt (len .Local.Scopes) 0 }}
import { MCPScope } from "../../scopes.js";
{{- end }}
{{ genImports }}

interface StartCommandFlags {
  readonly transport: "stdio" | "sse";
  readonly port: number;
  readonly tool?: string[];
  {{- if gt (len .Local.Scopes) 0 }}
  readonly scope?: MCPScope[];
  {{- end }}

  {{- if $globalSecurity }}
  {{-   range $field := unnestSecurityEnvFields $globalSecurity.Type }}
  {{-     $fieldName := sanitizeMCPCLIFlag $field.Name true }}
  {{-     $optional := not $field.Default }}
  {{-     $types := resolveOutbound (dict "usageLocation" $usageLocation "typeDef" $field.Type "rootTypeDef" $globalSDK.Type "optional" $optional "nullable" $field.Nullable)}}
  {{-     callImportTypesFunc $types.importInputTypes }}
  readonly {{ $fieldName }}{{if $optional}}?{{end}}: {{$types.inputType}},
  {{-   end }}
  {{- end }}{{/* if $globalSecurity */}}
  {{- if (ne $globalSDK.Globals nil)}}
  {{-   range $globalSDK.Globals.Fields}}
  {{-     $fieldName := templateGlobalFieldName .Name}}
  {{-     $flag := sanitizeMCPCLIFlag $fieldName true }}
  {{-     addImport "../../../lib/config.js" "SDKOptions" }}
  readonly {{$flag}}?: SDKOptions["{{$fieldName}}"] | undefined;
  {{-   end}}
  {{- end}}{{/* if (ne $globalSDK.Globals nil) */}}
  {{- if $hasServers }}
  readonly "server-url"?: string;
  {{- else }}
  readonly "server-url": string;
  {{- end}}
  {{- if $globalSDK.Servers}}{{if $serverMap}}
  {{- addImport "../../../lib/config.js" "SDKOptions" }}
  readonly server?: SDKOptions["server"];
  {{- else}}
  {{- addImport "../../../lib/config.js" "SDKOptions" }}
  readonly "server-index"?: SDKOptions["serverIdx"];
  {{- end}}
  {{- range $variable := $globalSDK.Servers.GetVariables}}
  {{- $name := $variable.Name }}
  {{- $fieldName := sanitizeMCPCLIFlag $name true }}
  {{- addImport "../../../lib/config.js" "SDKOptions"}}
  readonly {{$fieldName}}?: SDKOptions["{{sanitizeFieldName $name}}"];
  {{- end}}
  {{- end}}
  readonly "log-level": ConsoleLoggerLevel;
  readonly env?: [string, string][];
}

export async function main(this: LocalContext, flags: StartCommandFlags) {
  flags.env?.forEach(([key, value]) => {
    process.env[key] = value;
  });

  switch (flags.transport) {
    case "stdio":
      await startStdio(flags);
      break;
    case "sse":
      await startSSE(flags);
      break;
    default:
      throw new Error(`Invalid transport: ${flags.transport}`);
  }
}

async function startStdio(flags: StartCommandFlags) {
  const logger = createConsoleLogger(flags["log-level"]);
  const transport = new StdioServerTransport();
  const server = {{templateString "mcp-server/create-mcp-server.ts.stmpl" .Local}};
  await server.connect(transport);

  const abort = async () => {
    await server.close();
    process.exit(0);
  };
  process.on("SIGTERM", abort);
  process.on("SIGINT", abort);
}

async function startSSE(flags: StartCommandFlags) {
  const logger = createConsoleLogger(flags["log-level"]);
  const app = express();
  const mcpServer = {{templateString "mcp-server/create-mcp-server.ts.stmpl" .Local}};
  let transport: SSEServerTransport | undefined;
  const controller = new AbortController();

  app.get("/sse", async (_req, res) => {
    transport = new SSEServerTransport("/message", res);

    await mcpServer.connect(transport);

    mcpServer.server.onclose = async () => {
      res.end();
    };
  });

  app.post("/message", async (req, res) => {
    if (!transport) {
      throw new Error("Server transport not initialized");
    }

    await transport.handlePostMessage(req, res);
  });

  const httpServer = app.listen(flags.port, "0.0.0.0", () => {
    const ha = httpServer.address();
    const host = typeof ha === "string" ? ha : `${ha?.address}:${ha?.port}`;
    logger.info("MCP HTTP server started", { host });
  });

  let closing = false;
  controller.signal.addEventListener("abort", async () => {
    if (closing) {
      logger.info("Received second signal. Forcing shutdown.");
      process.exit(1);
    }
    closing = true;

    logger.info("Shutting down MCP server");

    await mcpServer.close();

    logger.info("Shutting down HTTP server");

    const timer = setTimeout(() => {
      logger.info("Forcing shutdown");
      process.exit(1);
    }, 5000);

    httpServer.close(() => {
      clearTimeout(timer);
      logger.info("Graceful shutdown complete");
      process.exit(0);
    });
  });

  const abort = () => controller.abort();
  process.on("SIGTERM", abort);
  process.on("SIGINT", abort);
}
