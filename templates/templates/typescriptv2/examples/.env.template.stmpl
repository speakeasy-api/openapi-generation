# {{.Global.Config.PackageName}} SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

{{- if .Global.Config.EnvVarPrefix }}

# Security Configuration
{{-   if .Global.AST.MainSDK.Security }}
# The SDK supports loading security credentials from environment variables
# with the prefix: {{.Global.Config.EnvVarPrefix}}_
#
# Security environment variables:
{{-     range $field := unnestSecurityEnvFields .Global.AST.MainSDK.Security.Type }}
{{-       $fieldName := templateSecurityEnvVars $field }}
{{ $fieldName }}={{ getEnvVarPlaceholder $field.Name }}
{{-     end }}
{{-   end }}

# Debug Configuration
# Enable HTTP request/response logging for debugging
{{ templateDebugEnvVar }}=true

{{- else }}

{{- end }}
