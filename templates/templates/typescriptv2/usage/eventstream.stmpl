{{- $responseFormat := getResponseFormat }}
{{- $fieldName := sanitizeFieldName (getResponseFieldName .Local.Operation "eventstream") }}

{{- $accessor := (getResponseVariableName .Local.StepID) }}
{{- if ne $responseFormat "flat" }}
{{- $accessor = print (getResponseVariableName .Local.StepID) "." $fieldName }}
{{- end }}

{{- if ne $responseFormat "flat" }}
if ({{$accessor}} == null) {
  throw new Error("failed to create stream: received null value");
}
{{- end }}

{{- if and .Local.Operation.Response.Type (eq .Local.Operation.Response.Type.Type "union") }}
{{- addEventStreamUsageImport }}
{{- $streamClass := eventStreamClassName }}
// Check if the response is a {{$streamClass}} instance for union types
if ({{$accessor}} instanceof {{$streamClass}}) {
  for await (const event of {{$accessor}}) {
    // Handle the event
    console.log(event);
  }
} else {
  console.log({{$accessor}});
}
{{- else }}
for await (const event of {{$accessor}}) {
  console.log(event);
}
{{- end }}
