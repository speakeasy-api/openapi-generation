{{- recurse 1 -}}
{{- addUsageImport .Global.Config.PackageName (sanitizeClassName .Global.AST.MainSDK.Type.Name) -}}
{{genImports "UsageImports"}}

{{templateString "usage/init.stmpl" .Local | trim }}

{{- $funcName := sanitizeFieldName .Local.Operation.ID}}
async function {{$funcName}}() {
{{templateString "usage/call.stmpl" .Local | trim | indent 2}}

{{templateString "usage/result.stmpl" .Local | trim | indent 2}}
}

{{$funcName}}();

