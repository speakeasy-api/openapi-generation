{{- recurse 1 -}}
{{- if .Global.Config.EnvVarPrefix }}
{{- if not isNoZod }}
{{- addZodPackageImport }}
{{- end }}
{{ genImports }}

{{- $dg := "src/lib/env.ts" }}
{{- $globalSDK := .Global.AST.MainSDK}}

export interface Env {
  {{- if .Global.AST.MainSDK.Security }}
  {{-   range $field := unnestSecurityEnvFields .Global.AST.MainSDK.Security.Type }}
  {{-     $fieldName := templateSecurityEnvVars $field }}
  {{-     $optional := not $field.Default }}
  {{-     $types := resolveOutbound (dict "usageLocation" "lib" "typeDef" $field.Type "rootTypeDef" $globalSDK.Type "optional" $optional "nullable" $field.Nullable)}}
  {{-     callImportTypesFunc $types.importInputTypes }}
  {{      $fieldName }}{{if $optional}}?{{end}}: {{$types.inputType}},
  {{-   end }}
  {{- end }}
  {{""}}
  {{- if .Global.AST.MainSDK.Globals }}
  {{-   range $idx, $field := .Global.AST.MainSDK.Globals.Fields}}
  {{-     if not $field.Type.IsPrimitive }}{{ continue }}{{ end }}
  {{-     $types := resolveOutbound (dict "usageLocation" "lib" "typeDef" $field.Type "rootTypeDef" $globalSDK.Type "optional" true "nullable" $field.Nullable)}}
  {{-     $fieldName := templateSecurityEnvVars $field }}
  {{-     callImportTypesFunc $types.importInputTypes }}
  {{      templateBuiltinComment $dg (printf "%s.%s" "Env" $fieldName) (print "Sets the " (templateGlobalFieldName $field.Name) " parameter for all supported operations") 1}}
  {{      $fieldName }}?: {{$types.inputType}},
  {{-   end }}
  {{- end }}
  {{""}}
  {{- if .Global.Config.EnvVarPrefix }}
  {{templateDebugEnvVar}}?: boolean | undefined;
  {{- end }}
}

{{- if isNoZod }}
{{- /* No-zod: env vars are read as plain strings from process.env. We coerce
       booleans/numbers ourselves for the debug flag since the wire is always
       a string. The shape just casts to Env — server env input is trusted. */ -}}
{{- else }}

export const envSchema: {{zodType "Env" "unknown"}} = z.object({
  {{- if .Global.AST.MainSDK.Security }}
  {{-   range $field := unnestSecurityEnvFields .Global.AST.MainSDK.Security.Type }}
  {{      templateSecurityEnvVars $field }}: {{resolveEnvSchema $field "lib"}},
  {{-   end }}
  {{- end }}
  {{""}}
  {{- if .Global.AST.MainSDK.Globals }}
  {{-   range $idx, $field := .Global.AST.MainSDK.Globals.Fields}}
  {{-     if not $field.Type.IsPrimitive }}{{ continue }}{{ end }}
  {{      templateSecurityEnvVars $field}}: {{resolveEnvSchema $field "lib"}},
  {{-   end }}
  {{- end }}
  {{""}}
  {{- if .Global.Config.EnvVarPrefix }}
  {{ templateDebugEnvVar }}: {{zodOptional "z.coerce.boolean()"}},
  {{- end }}
});
{{- end }}

/**
 * Checks for the existence of the Deno global object to determine the environment.
 * @returns {boolean} True if the runtime is Deno, false otherwise.
 */
function isDeno() {
  if ('Deno' in globalThis) {
    return true
  }

  return false;
}

let envMemo: Env | undefined = undefined;
/**
 * Reads and validates environment variables.
 */
export function env(): Env {
  if (envMemo) {
    return envMemo;
  }

  const globals = globalThis as {
    Deno?: { env?: { toObject?: () => Record<string, string | undefined> } };
    process?: { env?: Record<string, string | undefined> };
  };

  let envObject: Record<string, unknown> = {};
  if (isDeno()) {
    envObject = globals.Deno?.env?.toObject?.() ?? {};
  } else {
    envObject = globals.process?.env ?? {};
  }

  {{- if isNoZod }}

  envMemo = envObject as unknown as Env;
  {{- else }}

  envMemo = envSchema.parse(envObject);
  {{- end }}
  return envMemo;
}

/**
 * Clears the cached env object. Useful for testing with a fresh environment.
 */
export function resetEnv() {
  envMemo = undefined;
}

{{ if .Global.AST.MainSDK.Globals }}
{{ addInternalImport "config" "SDKOptions" "lib" }}
/**
 * Populates global parameters with environment variables.
 */
export function fillGlobals(options: SDKOptions): SDKOptions {
  const clone = { ...options };

  const envVars = env();

  {{  range $idx, $field := .Global.AST.MainSDK.Globals.Fields}}
  {{-   if not $field.Type.IsPrimitive }}{{ continue }}{{ end }}
  {{-   $envVar := templateSecurityEnvVars $field }}
  if (typeof envVars.{{$envVar}} !== "undefined") {
    clone.{{templateGlobalFieldName $field.Name}} ??= envVars.{{$envVar}};
  }
  {{- end }}

  return clone;
}
{{ end }}
{{ end }}