{{- recurse 1 -}}
{{- genImports -}}
{{- if isNoZod }}
{{- /* No-zod: const date-time fields are inlined as plain string types
       with no runtime check. constDateTime() is never called by generated
       code, so nothing to emit. */ -}}
{{- else }}
{{- addZodPackageImport }}

export function constDateTime(
  val: string,
): {{zodType "string" "unknown"}} {
  return z.custom<string>((v) => {
    return (
      typeof v === "string" && new Date(v).getTime() === new Date(val).getTime()
    );
  }, `Value must be equivalent to ${val}`);
}
{{- end }}
