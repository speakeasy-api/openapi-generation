test("test client credentials hook basic successfully authenticates with alt token url", async () => {
  recordTest("hooks-client-credentials-basic-success-alt-token-url");

  const scopes: ClientCredentialsOAuth2Scope[] = ["alt:one", "alt:two"];

  const sdk = new SDK({
    serverURL: API_TEST_SERVICE_URL,
    security: {
      clientCredentials: {
        clientID: "speakeasy-sdks",
        clientSecret: "supersecret-" + randSeq(10),
        tokenURL: "/clientcredentials/alt/token",
        scopes: scopes,
{{- range $f := collectClientCredentialsAdditionalFields }}
        {{ sanitizeFieldName (originalFieldName $f) }}: "",
{{- end }}
      },
    },
  });

  let res = await sdk.hooks.authenticatedRequest({});
  expect(res.httpMeta.response.status).toBe(200);

  res = await sdk.hooks.authenticatedRequest({});
  expect(res.httpMeta.response.status).toBe(200);
});

function randSeq(length: number) {
  const chars = "abcdefghijklmnopqrstuvwxyz";
  let result = "";
  for (let i = 0; i < length; i++) {
    result += chars.charAt(Math.floor(Math.random() * chars.length));
  }

  return result;
}
