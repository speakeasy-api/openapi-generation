import { expect, test } from "vitest";

import { SDK } from "../index.js";
import { recordTest, API_TEST_SERVICE_URL } from "./common_helpers.js";
import { ClientCredentialsOAuth2Scope } from "../hooks/{{getOAuth2ScopesFileName}}.js";

test("test client credentials basic hook successfully authenticates", async () => {
  recordTest("hooks-client-credentials-basic-success");

  const sdk = new SDK({
    serverURL: API_TEST_SERVICE_URL,
    security: {
      clientCredentials: {
        clientID: "speakeasy-sdks",
        clientSecret: "supersecret-" + randSeq(10),
{{- range $f := collectClientCredentialsAdditionalFields }}
        {{ sanitizeFieldName (originalFieldName $f) }}: "",
{{- end }}
      },
    },
  });

  let res = await sdk.hooks.authenticatedRequest({});
  expect(res.httpMeta.response.status).toBe(200);

  res = await sdk.hooks.authenticatedRequest({});
  expect(res.httpMeta.response.status).toBe(200);
});

test("test client credentials hook basic successfully authenticates with global server", async () => {
  recordTest("hooks-client-credentials-basic-success-global-server");

  const sdk = new SDK({
    security: {
      clientCredentials: {
        clientID: "speakeasy-sdks",
        clientSecret: "supersecret-" + randSeq(10),
{{- range $f := collectClientCredentialsAdditionalFields }}
