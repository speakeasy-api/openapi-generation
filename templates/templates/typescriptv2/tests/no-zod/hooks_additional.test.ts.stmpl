test("Test hooks authorization header modification", async () => {
  recordTest("hooks-authorization-header-modification");

  const s = new SDK({
    serverURL: HTTPBIN_URL,
    security: {
      apiKeyAuth: "Bearer testToken",
    },
  });

  const res = await s.hooks.authorizationHeaderModification();
  expect(res).toBeDefined();
  expect(res.httpMeta.response.status).toBe(200);
  expect(res.token?.authenticated).toBe(true);
  expect(res.token?.token).toBe("testToken modified");
});

test("Hooks can trigger retries", async () => {
  recordTest("hooks-trigger-retries");

  const spy = vi.fn();
  const httpClient = new HTTPClient().addHook("beforeRequest", spy);

  const s = new SDK({
    serverURL: HTTPBIN_URL,
    httpClient,
  });

  const retries = {
    strategy: "backoff",
    backoff: {
      exponent: 1.5,
      initialInterval: 50,
      maxInterval: 100,
      maxElapsedTime: 1000,
    },
  } as const;

  let res = await s.requestBodies.nullableObjectPost(null, { retries });

  expect(res).toBeDefined();
  expect(res.httpMeta.response.status).toBe(200);
  expect(spy).toHaveBeenCalledTimes(1);

  spy.mockReset();
  expect(spy).toHaveBeenCalledTimes(0);

  res = await s.requestBodies.nullableObjectPost(null, {
    retries,
    fetchOptions: { headers: { "x-force-retry-hook": "force-retry" } },
  });

  expect(res).toBeDefined();
  expect(res.httpMeta.response.status).toBe(200);
  expect(spy).toHaveBeenCalledTimes(2);
});

test("Hooks can access retry config for a method call", async () => {
  recordTest("hooks-access-retry-config");

  const spy = vi.fn();
  const httpClient = new HTTPClient().addHook("beforeRequest", spy);

  const s = new SDK({
    serverURL: HTTPBIN_URL,
    httpClient,
  });

  const retries = { strategy: "none" } as const;

  const res = await s.requestBodies.nullableObjectPost(null, {
    retries,
    fetchOptions: { headers: { "x-force-retry-hook": "force-retry" } },
  });

  expect(res).toBeDefined();
  expect(res.httpMeta.response.status).toBe(200);
  expect(spy).toHaveBeenCalledTimes(1);
});

test("Hooks can terminate retry loop", async () => {
  recordTest("hooks-terminate-retry-loop");

  let once = true;
  const spy = vi.fn();
  const httpClient = new HTTPClient()
    .addHook("beforeRequest", spy)
    .addHook("beforeRequest", (req) => {
      if (once) {
        once = false;
        req.headers.set("x-teapot", "json");
      }
    });

  const sdk = new SDK({
    serverURL: HTTPBIN_URL,
    httpClient,
  });

  const retries = {
    strategy: "backoff",
    backoff: {
      exponent: 1.5,
      initialInterval: 50,
      maxInterval: 100,
      maxElapsedTime: 1000,
    },
  } as const;

  const res1 = await sdk.methods.methodGet({
    serverURL: API_TEST_SERVICE_URL,
    retries,
    retryCodes: ["418"],
  });

  expect(res1).toBeDefined();
  expect(res1.httpMeta.response.status).toBe(200);
  expect(spy).toHaveBeenCalledTimes(2);

  spy.mockReset();
  expect(spy).toHaveBeenCalledTimes(0);

  // At this point, we've confirmed that retry behavior works as expected.
  // Below we will test to see if the hook can force a permanent error and abort
  // the retry loop.

  once = true;
  await expect(
    sdk.methods.methodGet({
      serverURL: API_TEST_SERVICE_URL,
      retries,
      retryCodes: ["418"],
      fetchOptions: {
        headers: {
          "x-force-retry-hook": "skip-retry",
        },
      },
    }),
  ).rejects.toThrow("Permanent error encountered");
});

test("test client credentials option successfully authenticates", async () => {
  recordTest("hooks-client-credentials-option-success");

  const log: RequestLogEntry[] = [];
  const httpClient = newRequestRecorderClient(log);
  const sdk = new SDK({
    serverURL: HTTPBIN_URL,
    httpClient,
    security: {
      clientCredentials: {
        clientID: "speakeasy-sdks",
        clientSecret: "supersecret-" + randSeq(10),
{{- range $f := collectClientCredentialsAdditionalFields }}
        {{ sanitizeFieldName (originalFieldName $f) }}: "",
{{- end }}
      },
    },
  });

  let res = await sdk.hooks.authenticatedRequest({});
  expect(res.httpMeta.response.status).toBe(200);

  // The requested token is still valid, so it should be reused.
  res = await sdk.hooks.authenticatedRequest({});
  expect(res.httpMeta.response.status).toBe(200);

  // Check that only a single token request was made
  const tokenUrl = "/clientcredentials/token?expires_in=90";
  const tokenRequests = log.filter(
    (entry) =>
      entry.url.includes(tokenUrl) && entry.body.includes("scope=read+write"),
  );
  expect(tokenRequests).toHaveLength(1);
});

test("test client credentials option successfully authenticates with alt token url", async () => {
  recordTest("hooks-client-credentials-option-success-alt-token-url");

  const log: RequestLogEntry[] = [];
  const httpClient = newRequestRecorderClient(log);
  const tokenUrl = "/clientcredentials/alt/token";
  const scopes: ClientCredentialsOAuth2Scope[] = ["alt:one", "alt:two"];

  const sdk = new SDK({
    serverURL: HTTPBIN_URL,
    httpClient,
    security: {
      clientCredentials: {
        clientID: "speakeasy-sdks",
        clientSecret: "supersecret-" + randSeq(10),
        scopes: scopes,
        tokenURL: tokenUrl,
{{- range $f := collectClientCredentialsAdditionalFields }}
        {{ sanitizeFieldName (originalFieldName $f) }}: "",
{{- end }}
      },
    },
  });

  let res = await sdk.hooks.authenticatedRequest({});
  expect(res.httpMeta.response.status).toBe(200);

  // The token received is already expired so another one should be requested.
  res = await sdk.hooks.authenticatedRequest({});
  expect(res.httpMeta.response.status).toBe(200);

  const tokenRequests = log.filter(
    (entry) =>
      entry.url.includes(tokenUrl) &&
      entry.body.includes("scope=alt%3Aone+alt%3Atwo"),
  );
  expect(tokenRequests).toHaveLength(2);
});

test("test hooks available oauth2 scopes", () => {
  recordTest("hooks-available-oauth2-scopes");

  const readScope: ClientCredentialsOAuth2Scope = "read";
  expect(readScope).toBe("read");
  const modelsReadScope: OAuth2Scope = "models:read";
  expect(modelsReadScope).toBe("models:read");

  const writeScope: ClientCredentialsOAuth2Scope = "write";
  expect(writeScope).toBe("write");
  const storeManageScope: OAuth2Scope = "store_manage";
  expect(storeManageScope).toBe("store_manage");
});
