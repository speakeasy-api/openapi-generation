import { expect, test, vi } from "vitest";

import { SDK } from "../index.js";
import { TestHooksRes } from "../sdk/models/operations/testhooks.js";

import {
  recordTest,
  randSeq,
  RequestLogEntry,
  newRequestRecorderClient,
  HTTPBIN_URL,
  API_TEST_SERVICE_URL,
} from "./common_helpers.js";
import { UnexpectedClientError } from "../sdk/models/errors/httpclienterrors.js";
import { HTTPClient } from "../lib/http.js";
import {
  ClientCredentialsOAuth2Scope,
  OAuth2Scope,
} from "../hooks/{{getOAuth2ScopesFileName}}.js";

test("Test hooks", async () => {
  recordTest("test-hooks");

  const s = new SDK({
    serverURL: HTTPBIN_URL,
    security: {
      apiKeyAuth: "Token YOUR_API_KEY",
    },
  });

  const response = await s.hooks.testHooks("someInitialValue");
  expect(response).toBeDefined();
  expect(response.httpMeta.response.status).toBe(200);
  // No-zod: header names arrive in their wire form (httpbin's canonical
  // Title-Case-With-Dashes), so we match those literals instead of the
  // camelized forms zod produces in primary.
  expect(response.res).toMatchObject({
    args: {
      someParam: "overriddenParam",
    },
    headers: {
      "Client-Level-Header": "added by client",
      "Idempotency-Key": "some-key",
    },
    url: `${HTTPBIN_URL}/anything/hooks?someParam=overriddenParam`,
  } as TestHooksRes);
});

test("Hooks can build a custom user agent from SDK metadata", async () => {
  recordTest("hooks-custom-user-agent");

  const s = new SDK({ serverURL: HTTPBIN_URL });

  const res = await s.hooks.hooksCustomUserAgent();
  expect(res.httpMeta.response.status).toBe(200);

  const headers = res.CustomUserAgentEcho?.headers ?? {};
  expect(headers["User-Agent"]).toBe(
    `acme-corp/{{.Global.Config.SDKVersion}} acme-corp/${process.version}`,
  );
  expect(headers["X-Test-Gen-Version"]).toBe("{{.Global.Config.GenVersion}}");
  expect(headers["X-Test-Doc-Version"]).toBe("{{.Global.Config.DocVersion}}");
  expect(headers["X-Test-Init-Sdk-Version"]).toBe(
    "{{.Global.Config.SDKVersion}}",
  );
});

test("Test hooks before create request", async () => {
  recordTest("test-hooks-before-create-request");

  const s = new SDK({
    serverURL: HTTPBIN_URL,
    security: {
      apiKeyAuth: "Token YOUR_API_KEY",
    },
  });

  const response = await s.hooks.testHooksBeforeCreateRequestPaths("foo/bar");
  expect(response).toBeDefined();
  expect(response.httpMeta.response.status).toBe(200);
  // No-zod: header name comes back in wire (Title-Case-With-Dashes) form.
  expect(response.res).toMatchObject({
    url: `${HTTPBIN_URL}/anything/hooks/beforeCreateRequestPaths/foo/bar`,
    headers: {
      "Old-Pathname":
        "/anything/hooks/beforeCreateRequestPaths/foo%2Fbar",
    },
  });
});

test("Test hooks after response", async () => {
  recordTest("test-hooks-after-response");

  const s = new SDK({
    serverURL: HTTPBIN_URL,
    security: {
      apiKeyAuth: "Token YOUR_API_KEY",
    },
  });

  try {
    await s.hooks.testHooksAfterResponse();
    expect.unreachable("sdk call is expected to fail");
  } catch (err: unknown) {
    expect(err).toBeInstanceOf(UnexpectedClientError);
    expect(err).toHaveProperty(["cause", "message"], "validation failed");
  }
});

