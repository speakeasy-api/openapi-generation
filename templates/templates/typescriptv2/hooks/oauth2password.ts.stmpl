{{- recurse 1 -}}
import { HTTPClient } from "../lib/http.js";
import { OAuth2SessionStore, OAuth2Session } from "../lib/oauth2-sessions.js";
import { SecurityState } from "../lib/security.js";
import { stringToBase64 } from "../lib/base64.js";
import { encodeBodyForm } from "../lib/encodings.js";
{{- if .Global.Config.SDKHooksConfigAccess -}}
import { SDKOptions, serverURLFromOptions } from "../lib/config.js";
{{- end -}}
{{genImports}}
{{- $responseFormat := getResponseFormat }}

import {
    AfterErrorContext,
    AfterErrorHook,
    BeforeRequestContext,
    BeforeRequestHook,
    SDKInitHook,{{if not .Global.Config.SDKHooksConfigAccess }}
    SDKInitOptions,{{end}}
} from "./types.js";

type Credentials = {
  {{constants.credentials.username}}: string;
  {{constants.credentials.password}}: string;
  {{constants.credentials.clientID}}?: string | undefined;
  {{constants.credentials.clientSecret}}?: string | undefined;
  {{constants.credentials.tokenURL}}: string;
};

export class ResourceOwnerPassswordCredentialsHook
  implements SDKInitHook, BeforeRequestHook, AfterErrorHook
{
  private baseURL?: URL | null;
  private client?: HTTPClient;
  private store = new OAuth2SessionStore();
  {{if .Global.Config.SDKHooksConfigAccess }}
  sdkInit(opts: SDKOptions): SDKOptions {
    this.baseURL = serverURLFromOptions(opts);
    this.client = opts.{{constants.httpClient}} || new HTTPClient();

    return opts;
  }
  {{else}}
  sdkInit(opts: SDKInitOptions): SDKInitOptions {
    this.baseURL = opts.baseURL;
    this.client = opts.client;

    return opts;
  }
  {{end}}
  async beforeRequest(
    hookCtx: BeforeRequestContext,
    request: Request,
  ): Promise<Request> {
    if (!hookCtx.{{constants.hookContext.oAuth2Scopes}}) {
      return request;
    }

    const scopes = hookCtx.{{constants.hookContext.oAuth2Scopes}};
    const credentials = await this.getCredentials(hookCtx.{{constants.hookContext.resolvedSecurity}});
    if (!credentials) {
      return request;
    }

    const ownerKey = this.getSessionOwnerKey(credentials);
    let session = this.store.getSession(ownerKey, scopes);

    if (!session) {
      session = await this.obtainToken(credentials, scopes);

      this.store.storeSession(ownerKey, scopes, session);
    }

    request.headers.set("Authorization", `Bearer ${session.token}`);

    return request;
  }

  async afterError(
    hookCtx: AfterErrorContext,
    response: Response | null,
    error: unknown,
  ): Promise<{ response: Response | null; error: unknown }> {
    if (error || !hookCtx.{{constants.hookContext.oAuth2Scopes}}) {
      return { response, error };
    }

    const scopes = hookCtx.{{constants.hookContext.oAuth2Scopes}};
    const credentials = await this.getCredentials(hookCtx.{{constants.hookContext.resolvedSecurity}});
    if (!credentials) {
      return { response, error };
    }

    const ownerKey = this.getSessionOwnerKey(credentials);
    if (response && response?.status === 401) {
      this.store.deleteSession(ownerKey, scopes);
    }

    return { response, error };
  }

  private async obtainToken(credentials: Credentials, scopes: string[]): Promise<OAuth2Session> {
    const body = [
      encodeBodyForm("grant_type", "password"),
      encodeBodyForm("username", credentials.{{constants.credentials.username}}),
      encodeBodyForm("password", credentials.{{constants.credentials.password}}),
      credentials.{{constants.credentials.clientID}} ? encodeBodyForm("client_id", credentials.{{constants.credentials.clientID}}) : null,
      credentials.{{constants.credentials.clientSecret}} ? encodeBodyForm("client_secret", credentials.{{constants.credentials.clientSecret}}) : null,
      scopes.length ? encodeBodyForm("scope", scopes.join(" ")) : null,
    ].filter(Boolean).join("&");

    const tokenURL = new URL(credentials.{{constants.credentials.tokenURL}} ?? "", this.baseURL ?? "");

    const request = new Request(tokenURL, {
      method: "POST",
      headers: {
        "Content-Type": "application/x-www-form-urlencoded",
      },
      body,
    });

    if (this.client == null) {
      throw new Error("Cannot make OAuth2 token request: HTTP client unavailable");
    }

    const res = await this.client.request(request);

    if (!res.ok) {
      {{- addErrorTypeImport getDefaultErrorClassName "hooks" }}
      throw new {{getDefaultErrorClassName}}(
        "Unexpected response for OAuth2 token request",
        { request, response: res, body: await res.text() },
      );
    }

    if (res.headers.get("content-type") !== "application/json") {
      {{- addErrorTypeImport getDefaultErrorClassName "hooks" }}
      throw new {{getDefaultErrorClassName}}(
        "OAuth2 token response was not \"application/json\"",
        { request, response: res, body: await res.text() },
      );
    }

    const data = await res.json();
    if (!data || typeof data !== "object") {
      throw new Error(`Unexpected response format: ${typeof data}`);
    }

    const tokenType = data.token_type?.toLowerCase()
    if (tokenType && tokenType !== "bearer") {
      throw new Error(`Unexpected token type: ${tokenType}`);
    }

    let expiresAt: number | undefined;
    if (typeof data.expires_in  === "number") {
      expiresAt = Date.now() + data.expires_in * 1000;
    }

    return {
      token: data.access_token,
      expiresAt: expiresAt ?? 0,
      scopes: scopes,
    };
  }

  private async getCredentials(
    source?: SecurityState | null | undefined,
  ): Promise<Credentials | null> {
    if (source?.oauth2.type !== "password") {
      return null;
    }

    return source.oauth2;
  }

  private getSessionOwnerKey(credentials: Credentials): string {
    const entries = [
      ["{{constants.credentials.clientID}}", credentials.{{constants.credentials.clientID}} || ""],
      ["{{constants.credentials.clientSecret}}", credentials.{{constants.credentials.clientSecret}} || ""],
      ["{{constants.credentials.username}}", credentials.{{constants.credentials.username}}],
      ["{{constants.credentials.password}}", credentials.{{constants.credentials.password}}],
      ["{{constants.credentials.tokenURL}}", credentials.{{constants.credentials.tokenURL}}],
    ];
    const params = new URLSearchParams(entries).toString();
    return stringToBase64(params);
  }
}
