{{- $op := .Local.Operation -}}
{{- $sdkVar := sanitizeFieldName .Global.AST.MainSDK.Type.Name }}
{{- $coreName := sanitizeCoreSDKName }}
{{- $funcName := sanitizeFuncName $op }}
{{- $args := templateUsageMethodParameters .Local 0 }}
{{- if $args }}
{{-   $args = printf "%s, %s" $sdkVar $args }}
{{- else }}
{{-   $args = $sdkVar }}
{{- end }}
### Standalone function

The standalone function version of this method:

