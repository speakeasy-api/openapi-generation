context.LocalComputed.CertainParameters = "Certain parameters"
context.LocalComputed.TheseParameters = "These parameters"
context.LocalComputed.TheseGlobalValues = "These global values"
context.LocalComputed.Defaults = "defaults"
context.LocalComputed.Them = "them"
context.LocalComputed.Parameters = "parameters"
context.LocalComputed.Are = "are"
if (context.Local.ParameterLen == 1) {
  context.LocalComputed.CertainParameters = "A parameter"
