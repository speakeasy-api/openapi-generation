terraform {
  required_providers {
    {{.Global.Config.PackageName}} = {
      source  = "{{.Global.Config.Author}}/{{.Global.Config.PackageName}}"
      version = "{{or .Global.Config.SDKVersion "0.0.1"}}"
    }
  }
}

provider "{{.Global.Config.PackageName}}" {
{{ templateProviderExample .Global }}
}