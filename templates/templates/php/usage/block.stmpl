{{templateString "usage/init.stmpl" .Local}}

{{- if .Local.Operation -}}
  {{- if .Local.RenderFeature "errors" false}}

try {
{{templateString "usage/call.stmpl" .Local | trim | indentPresent 4}}

{{templateString "usage/result.stmpl" .Local | trim | indentPresent 4}}
{{templateString "usage/errors.stmpl" .Local | trim}}
}
  {{- else}}

{{templateString "usage/call.stmpl" .Local}}
{{templateString "usage/result.stmpl" .Local}}
  {{- end}}
{{- end}}