{{- $testGroup := .Local.TestGroup -}}
{{- $test := .Local.Test -}}
{{- $workflow := $test.Workflow -}}
{{- if $test.Incomplete -}}
{{- addImport "pytest" "" -}}
@pytest.mark.skip(reason="{{templateTestIncompleteMessage $test.Incomplete}}")
{{- end}}
def test_{{sanitizeTestName $testGroup}}_{{sanitizeTestName $test.Name}}():
{{- if $test.Incomplete}}
    pass
{{- else}}
{{- templateTestID $test}}
{{- templateTestEnvVars $test}}
{{- addImport "tests.test_client" "create_test_http_client"}}
    test_http_client = create_test_http_client("{{$test.Name}}")
{{- if $workflow}}
{{range $idx, $step := $workflow.Steps}}
{{- if eq $step.Type "operation"}}
{{templateString "usage/init.stmpl" (dict "Context" $step.UsageContext "Async" false) | indentPresent 4}}
        assert {{templateSDKVarName}} is not None

{{templateString "usage/call.stmpl" (dict "Context" $step.UsageContext "Async" false) | indentPresent 8}}
{{templateAssertions $step.UsageContext | indentPresent 8}}
{{- else}}
{{- if eq $idx 0}}
{{templateWorkflow $workflow $step | indentPresent 4}}
{{- else}}
{{templateWorkflow $workflow $step | indentPresent 8}}
{{- end}}
{{- end}}{{- end}}{{end}}
{{- end}}