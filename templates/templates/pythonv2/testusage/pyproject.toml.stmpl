{{- if eq .Global.Config.PackageManager "uv" }}
[project]
name = "testusage"
version = "0.1.0"
description = "Test usage project"
authors = [{ name = "Speakeasy" }]
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "pylint>=3.2.0",
]

[build-system]
requires = ["setuptools>=80", "wheel"]
build-backend = "setuptools.build_meta"
{{- else }}
[tool.poetry]
name = "testusage"
packages = [{ include = "", from = "." }]
package-mode = false

[tool.poetry.dependencies]
python = "^3.10"
pylint = "^3.2.0"

[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"
{{- end }}
