{{ pythonHttpxImport }}
{{- if .Global.Config.EnvVarPrefix }}
import logging
import os
{{- end }}
from typing import Any, Protocol

class Logger(Protocol):
    def debug(self, msg: str, *args: Any, **kwargs: Any) -> None:
        pass

class NoOpLogger:
    def debug(self, msg: str, *args: Any, **kwargs: Any) -> None:
        pass

def get_body_content(req: httpx.Request) -> str:
    return "<streaming body>" if not hasattr(req, "_content") else str(req.content)

def get_default_logger() -> Logger:
    {{- if .Global.Config.EnvVarPrefix }}
    if os.getenv("{{templateDebugEnvVar}}"):
        logging.basicConfig(level=logging.DEBUG)
        return logging.getLogger("{{ getAbsoluteModuleImport }}")
    {{- end }}
    return NoOpLogger()

