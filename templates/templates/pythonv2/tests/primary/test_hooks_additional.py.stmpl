import os
import platform
import pytest
from openapi.models import shared
from openapi import SDK
from openapi.models.operations import *
from openapi._hooks.oauth2scopes import ClientCredentialsOAuth2Scope, OAuth2Scope
from openapi.types import BaseModel

from .common_helpers import record_test, rand_seq, RequestRecorderClient, HTTPBIN_URL


class _CountModel(BaseModel):
    count: int


def test_hooks_after_response():
    record_test("test-hooks-after-response")

    s = SDK(
        server_url=HTTPBIN_URL,
        security=shared.Security(
            api_key_auth="Token YOUR_API_KEY",
        )
    )

    assert s is not None

    with pytest.raises(Exception, match="validation failed"):
        s.hooks.test_hooks_after_response()


def test_hooks_custom_user_agent():
    record_test("hooks-custom-user-agent")

    s = SDK(server_url=HTTPBIN_URL)

    res = s.hooks.hooks_custom_user_agent()

    assert res.http_meta is not None
    assert res.http_meta.response is not None
    assert res.http_meta.response.status_code == 200
    assert res.custom_user_agent_echo is not None
    headers = res.custom_user_agent_echo.headers
    assert headers["User-Agent"] == f"acme-corp/{{.Global.Config.SDKVersion}} acme-corp/{platform.python_version()}"
    assert headers["X-Test-Gen-Version"] == "{{.Global.Config.GenVersion}}"
    assert headers["X-Test-Doc-Version"] == "{{.Global.Config.DocVersion}}"
    assert headers["X-Test-Init-Sdk-Version"] == "{{.Global.Config.SDKVersion}}"


