def test_after_parse_error_hook_preserves_original_exception_when_unhandled():
    """Hook returns the original exception → caller sees the parser's exception.

    Guards against accidental swallowing. Omits the test-only
    `x-test-after-parse-error` header so the test hook returns the
    original parser exception.
    """
    s = SDK(server_url=HTTPBIN_URL)
    raw = s.methods.with_raw_response.method_get()

    with pytest.raises(Exception) as exc_info:
        raw.parse(to=int)
    assert not isinstance(exc_info.value, RuntimeError) or "parse_error fired" not in str(exc_info.value)


def test_operation_metadata_propagates_to_hook_context():
    """OpenAPI `tags` and `x-` extensions reach the hook context at runtime.

    `hooksOperationMetadata` declares `tags: [hooks]`, a custom
    `x-test-operation-metadata` extension, an `x-test-template-delimiters`
    extension whose value embeds `{{"{{"}} }}` delimiters, and an `x-speakeasy-group`
    directive. The test hook echoes `hook_ctx.tags`, both custom extensions, and
    any `x-speakeasy-*` keys back via response headers, so we can assert the tags
    and custom extensions reach the hook while `x-speakeasy-*` directives are
    filtered out.

    The `x-test-template-delimiters` value round-trips byte-for-byte: its `{{"{{"}} }}`
    must survive being baked into generated source as a Python literal (escaped
    so the templating engine doesn't re-interpret it) and reach the hook intact.
    """
    record_test("hooks-access-operation-metadata")

    s = SDK(
        server_url=HTTPBIN_URL,
        security=shared.Security(
            api_key_auth="Token YOUR_API_KEY",
        ),
    )

    res = s.hooks.hooks_operation_metadata()

    assert res.http_meta is not None
    assert res.http_meta.response is not None
    headers = res.http_meta.response.headers
    assert headers.get("x-test-tags") == "hooks"
    assert headers.get("x-test-extension") == "visibility-internal"
    # An extension value containing `{{"{{"}} }}` templating delimiters must round-trip
    # byte-for-byte: escaped into the generated literal, never re-interpreted.
    assert headers.get("x-test-template-delimiters") == "use {{"{{"}}token}} in the header"
    # x-speakeasy-* codegen directives must not leak into the hook context.
    assert headers.get("x-test-speakeasy-keys") == "none"


def test_operation_metadata_threads_through_hook_context_subclasses():
    """`tags` and `extensions` round-trip from `HookContext` into subclasses.

    Pure construction test (no network): locks the threading edits in
    `types.py.stmpl` independently of the runtime hook path.
    """
    from openapi._hooks.types import (
        HookContext,
        ResponseContext,
        BeforeRequestContext,
        AfterSuccessContext,
        AfterErrorContext,
    )

    tags = ["hooks", "internal"]
    extensions = {"x-test-operation-metadata": "visibility-internal"}

    ctx = HookContext(
        config=None,
        base_url="https://example.com",
        operation_id="op",
        oauth2_scopes=None,
        security_source=None,
        tags=tags,
        extensions=extensions,
        response=ResponseContext(),
    )

    assert ctx.tags == tags
    assert ctx.extensions == extensions
    for subclass in (BeforeRequestContext, AfterSuccessContext, AfterErrorContext):
        assert subclass(ctx).tags == tags
        assert subclass(ctx).extensions == extensions

    none_ctx = HookContext(
        config=None,
        base_url="https://example.com",
        operation_id="op",
        oauth2_scopes=None,
        security_source=None,
        tags=None,
        extensions=None,
        response=ResponseContext(),
    )

    assert none_ctx.tags is None
    assert none_ctx.extensions is None
    for subclass in (BeforeRequestContext, AfterSuccessContext, AfterErrorContext):
        assert subclass(none_ctx).tags is None
        assert subclass(none_ctx).extensions is None


def test_hooks_available_oauth2_scopes():
    record_test("hooks-available-oauth2-scopes")

    assert ClientCredentialsOAuth2Scope.READ.value == "read"
    assert OAuth2Scope.MODELS_READ.value == "models:read"

    assert ClientCredentialsOAuth2Scope("write") == ClientCredentialsOAuth2Scope.WRITE
    assert OAuth2Scope("store_manage") == OAuth2Scope.STORE_MANAGE

    with pytest.raises(ValueError):
        OAuth2Scope("unknown")
