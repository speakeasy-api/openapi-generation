def test_hooks_authorization_header_modification():
    record_test("hooks-authorization-header-modification")

    s = SDK(
        server_url=HTTPBIN_URL,
        security=shared.Security(
            api_key_auth="Bearer testToken",
        )
    )

    assert s is not None

    res = s.hooks.authorization_header_modification()

    assert res is not None
    assert res.http_meta is not None
    assert res.http_meta.response is not None
    assert res.http_meta.response.status_code == 200
    assert res.token is not None
    assert res.token.authenticated is True
    assert res.token.token == "testToken modified"


@pytest.mark.asyncio()
async def test_hooks_before_create_request():
    record_test("test-hooks-before-create-request")

    s = SDK(
        server_url=HTTPBIN_URL,
        security=shared.Security(
            api_key_auth="Token YOUR_API_KEY",
        )
    )
    assert s is not None

    res = await s.hooks.test_hooks_before_create_request_paths_async(
        namespace="foo/bar"
    )

    assert res is not None
    assert res.http_meta is not None
    assert res.http_meta.response is not None
    assert res.http_meta.response.status_code == 200

    assert res.res is not None
    assert res.res == TestHooksBeforeCreateRequestPathsRes(
        url=f"{HTTPBIN_URL}/anything/hooks/beforeCreateRequestPaths/foo/bar",
        headers=TestHooksBeforeCreateRequestPathsHeaders(
            old_pathname="/anything/hooks/beforeCreateRequestPaths/foo/bar"
        ),
    )


def test_client_credentials_option_successfully_authenticates():
    record_test("hooks-client-credentials-option-success")

    client = RequestRecorderClient()
    s = SDK(
        server_url=HTTPBIN_URL,
        client=client,
        security=shared.Security(
            client_credentials=shared.SchemeClientCredentials(
                client_id="speakeasy-sdks",
                client_secret="supersecret-" + rand_seq(10),
{{- range $f := collectClientCredentialsAdditionalFields }}
                {{ sanitizeFieldName (originalFieldName $f) }}="",
{{- end }}
            )
        )
    )
    assert s is not None

    res = s.hooks.authenticated_request(request=None)
    assert res is not None
    assert res.http_meta is not None
    assert res.http_meta.response is not None
    assert res.http_meta.response.status_code == 200

    # The requested token is still valid, so it should be reused.
    res = s.hooks.authenticated_request(request=None)
    assert res is not None
    assert res.http_meta is not None
    assert res.http_meta.response is not None
    assert res.http_meta.response.status_code == 200

    # Checking that only a single token request was made
    token_url = "/clientcredentials/token?expires_in=90"
    token_requests = [entry for entry in client.log if
                      entry.request_url.endswith(token_url) and "scope=read+write" in entry.request_body]
    assert len(token_requests) == 1

    # Testing .env var credentials
    os.environ["SPEAKEASY_CLIENT_ID"] = "speakeasy-sdks"
    os.environ["SPEAKEASY_CLIENT_SECRET"] = "supersecret-" + rand_seq(10)
{{- range $f := collectClientCredentialsAdditionalFields }}
    os.environ["{{ templateSecurityEnvVars $f }}"] = "test"
{{- end }}
    s2 = SDK(server_url=HTTPBIN_URL)
    assert s2 is not None

    res2 = s2.hooks.authenticated_request(request=None)
    assert res2 is not None
    assert res2.http_meta is not None
    assert res2.http_meta.response is not None
    assert res2.http_meta.response.status_code == 200
    os.environ.pop("SPEAKEASY_CLIENT_ID", None)
    os.environ.pop("SPEAKEASY_CLIENT_SECRET", None)
{{- range $f := collectClientCredentialsAdditionalFields }}
    os.environ.pop("{{ templateSecurityEnvVars $f }}", None)
{{- end }}


def test_client_credentials_option_successfully_authenticates_with_alt_token_url():
    record_test("hooks-client-credentials-option-success-alt-token-url")

    client = RequestRecorderClient()
    token_url = "/clientcredentials/alt/token"
    s = SDK(
        server_url=HTTPBIN_URL,
        client=client,
        security=shared.Security(
            client_credentials=shared.SchemeClientCredentials(
                client_id="speakeasy-sdks",
                client_secret="supersecret-" + rand_seq(10),
                token_url=token_url,
                scopes=["alt:one", ClientCredentialsOAuth2Scope.ALT_TWO],
{{- range $f := collectClientCredentialsAdditionalFields }}
                {{ sanitizeFieldName (originalFieldName $f) }}="",
{{- end }}
            )
        )
    )
    assert s is not None

    res = s.hooks.authenticated_request(request=None)
    assert res is not None
    assert res.http_meta is not None
    assert res.http_meta.response is not None
    assert res.http_meta.response.status_code == 200

    # The token received is already expired so another one should be requested.
    res = s.hooks.authenticated_request(request=None)
    assert res is not None
    assert res.http_meta is not None
    assert res.http_meta.response is not None
    assert res.http_meta.response.status_code == 200

    token_requests = [
        entry for entry in client.log if
        (
            entry.request_url.endswith(token_url) and
         "scope=alt%3Aone+alt%3Atwo" in entry.request_body
        )
    ]
    assert len(token_requests) == 2


def test_response_mode_propagates_to_after_error_hook():
    """`HookContext.response.mode` reaches `AfterErrorHook` for all three modes.

    The test hook echoes `hook_ctx.response.mode` back via the
    `x-test-response-mode` header on its substitute response (only for
    `statusGetDefaultError` 418 case).
    """
    s = SDK()

    res = s.errors.status_get_default_error(status_code=418)
    assert res.http_meta.response.headers.get("x-test-response-mode") == "parsed"

    raw = s.errors.with_raw_response.status_get_default_error(status_code=418)
    assert raw.http_response.headers.get("x-test-response-mode") == "raw"

    with s.errors.with_streaming_response.status_get_default_error(
        status_code=418
    ) as streamed:
        assert streamed.http_response.headers.get("x-test-response-mode") == "streaming"


def test_after_parse_error_hook_fires_eagerly_for_raw_response():
    """4XX via `with_raw_response` runs the parser eagerly at the request call,
    so `after_parse_error` fires there — not on a deferred `.parse()`."""
    s = SDK()
    with pytest.raises(RuntimeError, match=r"parse_error fired mode=raw"):
        s.errors.with_raw_response.get_malformed_error_response(
            status_code=400,
            shape="malformed-json",
            http_headers={"x-test-after-parse-error": "true"},
        )


def test_after_error_hook_fires_eagerly_for_raw_response():
    """`after_error` fires for a 4XX via `with_raw_response`; its substituted
    error preempts the parser and raises at the request call."""
    s = SDK()
    with pytest.raises(RuntimeError, match=r"error fired mode=raw"):
        s.errors.with_raw_response.get_malformed_error_response(
            status_code=400,
            shape="malformed-json",
            http_headers={"x-test-after-error": "true"},
        )


def test_after_parse_error_hook_fires_for_raw_parse_time_failure():
    """A non-error (200) body that fails typed parsing fires `after_parse_error`
    when the caller invokes `.parse()` — the eager 4XX path doesn't touch 2xx."""
    s = SDK()
    raw = s.errors.with_raw_response.get_malformed_error_response(
        status_code=200,
        shape="wrong-type",
        http_headers={"x-test-after-parse-error": "true"},
    )
    with pytest.raises(RuntimeError, match=r"parse_error fired mode=raw"):
        raw.parse(to=_CountModel)


def test_after_parse_error_hook_fires_for_parsed_default_call():
    """`AfterParseErrorHook` fires for the default (non-raw) call path with `mode=parsed`.

    Locks `method.py.stmpl`'s direct `_speakeasy_parse_response(http_res_)`
    try/except wrap. Uses the malformed-error endpoint to force a real parse
    failure.
    """
    s = SDK()
    with pytest.raises(RuntimeError, match=r"parse_error fired mode=parsed"):
        s.errors.get_malformed_error_response(
            status_code=400,
            shape="malformed-json",
            http_headers={"x-test-after-parse-error": "true"},
        )


@pytest.mark.asyncio()
async def test_after_parse_error_hook_fires_eagerly_for_async_raw_response():
    """Async variant: parser runs eagerly, `after_parse_error` fires at the
    request call via native `AsyncSDKHooks.after_parse_error`."""
    async with SDK() as s:
        with pytest.raises(
            RuntimeError,
            match=r"async parse_error fired mode=raw execution=async",
        ):
            await s.errors.with_raw_response.get_malformed_error_response_async(
                status_code=400,
                shape="malformed-json",
                http_headers={"x-test-after-parse-error": "true"},
            )


@pytest.mark.asyncio()
async def test_after_error_hook_fires_eagerly_for_async_raw_response():
    """Async `after_error` fires for a 4XX via `with_raw_response`."""
    async with SDK() as s:
        with pytest.raises(RuntimeError, match=r"error fired mode=raw"):
            await s.errors.with_raw_response.get_malformed_error_response_async(
                status_code=400,
                shape="malformed-json",
                http_headers={"x-test-after-error": "true"},
            )


def test_after_parse_error_hook_fires_eagerly_for_streaming_response():
    """4XX via `with_streaming_response` raises on context entry (eager parse)."""
    s = SDK()
    with pytest.raises(RuntimeError, match=r"parse_error fired mode=streaming"):
        with s.errors.with_streaming_response.get_malformed_error_response(
            status_code=400,
            shape="malformed-json",
            http_headers={"x-test-after-parse-error": "true"},
        ):
            pass


def test_after_error_hook_fires_eagerly_for_streaming_response():
    """`after_error` fires for a 4XX via `with_streaming_response`."""
    s = SDK()
    with pytest.raises(RuntimeError, match=r"error fired mode=streaming"):
