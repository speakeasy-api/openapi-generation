{{- $context := .Local.Context -}}
{{- $isAsync := .Local.Async -}}
{{- $responseFormat := getResponseFormat -}}
{{- $resFieldName := sanitizeFieldName (getResponseFieldName $context.Operation "eventstream") -}}
{{if $isAsync}}async {{end}}with {{getResponseVariableName .Local.StepID}}{{if and (not (eq $responseFormat "flat")) $resFieldName}}.{{$resFieldName}}{{end}} as event_stream:
    {{if $isAsync}}async {{end}}for event in event_stream:
        # handle event
        print(event, flush=True)