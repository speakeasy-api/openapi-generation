package hooks

{{genImports}}

type oAuth2PasswordHook struct {
	// HTTP client for sending OAuth2 HTTP requests.
	client HTTPClient

	// OAuth2 session storage
	sessionStore *utils.OAuth2SessionStore
}

var (
	_ sdkInitHook       = (*oAuth2PasswordHook)(nil)
	_ beforeRequestHook = (*oAuth2PasswordHook)(nil)
	_ afterErrorHook    = (*oAuth2PasswordHook)(nil)
)

func NewOAuth2PasswordHook() *oAuth2PasswordHook {
	return &oAuth2PasswordHook{
		sessionStore: utils.NewOAuth2SessionStore(),
	}
}

{{if .Global.Config.SDKHooksConfigAccess}}
func (h *oAuth2PasswordHook) SDKInit(config config.SDKConfiguration) config.SDKConfiguration {
	h.client = config.Client
	return config
}
{{else}}
func (h *oAuth2PasswordHook) SDKInit(baseURL string, client HTTPClient) (string, HTTPClient) {
	h.client = client
	return baseURL, client
}
{{end}}

func (h *oAuth2PasswordHook) BeforeRequest(ctx BeforeRequestContext, req *http.Request) (*http.Request, error) {
	if ctx.OAuth2Scopes == nil {
		// OAuth2 not in use
		return req, nil
	}

	credentials, err := h.getCredentials(ctx.HookContext, ctx.SecuritySource)

	if err != nil {
		return nil, &FailEarly{Cause: err}
	}

	if credentials == nil {
		return req, err
	}

	if accessTokenCredentials, ok := credentials.(*utils.OAuth2AccessTokenCredentials); ok {
		req.Header.Set("Authorization", "Bearer "+accessTokenCredentials.AccessToken)

		return req, nil
	}

	session, err := h.sessionStore.GetSession(ctx.Context, h.client, credentials, ctx.OAuth2Scopes)

	if err != nil {
		return nil, err
	}

	req.Header.Set("Authorization", "Bearer "+session.AccessToken)

	return req, nil
}

func (h *oAuth2PasswordHook) AfterError(ctx AfterErrorContext, res *http.Response, err error) (*http.Response, error) {
	if ctx.OAuth2Scopes == nil {
		// OAuth2 not in use
		return res, err
	}

	// We don't want to refresh the token if the error is not related to the token
	if err != nil {
		return res, err
	}

	credentials, err := h.getCredentials(ctx.HookContext, ctx.SecuritySource)

	if err != nil {
		return nil, &FailEarly{Cause: err}
	}

	if credentials == nil || credentials.GrantType() == "access_token" {
		return res, nil
	}

	if res != nil && res.StatusCode == http.StatusUnauthorized {
		h.sessionStore.DeleteCredentialsSession(credentials)
	}

	return res, err
}

func (h *oAuth2PasswordHook) getCredentials(ctx HookContext, securitySourceFunc func(ctx context.Context) (any, error)) (utils.OAuth2AuthorizationGrantor, error) {
	if securitySourceFunc == nil {
		return nil, nil
	}

	sec, err := securitySourceFunc(ctx.Context)

	if err != nil {
		return nil, err
	}

	{{templateOAuth2PasswordSecurityAccess $credentialAccess | indent 4 | trim }}
}
