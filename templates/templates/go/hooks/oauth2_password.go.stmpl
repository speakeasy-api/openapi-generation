// Returns the absolute URL for the OAuth2 token endpoint.
func (h *oAuth2PasswordHook) tokenEndpoint(baseURL string, tokenURL string) (string, error) {
	u, err := url.Parse(tokenURL)

	if err != nil {
		return "", fmt.Errorf("failed to parse token URL: %w", err)
	}

	if u.IsAbs() {
		return tokenURL, nil
	}
	
	tokenEndpoint, err := url.JoinPath(baseURL, tokenURL)

	if err != nil {
		return "", fmt.Errorf("failed to join base and token URL: %w", err)
	}
	
	return tokenEndpoint, nil
}
