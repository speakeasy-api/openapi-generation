{{- $typeDef := .Local.Type -}}
{{- $outputLocation := .Local.Type.OutputLocation -}}
{{- $className := sanitizeClass .Local.Type $outputLocation true -}}
{{- $classAccessor := substr 0 1 (lower $className) -}}
{{- $dg := .Local.DocGroup -}}
{{- $transformFromAPI := getJQFromAPI .Local.Type -}}
{{- $transformToAPI := getJQToAPI .Local.Type -}}
{{templateComments .Local.Type.Comments $dg $className 0 "type" -}}
type {{$className}} struct {
    {{range .Local.Type.Fields -}}
    {{- $fieldName := sanitizeFieldName .Name -}}
    {{- if .Const -}}
    {{- $fieldName = sanitizePrivateFieldName .Name -}}
    {{- end }}
    {{- $fieldType := sanitizeFieldType . $outputLocation -}}
    {{- templateComments .Comments $dg (printf "%s.%s" $className $fieldName) 1 "field" true -}}
    {{- if eq .Type.Type "request-stream" -}}
    // This field accepts []byte data or io.Reader implementations, such as *os.File.
    {{ else if eq $fieldType "io.ReadCloser" -}}
    // The Close method must be called on this field, even if it is not used, to prevent resource leaks.
    {{ end -}}
    {{- if .Const -}}
    //lint:ignore U1000 accessed via reflection for JSON marshaling
    {{ end -}}
    {{$fieldName}} {{$fieldType}} {{templateAnnotations .}}
    {{end}}
    {{- if .Local.Type.Extensions.Pagination }}
    Next func() (*{{sanitizeClass .Local.Type $outputLocation true}}, error)
    {{- end }}
}
{{- if needsCustomJSONSerialization .Local.Type .Global.Config.RespectRequiredFields -}}{{"\n"}}
func ({{$classAccessor}} {{$className}}) MarshalJSON() ([]byte, error) {
    {{- addImport "utils"}}
    {{- if $transformToAPI }}
    {{ templateTransformToAPI $classAccessor $transformToAPI }}
    {{- else }}
    return utils.MarshalJSON({{$classAccessor}}, "", false);
    {{- end }}
}

func ({{$classAccessor}} *{{$className}}) UnmarshalJSON(data []byte) error {
    {{- addImport "utils"}}
    {{- if $transformFromAPI }}
    {{ templateTransformFromAPI "data" $transformFromAPI }}
    {{- end }}
    if err := utils.UnmarshalJSON(data, &{{$classAccessor}}, "", false, {{templateRequiredFields .Local.Type}}); err != nil {
        return err
    }
    return nil
}
{{end}}
{{range .Local.Type.Fields}}
{{- $fieldName := sanitizeFieldName .Name -}}
{{- $getterName := sanitizeGetterName $fieldName $typeDef.Fields -}}
{{- $optional := or .Optional .Nullable -}}
func ({{$classAccessor}} *{{$className}}) {{$getterName}}() {{sanitizeFieldType . $outputLocation}} {
    {{- if .Const}}
    {{- $isOptionalNullable := and .Nullable .Optional $.Global.Config.NullableOptionalWrapper}}
    {{- if $isOptionalNullable}}
    {{- addImport "optionalnullable"}}
    {{- $innerType := sanitizeType .Type false $outputLocation}}
    {{- $constVal := templateConstValue . $outputLocation true}}
    {{- if eq $constVal "nil"}}
    return optionalnullable.From[{{$innerType}}](nil)
    {{- else}}
    var tmp {{$innerType}} = {{$constVal}}
    return optionalnullable.From[{{$innerType}}](&tmp)
    {{- end}}
    {{- else}}
    return {{templateConstValue . $outputLocation}}
    {{- end}}
    {{- else}}
    if {{$classAccessor}} == nil {
        return {{templateZero .Type $optional $outputLocation}}
    }
    return {{$classAccessor}}.{{sanitizeFieldName .Name}}
    {{- end}}
}
{{ if eq .Type.Type "union" }}
{{ if .Type.Discriminator }}
{{- $parentField := . -}}
{{- $isOptionalNullable := and $parentField.Nullable $parentField.Optional $.Global.Config.NullableOptionalWrapper}}
{{ range sanitizeDiscriminatorGetters $typeDef.Fields $fieldName .Type.Discriminator.Mapping}}
func ({{$classAccessor}} *{{$className}}) {{.Getter}}() {{sanitizeType .Type true $outputLocation false}} {
    {{- if $optional }}
    if v := {{$classAccessor}}.{{$getterName}}(); v != nil {
        {{- if $isOptionalNullable}}
        if actualValue, ok := v.Get(); ok && actualValue != nil {
            return actualValue.{{sanitizeFieldName .Type.Name}}
        }
        return nil
        {{- else}}
        return v.{{sanitizeFieldName .Type.Name}}
        {{- end}}
    }
    return nil
    {{- else }}
    {{- if $isOptionalNullable}}
    if actualValue, ok := {{$classAccessor}}.{{$getterName}}().Get(); ok && actualValue != nil {
        return actualValue.{{sanitizeFieldName .Type.Name}}
    }
    return nil
    {{- else}}
    return {{$classAccessor}}.{{$getterName}}().{{sanitizeFieldName .Type.Name}}
    {{- end}}
    {{- end }}
}
{{ end }}
{{ end }}
{{ end }}
{{end}}
{{- if .Local.Type.EventStreamEnvelope}}
func ({{$classAccessor}} {{$className}}) GetEventEncoding(event string) (string, error) {
    return "{{getEventEncoding .Local.Type}}", nil
}
{{end}}
// #region class-body-{{lower $className}}
// #endregion class-body-{{lower $className}}
