package {{sanitizeModelPackageName .Global.Config.Imports.GetErrorsPath false}}

import (
	"net/http"
)

type ResponseValidationError struct {
	Message     string
	StatusCode  int
	Body        string
	RawResponse *http.Response
	Cause       error
}

var _ error = &ResponseValidationError{}

func NewResponseValidationError(message string, statusCode int, body string, httpRes *http.Response, cause error) *ResponseValidationError {
	return &ResponseValidationError{
		Message:     message,
		StatusCode:  statusCode,
		Body:        body,
		RawResponse: httpRes,
		Cause:       cause,
	}
}

func (e *ResponseValidationError) Error() string {
	return e.Cause.Error()
}

func (e *ResponseValidationError) Unwrap() error {
	return e.Cause
}
