{{- $errorName := getDefaultErrorClassName -}}
package {{sanitizeModelPackageName .Global.Config.Imports.GetErrorsPath false}}

import (
	"fmt"
	"net/http"
)

type {{$errorName}} struct {
	Message     string
	StatusCode  int
	Body        string
	RawResponse *http.Response
}

var _ error = &{{$errorName}}{}

func New{{$errorName}}(message string, statusCode int, body string, httpRes *http.Response) *{{$errorName}} {
	return &{{$errorName}}{
		Message:     message,
		StatusCode:  statusCode,
		Body:        body,
		RawResponse: httpRes,
	}
}

func (e *{{$errorName}}) Error() string {
	body := ""
	if len(e.Body) > 0 {
		body = fmt.Sprintf("\n%s", e.Body)
	}

	return fmt.Sprintf("%s: Status %d%s", e.Message, e.StatusCode, body)
}
