package tests

import (
	"context"
	"os"
	"strings"
	"testing"

	"{{getRootModulePath}}/pkg/models/operations"
	"{{getRootModulePath}}/pkg/models/shared"

	sdk "{{getRootModulePath}}"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

func TestHoistedNoAuthRetain(t *testing.T) {
	recordTest("auth-hoisted-no-auth-retained")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))
	err := s.Auth.NoAuth(context.Background())
	require.NoError(t, err)
}

func TestHoistedBasicAuth(t *testing.T) {
	recordTest("auth-hoisted-basic-auth")

	user := "testUser"
	passwd := "testPass"

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()), sdk.WithSecurity(shared.Security{
		Username: &user,
		Password: &passwd,
	}))
	res, err := s.Auth.BasicAuth(context.Background(), passwd, user)
	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, true, res.Authenticated)

	os.Setenv("SPEAKEASY_USERNAME", "testUser")
	os.Setenv("SPEAKEASY_PASSWORD", "testPass")

	s2 := sdk.New(sdk.WithServerURL(getHTTPBinURL()))
	res2, err2 := s2.Auth.BasicAuth(context.Background(), passwd, user)
	require.NoError(t, err2)
	require.NotNil(t, res2)
	assert.Equal(t, true, res2.Authenticated)

	os.Setenv("SPEAKEASY_USERNAME", "")
	os.Setenv("SPEAKEASY_PASSWORD", "")
}

func TestMultipleMixedOptionsAuth(t *testing.T) {
	recordTest("auth-hoisted-operation-auth-retained")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	err := s.AuthNew.MultipleMixedOptionsAuth(context.Background(), shared.AuthServiceRequestBody{
		BasicAuth: &shared.AuthServiceRequestBodyBasicAuth{
			Username: "testUser",
			Password: "testPass",
		},
	}, operations.MultipleMixedOptionsAuthSecurity{
		BasicAuth: &shared.SchemeBasicAuth{
			Username: "testUser",
			Password: "testPass",
		},
	})
	require.NoError(t, err)
}

func TestAuthenticatedRequest_OperationLevelOAuth2(t *testing.T) {
	recordTest("auth-operation-level-oauth2")

	recorder := NewRequestRecorderClient()
	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()), sdk.WithClient(recorder))
	clientSecret := "supersecret-" + randSeq(10)

	// A token should be requested with 'read', 'write' and 'erase' scopes.
	err := s.Hooks.AuthenticatedRequest(context.Background(), operations.AuthenticatedRequestSecurity{
		ClientID:     "speakeasy-sdks",
		ClientSecret: clientSecret,
	}, nil)
	require.NoError(t, err)

	// This operation requires 'read' and 'write' scopes.
	// The same token should be reused since [read, write, erase] is a superset of [read, write].
	err = s.Hooks.AuthenticatedRequestUnflattened(
		context.Background(),
		operations.AuthenticatedRequestUnflattenedSecurity{
			ClientCredentials: &shared.SchemeClientCredentials{
				ClientID:     "speakeasy-sdks",
				ClientSecret: clientSecret, // Use the same clientSecret for token reuse
			},
		},
		nil,
	)
	require.NoError(t, err)

	// Verify that only a single token was requested
    tokenRequested := false
	for _, entry := range recorder.Log {
		if strings.Contains(entry.RequestURI, "/clientcredentials/token") {
            if tokenRequested {
                assert.Fail(t, "Expected only a single token request")
            }
			tokenRequested = true
			assert.Contains(t, entry.RequestBody, "scope=read+write+erase")
		}
	}
}
