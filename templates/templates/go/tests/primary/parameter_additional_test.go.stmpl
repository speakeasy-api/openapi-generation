package tests

import (
	"context"
	"net/http"
	"strings"
	"testing"

	sdk "{{getRootModulePath}}"
	"{{getRootModulePath}}/pkg/models/operations"
	"{{getRootModulePath}}/pkg/optionalnullable"

	"github.com/stretchr/testify/require"
)

func TestParametersHeaderParamsNil(t *testing.T) {
	recordTest("parameters-header-params-nil")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Parameters.HeaderParamsNil(context.Background(), operations.HeaderParamsNilRequest{
		NullableHeader: nil,
	})

	require.Nil(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.Res)
	require.NotNil(t, res.Res.Headers)

	require.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	for k, v := range res.Res.Headers {
		hdr := strings.ToLower(k)
		if hdr == "optional-header" || hdr == "nullable-header" || hdr == "optional-nullable-header" {
			t.Fatalf("Header should not be present - got %s: %v", k, v)
		}
	}
}

func TestParametersAllowEmptyValueQueryParams(t *testing.T) {
	recordTest("parameters-allow-empty-value")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Parameters.AllowEmptyValueQueryParams(context.Background(), []string{""}, []string{}, optionalnullable.From(sdk.String("")), nil, sdk.String(""))

	require.Nil(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.HTTPMeta)
	require.NotNil(t, res.HTTPMeta.Response)
	require.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Res)
	require.NotNil(t, res.Res.URL)

	expectedURL := getHTTPBinURL() + "/anything/allowEmptyValue?" +
		"arrParam=&nullableStrParam=&numParam=&strParam="
	require.Equal(t, expectedURL, sortQueryParameters(*res.Res.URL))

	res2, err2 := s.Parameters.AllowEmptyValueQueryParams(context.Background(), []string{"a", "b"}, []string{"x", "y"}, optionalnullable.From(sdk.String("nullable")), sdk.Int64(123), sdk.String("test"))

	require.Nil(t, err2)
	require.NotNil(t, res2)
	require.NotNil(t, res2.HTTPMeta)
	require.NotNil(t, res2.HTTPMeta.Response)
	require.Equal(t, http.StatusOK, res2.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res2.Res)
	require.NotNil(t, res2.Res.URL)

	expectedURL2 := getHTTPBinURL() + "/anything/allowEmptyValue?" +
		"arrParam=a&arrParam=b&arrParamOmitEmpty=x&arrParamOmitEmpty=y&" +
		"nullableStrParam=nullable&numParam=123&strParam=test"
	require.Equal(t, expectedURL2, sortQueryParameters(*res2.Res.URL))
}
