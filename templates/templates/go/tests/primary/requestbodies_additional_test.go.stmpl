func TestRequestBodyPostFormOptionalNullable(t *testing.T) {
	recordTest("request-bodies-post-form-optional-nullable")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	str := "hello"
	setRes, err := s.RequestBodies.RequestBodyPostFormOptionalNullable(context.Background(), shared.ObjectWithOptionalNullableField{
		ReqStr:     "base",
		OptNullStr: optionalnullable.From(&str),
	})
	require.NoError(t, err)
	require.NotNil(t, setRes.Res)
	assert.Equal(t, "base", setRes.Res.Form.ReqStr)
	assertFormField(t, "hello", setRes.Res.Form.OptNullStr)

	nullRes, err := s.RequestBodies.RequestBodyPostFormOptionalNullable(context.Background(), shared.ObjectWithOptionalNullableField{
		ReqStr:     "base",
		OptNullStr: optionalnullable.From[string](nil),
	})
	require.NoError(t, err)
	require.NotNil(t, nullRes.Res)
	assert.Equal(t, "base", nullRes.Res.Form.ReqStr)
	assert.Nil(t, nullRes.Res.Form.OptNullStr)

	absentRes, err := s.RequestBodies.RequestBodyPostFormOptionalNullable(context.Background(), shared.ObjectWithOptionalNullableField{ReqStr: "base"})
	require.NoError(t, err)
	require.NotNil(t, absentRes.Res)
	assert.Equal(t, "base", absentRes.Res.Form.ReqStr)
	assert.Nil(t, absentRes.Res.Form.OptNullStr)
}

