func TestRequestBodyPostJSONOptionalNullable(t *testing.T) {
	recordTest("request-bodies-post-json-optional-nullable")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	body := optionalNullableFieldsSet()
	m := map[string]string{"k": "v"}
	decimalStrMap := map[string]*decimal.Big{
		"pi":   types.MustNewDecimalFromString("3.14159265358979344719667586"),
		"none": nil,
	}
	union := shared.CreateOptNullUnionStr("u")
	inner := "innerval"
	obj := shared.OptNullObj{InnerReqStr: "in", InnerOptNullStr: optionalnullable.From(&inner)}
	body.OptNullMap = optionalnullable.From(&m)
	body.OptNullDecimalStrMap = optionalnullable.From(&decimalStrMap)
	body.OptNullUnion = optionalnullable.From(&union)
	body.OptNullObj = optionalnullable.From(&obj)

	setRes, err := s.RequestBodies.RequestBodyPostJSONOptionalNullable(context.Background(), body)
	require.NoError(t, err)
	require.NotNil(t, setRes)
	assert.Equal(t, http.StatusOK, setRes.HTTPMeta.Response.StatusCode)
	require.NotNil(t, setRes.Res)
	setJSON := setRes.Res.JSON
	assert.Equal(t, "base", setJSON.ReqStr)
	assertFormField(t, "opt", setJSON.OptStr)
	assert.Equal(t, "hello", requireOptionalNullableSet(t, setJSON.OptNullStr))
	assert.Equal(t, int64(7), requireOptionalNullableSet(t, setJSON.OptNullInt))
	assert.Equal(t, 1.5, requireOptionalNullableSet(t, setJSON.OptNullNum))
	assert.Equal(t, true, requireOptionalNullableSet(t, setJSON.OptNullBool))
	assert.Equal(t, "8821239038968084", requireOptionalNullableSet(t, setJSON.OptNullBigInt).String())
	assert.Equal(t, "9223372036854775808", requireOptionalNullableSet(t, setJSON.OptNullBigIntStr).String())
	assert.Equal(t, "3.141592653589793", requireOptionalNullableSet(t, setJSON.OptNullDecimal).String())
	assert.Equal(t, "3.14159265358979344719667586", requireOptionalNullableSet(t, setJSON.OptNullDecimalStr).String())
	assert.True(t, requireOptionalNullableSet(t, setJSON.OptNullDateTime).Equal(types.MustTimeFromString("2024-01-02T03:04:05Z")))
	assert.Equal(t, "2024-01-02", requireOptionalNullableSet(t, setJSON.OptNullDate).String())
	assert.Equal(t, shared.OptNullEnumFirst, requireOptionalNullableSet(t, setJSON.OptNullEnum))
	assert.Equal(t, []string{"a"}, requireOptionalNullableSet(t, setJSON.OptNullArr))
	echoedBigArr := requireOptionalNullableSet(t, setJSON.OptNullBigIntStrArr)
	require.Len(t, echoedBigArr, 1)
	assert.Equal(t, "9223372036854775808", echoedBigArr[0].String())
	assert.Equal(t, m, requireOptionalNullableSet(t, setJSON.OptNullMap))
	echoedDecimalStrMap := requireOptionalNullableSet(t, setJSON.OptNullDecimalStrMap)
	require.NotNil(t, echoedDecimalStrMap["pi"])
	assert.Equal(t, "3.14159265358979344719667586", echoedDecimalStrMap["pi"].String())
	assert.Nil(t, echoedDecimalStrMap["none"])
	echoedUnion := requireOptionalNullableSet(t, setJSON.OptNullUnion)
	require.NotNil(t, echoedUnion.Str)
	assert.Equal(t, "u", *echoedUnion.Str)
	echoedObj := requireOptionalNullableSet(t, setJSON.OptNullObj)
	assert.Equal(t, "in", echoedObj.InnerReqStr)
	assert.Equal(t, "innerval", requireOptionalNullableSet(t, echoedObj.InnerOptNullStr))

	// Explicit null: JSON keeps every key with a null value (set and null).
	nullRes, err := s.RequestBodies.RequestBodyPostJSONOptionalNullable(context.Background(), optionalNullableFieldsNull())
	require.NoError(t, err)
	require.NotNil(t, nullRes.Res)
	nullJSON := nullRes.Res.JSON
	assert.Equal(t, "base", nullJSON.ReqStr)
	requireOptionalNullableNull(t, nullJSON.OptNullStr)
	requireOptionalNullableNull(t, nullJSON.OptNullInt)
	requireOptionalNullableNull(t, nullJSON.OptNullNum)
	requireOptionalNullableNull(t, nullJSON.OptNullBool)
	requireOptionalNullableNull(t, nullJSON.OptNullBigInt)
	requireOptionalNullableNull(t, nullJSON.OptNullBigIntStr)
	requireOptionalNullableNull(t, nullJSON.OptNullDecimal)
	requireOptionalNullableNull(t, nullJSON.OptNullDecimalStr)
	requireOptionalNullableNull(t, nullJSON.OptNullDateTime)
	requireOptionalNullableNull(t, nullJSON.OptNullDate)
	requireOptionalNullableNull(t, nullJSON.OptNullEnum)
	requireOptionalNullableNull(t, nullJSON.OptNullArr)
	requireOptionalNullableNull(t, nullJSON.OptNullBigIntStrArr)
	requireOptionalNullableNull(t, nullJSON.OptNullMap)
	requireOptionalNullableNull(t, nullJSON.OptNullDecimalStrMap)
	requireOptionalNullableNull(t, nullJSON.OptNullUnion)
	requireOptionalNullableNull(t, nullJSON.OptNullObj)

	// Absent: every key omitted entirely (neither set nor null).
	absentRes, err := s.RequestBodies.RequestBodyPostJSONOptionalNullable(context.Background(), shared.ObjectWithOptionalNullableFields{ReqStr: "base"})
	require.NoError(t, err)
	require.NotNil(t, absentRes.Res)
	absentJSON := absentRes.Res.JSON
	assert.Equal(t, "base", absentJSON.ReqStr)
	assert.False(t, absentJSON.OptNullStr.IsSet())
	assert.False(t, absentJSON.OptNullInt.IsSet())
	assert.False(t, absentJSON.OptNullArr.IsSet())
	assert.False(t, absentJSON.OptNullMap.IsSet())
	assert.False(t, absentJSON.OptNullObj.IsSet())
	assert.False(t, absentJSON.OptNullUnion.IsSet())
}

func TestRequestBodyPostJSONOptionalNullableBodyAndParam(t *testing.T) {
	recordTest("request-bodies-post-json-optional-nullable-body-and-param")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	// The shared component keeps the tri-state in the JSON body while the
	// deepObject query parameter unwraps to the bare value on the wire.
	bodyVal := "b"
	filterVal := "q"
	setRes, err := s.RequestBodies.RequestBodyPostJSONOptionalNullableBodyAndParam(context.Background(),
		shared.OptionalNullableBodyAndParam{OptNullStr: optionalnullable.From(&bodyVal)},
		&shared.OptionalNullableBodyAndParam{OptNullStr: optionalnullable.From(&filterVal)},
	)
	require.NoError(t, err)
	require.NotNil(t, setRes.Res)
	assert.Equal(t, "b", requireOptionalNullableSet(t, setRes.Res.JSON.OptNullStr))
	assert.Equal(t, "q", setRes.Res.Args["filter[optNullStr]"])

	// Explicit null survives in the JSON body and is omitted from the URL.
	nullRes, err := s.RequestBodies.RequestBodyPostJSONOptionalNullableBodyAndParam(context.Background(),
		shared.OptionalNullableBodyAndParam{OptNullStr: optionalnullable.From[string](nil)},
		&shared.OptionalNullableBodyAndParam{OptNullStr: optionalnullable.From[string](nil)},
	)
	require.NoError(t, err)
	require.NotNil(t, nullRes.Res)
	requireOptionalNullableNull(t, nullRes.Res.JSON.OptNullStr)
	assert.NotContains(t, nullRes.Res.Args, "filter[optNullStr]")
}

func TestOptionalNullableUrlencodedBodyTopLevel(t *testing.T) {
	recordTest("optional-nullable-urlencoded-body")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	// Set: the wrapped body serializes its properties as ordinary form fields.
	name := "widget"
	count := int64(2)
	res, err := s.RequestBodies.OptionalNullableUrlencodedBody(context.Background(),
		optionalnullable.From(&operations.OptionalNullableUrlencodedBodyNullableFormBody{Name: &name, Count: &count}))
	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Res)
	assert.Equal(t, "widget", res.Res.Form["name"])
	assert.Equal(t, "2", res.Res.Form["count"])

	// Explicit null: no fields are sent.
	nullRes, err := s.RequestBodies.OptionalNullableUrlencodedBody(context.Background(),
		optionalnullable.From[operations.OptionalNullableUrlencodedBodyNullableFormBody](nil))
	require.NoError(t, err)
	require.NotNil(t, nullRes.Res)
	assert.Empty(t, nullRes.Res.Form)

	// Unset: no fields are sent.
	unsetRes, err := s.RequestBodies.OptionalNullableUrlencodedBody(context.Background(), nil)
	require.NoError(t, err)
	require.NotNil(t, unsetRes.Res)
	assert.Empty(t, unsetRes.Res.Form)
}
