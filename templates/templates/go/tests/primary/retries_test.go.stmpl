func TestRetriesTimeout(t *testing.T) {
	recordTest("retries-timeout")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Retries.RetriesGet(context.Background(), pseudo_uuid(), sdk.Int64(1000000000), operations.WithRetries(retry.Config{
		Strategy: "backoff",
		Backoff: &retry.BackoffStrategy{
			InitialInterval: 1,
			MaxInterval:     50,
			Exponent:        1.1,
			MaxElapsedTime:  100,
		},
		RetryConnectionErrors: false,
	}))
	assert.Error(t, err)
	assert.Nil(t, res)
	assert.Equal(t, http.StatusServiceUnavailable, err.(*apierrors.APIError).StatusCode)
}

