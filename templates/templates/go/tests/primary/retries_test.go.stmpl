func TestRetriesRetryConnectionErrorsReject(t *testing.T) {
	recordTest("retries-retry-connection-errors-reject")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))
	faultSettings := `{"reject_count": 1}`
	numRetries := int64(2)
	uuid := pseudo_uuid()

	res, err := s.Retries.RetriesGetRetryConnectionErrors(context.Background(), faultSettings, numRetries, uuid, uuid)
	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	assert.NotNil(t, res.Retries)
	assert.EqualValues(t, 2, res.Retries.Retries)
}

