func TestOptionalFalseNullableFalse_Full(t *testing.T) {
	recordTest("object-with-optional-false-nullable-false-full")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	scenario := "full"
	res, err := s.OptionalNullableFields.ObjectWithOptionalFalseNullableFalseField(context.Background(), &scenario)

	require.Nil(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.ObjectWithOptionalFalseNullableFalseField)

	require.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	// Verify ID and Type fields
	require.Equal(t, int64(1), res.ObjectWithOptionalFalseNullableFalseField.GetID())
	require.Equal(t, "mammal", *res.ObjectWithOptionalFalseNullableFalseField.GetType())

	// Verify MedicalRecord is set with a value (required field)
	medicalRecord := res.ObjectWithOptionalFalseNullableFalseField.GetMedicalRecord()
	require.NotNil(t, medicalRecord, "MedicalRecord should not be nil")
	require.Equal(t, "fluffy is sick", *medicalRecord.GetDiagnosis())
