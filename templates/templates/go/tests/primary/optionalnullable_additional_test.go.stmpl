func TestOptionalNullable_Full(t *testing.T) {
	recordTest("object-with-optional-nullable-full")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	scenario := "full"
	res, err := s.OptionalNullableFields.ObjectWithOptionalTrueNullableTrueField(context.Background(), &scenario)

	require.Nil(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.ObjectWithOptionalTrueNullableTrueField)

	require.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	// Verify ID and Type fields
	require.Equal(t, int64(1), res.ObjectWithOptionalTrueNullableTrueField.GetID())
	require.Equal(t, "mammal", *res.ObjectWithOptionalTrueNullableTrueField.GetType())

	// Verify MedicalRecord is set with a value
	medicalRecord := res.ObjectWithOptionalTrueNullableTrueField.GetMedicalRecord()
	require.True(t, medicalRecord.IsSet(), "MedicalRecord should be set")
	require.False(t, medicalRecord.IsNull(), "MedicalRecord should not be null")

	record, ok := medicalRecord.Get()
	require.True(t, ok, "Should be able to get MedicalRecord")
	require.NotNil(t, record, "MedicalRecord should not be nil")
	require.Equal(t, "fluffy is sick", *record.GetDiagnosis())
}

