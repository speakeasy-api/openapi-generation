package tests

import (
	"context"
	"net/http"
	"testing"

    sdk "{{getRootModulePath}}"
	"github.com/stretchr/testify/require"
)


func TestOptionalNullable_Full(t *testing.T) {
	recordTest("object-with-optional-nullable-full")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	scenario := "full"
	res, err := s.OptionalNullableFields.ObjectWithOptionalTrueNullableTrueField(context.Background(), &scenario)

	require.Nil(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.ObjectWithOptionalTrueNullableTrueField)

	require.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	// Verify ID and Type fields
	require.Equal(t, int64(1), res.ObjectWithOptionalTrueNullableTrueField.GetID())
	require.Equal(t, "mammal", *res.ObjectWithOptionalTrueNullableTrueField.GetType())

	// Verify MedicalRecord is set with a value
	medicalRecord := res.ObjectWithOptionalTrueNullableTrueField.GetMedicalRecord()
	require.True(t, medicalRecord.IsSet(), "MedicalRecord should be set")
	require.False(t, medicalRecord.IsNull(), "MedicalRecord should not be null")

	record, ok := medicalRecord.Get()
	require.True(t, ok, "Should be able to get MedicalRecord")
	require.NotNil(t, record, "MedicalRecord should not be nil")
	require.Equal(t, "fluffy is sick", *record.GetDiagnosis())
}

func TestOptionalNullable_MedicalRecordAbsent(t *testing.T) {
	recordTest("object-with-optional-nullable-field-absent")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	scenario := "medicalRecordAbsent"
	res, err := s.OptionalNullableFields.ObjectWithOptionalTrueNullableTrueField(context.Background(), &scenario)

	require.Nil(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.ObjectWithOptionalTrueNullableTrueField)

	require.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	// Verify ID and Type fields
	require.Equal(t, int64(1), res.ObjectWithOptionalTrueNullableTrueField.GetID())
	require.Equal(t, "mammal", *res.ObjectWithOptionalTrueNullableTrueField.GetType())

	// Verify MedicalRecord is NOT set (field is omitted from JSON)
	medicalRecord := res.ObjectWithOptionalTrueNullableTrueField.GetMedicalRecord()
	require.Nil(t, medicalRecord, "MedicalRecord should be nil")
}

func TestOptionalNullable_MedicalRecordNull(t *testing.T) {
	recordTest("object-with-optional-nullable-field-null")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	scenario := "medicalRecordNull"
	res, err := s.OptionalNullableFields.ObjectWithOptionalTrueNullableTrueField(context.Background(), &scenario)

	require.Nil(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.ObjectWithOptionalTrueNullableTrueField)

	require.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	// Verify ID and Type fields
	require.Equal(t, int64(1), res.ObjectWithOptionalTrueNullableTrueField.GetID())
	require.Equal(t, "mammal", *res.ObjectWithOptionalTrueNullableTrueField.GetType())

	// Verify MedicalRecord is set to null (explicitly null in JSON)
	medicalRecord := res.ObjectWithOptionalTrueNullableTrueField.GetMedicalRecord()
	require.True(t, medicalRecord.IsSet(), "MedicalRecord should be set")
	require.True(t, medicalRecord.IsNull(), "MedicalRecord should be explicitly null")

	record, ok := medicalRecord.Get()
	require.True(t, ok, "Should be able to get MedicalRecord (even when null)")
	require.Nil(t, record, "MedicalRecord value should be nil")
}

func TestOptionalFalseNullableTrue_Full(t *testing.T) {
	recordTest("object-with-optional-false-nullable-true-full")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	scenario := "full"
	res, err := s.OptionalNullableFields.ObjectWithOptionalFalseNullableTrueField(context.Background(), &scenario)

	require.Nil(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.ObjectWithOptionalFalseNullableTrueField)

	require.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	// Verify ID and Type fields
	require.Equal(t, int64(1), res.ObjectWithOptionalFalseNullableTrueField.GetID())
	require.Equal(t, "mammal", *res.ObjectWithOptionalFalseNullableTrueField.GetType())

	// Verify MedicalRecord is set with a value (required field, so it's a plain pointer)
	medicalRecord := res.ObjectWithOptionalFalseNullableTrueField.GetMedicalRecord()
	require.NotNil(t, medicalRecord, "MedicalRecord should not be nil")
	require.Equal(t, "fluffy is sick", *medicalRecord.GetDiagnosis())
}

