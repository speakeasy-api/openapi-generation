func TestOptionalFalseNullableTrue_MedicalRecordNull(t *testing.T) {
	recordTest("object-with-optional-false-nullable-true-field-null")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	scenario := "medicalRecordNull"
