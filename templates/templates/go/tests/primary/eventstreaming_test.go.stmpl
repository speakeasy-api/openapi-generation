func TestEventStreamWPTCompliance(t *testing.T) {
	recordTest("event-stream-wpt-compliance")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Eventstreams.WptCompliance(context.Background())
	require.NoError(t, err)
	require.NotNil(t, res)

	defer res.SseEvent.Close()

	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	var actual []shared.SseEvent
	var expected []shared.SseEvent
	for res.SseEvent.Next() {
		ev := res.SseEvent.Value()
		if ev.Event != nil && *ev.Event == "expected" {
			var unescaped string
			require.NoError(t, json.Unmarshal([]byte(ev.Data), &unescaped), "failed to unescape expectations")
			require.NoError(t, json.Unmarshal([]byte(unescaped), &expected), "failed to parse expectations")
		} else {
			actual = append(actual, *ev)
		}
	}
	assert.NoError(t, res.SseEvent.Err())
	require.Greater(t, len(expected), 0, "no expectations received from server")
	assert.Equal(t, expected, actual)
}

