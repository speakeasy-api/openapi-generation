		shared.DifferentDataSchemas{
			ID:    "event-6",
			Data:  shared.CreateDifferentDataSchemasDataFloat32(3.14159),
			Event: shared.EventPrimitive,
		},
	}, events)
}

func TestEventStreamWithMixedData(t *testing.T) {
	recordTest("event-stream-mixed-data")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Eventstreams.MixedData(context.Background())
	require.NoError(t, err)
	require.NotNil(t, res)

	defer res.MixedDataEvent.Close()

	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	events := []shared.MixedDataEvent{}
	for res.MixedDataEvent.Next() {
		events = append(events, *res.MixedDataEvent.Value())
	}
	assert.NoError(t, res.MixedDataEvent.Err())

	assert.Len(t, events, 4)

	// First event: JSON object
	assert.Equal(t, shared.MixedDataEventEventCompletion, events[0].Event)
	assert.NotNil(t, events[0].Data.MessageEvent)
	assert.Equal(t, "Hello world", events[0].Data.MessageEvent.Content)

	// Second event: plain text
	assert.Equal(t, shared.MixedDataEventEventText, events[1].Event)
	assert.NotNil(t, events[1].Data.Str)
	assert.Equal(t, "Processing your request...", *events[1].Data.Str)

	// Third event: plain text
	assert.Equal(t, shared.MixedDataEventEventLoading, events[2].Event)
	assert.NotNil(t, events[2].Data.Str)
	assert.Equal(t, "Almost done", *events[2].Data.Str)

	// Fourth event: JSON object
	assert.Equal(t, shared.MixedDataEventEventCompletion, events[3].Event)
	assert.NotNil(t, events[3].Data.MessageEvent)
	assert.Equal(t, "Done!", events[3].Data.MessageEvent.Content)
}

