func TestEventStreamWithAbortSignal(t *testing.T) {
	recordTest("event-stream-with-abort-signal")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	ctx, cancel := context.WithCancel(context.Background())

	res, err := s.Eventstreams.Text(ctx)
	require.NoError(t, err)
	require.NotNil(t, res)

	defer res.TextEvent.Close()

	chunks := 0
	message := ""
	var abortErr error

	for res.TextEvent.Next() {
		if chunks == 1 {
			cancel()
		}
		event := res.TextEvent.Value()
		message += event.Data
		chunks++
	}
	abortErr = res.TextEvent.Err()

	assert.Equal(t, context.Canceled, abortErr)
	assert.Equal(t, "Hello ", message)
}

func TestEventStreamStayOpenBreakingEarly(t *testing.T) {
	recordTest("event-stream-stay-open-break-early")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Eventstreams.StayOpen(context.Background())
	require.NoError(t, err)
	require.NotNil(t, res)

	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	events := []string{}

	for res.TextEvent.Next() {
		events = append(events, res.TextEvent.Value().Data)
		break
	}
	assert.Len(t, events, 1)

	// In Go, `break` doesn't perform auto-cleanup: stream is still readable
	assert.True(t, res.TextEvent.Next())

	// Manually closing stream
	res.TextEvent.Close()
	assert.False(t, res.TextEvent.Next())
}

