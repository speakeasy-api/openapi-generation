func TestEventStreamLargeEventSmallChunks(t *testing.T) {
	recordTest("event-stream-large-event-small-chunks")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	size := int64(2 * 1024 * 1024)
	res, err := s.Eventstreams.LargeEventSmallChunks(context.Background(), &size)
	require.NoError(t, err)
	require.NotNil(t, res)

	defer res.LargeChunkedEvent.Close()

	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	contents := []string{}
	for res.LargeChunkedEvent.Next() {
		contents = append(contents, res.LargeChunkedEvent.Value().Data.Content)
	}
	require.NoError(t, res.LargeChunkedEvent.Err())

	require.Len(t, contents, 3)
	assert.Equal(t, "start", contents[0])
	assert.Equal(t, "end", contents[2])

	big := contents[1]
	require.Len(t, big, int(size))
	assert.Equal(t, uint8('S'), big[0])
	assert.Equal(t, uint8('E'), big[len(big)-1])
	assert.NotContains(t, big[1:len(big)-1], "b")
	assert.Equal(t, int(size)-2, strings.Count(big, "a"))
}

func TestEventStreamSplitBoundaries(t *testing.T) {
	recordTest("event-stream-split-boundaries")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Eventstreams.SplitBoundaries(context.Background())
	require.NoError(t, err)
	require.NotNil(t, res)

	defer res.SplitBoundaryEvent.Close()

	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	actualTags := []string{}
	expectedTags := []string{}
	for res.SplitBoundaryEvent.Next() {
		ev := res.SplitBoundaryEvent.Value()
		if string(ev.Data.Kind) == "expected" {
			expectedTags = ev.Data.Tags
		} else {
			actualTags = append(actualTags, ev.Data.Tags...)
		}
	}
	require.NoError(t, res.SplitBoundaryEvent.Err())

	assert.Greater(t, len(expectedTags), 0)
	assert.Equal(t, expectedTags, actualTags)
}

// A request timeout must bound the whole stream, not cancel it before the
// caller iterates: with the timeout context handed to the returned stream
// (released on Close), a stream that completes within the deadline is read
// to completion.
func TestEventStreamWithTimeoutStreamsToCompletion(t *testing.T) {
	recordTest("event-stream-with-timeout-streams-to-completion")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()), sdk.WithTimeout(30*time.Second))

	res, err := s.Eventstreams.JSON(context.Background())
	require.NoError(t, err)
	require.NotNil(t, res)
	defer res.JSONEvent.Close()

	message := ""
	for res.JSONEvent.Next() {
		message += res.JSONEvent.Value().Data.Content
	}
	require.NoError(t, res.JSONEvent.Err())
	assert.Equal(t, "Hello world!", message)
}

// The per-operation timeout is honoured the same way.
func TestEventStreamWithOperationTimeoutStreamsToCompletion(t *testing.T) {
	recordTest("event-stream-with-operation-timeout-streams-to-completion")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Eventstreams.JSON(context.Background(), operations.WithOperationTimeout(30*time.Second))
	require.NoError(t, err)
	require.NotNil(t, res)
	defer res.JSONEvent.Close()

	count := 0
	for res.JSONEvent.Next() {
		count++
	}
	require.NoError(t, res.JSONEvent.Err())
	assert.Equal(t, 4, count)
}

// The deadline still applies to the whole stream: a stream that stalls past
// the timeout ends with a deadline error instead of hanging.
func TestEventStreamTimeoutStillBoundsSlowStream(t *testing.T) {
	recordTest("event-stream-timeout-still-bounds-slow-stream")

	slow := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "text/event-stream")
		w.WriteHeader(http.StatusOK)
		fmt.Fprint(w, "data: {\"data\":{\"content\":\"first\"}}\n\n")
		if f, ok := w.(http.Flusher); ok {
			f.Flush()
		}
		select {
		case <-r.Context().Done():
		case <-time.After(20 * time.Second):
		}
	}))
	defer slow.Close()

	s := sdk.New(sdk.WithTimeout(2 * time.Second))

	res, err := s.Eventstreams.JSON(context.Background(), operations.WithServerURL(slow.URL))
	require.NoError(t, err)
	require.NotNil(t, res)
	defer res.JSONEvent.Close()

	start := time.Now()
	count := 0
	for res.JSONEvent.Next() {
		count++
	}
	assert.Equal(t, 1, count, "the first event arrives before the deadline")
	require.Error(t, res.JSONEvent.Err(), "the stalled stream must end with the deadline error")
	assert.ErrorIs(t, res.JSONEvent.Err(), context.DeadlineExceeded)
	assert.Less(t, time.Since(start), 15*time.Second, "the deadline must cut the stalled stream short")
}

func decodeRawEvent(se []byte) (map[string]json.RawMessage, error) {
	var event map[string]json.RawMessage
	if err := json.Unmarshal(se, &event); err != nil {
		return nil, err
	}
	return event, nil
}

func countingCancel(cancel context.CancelFunc, releases *atomic.Int32) context.CancelFunc {
	return func() {
		releases.Add(1)
		cancel()
	}
}

func TestEventStreamNextAfterEOFStaysFinished(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
	defer cancel()

	var releases atomic.Int32
	es := stream.NewEventStream(ctx, strings.NewReader("data: {\"content\":\"first\"}\n\n"), decodeRawEvent, "", stream.WithCancel[map[string]json.RawMessage](countingCancel(cancel, &releases)))

	require.True(t, es.Next())
	require.False(t, es.Next())
	require.NoError(t, es.Err())
	assert.ErrorIs(t, ctx.Err(), context.Canceled, "the owned context is released at EOF")

	require.False(t, es.Next())
	require.NoError(t, es.Err(), "Next after EOF must not surface the released context")
	require.NoError(t, es.Close())
	require.NoError(t, es.Err())
	assert.EqualValues(t, 1, releases.Load(), "the owned cancel runs exactly once")
}

// signalReadCloser closes started on its first Read, before delegating to the
// wrapped reader, so a test knows the consumer is inside a blocking Read
// rather than merely scheduled.
type signalReadCloser struct {
	io.ReadCloser
	started chan struct{}
	once    sync.Once
}

func (sr *signalReadCloser) Read(p []byte) (int, error) {
	sr.once.Do(func() { close(sr.started) })
	return sr.ReadCloser.Read(p)
}

func TestEventStreamCloseWhileNextBlocked(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
	defer cancel()

	pr, pw := io.Pipe()
	defer pw.Close()

	// The signal fires from inside the consuming goroutine's first Read, so
	// Close below always races with a Next that is already committed to the
	// blocking read, never with one that has not started yet.
	started := make(chan struct{})
	src := &signalReadCloser{ReadCloser: pr, started: started}

	var releases atomic.Int32
	es := stream.NewEventStream(ctx, src, decodeRawEvent, "", stream.WithCancel[map[string]json.RawMessage](countingCancel(cancel, &releases)))

	var wg sync.WaitGroup
	wg.Add(1)
	go func() {
		defer wg.Done()
		for es.Next() {
		}
	}()

	<-started
	require.NoError(t, es.Close())
	wg.Wait()

	assert.ErrorIs(t, ctx.Err(), context.Canceled)
	assert.EqualValues(t, 1, releases.Load(), "the owned cancel runs exactly once")
	require.False(t, es.Next())
}
