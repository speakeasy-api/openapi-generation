func TestEventStreamChatHeartbeat(t *testing.T) {
	recordTest("event-stream-chat-heartbeat-skips-dataless")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Eventstreams.ChatHeartbeat(context.Background())
	require.NoError(t, err)
	require.NotNil(t, res)

	defer res.ChatCompletionEvent.Close()

	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	events := []shared.ChatCompletionEvent{}
	for res.ChatCompletionEvent.Next() {
		events = append(events, *res.ChatCompletionEvent.Value())
	}
	assert.NoError(t, res.ChatCompletionEvent.Err())

	// Server sends: data("Hello1"), heartbeat (skipped), data("Hello 2"), data("!"), [DONE]
	assert.Len(t, events, 3)

	assert.Equal(t, []shared.ChatCompletionEvent{
		{Data: shared.ChatCompletionEventData{Content: "Hello1"}},
		{Data: shared.ChatCompletionEventData{Content: "Hello 2"}},
		{Data: shared.ChatCompletionEventData{Content: "!"}},
	}, events)
}

