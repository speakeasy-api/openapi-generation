		},
		shared.DifferentDataSchemas{
			ID: "event-3",
			Data: shared.CreateDifferentDataSchemasDataMessageEvent(shared.MessageEvent{
				Content: "Have a great day!",
			}),
			Event: shared.EventMessage,
		},
		shared.DifferentDataSchemas{
			ID:    "event-4",
