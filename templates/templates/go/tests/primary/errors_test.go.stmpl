func TestStatusGetError_DefaultErrorCodes(t *testing.T) {
	recordTest("errors-status-get-error-default-error-codes")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	// When `clientServerStatusCodesAsErrors: true` is set (default), 4XX and 5XX ranges
	// are automatically treated as errors.

	// 400 and 500 responses are explicitly defined
	res, err := s.Errors.StatusGetError(context.Background(), 400)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, "API error occurred: Status 400", err.Error())

	var sdkErr *apierrors.APIError
	if assert.ErrorAs(t, err, &sdkErr) {
		assert.Equal(t, 400, sdkErr.StatusCode)
		assert.Equal(t, 400, sdkErr.RawResponse.StatusCode)
	}

	res, err = s.Errors.StatusGetError(context.Background(), 500)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, "API error occurred: Status 500", err.Error())

	if assert.ErrorAs(t, err, &sdkErr) {
		assert.Equal(t, 500, sdkErr.StatusCode)
		assert.Equal(t, 500, sdkErr.RawResponse.StatusCode)
	}

	// 404 and 503 responses are undefined but still treated as errors by default
	res, err = s.Errors.StatusGetError(context.Background(), 404)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, "API error occurred: Status 404", err.Error())

	res, err = s.Errors.StatusGetError(context.Background(), 503)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, "API error occurred: Status 503", err.Error())
}

func TestStatusGetError_300_NonError(t *testing.T) {
	recordTest("errors-status-get-error300-non-error")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Errors.StatusGetError(context.Background(), 300)
	assert.NoError(t, err)
	assert.Equal(t, 300, res.HTTPMeta.Response.StatusCode)
}

func TestStatusGetErrorXSpeakeasyErrors(t *testing.T) {
	recordTest("errors-status-get-error-x-speakeasy-errors")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	// 400 response is explicitly defined and is marked as an error in `x-speakeasy-errors`
	res, err := s.Errors.StatusGetXSpeakeasyErrors(context.Background(), 400)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, "API error occurred: Status 400\n{\"message\":\"an error occurred\",\"code\":\"400\",\"type\":\"internal\"}\n", err.Error())

	var sdkErr *apierrors.APIError
	if assert.ErrorAs(t, err, &sdkErr) {
		assert.Equal(t, 400, sdkErr.StatusCode)
		assert.Equal(t, 400, sdkErr.RawResponse.StatusCode)
	}

	// 401 response is undefined but it is marked as an error in `x-speakeasy-errors`
	res, err = s.Errors.StatusGetXSpeakeasyErrors(context.Background(), 401)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, "API error occurred: Status 401\n{\"message\":\"an error occurred\",\"code\":\"401\",\"type\":\"internal\"}\n", err.Error())

	if assert.ErrorAs(t, err, &sdkErr) {
		assert.Equal(t, 401, sdkErr.StatusCode)
		assert.Equal(t, 401, sdkErr.RawResponse.StatusCode)
	}

	// 402 response is undefined and is not treated as an API error since it's not listed in `x-speakeasy-errors`.
	// Instead we raise a "unknown status code received" exception.
	res, err = s.Errors.StatusGetXSpeakeasyErrors(context.Background(), 402)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, "unknown status code returned: Status 402\n{\"message\":\"an error occurred\",\"code\":\"402\",\"type\":\"internal\"}\n", err.Error())

	if assert.ErrorAs(t, err, &sdkErr) {
		assert.Equal(t, 402, sdkErr.StatusCode)
		assert.Equal(t, 402, sdkErr.RawResponse.StatusCode)
	}

	// Both 500 and 501 responses are marked as errors since `5XX` is listed `x-speakeasy-errors`.
	res, err = s.Errors.StatusGetXSpeakeasyErrors(context.Background(), 500)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, "an error occurred", err.Error())

	var e *apierrors.Error
	if assert.ErrorAs(t, err, &e) {
		assert.Equal(t, "500", *e.Code)
	}

	res, err = s.Errors.StatusGetXSpeakeasyErrors(context.Background(), 501)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, `{"code":"501","message":"an error occurred","type":"internal"}`, err.Error())

	var e501 *apierrors.StatusGetXSpeakeasyErrorsResponseBody
	if assert.ErrorAs(t, err, &e501) {
		assert.Equal(t, "501", *e501.Code)
		assert.Equal(t, 501, e501.HTTPMeta.Response.StatusCode)
	}
}

func TestStatusGetSuccessXSpeakeasyErrorsEmptyStatusCodeList(t *testing.T) {
	recordTest("errors-status-get-error-x-speakeasy-errors-none")

	s := sdk.New()

	// `x-speakeasy-errors` overrides the `clientServerStatusCodesAsErrors` setting
	// with a dummy list, meaning all responses are treated as non-errors.

	res, err := s.Errors.StatusGetNonError(context.Background(), 200)
	assert.NoError(t, err)
	assert.Equal(t, 200, res.HTTPMeta.Response.StatusCode)

	res, err = s.Errors.StatusGetNonError(context.Background(), 400)
	assert.NoError(t, err)
	assert.Equal(t, 400, res.HTTPMeta.Response.StatusCode)

	res, err = s.Errors.StatusGetNonError(context.Background(), 500)
	assert.NoError(t, err)
	assert.Equal(t, 500, res.HTTPMeta.Response.StatusCode)
}

func TestStatusGetSuccessXSpeakeasyErrorsUnspecifiedResponses(t *testing.T) {
	recordTest("errors-status-get-error-x-speakeasy-errors-default")

	s := sdk.New()

	// `x-speakeasy-errors` overrides the `clientServerStatusCodesAsErrors` setting
	// by marking all *unspecified* responses as errors.

	// 200 and 400 responses are explicitly defined, so they are treated as non-errors.
	res, err := s.Errors.StatusGetDefaultError(context.Background(), 200)
	assert.NoError(t, err)
	assert.Equal(t, 200, res.HTTPMeta.Response.StatusCode)

	res, err = s.Errors.StatusGetDefaultError(context.Background(), 400)
	assert.NoError(t, err)
	assert.Equal(t, 400, res.HTTPMeta.Response.StatusCode)

	// 404 and 500 responses are undefined, so they are treated as errors.
	res, err = s.Errors.StatusGetDefaultError(context.Background(), 404)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, "API error occurred: Status 404", err.Error())

	res, err = s.Errors.StatusGetDefaultError(context.Background(), 500)
	assert.Nil(t, res)
	assert.Error(t, err)
	assert.Equal(t, "API error occurred: Status 500", err.Error())

	// To make sure the catch-all "default" code gets properly applied in `templateErrorStatusCodesCheck`,
	// an AfterError hook was added to Hooks/TestHook.go to recover from 418 error.
	res, err = s.Errors.StatusGetDefaultError(context.Background(), 418)
	assert.NoError(t, err)
	assert.Equal(t, 200, res.HTTPMeta.Response.StatusCode)
}

func TestConnectionErrorGet(t *testing.T) {
	recordTest("errors-connection-error")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Errors.ConnectionErrorGet(context.Background())
	assert.Error(t, err)
	assert.ErrorContains(t, err, "error sending request: Get \"http://somebrokenapi.broken/anything/connectionError\": dial tcp: lookup somebrokenapi.broken")
	assert.Nil(t, res)
}

func TestUnionOfErrors(t *testing.T) {
	recordTest("errors-union-of-errors")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	req1 := operations.CreateErrorUnionPostRequestBodyErrorType1RequestBody(
		operations.ErrorType1RequestBody{Error: "Error1"},
	)
	res1, err1 := s.Errors.ErrorUnionPost(context.Background(), req1)
	assert.Nil(t, res1)
	assert.Error(t, err1)
	assert.Equal(t, "{\"error\":\"Error1\"}", err1.Error())

	req2 := operations.CreateErrorUnionPostRequestBodyErrorType2RequestBody(
		operations.ErrorType2RequestBody{
			ErrorType2Message: &operations.ErrorType2Message{Message: "Error2"},
		},
	)
	res2, err2 := s.Errors.ErrorUnionPost(context.Background(), req2)
	assert.Nil(t, res2)
	assert.Error(t, err2)
	assert.Equal(t, "{\"error\":{\"message\":\"Error2\"}}", err2.Error())
}

func TestUnionOfErrorsDiscriminated(t *testing.T) {
	recordTest("errors-union-of-errors-discriminated")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	req1 := operations.CreateErrorUnionDiscriminatedPostRequestBodyTaggedError1RequestBody(
		operations.TaggedError1RequestBody{Error: "Error1", Tag: "tag1"},
	)
	res1, err1 := s.Errors.ErrorUnionDiscriminatedPost(context.Background(), req1)
	assert.Nil(t, res1)
	assert.Error(t, err1)
	assert.Equal(t, "{\"error\":\"Error1\",\"tag\":\"tag1\"}", err1.Error())

	req2 := operations.CreateErrorUnionDiscriminatedPostRequestBodyTaggedError2RequestBody(
		operations.TaggedError2RequestBody{
			Tag:                 "tag2",
			TaggedError2Message: operations.TaggedError2Message{Message: "Error2"},
		},
	)
	res2, err2 := s.Errors.ErrorUnionDiscriminatedPost(context.Background(), req2)
	assert.Nil(t, res2)
	assert.Error(t, err2)
	assert.Equal(t, "{\"error\":{\"message\":\"Error2\"},\"tag\":\"tag2\"}", err2.Error())
}

func TestErrorUnionRedecodePreservesHTTPMeta(t *testing.T) {
	t.Run("discriminated", func(t *testing.T) {
		var u apierrors.ErrorUnionDiscriminatedPostResponseBody
		require.NoError(t, json.Unmarshal([]byte(`{"tag":"tag1","error":"Error1"}`), &u))
		require.Equal(t, apierrors.ErrorUnionDiscriminatedPostResponseBodyTypeTag1, u.Type)

		response := &http.Response{StatusCode: http.StatusInternalServerError}
		u.HTTPMeta = shared.HTTPMetadata{Response: response}

		require.NoError(t, json.Unmarshal([]byte(`{"tag":"tag2","error":{"message":"Error2"}}`), &u))
		assert.Equal(t, apierrors.ErrorUnionDiscriminatedPostResponseBodyTypeTag2, u.Type)
		assert.Nil(t, u.TaggedError1)
		require.NotNil(t, u.TaggedError2)
		assert.Equal(t, "Error2", u.TaggedError2.Error.Message)
		assert.Same(t, response, u.HTTPMeta.Response)

		require.Error(t, json.Unmarshal([]byte(`{"tag":"tag1","error":{"message":"not a string"}}`), &u))
		assert.Equal(t, apierrors.ErrorUnionDiscriminatedPostResponseBodyTypeTag2, u.Type)
		assert.Nil(t, u.TaggedError1)
		require.NotNil(t, u.TaggedError2)
		assert.Equal(t, "Error2", u.TaggedError2.Error.Message)
		assert.Same(t, response, u.HTTPMeta.Response)
	})

	t.Run("populated fields", func(t *testing.T) {
		var u apierrors.ErrorUnionPostResponseBody
		require.NoError(t, json.Unmarshal([]byte(`{"error":"Error1"}`), &u))
		require.Equal(t, apierrors.ErrorUnionPostResponseBodyTypeErrorType1, u.Type)

		response := &http.Response{StatusCode: http.StatusInternalServerError}
		u.HTTPMeta = shared.HTTPMetadata{Response: response}

		require.NoError(t, json.Unmarshal([]byte(`{"error":{"message":"Error2"}}`), &u))
		assert.Equal(t, apierrors.ErrorUnionPostResponseBodyTypeErrorType2, u.Type)
		assert.Nil(t, u.ErrorType1)
		require.NotNil(t, u.ErrorType2)
		assert.Same(t, response, u.HTTPMeta.Response)
	})
}
