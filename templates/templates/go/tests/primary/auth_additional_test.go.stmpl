func TestHoistedSecurityInvalidField(t *testing.T) {
	recordTest("auth-hoisted-security-invalid-field")

	s := sdk.New(sdk.WithSecuritySource(func(ctx context.Context) (shared.Security, error) {
		return shared.Security{
			BasicHTTP: &shared.SchemeBasicHTTP{Username: "user", Password: "pass"},
		}, nil
	}))

	_, err := s.Auth.HoistedSecurityAccessTokenFirst(context.Background())
	require.Error(t, err)
	var apiErr *apierrors.APIError
	require.ErrorAs(t, err, &apiErr)
	assert.Equal(t, http.StatusUnauthorized, apiErr.StatusCode)
}
