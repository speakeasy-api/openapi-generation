	simpleObject := createSimpleObjectWithType()
	deepObject := createDeepObjectWithType()
	
	req := shared.NestedArrayOfDiscriminatedUnions{
		NestedArray: [][]shared.StronglyTypedOneOfObject{
			{shared.CreateStronglyTypedOneOfObjectSimpleObjectWithType(simpleObject)},
			{
				shared.CreateStronglyTypedOneOfObjectDeepObjectWithType(deepObject),
				shared.CreateStronglyTypedOneOfObjectSimpleObjectWithType(simpleObject),
			},
		},
	}
	
	res, err := s.Unions.NestedArrayOfDiscriminatedUnions(context.Background(), req)
	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Res)
	require.NotNil(t, res.Res.JSON.NestedArray)
	
	nestedArray := res.Res.JSON.NestedArray
	assert.Len(t, nestedArray, 2)
	
	// First sub-array has 1 element (simpleObject)
	assert.Len(t, nestedArray[0], 1)
	assert.Equal(t, shared.StronglyTypedOneOfObjectTypeSimpleObjectWithType, nestedArray[0][0].Type)
	assert.Equal(t, simpleObject, *nestedArray[0][0].SimpleObjectWithType)
	
	// Second sub-array has 2 elements (deepObject, simpleObject)
	assert.Len(t, nestedArray[1], 2)
	assert.Equal(t, shared.StronglyTypedOneOfObjectTypeDeepObjectWithType, nestedArray[1][0].Type)
	assert.Equal(t, deepObject, *nestedArray[1][0].DeepObjectWithType)
	assert.Equal(t, shared.StronglyTypedOneOfObjectTypeSimpleObjectWithType, nestedArray[1][1].Type)
	assert.Equal(t, simpleObject, *nestedArray[1][1].SimpleObjectWithType)
}

