	res, err := s.Unions.SmartUnionUnionVsUnion(ctx, reqBody)
	require.NoError(t, err)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Res)

	responseJSON := res.Res.GetJSON()
	assert.Equal(t, operations.SmartUnionUnionVsUnionJSONTypeSmartUnionUnionVsUnionUnions2, responseJSON.Type)
	require.NotNil(t, responseJSON.SmartUnionUnionVsUnionUnions2)
	// Inner union should resolve to B2 (has fields a, b, c)
	assert.Equal(t, operations.SmartUnionUnionVsUnionUnions2TypeSmartUnionVsUnionB2, responseJSON.SmartUnionUnionVsUnionUnions2.Type)
	require.NotNil(t, responseJSON.SmartUnionUnionVsUnionUnions2.SmartUnionVsUnionB2)
	assert.Equal(t, "", responseJSON.SmartUnionUnionVsUnionUnions2.SmartUnionVsUnionB2.A)
	assert.Equal(t, "", responseJSON.SmartUnionUnionVsUnionUnions2.SmartUnionVsUnionB2.B)
	assert.Equal(t, "", responseJSON.SmartUnionUnionVsUnionUnions2.SmartUnionVsUnionB2.C)
}

