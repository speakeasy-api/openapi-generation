func TestDiscriminatedOpenEnum(t *testing.T) {
	recordTest("unions-discriminated-open-enum")

	s := sdk.New()
	ctx := context.Background()

	// Test 1: active status
	activeReqBytes := []byte(`{"status": "active", "userId": "user-123", "activeAt": "2024-01-15T10:30:00Z"}`)
	var activeReq shared.DiscriminatedOpenEnumUnion
	err := json.Unmarshal(activeReqBytes, &activeReq)
	require.NoError(t, err)

	activeRes, err := s.Unions.DiscriminatedOpenEnum(ctx, activeReq)
	require.NoError(t, err)
	assert.Equal(t, http.StatusOK, activeRes.HTTPMeta.Response.StatusCode)
	require.NotNil(t, activeRes.Res)

	activeJSON := activeRes.Res.GetJSON()
	assert.Equal(t, shared.DiscriminatedOpenEnumUnionTypeActive, activeJSON.Type)
	require.NotNil(t, activeJSON.ObjectWithOpenEnumStatus1)
	assert.Equal(t, "user-123", activeJSON.ObjectWithOpenEnumStatus1.UserID)

	// Test 2: inactive status
	inactiveReqBytes := []byte(`{"status": "inactive", "reason": "User requested deactivation", "inactiveSince": "2024-01-10T15:45:00Z"}`)
	var inactiveReq shared.DiscriminatedOpenEnumUnion
	err = json.Unmarshal(inactiveReqBytes, &inactiveReq)
	require.NoError(t, err)

	inactiveRes, err := s.Unions.DiscriminatedOpenEnum(ctx, inactiveReq)
	require.NoError(t, err)
	assert.Equal(t, http.StatusOK, inactiveRes.HTTPMeta.Response.StatusCode)
	require.NotNil(t, inactiveRes.Res)

	inactiveJSON := inactiveRes.Res.GetJSON()
	assert.Equal(t, shared.DiscriminatedOpenEnumUnionTypeInactive, inactiveJSON.Type)
	require.NotNil(t, inactiveJSON.ObjectWithOpenEnumStatus2)
	assert.Equal(t, "User requested deactivation", inactiveJSON.ObjectWithOpenEnumStatus2.Reason)
}

func TestCircularReferenceRecursiveOneOf(t *testing.T) {
	recordTest("unions-circular-reference-recursive-one-of")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	payload := shared.CreateRecursiveOneOfValueArrayOfRecursiveOneOfValue(
		[]shared.RecursiveOneOfValue{
			shared.CreateRecursiveOneOfValueStr("hello"),
			shared.CreateRecursiveOneOfValueMapOfRecursiveOneOfValue(
				map[string]shared.RecursiveOneOfValue{
					"nested": shared.CreateRecursiveOneOfValueArrayOfRecursiveOneOfValue(
						[]shared.RecursiveOneOfValue{
							shared.CreateRecursiveOneOfValueStr("world"),
						},
					),
				},
			),
		},
	)

	res, err := s.Unions.CircularReferenceRecursiveOneOf(
		context.Background(),
		operations.CircularReferenceRecursiveOneOfRequestBody{
			Value: sdk.Pointer(payload),
		},
	)
	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Object)
	assert.Equal(t, payload, res.Object.JSON.Value)
}
