		Input: map[string]shared.OneOfPrimitives{
			"str":  shared.CreateOneOfPrimitivesStr("test"),
			"bool": shared.CreateOneOfPrimitivesBoolean(true),
		},
	}

	res, err := s.Unions.UnionMapOptional(context.Background(), req)
	require.NoError(t, err)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Res)

	// Verify the input map is echoed back correctly
	responseInput := res.Res.JSON.GetInput()
	require.NotNil(t, responseInput)
	require.Contains(t, responseInput, "str")
	require.Contains(t, responseInput, "bool")
	
	// Check string value
