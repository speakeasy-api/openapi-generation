func TestOpenEnumsRoundTripStringUnion(t *testing.T) {
	recordTest("open-enums-round-trip-string-union")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Enums.EnumsPostOpenEnumUnrecognized(context.Background(), shared.ThemeRequestOpaque{
		Color:     sdk.String("purple"),
		Icon:      sdk.String("tick"),
		HeroWidth: sdk.Int64(2160),
	})
	require.NoError(t, err)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)

	body := res.ThemeResponse
	require.NotNil(t, body)

	theme := body.JSON
	require.NotNil(t, theme)
	wantColor := shared.Color("purple")
	assert.Equal(t, &wantColor, theme.Color)
	wantIcon := shared.IconTick
	assert.Equal(t, &wantIcon, theme.Icon)
	wantHeroWidth := shared.HeroWidth(2160)
	assert.Equal(t, &wantHeroWidth, theme.HeroWidth)

	// Test round trip: pass the received values back to the same endpoint
	roundTripRes, err := s.Enums.EnumsPostOpenEnumUnrecognized(context.Background(), shared.ThemeRequestOpaque{
		Color:     sdk.String(string(*theme.Color)),
		Icon:      sdk.String(string(*theme.Icon)),
		HeroWidth: sdk.Int64(int64(*theme.HeroWidth)),
	})
	require.NoError(t, err)
	assert.Equal(t, http.StatusOK, roundTripRes.HTTPMeta.Response.StatusCode)

	roundTripBody := roundTripRes.ThemeResponse
	require.NotNil(t, roundTripBody)

	roundTripTheme := roundTripBody.JSON
	require.NotNil(t, roundTripTheme)
	assert.Equal(t, &wantColor, roundTripTheme.Color)
	assert.Equal(t, &wantIcon, roundTripTheme.Icon)
	assert.Equal(t, &wantHeroWidth, roundTripTheme.HeroWidth)
}

