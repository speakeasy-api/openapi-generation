	assert.Equal(t, true, *boolValue.Boolean)

	// Test 2: With nil/empty input (optional behavior)
	req = operations.UnionMapOptionalRequestBody{
		Input: nil,
	}

	res, err = s.Unions.UnionMapOptional(context.Background(), req)
	require.NoError(t, err)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Res)

	// Verify the input is nil when passed as nil
	responseInput = res.Res.JSON.GetInput()
	assert.Nil(t, responseInput)
}

func TestSmartUnionOpenEnumsAndSize(t *testing.T) {
	recordTest("smart-union-open-enums-and-size")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	// Test with unrecognized enum value "bat" and additional field "name"
	// This should match the cat variant because:
	// 1. "bat" is not a recognized enum value for either variant
	// 2. Smart resolution falls back to structural matching
	// 3. The cat variant has both "kind" and "name" fields, dog only has "kind"
	// 4. Since payload has both fields, it should match the more specific variant (cat)
	
	// We need to test this by creating a cat variant but with the unrecognized enum value
	req := shared.SmartUnionOpenEnumsAndSizeCatWithName{
		Kind: shared.SmartUnionOpenEnumsAndSizeCatWithNameKind("bat"), // Unrecognized value
		Name: "asdf",
	}

	requestBody := operations.CreateSmartUnionOpenEnumsAndSizeRequestBodySmartUnionOpenEnumsAndSizeCatWithName(req)

	res, err := s.Unions.SmartUnionOpenEnumsAndSize(context.Background(), requestBody)
	require.NoError(t, err)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Res)

	// Verify the response matches the cat variant (with name field)
	responseJSON := res.Res.GetJSON()
	assert.Equal(t, operations.SmartUnionOpenEnumsAndSizeJSONTypeSmartUnionOpenEnumsAndSizeCatWithName, responseJSON.Type)
	require.NotNil(t, responseJSON.SmartUnionOpenEnumsAndSizeCatWithName)

	// Verify the payload is echoed back correctly
	catResponse := responseJSON.SmartUnionOpenEnumsAndSizeCatWithName
	assert.Equal(t, shared.SmartUnionOpenEnumsAndSizeCatWithNameKind("bat"), catResponse.GetKind()) // Unrecognized enum preserved
	assert.Equal(t, "asdf", catResponse.GetName())
}

