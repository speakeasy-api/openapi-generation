func TestPollingDelaySeconds(t *testing.T) {
	t.Parallel()

	recordTest("polling-delay-seconds")

	client := sdk.New(sdk.WithServerURL(getHTTPBinURL()))
	requestID := pseudo_uuid()

	// Endpoint requires initial request with requestID query parameter
	res, err := client.Polling.DelaySeconds(t.Context(), requestID)
	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusCreated, res.HTTPMeta.Response.StatusCode)

	res, err = client.Polling.DelaySeconds(
		t.Context(),
		requestID,
		operations.WithPolling(client.Polling.DelaySecondsWaitForSuccess()),
	)
	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Polling)
	assert.Equal(t, shared.PollingStatusCompleted, res.Polling.Status)
}

func TestPollingDelaySecondsOverride(t *testing.T) {
	t.Parallel()

	recordTest("polling-delay-seconds-override")

	client := sdk.New(sdk.WithServerURL(getHTTPBinURL()))
	requestID := pseudo_uuid()

	// Endpoint requires initial request with requestID query parameter
	res, err := client.Polling.DelaySecondsOverride(t.Context(), requestID)
	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusCreated, res.HTTPMeta.Response.StatusCode)

	res, err = client.Polling.DelaySecondsOverride(
		t.Context(),
		requestID,
		operations.WithPolling(
			client.Polling.DelaySecondsOverrideWaitForSuccess(),
			polling.WithDelaySecondsOverride(5),
		),
	)
	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Polling)
	assert.Equal(t, shared.PollingStatusCompleted, res.Polling.Status)
}

func TestPollingFailureCriteriaResponseBody(t *testing.T) {
	t.Parallel()

	recordTest("polling-failure-criteria-response-body")

	client := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := client.Polling.FailureCriteriaResponseBody(
		t.Context(),
		operations.WithPolling(client.Polling.FailureCriteriaResponseBodyWaitForStatusCompleted()),
	)
	require.ErrorAs(t, err, new(*polling.FailureCriteriaError))
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Polling)
	assert.Equal(t, shared.PollingStatusFailed, res.Polling.Status)
}

func TestPollingFailureCriteriaResponseBodyOptional(t *testing.T) {
	t.Parallel()

	recordTest("polling-failure-criteria-response-body-optional")

	client := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := client.Polling.FailureCriteriaResponseBodyOptional(
		t.Context(),
		operations.WithPolling(client.Polling.FailureCriteriaResponseBodyOptionalWaitForStatusCompleted()),
	)
	require.ErrorAs(t, err, new(*polling.FailureCriteriaError))
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.PollingOptional)
	require.NotNil(t, res.PollingOptional.Status)
	assert.Equal(t, shared.PollingStatusFailed, *res.PollingOptional.Status)
}

