func TestPollingSuccessCriteriaStatusCodeErrorKnown(t *testing.T) {
	t.Parallel()

	recordTest("polling-success-criteria-status-code-error-known")

	client := sdk.New(sdk.WithServerURL(getHTTPBinURL()))
	requestID := pseudo_uuid()

	res, err := client.Polling.SuccessCriteriaStatusCode(
		t.Context(),
		requestID,
		http.StatusNotFound,
		operations.WithPolling(
			client.Polling.SuccessCriteriaStatusCodeWaitForNotFound(),
			polling.WithLimitCountOverride(2), // pass/fail more immediately
		),
	)
	require.NoError(t, err)
	require.Nil(t, res)
}

