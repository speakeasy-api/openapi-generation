package tests

import (
	"context"
	"testing"

	sdk "{{getRootModulePath}}"
	"{{getRootModulePath}}/pkg/models/shared"
	"github.com/stretchr/testify/require"
)

func TestOpenEnumsRoundTrip(t *testing.T) {
	recordTest("open-enums-round-trip")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Enums.EnumsPostOpenEnumUnrecognized(context.Background(), shared.ThemeRequestOpaque{
		Color:     sdk.String("purple"),
		Icon:      sdk.String("tick"),
		HeroWidth: sdk.Int64(2160),
	})
	require.NoError(t, err)

	body := res.ThemeResponse
	require.NotNil(t, body)

	theme := body.JSON
	wantColor := shared.Color("purple")
	require.Equal(t, &wantColor, theme.Color)
	wantIcon := shared.IconTick
	require.Equal(t, &wantIcon, theme.Icon)
	wantHeroWidth := shared.HeroWidth(2160)
	require.Equal(t, &wantHeroWidth, theme.HeroWidth)

	roundTripRes, err := s.Enums.EnumsPostOpenEnumUnrecognized(context.Background(), shared.ThemeRequestOpaque{
		Color:     sdk.String(string(*theme.Color)),
		Icon:      sdk.String(string(*theme.Icon)),
		HeroWidth: sdk.Int64(int64(*theme.HeroWidth)),
	})
	require.NoError(t, err)

	roundTripBody := roundTripRes.ThemeResponse
	require.NotNil(t, body)

	roundTripTheme := roundTripBody.JSON
	wantColor = shared.Color("purple")
	require.Equal(t, &wantColor, roundTripTheme.Color)
	wantIcon = shared.IconTick
	require.Equal(t, &wantIcon, roundTripTheme.Icon)
	wantHeroWidth = shared.HeroWidth(2160)
	require.Equal(t, &wantHeroWidth, roundTripTheme.HeroWidth)
}

func TestEnumValues(t *testing.T) {
	recordTest("enum-values")

	require.Equal(t, []shared.PrototypeMemberNameEnum{
		shared.PrototypeMemberNameEnumStandard,
		shared.PrototypeMemberNameEnumConstructor,
		shared.PrototypeMemberNameEnumToString,
		shared.PrototypeMemberNameEnumValueOf,
		shared.PrototypeMemberNameEnumHasOwnProperty,
	}, shared.PrototypeMemberNameEnumValues())

	require.Equal(t, []shared.ValuesMemberEnum{shared.ValuesMemberEnumValues, shared.ValuesMemberEnumCount}, shared.ValuesMemberEnumEnumValues())
	require.Equal(t, []shared.Priority{shared.PriorityLow, shared.PriorityHigh}, shared.PriorityEnumValues())
	require.Equal(t, []shared.PriorityEnum{shared.PriorityEnumUrgent, shared.PriorityEnumNormal}, shared.PriorityEnumEnumValues())

	require.Equal(t, []shared.HeroWidth{480, 720, 1080}, shared.HeroWidthValues())

	colors := shared.ColorValues()
	require.Equal(t, []shared.Color{
		shared.ColorRed,
		shared.ColorGreen,
		shared.ColorBlue,
		shared.ColorReturn,
		shared.ColorClass,
		shared.ColorInt,
	}, colors)
	for _, c := range colors {
		require.True(t, c.IsExact(), "ColorValues returned %q, which IsExact rejects", c)
	}
}
