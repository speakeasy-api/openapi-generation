func TestPaginationLimitOffsetNullable(t *testing.T) {
	recordTest("pagination-limit-offset-nullable")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	// Passing nil for the required+nullable offset/limit forces the SDK to
	// serialise null values; the generated paginator must narrow them to int64
	// before computing the next offset and comparing against limit, otherwise
	// strict type checkers reject the arithmetic on a potentially-null operand.
	serverLimit := 10
	res, err := s.Pagination.PaginationOffsetNullable(context.Background(), nil, nil)

	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	assert.NotNil(t, res.Res)
	assert.Equal(t, serverLimit, len(res.Res.ResultArray))

	nextRes, err := res.Next()
	require.NoError(t, err)
	require.NotNil(t, nextRes)
	assert.Equal(t, serverLimit, len(nextRes.Res.ResultArray))

	emptyRes, err := nextRes.Next()
	require.NoError(t, err)
	require.NotNil(t, emptyRes)
	assert.Equal(t, 0, len(emptyRes.Res.ResultArray))

	nullRes, err := emptyRes.Next()
	require.NoError(t, err)
	require.Nil(t, nullRes)
}

