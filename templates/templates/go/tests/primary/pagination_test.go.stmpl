func TestPaginationNextUsesCallerContextWithTimeout(t *testing.T) {
	var requests atomic.Int32
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		requests.Add(1)
		w.Header().Set("Content-Type", "application/json")

		var results []int64
		switch r.URL.Query().Get("cursor") {
		case "-1":
			results = []int64{0}
		case "0":
			results = []int64{1}
		case "1":
			results = []int64{}
		default:
			t.Errorf("unexpected cursor %q", r.URL.Query().Get("cursor"))
			http.Error(w, "unexpected cursor", http.StatusBadRequest)
			return
		}

		assert.NoError(t, json.NewEncoder(w).Encode(map[string]interface{}{
			"numPages":    3,
			"resultArray": results,
		}))
	}))
	defer server.Close()

	// The caller's context carries a value and a deadline sooner than the SDK
	// timeout. Every page's request must observe both, so a Next() that
	// substituted context.Background() for the caller's context would fail
	// the per-request assertions below.
	callerDeadline := time.Now().Add(30 * time.Second)
	ctx, cancel := context.WithDeadline(
		context.WithValue(context.Background(), paginationCtxKey{}, "caller"),
		callerDeadline,
	)
	defer cancel()

	client := &paginationCtxObservingClient{}

	// The operation declares its own servers, so the per-call option is what
	// redirects it (and Next() forwards per-call options to later pages).
	s := sdk.New(sdk.WithTimeout(5*time.Minute), sdk.WithClient(client))

	res, err := s.Pagination.PaginationCursorParams(ctx, -1, operations.WithServerURL(server.URL))
	require.NoError(t, err)
	require.NotNil(t, res)

	for res != nil {
		res, err = res.Next()
		require.NoError(t, err)
	}
	assert.Equal(t, int32(3), requests.Load())

	require.Len(t, client.observations, 3)
	for i, observed := range client.observations {
		assert.Equal(t, "caller", observed.callerValue, "request %d lost the caller's context value", i+1)
		require.True(t, observed.hasDeadline, "request %d has no deadline", i+1)
		// The caller's deadline is sooner than the 5m SDK timeout, so it must
		// win on every page, including pages fetched via Next().
		assert.True(t, observed.deadline.Equal(callerDeadline),
			"request %d deadline %v is not the caller's deadline %v", i+1, observed.deadline, callerDeadline)
	}
}

func TestPaginationNextTimeoutBoundsStalledPage(t *testing.T) {
	var requests atomic.Int32
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		requests.Add(1)
		if r.URL.Query().Get("cursor") != "-1" {
			select {
			case <-r.Context().Done():
			case <-time.After(20 * time.Second):
			}
			return
		}

		w.Header().Set("Content-Type", "application/json")
		assert.NoError(t, json.NewEncoder(w).Encode(map[string]interface{}{
			"numPages":    3,
			"resultArray": []int64{0},
		}))
	}))
	defer server.Close()

	s := sdk.New(sdk.WithTimeout(2 * time.Second))

	res, err := s.Pagination.PaginationCursorParams(context.Background(), -1, operations.WithServerURL(server.URL))
	require.NoError(t, err)
	require.NotNil(t, res)

	next, err := res.Next()
	require.Error(t, err)
	assert.Nil(t, next)
	assert.ErrorIs(t, err, context.DeadlineExceeded)
	// The stalled page may or may not reach the server before the deadline
	// fires under load; the first page must have, and nothing beyond it.
	assert.Contains(t, []int32{1, 2}, requests.Load())
}

func TestPaginationNextReturnsCallerContextCancellation(t *testing.T) {
	var requests atomic.Int32
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		requests.Add(1)
		w.Header().Set("Content-Type", "application/json")
		assert.NoError(t, json.NewEncoder(w).Encode(map[string]any{
			"numPages":    3,
			"resultArray": []int64{0},
		}))
	}))
	defer server.Close()

	ctx, cancel := context.WithCancel(context.Background())

	s := sdk.New(sdk.WithTimeout(5 * time.Second))

	res, err := s.Pagination.PaginationCursorParams(ctx, -1, operations.WithServerURL(server.URL))
	require.NoError(t, err)
	require.NotNil(t, res)

	// Cancel the caller's context between pages. Next() derives each page's
	// context from the caller's, so the second fetch must fail client-side
	// with the caller's cancellation and never reach the server.
	cancel()

	next, err := res.Next()
	require.Error(t, err)
	assert.Nil(t, next)
	assert.ErrorIs(t, err, context.Canceled)
	assert.Equal(t, int32(1), requests.Load())
}

