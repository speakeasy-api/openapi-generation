func TestPaginationLimitOffsetPageBodyNullable(t *testing.T) {
	recordTest("pagination-limit-offset-page-body-nullable")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	// first request sends a null body; later pages materialize one with the
	// advanced page (wire sequence enforced by the test service)
	res, err := s.Pagination.PaginationLimitOffsetPageBodyNullable(context.Background(), nil)

	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	require.NotNil(t, res.Res)
	assert.Equal(t, []int64{0, 1, 2, 3, 4, 5, 6}, res.Res.ResultArray)

	nextRes, err := res.Next()
	require.NoError(t, err)
	require.NotNil(t, nextRes)
	assert.Equal(t, http.StatusOK, nextRes.HTTPMeta.Response.StatusCode)
	require.NotNil(t, nextRes.Res)
	assert.Equal(t, []int64{7, 8, 9, 10, 11, 12, 13}, nextRes.Res.ResultArray)

	lastRes, err := nextRes.Next()
	require.NoError(t, err)
	require.NotNil(t, lastRes)
	assert.Equal(t, http.StatusOK, lastRes.HTTPMeta.Response.StatusCode)
	require.NotNil(t, lastRes.Res)
	assert.Equal(t, []int64{14, 15, 16, 17, 18, 19}, lastRes.Res.ResultArray)

	nilRes, err := lastRes.Next()
	require.NoError(t, err)
	require.Nil(t, nilRes)
}

