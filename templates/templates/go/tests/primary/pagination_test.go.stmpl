func TestPaginationWithRetries(t *testing.T) {
	recordTest("pagination-with-retries")

	client := newPaginationTestClient()

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()), sdk.WithClient(client))

	faultSettings := sdk.String(`{"error_code": 503, "error_count": 3}`)

	res, err := s.Pagination.PaginationWithRetries(context.Background(), nil, faultSettings, nil)
	require.NoError(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.Res, "(1) expected response to have non-nil body")
	count := len(res.Res.ResultArray)

	res, err = res.Next()
	require.NoError(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.Res, "(2) expected response to have non-nil body")
	count += len(res.Res.ResultArray)

	res, err = res.Next()
	require.NoError(t, err)
	require.NotNil(t, res)
	require.NotNil(t, res.Res, "(3) expected response to have non-nil body")
	count += len(res.Res.ResultArray)

	res, err = res.Next()
	require.NoError(t, err)
	require.Nil(t, res)

	failattempt := paginationRequestLog{
		status: http.StatusServiceUnavailable,
		method: http.MethodGet,
		path:   "/pagination/cursor_non_numeric",
	}
	successattempt := paginationRequestLog{
		status: http.StatusOK,
		method: http.MethodGet,
		path:   "/pagination/cursor_non_numeric",
	}

	require.Equal(t, 20, count, "expected 20 results")
	require.Equal(t, 6, len(client.logs), "expected 6 http calls")
	require.Equal(t, failattempt, client.logs[0], "expected first call to fail")
	require.Equal(t, failattempt, client.logs[1], "expected second call to fail")
	require.Equal(t, failattempt, client.logs[2], "expected third call to fail")
	require.Equal(t, successattempt, client.logs[3], "expected fourth call to succeed")
	require.Equal(t, successattempt, client.logs[4], "expected fifth call to succeed")
	require.Equal(t, successattempt, client.logs[5], "expected sixth call to succeed")
}

func TestPaginationCursorNullableLimit(t *testing.T) {
	recordTest("pagination-cursor-nullable-limit")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	defaultLimit := 10
	// Call without setting cursor or limit — both are OptionalNullable and
	// should default to unset. The server defaults limit to 10.
	var cursor optionalnullable.OptionalNullable[string]
	var limit optionalnullable.OptionalNullable[int64]
	res, err := s.Pagination.PaginationCursorNullableLimit(context.Background(), cursor, limit)

	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	assert.NotNil(t, res.PaginationCursorNullableLimitNextCursor)
	assert.Equal(t, defaultLimit, len(res.PaginationCursorNullableLimitNextCursor.Results))

	nextRes, err := res.Next()
	require.NoError(t, err)
	require.NotNil(t, nextRes)
	assert.NotNil(t, nextRes.PaginationCursorNullableLimitNextCursor)
	assert.Equal(t, defaultLimit, len(nextRes.PaginationCursorNullableLimitNextCursor.Results))

	// Paginate until exhausted
	lastRes := nextRes
	for {
		n, err := lastRes.Next()
		require.NoError(t, err)
		if n == nil {
			break
		}
		lastRes = n
	}

	assert.NotNil(t, lastRes.PaginationCursorNullableLimitNextCursor)
}

type paginationTestClient struct {
	http.Client
	reqID string
	logs  []paginationRequestLog
}

func newPaginationTestClient() *paginationTestClient {
	return &paginationTestClient{
		Client: http.Client{},
		reqID:  pseudo_uuid(),
		logs:   []paginationRequestLog{},
	}
}

func (c *paginationTestClient) Do(req *http.Request) (*http.Response, error) {
	req.Header.Set("Request-ID", c.reqID)

	var buf bytes.Buffer
	body := req.Body
	if body != nil {
		defer body.Close()
		req.Body = io.NopCloser(io.TeeReader(body, &buf))
	}

	res, err := c.Client.Do(req)
	if err != nil {
		return nil, err
	}

	c.logs = append(c.logs, paginationRequestLog{
		status: res.StatusCode,
		method: req.Method,
		path:   req.URL.Path,
		body:   buf.Bytes(),
	})

	return res, nil
}

type paginationRequestLog struct {
	status int
	method string
	path   string
	body   []byte
}

// paginationCtxKey marks a value planted on a caller's context so tests can
// prove the caller's context reaches every page request.
type paginationCtxKey struct{}

type paginationCtxObservation struct {
	callerValue any
	deadline    time.Time
	hasDeadline bool
}

// paginationCtxObservingClient records each request context's caller-planted
// value and effective deadline before performing the request.
type paginationCtxObservingClient struct {
	http.Client
	observations []paginationCtxObservation
}

func (c *paginationCtxObservingClient) Do(req *http.Request) (*http.Response, error) {
	deadline, hasDeadline := req.Context().Deadline()
	c.observations = append(c.observations, paginationCtxObservation{
		callerValue: req.Context().Value(paginationCtxKey{}),
		deadline:    deadline,
		hasDeadline: hasDeadline,
	})
	return c.Client.Do(req)
}
