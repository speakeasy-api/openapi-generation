	require.NoError(t, err)
	require.NotNil(t, nextRes)
	assert.Equal(t, 5, len(nextRes.Res.ResultArray))

	penultimateRes, err := nextRes.Next()
	require.NoError(t, err)
	require.NotNil(t, penultimateRes)
	assert.Equal(t, 0, len(penultimateRes.Res.ResultArray))

	nullRes, err := penultimateRes.Next()
	require.NoError(t, err)
	require.Nil(t, nullRes)
}

func TestPaginationCursorNonNumericNullable(t *testing.T) {
	recordTest("pagination-cursor-non-numeric-nullable")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	res, err := s.Pagination.PaginationCursorNonNumericNullable(
		context.Background(),
		optionalnullable.From(sdk.String("2")),
	)

	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	assert.NotNil(t, res.Res)
	assert.Equal(t, 15, len(res.Res.ResultArray))
	assert.Equal(t, optionalnullable.From(sdk.String("17")), res.Res.Cursor)

	nextRes, err := res.Next()
	require.NoError(t, err)
	require.NotNil(t, nextRes)
	assert.Equal(t, 2, len(nextRes.Res.ResultArray))
	require.Equal(t, optionalnullable.From[string](nil), nextRes.Res.Cursor)

	nullRes, err := nextRes.Next()
	require.NoError(t, err)
	require.Nil(t, nullRes)
}

