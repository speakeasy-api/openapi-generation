func TestPaginationLimitOffsetPageParams(t *testing.T) {
	recordTest("pagination-limit-offset-page-params")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	serverLimit := 20
	var page int64 = 1
	res, err := s.Pagination.PaginationLimitOffsetPageParams(context.Background(), page)

	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	assert.NotNil(t, res.Res)
	assert.Equal(t, serverLimit, len(res.Res.ResultArray))

	nextRes, err := res.Next()
	require.NoError(t, err)
	require.NotNil(t, nextRes)
	assert.Equal(t, 0, len(nextRes.Res.ResultArray))

	nullRes, err := nextRes.Next()
	require.NoError(t, err)
	require.Nil(t, nullRes)
}

func TestPaginationLimitOffsetPageParamsConst(t *testing.T) {
	recordTest("pagination-limit-offset-page-params-const")

	s := sdk.New(sdk.WithServerURL(getHTTPBinURL()))

	constPageSize := 5
	totalItems := 20
	var page int64 = 1
	res, err := s.Pagination.PaginationLimitOffsetPageParamsConst(context.Background(), &page)

	require.NoError(t, err)
	require.NotNil(t, res)
	assert.Equal(t, http.StatusOK, res.HTTPMeta.Response.StatusCode)
	assert.NotNil(t, res.Res)
	// With const pageSize=5, we should get 5 items per page
	assert.Equal(t, constPageSize, len(res.Res.ResultArray))

	// Page through all results (20 items / 5 per page = 4 pages)
	itemsReceived := constPageSize
	currentRes := res

	for itemsReceived < totalItems {
		nextRes, err := currentRes.Next()
		require.NoError(t, err)
		require.NotNil(t, nextRes)
		assert.Equal(t, constPageSize, len(nextRes.Res.ResultArray))
		itemsReceived += len(nextRes.Res.ResultArray)
		currentRes = nextRes
	}

	// Next call should return empty array (no more items)
	emptyRes, err := currentRes.Next()
	require.NoError(t, err)
	require.NotNil(t, emptyRes)
	assert.Equal(t, 0, len(emptyRes.Res.ResultArray))

	// Final call should return nil (pagination complete)
	nullRes, err := emptyRes.Next()
	require.NoError(t, err)
	require.Nil(t, nullRes)
}

