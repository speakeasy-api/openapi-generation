{{- if .Local.Operation -}}
{{- $namespace := sanitizeSDKAccess .Local.SDK }}
{{- $methodParameters := templateUsageMethodParameters .Local 1 -}}
{{- $methodParameters.LocalDeclarations | indentPresent 4 }}
