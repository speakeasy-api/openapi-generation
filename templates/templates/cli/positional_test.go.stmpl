{{- recurse 1 -}}
{{- $pc := getPositionalTestCase -}}
{{- if $pc -}}
{{- addImport "encoding/json" -}}
{{- addImport "strings" -}}
{{- addImport "testing" -}}
{{- addImport "github.com/stretchr/testify/assert" -}}
{{- addImport "github.com/stretchr/testify/require" -}}
{{- addImport "internal/clierrors" true -}}
{{- addImport "internal/flagutil" true -}}
{{- if isInteractiveModeEnabled -}}
{{- addImport "github.com/spf13/cobra" -}}
{{- addImport "internal/interactive" true -}}
{{- end -}}
package tests

{{genImports}}

const positionalTestValue = "positional-value"

func positionalTestArgs(extra ...string) []string {
	return append([]string{"--dry-run", {{$pc.PathArgs}}}, extra...)
}

func positionalDryRunURL(t *testing.T, h *CLITestHarness) string {
	t.Helper()
	var preview struct {
		Request struct {
			URL string `json:"url"`
		} `json:"request"`
	}
	require.NoError(t, json.Unmarshal([]byte(strings.TrimSpace(h.GetStdout())), &preview))
	return preview.Request.URL
}

func TestPositionalArgument_MatchesFlag(t *testing.T) {
	positional := NewCLITestHarness(t)
	require.NoError(t, positional.Run(positionalTestArgs(positionalTestValue)))
	flag := NewCLITestHarness(t)
	require.NoError(t, flag.Run(positionalTestArgs("--{{$pc.FlagName}}", positionalTestValue)))

	url := positionalDryRunURL(t, positional)
	assert.Contains(t, url, positionalTestValue)
	assert.Equal(t, positionalDryRunURL(t, flag), url)
}

func TestPositionalArgument_AcceptsBooleanLookingValue(t *testing.T) {
	for _, value := range []string{"true", "false"} {
		t.Run(value, func(t *testing.T) {
			h := NewCLITestHarness(t)
			require.NoError(t, h.Run(positionalTestArgs(value)))
			assert.Contains(t, positionalDryRunURL(t, h), value)
		})
	}
}

func TestPositionalArgument_RejectsBothForms(t *testing.T) {
	h := NewCLITestHarness(t)
	err := h.Run(positionalTestArgs(positionalTestValue, "--{{$pc.FlagName}}", positionalTestValue))
	require.Error(t, err)
	assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
	assert.Contains(t, err.Error(), "not both")
}

func TestPositionalArgument_RequiresOneForm(t *testing.T) {
	h := NewCLITestHarness(t)
	err := h.Run(positionalTestArgs())
	var missing *flagutil.MissingRequiredFlagError
	require.ErrorAs(t, err, &missing)
	assert.Equal(t, "{{$pc.FlagName}}", missing.FlagName)
	assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
}

func TestPositionalArgument_RejectsFlagAfterTerminator(t *testing.T) {
	h := NewCLITestHarness(t)
	err := h.Run(positionalTestArgs("--", "--verbose"))
	require.Error(t, err)
	assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
	assert.Empty(t, h.GetStdout())
}

func TestPositionalArgument_UsageAdvertisesArgument(t *testing.T) {
	h := NewCLITestHarness(t)
	require.NoError(t, h.Run([]string{ {{- $pc.PathArgs}}, "--usage"}))
	assert.Contains(t, h.GetStdout(), `arg "{{$pc.FlagName}}"`)
}
{{- if isInteractiveModeEnabled}}

type positionalPrompter struct {
	fieldIDs []string
}

func (p *positionalPrompter) Prompt(_ *cobra.Command, fields []interactive.PromptField) ([]interactive.PromptAnswer, error) {
	answers := make([]interactive.PromptAnswer, len(fields))
	for i, field := range fields {
		p.fieldIDs = append(p.fieldIDs, field.ID)
		if field.ID == "arg:{{$pc.FlagName}}" {
			answers[i] = interactive.PromptAnswer{Set: true, Values: []string{positionalTestValue}}
		}
	}
	return answers, nil
}

func TestPositionalArgument_InteractivePromptsForArgument(t *testing.T) {
	p := &positionalPrompter{}
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunInteractive(positionalTestArgs(), p))
	assert.Contains(t, p.fieldIDs, "arg:{{$pc.FlagName}}")
	assert.NotContains(t, p.fieldIDs, "flag:{{$pc.FlagName}}")
	assert.Contains(t, positionalDryRunURL(t, h), positionalTestValue)
}
{{- end}}
{{- end}}
