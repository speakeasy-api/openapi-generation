// Declared intent commands (x-speakeasy-cli-commands) answer --usage with
// their KDL schema instead of the help page or a lookup failure.
func TestUsageSchema_IntentCommandBare(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{ {{templateIntentUsagePathArgs}}, "--usage" })
    require.NoError(t, err)

    stdout := strings.TrimSpace(h.GetStdout())
    stderr := h.GetStderr()

    assert.Contains(t, stdout, "cmd \"{{templateIntentUsageCmdName}}\"")
    {{- if templateIntentUsageArgsTestEnabled }}
    assert.Contains(t, stdout, "arg \"")
    {{- end }}
    assert.NotContains(t, stdout, "name \"")
    assert.Empty(t, stderr)
}

