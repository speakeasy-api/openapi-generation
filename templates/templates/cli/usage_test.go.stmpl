func TestCatalogCommandListsValues(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{"{{templateCatalogUsageCmdName}}"})
    require.NoError(t, err)

    assert.Contains(t, h.GetStdout(), "{{templateCatalogUsageFirstValue}}")
    assert.NotContains(t, h.GetStdout(), "cmd \"")
}

func TestCatalogCommandDryRunStillRendersStructuredValues(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{"{{templateCatalogUsageCmdName}}", "--dry-run", "--output-format", "json"})
    require.NoError(t, err)

    assert.Contains(t, h.GetStdout(), "{{templateCatalogUsageFirstValue}}")
    assert.Empty(t, h.GetStderr())
}
