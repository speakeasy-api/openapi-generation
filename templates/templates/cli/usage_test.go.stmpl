{{- if templateIntentUsageSchemaPrecedenceTestEnabled }}

// --usage documents the command and wins over --schema (matching operation
// commands): KDL comes back, not the request-body JSON Schema.
func TestUsageSchema_IntentUsageBeatsSchema(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{ {{templateIntentUsagePathArgs}}, "--usage", "--schema" })
    require.NoError(t, err)

    stdout := strings.TrimSpace(h.GetStdout())
    stderr := h.GetStderr()

    assert.Contains(t, stdout, "cmd \"{{templateIntentUsageCmdName}}\"")
    assert.Contains(t, stdout, "flag \"--schema\"")
    assert.Empty(t, stderr)
}
{{- end }}
{{- end }}

