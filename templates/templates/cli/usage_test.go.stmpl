// assertWellFormedKDLStrings scans the complete output's quoted strings and
// fails on raw code points KDL v2 forbids (controls, delete, NEL, LS/PS,
// direction controls, U+FEFF) or escape sequences it does not define (Go's
// %q spellings such as \a, \v, and \xNN). Quote state carries across
// lines: emitters escape newlines, so a raw newline inside a string is
// itself malformed output.
func assertWellFormedKDLStrings(t *testing.T, out string) {
    t.Helper()
    legalEscape := regexp.MustCompile(`^(?:[nrt\\"bfs]|u\{[0-9a-fA-F]{1,6}\})`)
    forbidden := func(r rune) bool {
        return (r < 0x20 && r != '\n') || r == 0x7f || r == 0x85 ||
            r == 0x200e || r == 0x200f || r == 0x2028 || r == 0x2029 ||
            (r >= 0x202a && r <= 0x202e) || (r >= 0x2066 && r <= 0x2069) ||
            r == 0xfeff
    }
    runes := []rune(out)
    const (
        outside = iota
        inSingle
        inMulti
    )
    state := outside
    line := 1
    quoteRun := 0
    consumeEscape := func(i int) int {
        rest := string(runes[i+1:])
        if !legalEscape.MatchString(rest) {
            t.Errorf("usage output line %d holds a non-KDL escape near column %d", line, i+1)
            return i + 1
        }
        if i+1 < len(runes) && runes[i+1] == 'u' {
            for i < len(runes) && runes[i] != '}' {
                i++
            }
            return i
        }
        return i + 1
    }
    for i := 0; i < len(runes); i++ {
        r := runes[i]
        if r == '\n' {
            if state == inSingle {
                t.Errorf("usage output line %d has a raw newline inside a quoted string (emitters must escape it)", line)
                state = outside
            }
            quoteRun = 0
            line++
            continue
        }
        if forbidden(r) {
            t.Errorf("usage output line %d contains forbidden raw code point %U", line, r)
            continue
        }
        switch state {
        case outside:
            if r != '"' {
                continue
            }
            // """ opens a multi-line string, which KDL requires to be
            // followed directly by a newline; anything else is a
            // single-line string open (`""` closes again immediately).
            if i+2 < len(runes) && runes[i+1] == '"' && runes[i+2] == '"' {
                if i+3 >= len(runes) || runes[i+3] != '\n' {
                    t.Errorf("usage output line %d opens a multi-line string without a following newline", line)
                }
                state = inMulti
                quoteRun = 0
                i += 2
                continue
            }
            state = inSingle
        case inSingle:
            switch r {
            case '"':
                state = outside
            case '\\':
                i = consumeEscape(i)
            }
        case inMulti:
            // Inside """ ... """ lone and double quotes are literal; only
            // an unescaped run of three closes the string. Emitters escape
            // the third quote of any content run.
            if r == '"' {
                quoteRun++
                if quoteRun == 3 {
                    state = outside
                    quoteRun = 0
                }
                continue
            }
            quoteRun = 0
            if r == '\\' {
                i = consumeEscape(i)
            }
        }
    }
    if state != outside {
        t.Errorf("usage output ends inside an unterminated quoted string (line %d)", line)
    }
}

func TestUsageSchema_Root(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{"--usage"})
    require.NoError(t, err)

    stdout := h.GetStdout()
    stderr := h.GetStderr()

    assert.Contains(t, stdout, "name ")
    assert.Contains(t, stdout, "bin \"{{sanitizeCliName}}\"")
{{- if templateUsageRootAboutMultiline}}
    // The root description contains newlines and must render as a KDL v2
    // multi-line string, not a single line of \n escapes.
    assert.Contains(t, stdout, "about \"\"\"\n")
{{- else}}
    assert.Contains(t, stdout, "about \"")
{{- end}}
    assert.Contains(t, stdout, "flag \"--usage\" help=\"Print the CLI Usage schema in KDL format\" global=#true")
    assert.Contains(t, stdout, "cmd \"configure\"")
    assert.Contains(t, stdout, "cmd \"version\"")
    assertWellFormedKDLStrings(t, stdout)
    assert.Empty(t, stderr)
}

func TestUsageSchema_Subtree(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{"configure", "--usage"})
    require.NoError(t, err)

    stdout := strings.TrimSpace(h.GetStdout())
    stderr := h.GetStderr()

    assert.Contains(t, stdout, "cmd \"configure\"")
    assert.NotContains(t, stdout, "name \"")
    assert.Empty(t, stderr)
}

{{- if templateUsageSubgroupPathTestEnabled }}
func TestUsageSchema_GroupSubtree(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{ {{templateUsageSubgroupPathArgs}}, "--usage" })
    require.NoError(t, err)

    stdout := strings.TrimSpace(h.GetStdout())
    stderr := h.GetStderr()

    assert.Contains(t, stdout, "cmd \"{{templateUsageSubgroupPathCommandName}}\"")
    assert.NotContains(t, stdout, "name \"")
    assert.Empty(t, stderr)
}
{{- end }}

func TestUsageSchema_UsageFalseDoesNotEmitSchema(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{"version", "--usage=false"})
    require.NoError(t, err)

    stdout := h.GetStdout()
    stderr := h.GetStderr()

    assert.NotContains(t, stdout, "name ")
    assert.NotContains(t, stdout, "bin \"")
    assert.NotEmpty(t, strings.TrimSpace(stdout))
    assert.Empty(t, stderr)
}

{{- if templateUsageAliasPathTestEnabled }}
func TestUsageSchema_AliasPath(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{ {{templateUsageAliasPathArgs}}, "--usage" })
    require.NoError(t, err)

    stdout := strings.TrimSpace(h.GetStdout())
    stderr := h.GetStderr()

    assert.Contains(t, stdout, "cmd \"{{templateUsageAliasPathCanonicalName}}\"")
    assert.Contains(t, stdout, "alias \"{{templateUsageAliasPathAlias}}\"")
    assert.NotContains(t, stdout, "name \"")
    assert.Empty(t, stderr)
}
{{- end }}

{{- if templateDiscriminatedUnionUsageTestEnabled }}

// Discriminated-union commands expose their top-level and per-variant flags
// in KDL exactly as Cobra registers them.
func TestUsageSchema_DiscriminatedUnionFlags(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{ {{templateDiscriminatedUnionUsagePathArgs}}, "--usage" })
    require.NoError(t, err)

    stdout := strings.TrimSpace(h.GetStdout())
    stderr := h.GetStderr()

    assert.Contains(t, stdout, "flag \"--{{templateDiscriminatedUnionUsageFlag}}")
    assert.Contains(t, stdout, "--{{templateDiscriminatedUnionUsageFirstVariantFlag}}")
    assert.Empty(t, stderr)
}
{{- end }}

