{{- if templateAuthUsageTestEnabled }}

// The built-in auth group and its subcommands honor the --usage contract:
// KDL comes back and nothing runs (login must not prompt, logout must not
// clear credentials).
func TestUsageSchema_AuthGroup(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{"auth", "--usage"})
    require.NoError(t, err)

    stdout := strings.TrimSpace(h.GetStdout())
    stderr := h.GetStderr()

    assert.Contains(t, stdout, "cmd \"auth\"")
    assert.Contains(t, stdout, "cmd \"login\"")
    assert.Contains(t, stdout, "cmd \"logout\"")
    assert.NotContains(t, stdout, "Usage:")
    assert.Empty(t, stderr)
}

func TestUsageSchema_AuthLogoutDoesNotRun(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{"auth", "logout", "--usage"})
    require.NoError(t, err)

    stdout := strings.TrimSpace(h.GetStdout())
    stderr := h.GetStderr()

    assert.Contains(t, stdout, "cmd \"logout\"")
    assert.NotContains(t, stdout, "credentials have been cleared")
    assert.Empty(t, stderr)
}
{{- end }}

// Cobra's own default commands are created before interception, so
// `completion bash --usage` documents instead of printing a shell script.
func TestUsageSchema_CompletionDoesNotRun(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{"completion", "bash", "--usage"})
    require.NoError(t, err)

    stdout := strings.TrimSpace(h.GetStdout())
    stderr := h.GetStderr()

    assert.Contains(t, stdout, "cmd \"bash\"")
    assert.NotContains(t, stdout, "# bash completion")
    assert.Empty(t, stderr)
}

func TestUsageSchema_HelpCommand(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{"help", "--usage"})
    require.NoError(t, err)

    assert.Contains(t, strings.TrimSpace(h.GetStdout()), "cmd \"help\"")
    assert.Empty(t, h.GetStderr())
}

// --usage wins over the root pre-run: an invalid CLI-owned enum value is not
// validated when the command only documents itself.
func TestUsageSchema_WinsOverFlagValidation(t *testing.T) {
    h := NewCLITestHarness(t)
    err := h.RunBare([]string{"version", "--usage", "-o", "jsno"})
    require.NoError(t, err)

    assert.Contains(t, h.GetStdout(), "cmd \"version\"")
}

