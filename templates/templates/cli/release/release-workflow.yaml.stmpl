name: Release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write

jobs:
  goreleaser:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0

      - name: Setup Go
        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: "go.mod"
          cache: true

{{- if or isHomebrewEnabled isWingetEnabled isNFPMEnabled }}
      - name: Import GPG key
        uses: crazy-max/ghaction-import-gpg@2dc316deee8e90f13e1a351ab510b4d5bc0c82cd # v7.0.0
        id: import_gpg
        with:
          gpg_private_key: ${{"{{"}} secrets.CLI_GPG_SECRET_KEY {{"}}"}}
          passphrase: ${{"{{"}} secrets.CLI_GPG_PASSPHRASE {{"}}"}}

{{- end }}
      - name: Run GoReleaser
        uses: goreleaser/goreleaser-action@f06c13b6b1a9625abc9e6e439d9c05a8f2190e94 # v7.2.3
        with:
          distribution: goreleaser
          version: "~> v2"
          args: release --clean
        env:
          GITHUB_TOKEN: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
{{- if or isHomebrewEnabled isWingetEnabled isNFPMEnabled }}
          GPG_FINGERPRINT: ${{"{{"}} steps.import_gpg.outputs.fingerprint {{"}}"}}
{{- end }}
{{- if isHomebrewEnabled }}
          # Required when Homebrew tap publishing is enabled.
          # Classic PATs need public_repo (public tap) or repo (private tap).
          # Fine-grained PATs need Contents: Read and write on {{getHomebrewTap}}.
          HOMEBREW_TAP_GITHUB_TOKEN: ${{"{{"}} secrets.HOMEBREW_TAP_GITHUB_TOKEN {{"}}"}}
{{- end }}
{{- if isWingetEnabled }}
          # Required when WinGet publishing is enabled.
          # PAT must have public_repo scope so GoReleaser can push a branch and open a PR against microsoft/winget-pkgs.
          WINGET_GITHUB_TOKEN: ${{"{{"}} secrets.WINGET_GITHUB_TOKEN {{"}}"}}
{{- end }}

      - name: Upload artifacts
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        if: always()
        with:
          name: release-artifacts
          path: |
            dist/
            !dist/*.txt
          retention-days: 30
