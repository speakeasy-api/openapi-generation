{{- if isAnyInteractiveEnabled}}
package forms

import (
	"bytes"
	"errors"
	"strings"
	"testing"

	tea "charm.land/bubbletea/v2"
)

func press(f *Form, keys ...string) tea.Cmd {
	var last tea.Cmd
	for _, k := range keys {
		var msg tea.KeyPressMsg
		switch k {
		case "enter":
			msg = tea.KeyPressMsg{Code: tea.KeyEnter}
		case "tab":
			msg = tea.KeyPressMsg{Code: tea.KeyTab}
		case "shift+tab":
			msg = tea.KeyPressMsg{Code: tea.KeyTab, Mod: tea.ModShift}
		case "up":
			msg = tea.KeyPressMsg{Code: tea.KeyUp}
		case "down":
			msg = tea.KeyPressMsg{Code: tea.KeyDown}
		case "left":
			msg = tea.KeyPressMsg{Code: tea.KeyLeft}
		case "backspace":
			msg = tea.KeyPressMsg{Code: tea.KeyBackspace}
		case "ctrl+c":
			msg = tea.KeyPressMsg{Code: 'c', Mod: tea.ModCtrl}
		case "ctrl+j":
			msg = tea.KeyPressMsg{Code: 'j', Mod: tea.ModCtrl}
		default:
			for _, r := range k {
				_, last = f.Update(tea.KeyPressMsg{Code: r, Text: string(r)})
			}
			continue
		}
		_, last = f.Update(msg)
	}
	return last
}

func isQuit(cmd tea.Cmd) bool {
	if cmd == nil {
		return false
	}
	_, ok := cmd().(tea.QuitMsg)
	return ok
}

func required(v string) error {
	if strings.TrimSpace(v) == "" {
		return errors.New("required")
	}
	return nil
}

func TestFormStepsThroughPagesAndSubmits(t *testing.T) {
	var token, user, format string
	f := New(
		NewPage("Authentication",
			NewInput(&token).Title("Token").Password(),
			NewInput(&user).Title("User").Placeholder("alice"),
		),
		NewPage("Preferences",
			NewSelect(&format, NewOption("Keep current", ""), NewOption("json", "json"), NewOption("yaml", "yaml")).Title("Format"),
		),
	)
	f.Init()

	press(f, "secret", "tab", "bob", "shift+tab", "!", "enter", "enter")
	if f.page != 1 {
		t.Fatalf("expected the second page, got page %d", f.page)
	}
	if !strings.Contains(f.render(), "Preferences") || strings.Contains(f.render(), "Authentication") {
		t.Fatalf("expected only the second page to render:\n%s", f.render())
	}
	press(f, "down", "down", "down", "up")
	if !isQuit(press(f, "enter")) {
		t.Fatal("enter on the last field should submit")
	}
	if token != "secret!" || user != "bob" || format != "yaml" {
		t.Fatalf("got token=%q user=%q format=%q", token, user, format)
	}
	if strings.Contains(f.render(), "secret") {
		t.Fatal("password input must not render its value")
	}
}

func TestTabDoesNotSubmitFromLastField(t *testing.T) {
	var v string
	f := New(NewPage("", NewInput(&v)))
	f.Init()
	if press(f, "tab") != nil || f.finished {
		t.Fatal("tab on the last field should do nothing")
	}
}

func TestValidationBlocksMovingForward(t *testing.T) {
	var a, b string
	f := New(NewPage("", NewInput(&a).Title("A").Validate(required), NewInput(&b).Title("B")))
	f.Init()

	press(f, "enter")
	if f.field != 0 || !strings.Contains(f.render(), "required") {
		t.Fatalf("expected to stay on A with an error, field=%d\n%s", f.field, f.render())
	}
	press(f, "x")
	if strings.Contains(f.render(), "required") {
		t.Fatal("typing should clear the error")
	}
	press(f, "enter")
	if f.field != 1 {
		t.Fatalf("expected to move to B, field=%d", f.field)
	}
	press(f, "shift+tab")
	if f.field != 0 {
		t.Fatal("shift+tab should move back without validating")
	}
}

func TestTextInsertsNewlinesAndEnterMovesOn(t *testing.T) {
	var body string
	f := New(NewPage("", NewText(&body).Validate(required)))
	f.Init()
	press(f, `{"a":`, "ctrl+j", "1}")
	if !isQuit(press(f, "enter")) {
		t.Fatal("enter should submit the text field")
	}
	if body != "{\"a\":\n1}" {
		t.Fatalf("got %q", body)
	}
}

func TestConfirmKeys(t *testing.T) {
	var yes bool
	f := New(NewPage("", NewConfirm(&yes).Title("Continue?")))
	f.Init()
	press(f, "left")
	if !yes {
		t.Fatal("left should toggle")
	}
	if !isQuit(press(f, "n")) || yes {
		t.Fatal("n should answer no and submit")
	}
	yes = false
	f = New(NewPage("", NewConfirm(&yes)))
	f.Init()
	if !isQuit(press(f, "y")) || !yes {
		t.Fatal("y should answer yes and submit")
	}
}

func TestSelectStartsAtCurrentValueAndWraps(t *testing.T) {
	v := "b"
	f := New(NewPage("", NewSelect(&v, NewOption("A", "a"), NewOption("B", "b"), NewOption("C", "c"))))
	f.Init()
	press(f, "down", "down")
	if v != "a" {
		t.Fatalf("expected the cursor to wrap to a, got %q", v)
	}
}

func TestSelectWindowFitsTerminalHeight(t *testing.T) {
	var v string
	options := make([]Option, 40)
	for i := range options {
		options[i] = NewOption("option-"+string(rune('A'+i%26)), string(rune('a'+i%26)))
	}
	f := New(NewPage("", NewSelect(&v, options...)))
	f.Init()
	f.Update(tea.WindowSizeMsg{Width: 80, Height: 12})
	if lines := strings.Count(f.render(), "\n") + 1; lines > 12 {
		t.Fatalf("rendered %d lines for a 12-line terminal", lines)
	}
}

func TestCtrlCAborts(t *testing.T) {
	var v string
	f := New(NewPage("", NewInput(&v)))
	f.Init()
	if !isQuit(press(f, "ctrl+c")) || !f.aborted {
		t.Fatal("ctrl+c should abort")
	}
}

func TestPrompts(t *testing.T) {
	tests := []struct {
		name  string
		input string
		build func() (*Form, func() string)
		want  string
		out   []string
	}{
		{
			name:  "input keeps current value on blank answer",
			input: "\n",
			build: func() (*Form, func() string) {
				v := "kept"
				return New(NewPage("", NewInput(&v).Title("Name"))), func() string { return v }
			},
			want: "kept",
			out:  []string{"Name\n> "},
		},
		{
			name:  "input re-asks until valid",
			input: "\n  \nok\n",
			build: func() (*Form, func() string) {
				var v string
				return New(NewPage("", NewInput(&v).Validate(required))), func() string { return v }
			},
			want: "ok",
			out:  []string{"required\n> required\n> "},
		},
		{
			name:  "secret read from a pipe is not echoed",
			input: "s3cret\n",
			build: func() (*Form, func() string) {
				var v string
				return New(NewPage("", NewInput(&v).Title("Token").Password())), func() string { return v }
			},
			want: "s3cret",
		},
		{
			name:  "select by number",
			input: "9\n2\n",
			build: func() (*Form, func() string) {
				var v string
				return New(NewPage("", NewSelect(&v, NewOption("A", "a"), NewOption("B", "b")).Title("Pick"))), func() string { return v }
			},
			want: "b",
			out:  []string{"Pick\n  1. A\n  2. B\nChoose 1-2 [1]: Enter a number from 1 to 2.\n"},
		},
		{
			name:  "confirm",
			input: "maybe\nyes\n",
			build: func() (*Form, func() string) {
				var v bool
				return New(NewPage("", NewConfirm(&v).Title("Sure?"))), func() string {
					if v {
						return "yes"
					}
					return "no"
				}
			},
			want: "yes",
			out:  []string{"[y/N]: Answer y or n.\n"},
		},
		{
			name:  "end of input stops asking",
			input: "first\n",
			build: func() (*Form, func() string) {
				var a, b string
				f := New(NewPage("", NewInput(&a).Title("A"), NewInput(&b).Title("B").Validate(required)))
				return f, func() string { return a + "|" + b }
			},
			want: "first|",
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			f, got := tt.build()
			var out bytes.Buffer
			f.prompt(&out, strings.NewReader(tt.input))
			if got() != tt.want {
				t.Fatalf("got %q, want %q", got(), tt.want)
			}
			for _, s := range tt.out {
				if !strings.Contains(out.String(), s) {
					t.Fatalf("output %q does not contain %q", out.String(), s)
				}
			}
			if strings.Contains(out.String(), "s3cret") {
				t.Fatal("secret was echoed")
			}
		})
	}
}
{{- end}}
