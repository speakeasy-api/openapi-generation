{{- if anyOperationHasBinary}}
// Package output — binary response support.
// This file is generated only when at least one operation has a binary response.
package output

import (
	"encoding/base64"
	"fmt"
	"io"
	"os"
	"path/filepath"

	"github.com/spf13/cobra"
	"golang.org/x/term"

	"{{getGolangPackage}}/internal/flagutil"
)

// WriteToFile writes response content to a file path.
// Works for any content type (binary or structured), but primarily intended
// for binary downloads.
func WriteToFile(cmd *cobra.Command, res interface{}, path string) error {
	if flagutil.DidDryRunRequest(cmd) {
		return nil
	}
	content := extractResultContent(res)

	f, err := os.Create(path)
	if err != nil {
		return fmt.Errorf("failed to create output file: %w", err)
	}
	closed := false
	defer func() {
		if !closed {
			_ = f.Close()
		}
	}()

	switch c := content.(type) {
	case io.ReadCloser:
		defer c.Close()
		_, err := io.Copy(f, c)
		if err != nil {
			return fmt.Errorf("failed to write to output file: %w", err)
		}
	case []byte:
		if _, err := f.Write(c); err != nil {
			return fmt.Errorf("failed to write to output file: %w", err)
		}
	case nil:
	default:
		// Non-binary: marshal to JSON and write
		data, err := marshalJSON(content)
		if err != nil {
			return err
		}
		if _, err := f.Write(data); err != nil {
			return fmt.Errorf("failed to write to output file: %w", err)
		}
	}
	if err := f.Close(); err != nil {
		return fmt.Errorf("failed to close output file: %w", err)
	}
	closed = true

	absPath, err := filepath.Abs(path)
	if err != nil {
		absPath = path
	}
	written, err := os.Stat(absPath)
	if err != nil {
		return fmt.Errorf("failed to verify output file: %w", err)
	}
	if !IsMachineMode(cmd) {
		fmt.Fprintf(cmd.ErrOrStderr(), "Wrote %s (%d bytes)%s", absPath, written.Size(), string(rune(10)))
	}
	return renderPathEnvelope(cmd, absPath, map[string]interface{}{
		"path":       absPath,
		"size_bytes": written.Size(),
	})
}

// WriteBase64 encodes binary response content as base64 and prints it to stdout.
// For streamed responses (io.ReadCloser), encoding is performed incrementally
// to avoid buffering the entire payload in memory.
func WriteBase64(cmd *cobra.Command, res interface{}) error {
	if flagutil.DidDryRunRequest(cmd) {
		return nil
	}
	content := extractResultContent(res)
	if content == nil {
		return nil
	}

	w := cmd.OutOrStdout()

	switch c := content.(type) {
	case io.ReadCloser:
		defer c.Close()
		enc := base64.NewEncoder(base64.StdEncoding, w)
		if _, err := io.Copy(enc, c); err != nil {
			_ = enc.Close()
			return fmt.Errorf("failed to stream binary response: %w", err)
		}
		if err := enc.Close(); err != nil {
			return fmt.Errorf("failed to finalize base64 encoding: %w", err)
		}
		fmt.Fprintln(w)
	case []byte:
		fmt.Fprintln(w, base64.StdEncoding.EncodeToString(c))
	default:
		data, err := marshalJSON(content)
		if err != nil {
			return err
		}
		fmt.Fprintln(w, base64.StdEncoding.EncodeToString(data))
	}

	return nil
}

// IsBinaryTTYBlocked returns true if the response has binary content AND
// stdout is an interactive terminal. Used by binary-only operations to
// prevent dumping binary to the terminal.
func IsBinaryTTYBlocked(cmd *cobra.Command, res interface{}) bool {
	content := extractResultContent(res)
	if content == nil {
		return false
	}
	isBinary := false
	switch content.(type) {
	case io.ReadCloser, []byte:
		isBinary = true
	}
	if !isBinary {
		return false
	}
	return isInteractiveTTY(cmd.OutOrStdout())
}

// isInteractiveTTY checks if a writer is connected to an interactive terminal.
// Returns false for buffers, pipes, and redirected file descriptors.
func isInteractiveTTY(w io.Writer) bool {
	type fder interface {
		Fd() uintptr
	}
	if f, ok := w.(fder); ok {
		return term.IsTerminal(int(f.Fd()))
	}
	return false
}
{{- end}}
