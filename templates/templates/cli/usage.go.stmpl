{{- recurse 1 -}}
{{- addImport "fmt" -}}
{{- addImport "io" -}}
{{- addImport "encoding/json" -}}
{{- addImport "strings" -}}
{{- addImport "sync" -}}
{{- addImport "github.com/spf13/cobra" -}}
{{- addImport "github.com/spf13/pflag" -}}
package usage

{{genImports}}

type usageItem struct {
	key      string
	text     string
	settings bool
	hidden   bool
}

type usageNode struct {
	head     string
	aliases  []usageItem
	args     []usageItem
	flags    []usageItem
	children []string
}

{{templateUsageNodeMap}}

func UsageRequested(cmd *cobra.Command) bool {
	if cmd == nil {
		return false
	}
	if flag := cmd.Flags().Lookup("usage"); flag != nil {
		value, err := cmd.Flags().GetBool("usage")
		return err == nil && value
	}
	if flag := cmd.InheritedFlags().Lookup("usage"); flag != nil {
		value, err := cmd.InheritedFlags().GetBool("usage")
		return err == nil && value
	}
	return false
}

// DisarmRequiredFlags clears cobra's required-flag annotations so a --usage
// invocation answers with the command's schema even when required inputs are
// absent: requiredness is part of the answer, not a precondition for asking.
// Cobra validates the same annotations itself after the pre-run hooks, so
// skipping the CLI's own eager validation alone would not be enough. The
// cleared annotations are kept aside for RearmRequiredFlags, so a reused
// command tree keeps enforcing requiredness on later executions.
func DisarmRequiredFlags(cmd *cobra.Command) {
	saved := map[*pflag.Flag][]string{}
	cmd.Flags().VisitAll(func(f *pflag.Flag) {
		if values, ok := f.Annotations[cobra.BashCompOneRequiredFlag]; ok {
			saved[f] = values
			delete(f.Annotations, cobra.BashCompOneRequiredFlag)
		}
	})
	if len(saved) > 0 {
		disarmedRequiredFlags.Store(cmd, saved)
	}
}

// RearmRequiredFlags restores the annotations DisarmRequiredFlags removed.
func RearmRequiredFlags(cmd *cobra.Command) {
	value, ok := disarmedRequiredFlags.LoadAndDelete(cmd)
	if !ok {
		return
	}
	for f, values := range value.(map[*pflag.Flag][]string) {
		if f.Annotations == nil {
			f.Annotations = map[string][]string{}
		}
		f.Annotations[cobra.BashCompOneRequiredFlag] = values
	}
}

var disarmedRequiredFlags sync.Map

func selectedCommandPath(cmd *cobra.Command) []string {
	if cmd == nil {
		return nil
	}
	parts := []string{}
	for cur := cmd; cur != nil; cur = cur.Parent() {
		if cur.Name() == "" {
			continue
		}
		if cur.Parent() == nil {
			continue
		}
		parts = append([]string{cur.Name()}, parts...)
	}
	return parts
}

func EmitSchema(cmd *cobra.Command, w io.Writer) error {
	var b strings.Builder
	tabled := cmd.Root().Name() == usageRootName
	renderUsageNode(&b, cmd, strings.Join(selectedCommandPath(cmd), " "), 0, true, tabled)
	_, err := io.WriteString(w, b.String())
	return err
}

const (
	usageDynamicAnnotation   = "speakeasy_usage_dynamic"
	usageGeneratedAnnotation = "speakeasy_usage_generated"
	usageRootName            = "{{sanitizeCliName}}"
)

func renderUsageNode(b *strings.Builder, cmd *cobra.Command, path string, indent int, own, tabled bool) {
	isRoot := tabled && cmd.Parent() == nil
	var node usageNode
	static := false
	if tabled {
		node, static = usageNodes[path]
	}
	if static && !isRoot && cmd.Annotations[usageGeneratedAnnotation] != usageFlagSetIdentity(cmd) {
		node, static = usageNode{children: node.children}, false
	}
	dynamic := !static || cmd.Annotations[usageDynamicAnnotation] == "true"
	itemPrefix := "  "
	if isRoot {
		itemPrefix = ""
	}
	head := node.head
	if dynamic && !isRoot {
		head = "cmd " + kdlQuote(cmd.Name()) + " help=" + kdlQuoteAt(cmd.Short, "  ")
	}
	var body []string
	if dynamic {
		body = mergedUsageBody(cmd, node, own, itemPrefix)
	} else {
		body = staticUsageBody(node, own)
	}
	children := usageChildren(cmd, node.children)
	block := !isRoot && (len(body) > 0 || len(children) > 0)

	writeUsageIndented(b, head, indent)
	if block {
		b.WriteString(" {")
	}
	b.WriteByte('\n')
	for _, item := range body {
		writeUsageIndented(b, item, indent)
		b.WriteByte('\n')
	}
	childIndent := indent + 1
	if isRoot {
		childIndent = indent
	}
	for _, child := range children {
		childPath := child.Name()
		if path != "" {
			childPath = path + " " + childPath
		}
		renderUsageNode(b, child, childPath, childIndent, false, tabled)
	}
	if block {
		b.WriteString(strings.Repeat("  ", indent) + "}\n")
	}
}

// Settings flags are declared once on the root, so only a command's own schema lists them.
func staticUsageBody(node usageNode, own bool) []string {
	var body []string
	for _, alias := range node.aliases {
		body = append(body, alias.text)
	}
	for _, arg := range node.args {
		body = append(body, arg.text)
	}
	for _, flag := range node.flags {
		if own || !flag.settings {
			body = append(body, flag.text)
		}
	}
	return body
}

func mergedUsageBody(cmd *cobra.Command, node usageNode, own bool, prefix string) []string {
	local := cmd.LocalFlags()
	var body []string
	listed := map[string]bool{}
	for _, alias := range node.aliases {
		listed[alias.key] = true
		if cmd.HasAlias(alias.key) {
			body = append(body, alias.text)
		}
	}
	for _, alias := range cmd.Aliases {
		if !listed[alias] {
			body = append(body, prefix+"alias "+kdlQuote(alias))
		}
	}
	if usageArgsUnchanged(node.args, usagePromptArgs(cmd)) {
		for _, arg := range node.args {
			body = append(body, arg.text)
		}
	} else {
		body = append(body, liveUsageArgs(cmd, prefix)...)
	}
	listed = map[string]bool{}
	for _, flag := range node.flags {
		listed[flag.key] = true
		f := cmd.Flags().Lookup(flag.key)
		if f != nil && (own || !flag.settings) && (flag.hidden || !f.Hidden) {
			body = append(body, flag.text)
		}
	}
	local.VisitAll(func(f *pflag.Flag) {
		if !f.Hidden && f.Name != "help" && !listed[f.Name] {
			body = append(body, liveUsageFlag(f, prefix))
		}
	})
	return body
}

func usageChildren(cmd *cobra.Command, declared []string) []*cobra.Command {
	var children []*cobra.Command
	listed := map[string]bool{}
	for _, name := range declared {
		listed[name] = true
		for _, child := range cmd.Commands() {
			if child.Name() == name && !child.Hidden {
				children = append(children, child)
				break
			}
		}
	}
	for _, child := range cmd.Commands() {
		if !listed[child.Name()] && child.IsAvailableCommand() {
			children = append(children, child)
		}
	}
	return children
}

// KDL multi-line strings keep empty lines unindented, so re-indenting skips them.
func writeUsageIndented(b *strings.Builder, text string, indent int) {
	prefix := strings.Repeat("  ", indent)
	for i, line := range strings.Split(text, "\n") {
		if i > 0 {
			b.WriteByte('\n')
		}
		if line != "" {
			b.WriteString(prefix + line)
		}
	}
}

// MarkDynamic makes --usage render a generated command's runtime help, aliases,
// args and added flags from its cobra definition, keeping generated lines for
// the inputs it still has.
func MarkDynamic(cmd *cobra.Command) {
	if cmd.Annotations == nil {
		cmd.Annotations = map[string]string{}
	}
	cmd.Annotations[usageDynamicAnnotation] = "true"
}

// MarkGenerated records cmd and its subtree as the generated commands the
// usageNodes table describes; a same-named command attached later, or a marked
// command whose flag sets are replaced, renders live.
func MarkGenerated(cmd *cobra.Command) {
	if cmd.Annotations == nil {
		cmd.Annotations = map[string]string{}
	}
	cmd.Annotations[usageGeneratedAnnotation] = usageFlagSetIdentity(cmd)
	for _, child := range cmd.Commands() {
		MarkGenerated(child)
	}
}

// InitDefaultCommands creates cobra's default help and completion commands and
// marks only the ones cobra created, leaving a custom command of the same name live.
func InitDefaultCommands(root *cobra.Command) {
	existing := map[*cobra.Command]bool{}
	for _, cmd := range root.Commands() {
		existing[cmd] = true
	}
	root.InitDefaultHelpCmd()
	root.InitDefaultCompletionCmd()
	for _, cmd := range root.Commands() {
		if !existing[cmd] {
			MarkGenerated(cmd)
		}
	}
}

func usageFlagSetIdentity(cmd *cobra.Command) string {
	return fmt.Sprintf("%p %p", cmd.Flags(), cmd.PersistentFlags())
}

// Go's %q emits \a, \v, and \xNN escapes that KDL v2 does not define.
func kdlQuote(s string) string {
	var b strings.Builder
	b.WriteByte('"')
	for _, r := range s {
		switch r {
		case '\\':
			b.WriteString(`\\`)
		case '"':
			b.WriteString(`\"`)
		case '\n':
			b.WriteString(`\n`)
		case '\r':
			b.WriteString(`\r`)
		case '\t':
			b.WriteString(`\t`)
		default:
			if r < 0x20 || r == 0x7f || r == 0x85 ||
				r == 0x200e || r == 0x200f || r == 0x2028 || r == 0x2029 ||
				(r >= 0x202a && r <= 0x202e) || (r >= 0x2066 && r <= 0x2069) ||
				r == 0xfeff {
				fmt.Fprintf(&b, `\u{%x}`, r)
			} else {
				b.WriteRune(r)
			}
		}
	}
	b.WriteByte('"')
	return b.String()
}

// Two consecutive quotes are legal inside a KDL """ string; a third would terminate it.
func kdlEscapeMultilineLine(line string) string {
	var b strings.Builder
	quoteRun := 0
	for _, r := range line {
		if r == '"' {
			quoteRun++
			if quoteRun == 3 {
				b.WriteString(`\"`)
				quoteRun = 0
				continue
			}
			b.WriteByte('"')
			continue
		}
		quoteRun = 0
		switch r {
		case '\\':
			b.WriteString(`\\`)
		case '\r':
			b.WriteString(`\r`)
		case '\t':
			b.WriteString(`\t`)
		default:
			if r < 0x20 || r == 0x7f || r == 0x85 ||
				r == 0x200e || r == 0x200f || r == 0x2028 || r == 0x2029 ||
				(r >= 0x202a && r <= 0x202e) || (r >= 0x2066 && r <= 0x2069) ||
				r == 0xfeff {
				fmt.Fprintf(&b, `\u{%x}`, r)
			} else {
				b.WriteRune(r)
			}
		}
	}
	return b.String()
}

// KDL dedent strips the closing line's indent from every line and empties whitespace-only lines.
func kdlQuoteAt(s, contentPrefix string) string {
	if !strings.Contains(s, "\n") {
		return kdlQuote(s)
	}
	lines := strings.Split(s, "\n")
	for _, line := range lines {
		if line != "" && (strings.TrimSpace(line) == "" || strings.TrimRight(line, " \t") != line) {
			return kdlQuote(s)
		}
	}
	var b strings.Builder
	b.WriteString("\"\"\"\n")
	for _, line := range lines {
		if line != "" {
			b.WriteString(contentPrefix)
			b.WriteString(kdlEscapeMultilineLine(line))
		}
		b.WriteByte('\n')
	}
	b.WriteString(contentPrefix)
	b.WriteString(`"""`)
	return b.String()
}

func usageArgsUnchanged(generated []usageItem, live []usagePromptArg) bool {
	if len(generated) == 0 || len(generated) != len(live) {
		return false
	}
	for i, arg := range generated {
		if arg.key != live[i].Name {
			return false
		}
	}
	return true
}

type usagePromptArg struct {
	Name     string `json:"name"`
	Summary  string `json:"summary"`
	Required bool   `json:"required"`
	Variadic bool   `json:"variadic"`
}

func usagePromptArgs(cmd *cobra.Command) []usagePromptArg {
	var promptArgs struct {
		Version int              `json:"version"`
		Args    []usagePromptArg `json:"args"`
	}
	if raw := cmd.Annotations["speakeasy_prompt_args"]; raw == "" || json.Unmarshal([]byte(raw), &promptArgs) != nil || promptArgs.Version != 1 {
		return nil
	}
	return promptArgs.Args
}

func liveUsageArgs(cmd *cobra.Command, prefix string) []string {
	if promptArgs := usagePromptArgs(cmd); promptArgs != nil {
		var lines []string
		for _, arg := range promptArgs {
			line := prefix + "arg " + kdlQuote(arg.Name)
			if arg.Summary != "" {
				line += " help=" + kdlQuoteAt(arg.Summary, prefix+"  ")
			}
			if arg.Required {
				line += " required=#true"
			}
			if arg.Variadic {
				line += " var=#true"
			}
			lines = append(lines, line)
		}
		return lines
	}
	if args := cmd.Annotations["speakeasy_args_help"]; args != "" {
		return []string{prefix + "args " + kdlQuoteAt(args, prefix+"  ")}
	}
	return nil
}

func liveUsageFlag(f *pflag.Flag, prefix string) string {
	name := "--" + f.Name
	if f.Shorthand != "" {
		name = "-" + f.Shorthand + " " + name
	}
	_, repeatable := f.Value.(pflag.SliceValue)
	if f.Value.Type() != "bool" {
		placeholder := strings.ReplaceAll(f.Name, "-", "_")
		if repeatable {
			placeholder += "..."
		}
		name += " <" + placeholder + ">"
	}
	line := prefix + "flag " + kdlQuote(name) + " help=" + kdlQuoteAt(f.Usage, prefix+"  ")
	if repeatable {
		line += " var=#true"
	}
	return line
}

func Intercept(root *cobra.Command) {
	for _, child := range root.Commands() {
		Intercept(child)
	}
	if root.RunE == nil && root.Run == nil && root.Args == nil && root.HasSubCommands() {
		if root.Annotations == nil {
			root.Annotations = make(map[string]string)
		}
		root.Annotations[usageSynthesizedGroupAnnotation] = "true"
	}
	root.PersistentPreRunE = skipOnUsageE(root.PersistentPreRunE, root.PersistentPreRun)
	root.PersistentPreRun = nil
	root.PreRunE = skipOnUsageE(root.PreRunE, root.PreRun)
	root.PreRun = nil
	root.PostRunE = skipOnUsageE(root.PostRunE, root.PostRun)
	root.PostRun = nil
	root.PersistentPostRunE = skipOnUsageE(root.PersistentPostRunE, root.PersistentPostRun)
	root.PersistentPostRun = nil

	runE, run := root.RunE, root.Run
	root.Run = nil
	root.RunE = func(cmd *cobra.Command, args []string) error {
		if UsageRequested(cmd) {
			return EmitSchema(cmd, cmd.OutOrStdout())
		}
		if runE != nil {
			return runE(cmd, args)
		}
		if run != nil {
			run(cmd, args)
			return nil
		}
		return cmd.Help()
	}
}

const usageSynthesizedGroupAnnotation = "speakeasy_usage_synthesized_group"

func GroupMadeRunnable(cmd *cobra.Command) bool {
	return cmd != nil && cmd.Annotations[usageSynthesizedGroupAnnotation] == "true"
}

// Returning nil rather than a wrapper keeps Cobra's nearest-PersistentPreRunE lookup intact.
func skipOnUsageE(hookE func(*cobra.Command, []string) error, hook func(*cobra.Command, []string)) func(*cobra.Command, []string) error {
	if hookE == nil && hook == nil {
		return nil
	}
	return func(cmd *cobra.Command, args []string) error {
		if UsageRequested(cmd) {
			return nil
		}
		if hookE != nil {
			return hookE(cmd, args)
		}
		hook(cmd, args)
		return nil
	}
}
