package interactive

import (
	"bytes"
	"testing"

	"github.com/spf13/cobra"

	"{{getGolangPackage}}/internal/output"
)

func newPolicyTestCommand(t *testing.T, flags map[string]string) *cobra.Command {
	t.Helper()
	output.ResetAgentMode()
	t.Cleanup(output.ResetAgentMode)

	root := &cobra.Command{Use: "test"}
	cmd := &cobra.Command{Use: "leaf"}
	root.AddCommand(cmd)
	root.PersistentFlags().Bool("interactive", {{interactiveByDefault}}, "")
	root.PersistentFlags().Bool("no-interactive", false, "")
	root.PersistentFlags().Bool("agent-mode", false, "")
	cmd.SetIn(bytes.NewBuffer(nil))
	cmd.SetOut(bytes.NewBuffer(nil))
	if err := root.PersistentFlags().Set("agent-mode", "false"); err != nil {
		t.Fatalf("disable environment-detected agent mode: %v", err)
	}
	for name, value := range flags {
		if err := root.PersistentFlags().Set(name, value); err != nil {
			t.Fatalf("set --%s: %v", name, err)
		}
	}
	_ = cmd.InheritedFlags()
	return cmd
}

func TestResolveKeepsPolicySeparateFromPromptInjection(t *testing.T) {
	originalHook := promptFromContext
	promptFromContext = func(*cobra.Command) bool { return true }
	t.Cleanup(func() { promptFromContext = originalHook })

	decision := Resolve(newPolicyTestCommand(t, nil))
	if decision.requested != {{interactiveByDefault}} {
		t.Fatalf("requested = %v, want configured default {{interactiveByDefault}}", decision.requested)
	}
	if decision.PromptRequiredInputs() != {{interactiveByDefault}} {
		t.Fatalf("PromptRequiredInputs = %v, want {{interactiveByDefault}}", decision.PromptRequiredInputs())
	}
	if IsInteractive(newPolicyTestCommand(t, nil)) != {{interactiveByDefault}} {
		t.Fatal("IsInteractive must remain a thin PromptRequiredInputs wrapper")
	}
}

func TestResolveExplicitPrecedence(t *testing.T) {
	originalHook := promptFromContext
	promptFromContext = func(*cobra.Command) bool { return true }
	t.Cleanup(func() { promptFromContext = originalHook })

	requested := Resolve(newPolicyTestCommand(t, map[string]string{"interactive": "true"}))
	if !requested.requested || !requested.PromptRequiredInputs() {
		t.Fatal("--interactive must request prompting when the test hook supplies terminal capability")
	}

	for name, flags := range map[string]map[string]string{
		"no-interactive":    {"interactive": "true", "no-interactive": "true"},
		"interactive-false": {"interactive": "false"},
		"agent-mode":        {"interactive": "true", "agent-mode": "true"},
	} {
		t.Run(name, func(t *testing.T) {
			decision := Resolve(newPolicyTestCommand(t, flags))
			if decision.requested || decision.PromptRequiredInputs() {
				t.Fatalf("kill switch did not suppress interaction: %+v", decision)
			}
		})
	}
}

func TestDecisionSurfaceRequirements(t *testing.T) {
	if (Decision{requested: true, hasInjectedPrompter: true}).AutoExplore() {
		t.Fatal("an injected operation prompter must not substitute for explorer terminal IO")
	}
	if !(Decision{requested: true, terminalPair: true}).AutoExplore() {
		t.Fatal("requested terminal interaction should allow auto-explore")
	}
	if mode := (Decision{requested: true}).FormMode(); mode != FormAccessible {
		t.Fatalf("off-TTY requested forms should be accessible, got %v", mode)
	}
	if mode := (Decision{requested: true, terminalPair: true}).FormMode(); mode != FormTUI {
		t.Fatalf("terminal forms should use TUI mode, got %v", mode)
	}
	if mode := (Decision{}).FormMode(); mode != FormOff {
		t.Fatalf("unrequested forms should be disabled, got %v", mode)
	}
}

func TestDirectExploreValidation(t *testing.T) {
	if got := (Decision{terminalPair: true, explicitNoInteractive: true}).ValidateDirectExplore(); got == nil || got.Error() != "explore conflicts with --no-interactive/--interactive=false" {
		t.Fatalf("unexpected conflict error: %v", got)
	}
	if got := (Decision{}).ValidateDirectExplore(); got == nil || got.Error() != "explore requires an interactive terminal (stdin and stdout must be a TTY)" {
		t.Fatalf("unexpected terminal error: %v", got)
	}
	if err := (Decision{terminalPair: true}).ValidateDirectExplore(); err != nil {
		t.Fatalf("terminal direct explore should be allowed: %v", err)
	}
}
