package tests

import (
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

func TestBasicAuthFlattenedGlobal(t *testing.T) {
	recordTest("auth-basic-auth-flattened-global")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"auth", "basic-auth-global",
		"--username", "testUser",
		"--password", "testPass",
	})
	require.NoError(t, err)

	output := h.GetStdout()
	assert.Equal(t, true, jsonGetBool(output, "authenticated"))
	assert.Equal(t, "testUser", jsonGetString(output, "user"))
}

