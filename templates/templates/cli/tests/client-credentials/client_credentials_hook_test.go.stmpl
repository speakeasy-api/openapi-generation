package tests

import (
	"net/http"
	"net/http/httptest"
	"sync"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// Client-credentials tests use RunBare() (no --server-url override) so the SDK
// uses its default server (speakeasy-api-test-service) which handles the
// /clientcredentials/token endpoint. The generated mock server does not handle
// OAuth2 token endpoints.
//
// The authenticated-request operations return no body (only HTTP status), so
// we assert on success (no error) rather than output content.

func TestClientCredentials_HookSuccessfullyAuthenticates(t *testing.T) {
	recordTest("hooks-client-credentials-success")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"hooks", "authenticated-request",
		"--client-id", "speakeasy-sdks",
		"--client-secret", "supersecret-test",
	})
	require.NoError(t, err)
}

func TestClientCredentials_HookSuccessfullyAuthenticatesGlobalServer(t *testing.T) {
	recordTest("hooks-client-credentials-success-global-server")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"hooks", "authenticated-request-global-server",
		"--client-id", "speakeasy-sdks",
		"--client-secret", "supersecret-test",
	})
	require.NoError(t, err)
}

func TestClientCredentials_HookMissingScopes(t *testing.T) {
	recordTest("hooks-client-credentials-no-scopes")

	h := NewCLITestHarness(t)
	// The no-scopes operation should fail because the token endpoint requires
	// 'read' and 'write' scopes but this operation does not specify any.
	err := h.RunBare([]string{
		"hooks", "authenticated-request-no-scopes",
		"--client-id", "speakeasy-sdks",
		"--client-secret", "supersecret-test",
	})
	require.Error(t, err)
	assert.Contains(t, err.Error(), "empty_scopes")
}

func TestClientCredentials_HookLowercaseBearerToken(t *testing.T) {
	recordTest("hooks-client-credentials-lowercase-bearer")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"hooks", "authenticated-request",
		"--client-id", "speakeasy-sdks",
		"--client-secret", "supersecret-test",
		"--token-url", "/clientcredentials/token?token_type=bearer",
	})
	require.NoError(t, err)
}

func TestClientCredentials_RepeatedHeadersReachOnlyTheOperation(t *testing.T) {
	var mu sync.Mutex
	var tokenHeaders, apiHeaders http.Header
	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		mu.Lock()
		defer mu.Unlock()
		if r.URL.Path == "/clientcredentials/token" {
			tokenHeaders = r.Header.Clone()
			w.Header().Set("Content-Type", "application/json")
			_, _ = w.Write([]byte(`{"access_token":"test-token","token_type":"Bearer","expires_in":3600}`))
			return
		}
		apiHeaders = r.Header.Clone()
		w.WriteHeader(http.StatusOK)
	}))
	t.Cleanup(s.Close)

	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, []string{
		"hooks", "authenticated-request",
		"--client-id", "repeated-headers-client",
		"--client-secret", "supersecret-test",
		"-H", "X-Api-Key: a", "-H", "X-Api-Key: b",
		"-H", "Content-Type: application/json", "-H", "Content-Type: text/plain",
		"-H", "Authorization: user-a", "-H", "Authorization: user-b",
	}), h.GetStderr())

	mu.Lock()
	defer mu.Unlock()
	require.NotNil(t, tokenHeaders, "token endpoint was not called")
	require.NotNil(t, apiHeaders, "operation endpoint was not called")

	assert.Equal(t, []string{"a", "b"}, apiHeaders.Values("X-Api-Key"))
	assert.Equal(t, []string{"application/json", "text/plain"}, apiHeaders.Values("Content-Type"))
	assert.Equal(t, []string{"user-a", "user-b"}, apiHeaders.Values("Authorization"))
	assert.Empty(t, apiHeaders.Values("X-Cli-Repeated-Headers"))

	assert.Empty(t, tokenHeaders.Values("X-Api-Key"))
	assert.Equal(t, []string{"application/x-www-form-urlencoded"}, tokenHeaders.Values("Content-Type"))
	assert.NotContains(t, tokenHeaders.Values("Authorization"), "user-a")
	assert.NotContains(t, tokenHeaders.Values("Authorization"), "user-b")
	assert.Empty(t, tokenHeaders.Values("X-Cli-Repeated-Headers"))
}

func TestClientCredentials_HookAltTokenURL(t *testing.T) {
	recordTest("hooks-client-credentials-success-alt-token-url")

	h := NewCLITestHarness(t)
	// Use the alternate token endpoint with non-default scopes.
	// The alt endpoint expects "alt:one" and "alt:two" scopes.
	err := h.RunBare([]string{
		"hooks", "authenticated-request",
		"--client-id", "speakeasy-sdks",
		"--client-secret", "supersecret-test",
		"--token-url", "/clientcredentials/alt/token",
		"--scopes", "alt:one,alt:two",
	})
	require.NoError(t, err)
}
