package tests

import (
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// Client-credentials tests use RunBare() (no --server-url override) so the SDK
// uses its default server (speakeasy-api-test-service) which handles the
// /clientcredentials/token endpoint. The generated mock server does not handle
// OAuth2 token endpoints.
//
// The authenticated-request operations return no body (only HTTP status), so
// we assert on success (no error) rather than output content.

func TestClientCredentials_HookSuccessfullyAuthenticates(t *testing.T) {
	recordTest("hooks-client-credentials-success")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"hooks", "authenticated-request",
		"--client-id", "speakeasy-sdks",
		"--client-secret", "supersecret-test",
	})
	require.NoError(t, err)
}

func TestClientCredentials_HookSuccessfullyAuthenticatesGlobalServer(t *testing.T) {
	recordTest("hooks-client-credentials-success-global-server")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"hooks", "authenticated-request-global-server",
		"--client-id", "speakeasy-sdks",
		"--client-secret", "supersecret-test",
	})
	require.NoError(t, err)
}

func TestClientCredentials_HookMissingScopes(t *testing.T) {
	recordTest("hooks-client-credentials-no-scopes")

	h := NewCLITestHarness(t)
	// The no-scopes operation should fail because the token endpoint requires
	// 'read' and 'write' scopes but this operation does not specify any.
	err := h.RunBare([]string{
		"hooks", "authenticated-request-no-scopes",
		"--client-id", "speakeasy-sdks",
		"--client-secret", "supersecret-test",
	})
	require.Error(t, err)
	assert.Contains(t, err.Error(), "empty_scopes")
}

func TestClientCredentials_HookLowercaseBearerToken(t *testing.T) {
	recordTest("hooks-client-credentials-lowercase-bearer")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"hooks", "authenticated-request",
		"--client-id", "speakeasy-sdks",
		"--client-secret", "supersecret-test",
		"--token-url", "/clientcredentials/token?token_type=bearer",
	})
	require.NoError(t, err)
}

func TestClientCredentials_HookAltTokenURL(t *testing.T) {
	recordTest("hooks-client-credentials-success-alt-token-url")

	h := NewCLITestHarness(t)
	// Use the alternate token endpoint with non-default scopes.
	// The alt endpoint expects "alt:one" and "alt:two" scopes.
	err := h.RunBare([]string{
		"hooks", "authenticated-request",
		"--client-id", "speakeasy-sdks",
		"--client-secret", "supersecret-test",
		"--token-url", "/clientcredentials/alt/token",
		"--scopes", "alt:one,alt:two",
	})
	require.NoError(t, err)
}
