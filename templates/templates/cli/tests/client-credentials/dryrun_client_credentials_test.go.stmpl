package tests

import (
	"bufio"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

type clientCredentialsDryRunPreview struct {
	DryRun  bool `json:"dry_run"`
	Request struct {
		Method  string              `json:"method"`
		URL     string              `json:"url"`
		Headers map[string][]string `json:"headers"`
		Body    interface{}         `json:"body"`
	} `json:"request"`
}

func parseClientCredentialsDryRunPreviews(t *testing.T, stdout string) []clientCredentialsDryRunPreview {
	t.Helper()
	var previews []clientCredentialsDryRunPreview
	scanner := bufio.NewScanner(strings.NewReader(stdout))
	for scanner.Scan() {
		var preview clientCredentialsDryRunPreview
		require.NoError(t, json.Unmarshal(scanner.Bytes(), &preview))
		require.True(t, preview.DryRun)
		previews = append(previews, preview)
	}
	require.NoError(t, scanner.Err())
	return previews
}

func TestClientCredentialsDryRunPreviewsTokenAndAPIRequests(t *testing.T) {
	recordTest("client-credentials-dry-run-token-and-api")
	const secret = "supersecret-dry-run"

	for _, machine := range []bool{false, true} {
		mode := "human"
		if machine {
			mode = "json"
		}
		t.Run(mode, func(t *testing.T) {
			requests := 0
			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				requests++
				w.Header().Set("Content-Type", "application/json")
				_, _ = w.Write([]byte(`{}`))
			}))
			t.Cleanup(server.Close)

			args := []string{
				"--dry-run", "--no-interactive",
				// Use the per-operation client-credentials command. The fixture's
				// flattened global-security command has a known, unrelated
				// second-credential selection defect.
				"hooks", "auth-req-overridden",
				"--client-id", "speakeasy-sdks",
				"--client-secret", secret,
			}
			h := NewCLITestHarness(t)
			if machine {
				require.NoError(t, h.RunWithStdinServer(server.URL, args, ""))
			} else {
				require.NoError(t, h.RunWithStdinServerRaw(server.URL, args, ""))
			}
			assert.Zero(t, requests, "dry-run must intercept both OAuth and API requests")
			combined := h.GetStdout() + h.GetStderr()
			assert.NotContains(t, combined, secret)

			if machine {
				assert.Empty(t, h.GetStderr())
				previews := parseClientCredentialsDryRunPreviews(t, h.GetStdout())
				require.Len(t, previews, 2)
				tokenBody, ok := previews[0].Request.Body.(string)
				require.True(t, ok, "token request body must be a redacted form string")
				assert.Contains(t, tokenBody, "grant_type=client_credentials")
				assert.Contains(t, tokenBody, "client_secret=[REDACTED]")
				assert.Equal(t, []string{"[REDACTED]"}, previews[1].Request.Headers["Authorization"])
			} else {
				assert.Empty(t, h.GetStdout())
				assert.Equal(t, 2, strings.Count(h.GetStderr(), "[DRY-RUN] Would send:"))
				assert.Contains(t, h.GetStderr(), "grant_type=client_credentials")
				assert.Contains(t, h.GetStderr(), "client_secret=[REDACTED]")
				assert.Contains(t, h.GetStderr(), "Authorization: [REDACTED]")
			}
		})
	}
}
