package tests

import (
	"encoding/json"
	"net/http"
	"net/url"
	"strings"
	"testing"

	"github.com/stretchr/testify/require"
)

// OAuth2 password tests use RunBare() (no --server-url) so the SDK uses its
// default server (speakeasy-api-test-service at port 35456) and each test
// explicitly provides exactly the credentials it needs.

// fetchOAuth2Token obtains a real JWT from the test service's token endpoint
// using the OAuth2 Resource Owner Password Credentials grant.
func fetchOAuth2Token(t *testing.T, scopes string) string {
	t.Helper()
	data := url.Values{
		"grant_type":    {"password"},
		"username":      {"testuser"},
		"password":      {"testpassword"},
		"client_id":     {"beezy"},
		"client_secret": {"super-secret"},
		"scope":         {scopes},
	}
	resp, err := http.Post(
		"http://localhost:35456/oauth2/token",
		"application/x-www-form-urlencoded",
		strings.NewReader(data.Encode()),
	)
	require.NoError(t, err)
	defer resp.Body.Close()
	require.Equal(t, http.StatusOK, resp.StatusCode)

	var tokenResp struct {
		AccessToken string `json:"access_token"`
	}
	err = json.NewDecoder(resp.Body).Decode(&tokenResp)
	require.NoError(t, err)
	require.NotEmpty(t, tokenResp.AccessToken)
	return tokenResp.AccessToken
}

func TestOAuth2Password_WithCredentials(t *testing.T) {
	recordTest("hooks-oauth2-password-with-credentials")

	h := NewCLITestHarness(t)
	// Explicitly pass OAuth2 credentials; the hook exchanges them at the
	// token endpoint for a real JWT, then sets the Authorization header.
	err := h.RunBare([]string{
		"products", "list",
		"--username", "testuser",
		"--password", "testpassword",
		"--client-id", "beezy",
		"--client-secret", "super-secret",
	})
	require.NoError(t, err)
}

func TestOAuth2Password_WithToken(t *testing.T) {
	recordTest("hooks-oauth2-password-with-token")

	// First obtain a real JWT from the token endpoint (matching Go SDK behavior).
	token := fetchOAuth2Token(t, "products:read")

	h := NewCLITestHarness(t)
	// Pass the pre-obtained token; the hook uses it directly as Bearer token
	// without calling the token endpoint.
	err := h.RunBare([]string{
		"products", "list",
		"--oauth2-token", token,
	})
	require.NoError(t, err)
}

func TestOAuth2Password_OperationSecurityOption(t *testing.T) {
	recordTest("hooks-oauth2-password-operation-security-option")

	h := NewCLITestHarness(t)
	// updateProductStock has operation-level security (bearerAuth | oauth2).
	// Pass OAuth2 credentials as operation-level flags; the hook exchanges
	// them for a real JWT via the token endpoint.
	err := h.RunBare([]string{
		"inventory", "update-product-stock",
		"--username", "testuser",
		"--password", "testpassword",
		"--client-id", "beezy",
		"--client-secret", "super-secret",
		"--id", "123",
		"--quantity-delta", "99",
	})
	require.NoError(t, err)
}

func TestOAuth2Password_BadCredentials(t *testing.T) {
	recordTest("hooks-oauth2-password-bad-credentials")

	h := NewCLITestHarness(t)
	// Bad password — the token endpoint should reject with "invalid username or password"
	err := h.RunBare([]string{
		"products", "list",
		"--username", "testuser",
		"--password", "BAD_PASSWORD",
		"--client-id", "beezy",
		"--client-secret", "super-secret",
	})
	require.Error(t, err)
	require.ErrorContains(t, err, "invalid username or password")
}

func TestOAuth2Password_NotRequired(t *testing.T) {
	recordTest("hooks-oauth2-password-not-required")

	h := NewCLITestHarness(t)
	// health-check does not require OAuth2; the hook should skip
	// token acquisition even though credentials are provided.
	err := h.RunBare([]string{
		"health-check",
		"--username", "testuser",
		"--password", "testpassword",
		"--client-id", "beezy",
		"--client-secret", "super-secret",
	})
	require.NoError(t, err)
}
