package tests

import (
	"testing"

	"github.com/stretchr/testify/require"
)

func TestCustomHTTPAuth(t *testing.T) {
	recordTest("auth-custom-security-scheme-only")

	// Skip: The generated custom security hook expects *components.Security (pointer)
	// but AsSecuritySource wraps the value type, causing a type assertion failure.
	// This is a pre-existing SDK generation issue with custom HTTP security schemes.
	t.Skip("custom HTTP security hook has type assertion incompatibility with CLI security model")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"auth", "custom-http-only",
		"--username", "testUser",
		"--password", "testPass",
	})
	require.NoError(t, err)
}
