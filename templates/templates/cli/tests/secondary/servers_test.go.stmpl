package tests

import (
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

func TestSelectGlobalServerValid(t *testing.T) {
	recordTest("servers-select-global-server-valid")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"servers", "select-global"})
	require.NoError(t, err)
	assert.NotEmpty(t, h.GetStdout())
}

func TestSelectGlobalServerBroken(t *testing.T) {
	recordTest("servers-select-global-server-broken")

	h := NewCLITestHarness(t)
	err := h.RunWithServer("http://broken", []string{"servers", "select-global"})
	assert.Error(t, err)
}

func TestSelectGlobalServerByNameDefault(t *testing.T) {
	recordTest("servers-select-global-server-by-name-default")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	// No --server flag: uses default server ("default-server"), --server-url redirects to echo
	err := h.RunWithServer(s.URL, []string{"servers", "select-global"})
	require.NoError(t, err)
	assert.NotEmpty(t, h.GetStdout())
}

func TestSelectGlobalServerByNameValid(t *testing.T) {
	recordTest("servers-select-global-server-by-name-valid")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	// --server "default-server" is a valid name, --server-url redirects to echo
	err := h.RunWithServer(s.URL, []string{"servers", "select-global", "--server", "default-server"})
	require.NoError(t, err)
	assert.NotEmpty(t, h.GetStdout())
}

func TestSelectGlobalServerByNameInvalid(t *testing.T) {
	recordTest("servers-select-global-server-by-name-invalid")

	h := NewCLITestHarness(t)
	// "unknown" is not in the global server list — expect validation error
	err := h.RunBare([]string{"servers", "select-global", "--server", "unknown"})
	assert.Error(t, err)
}

func TestSelectGlobalServerByNameBroken(t *testing.T) {
	recordTest("servers-select-global-server-by-name-broken")

	h := NewCLITestHarness(t)
	// "BrokenServer" resolves to "http://broken" — expect connection error
	err := h.RunBare([]string{"servers", "select-global", "--server", "BrokenServer"})
	assert.Error(t, err)
}
