package tests

import (
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// TestNoServersListObjects verifies that CLI commands work when no servers are defined
// in the spec, by providing --server-url explicitly.
func TestNoServersListObjects(t *testing.T) {
	recordTest("no-servers")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"list-objects"})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"GET"`)
}
