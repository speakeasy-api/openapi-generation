package tests

import (
	"net/http"
	"net/http/httptest"
	"sync/atomic"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	"{{getGolangPackage}}/internal/clierrors"
)

func TestJSONArrayQueryParamExampleRendersSingleToken(t *testing.T) {
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunBare([]string{"parameters", "cli-json-array-flags-get", "--help"}))
	assert.Contains(t, h.GetStdout(), `--tags '["urgent","needs review"]'`)
}

func TestJSONArrayQueryParamSendsArrayElements(t *testing.T) {
	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, []string{
		"parameters", "cli-json-array-flags-get",
		"--tags", `["urgent","needs review"]`,
	}))
	tags, ok := jsonGet(h.GetStdout(), "args.tags").([]interface{})
	require.True(t, ok, "tags must be repeated in the query: %s", h.GetStdout())
	assert.Equal(t, []interface{}{"urgent", "needs review"}, tags)
}

func TestJSONArrayQueryParamRejectsEmptyRequiredArray(t *testing.T) {
	var requests atomic.Int32
	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		requests.Add(1)
	}))
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{
		"parameters", "cli-json-array-flags-get",
		"--tags", `[]`,
	})
	require.Error(t, err)
	assert.Contains(t, err.Error(), "invalid value for --tags: empty array; a required parameter cannot be sent empty")
	assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
	assert.Zero(t, requests.Load(), "no request must be sent without the required tags")
}
