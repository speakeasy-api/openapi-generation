func TestHoistedSecurityOptionBasicHTTPOnly(t *testing.T) {
	recordTest("auth-hoisted-security-option-basic-http-only")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"auth", "hoisted-security-option-basic-http-only",
		"--username", "testUser",
		"--password", "testPass",
		"--api-key-auth", "testApiKey",
		"--access-token", "Bearer ghp_xxxx",
	})
	require.NoError(t, err)

	output := h.GetStdout()
	assert.Equal(t, true, jsonGetBool(output, "authenticated"))
	assert.Equal(t, "testUser", jsonGetString(output, "user"))
}

func TestHoistedSecurityOptionsInvalidOption(t *testing.T) {
	recordTest("auth-hoisted-security-invalid-option")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"auth", "hoisted-security-option-access-token-first",
		"--username", "user",
		"--password", "pass",
	})
	require.Error(t, err)
}
