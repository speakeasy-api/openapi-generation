package tests

import (
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// The client-credentials-basic variant has multiple servers but forces
// cli.serverSelectionFlag: hidden.

func TestServerSelectionFlagHiddenFromHelp(t *testing.T) {
	h := NewCLITestHarness(t)
	err := h.RunBare([]string{"--help"})
	require.NoError(t, err)

	stdout := h.GetStdout()
	assert.NotContains(t, stdout, "--server string")
	assert.Contains(t, stdout, "--server-url string")
}

func TestServerSelectionFlagHiddenStillParses(t *testing.T) {
	h := NewCLITestHarness(t)
	err := h.RunBare([]string{"version", "--server", "0"})
	require.NoError(t, err)
}

func TestServerSelectionFlagHiddenInUsage(t *testing.T) {
	h := NewCLITestHarness(t)
	err := h.RunBare([]string{"--usage"})
	require.NoError(t, err)

	stdout := h.GetStdout()
	var serverLine string
	for _, line := range strings.Split(stdout, "\n") {
		line = strings.TrimSpace(line)
		if strings.HasPrefix(line, `flag "--server <server>"`) {
			serverLine = line
			break
		}
	}
	require.NotEmpty(t, serverLine, "server flag missing from usage schema")
	assert.Contains(t, serverLine, "hide=#true")
}
