func TestGlobalPathParameterGet_UsesGlobal(t *testing.T) {
	recordTest("globals-path-parameter-get-uses-global")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"globals", "global-path-parameter-get", "--global-path-param", "1"})
	require.NoError(t, err)

	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	// Path parameter should appear in the echoed URL
	url := jsonGetString(output, "url")
	assert.Contains(t, url, "/1")
}

func TestGlobalsHeaderGet_UsesGlobal(t *testing.T) {
	recordTest("globals-header-get-uses-global")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"globals", "globals-header-get", "--global-header-param=true"})
	require.NoError(t, err)

	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	// Echo server reflects headers; verify the header was sent
	assert.Contains(t, output, `"Globalheaderparam"`)
}

func TestGlobalsHeaderKeepsCustomClientHeaders(t *testing.T) {
	recordTest("globals-header-keeps-custom-client-headers")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"globals", "globals-header-get",
		"--global-header-param=true",
		"--header", "X-Custom-Header: someValue",
	})
	require.NoError(t, err)

	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	// Both the global header param and the custom --header should coexist
	assert.Contains(t, output, `"Globalheaderparam"`)
	assert.Equal(t, "someValue", jsonGetString(output, "headers.X-Custom-Header"))
}

func TestGlobalsHeaderGet_UsesLocal(t *testing.T) {
	recordTest("globals-header-get-uses-local")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"globals", "globals-header-get", "--global-header-param=false"})
	require.NoError(t, err)

	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	// Verify the header was sent with the local override value
	assert.Contains(t, output, `"Globalheaderparam"`)
}
