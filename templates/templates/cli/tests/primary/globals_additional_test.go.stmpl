func TestGlobalsHiddenPost(t *testing.T) {
	recordTest("globals-hidden-post")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"globals", "globals-hidden-post",
		"--test", "friend",
		"--other", "37",
		"--global-hidden-query-param", "hello",
		"--global-hidden-header-param", "world",
		"--global-hidden-path-param", "test",
	})
	require.NoError(t, err)

	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"friend"`)
}

func TestGlobalsOperationParamsOnly(t *testing.T) {
	recordTest("globals-operation-params-only")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"globals", "globals-operation-scoped-exclusive",
		"--operation-header-param", "operationHeader",
		"--operation-path-param", "operationPath",
		"--operation-query-param", "operationQuery",
	})
	require.NoError(t, err)

	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	// Global params should NOT be in the response (operation-scoped only)
	assert.NotContains(t, output, `"globalQueryParam"`)
}

