func TestJsonlDeserializationCamelCase(t *testing.T) {
	recordTest("jsonl-deserialization-camel-case-properties")

	h := NewCLITestHarness(t)
	err := h.RunWithServer(getAPITestServiceURL(), []string{"jsonl", "jsonl-deserialization-verification"})
	require.NoError(t, err)

	events := parseNDJSON(t, h.GetStdout())
	require.GreaterOrEqual(t, len(events), 1, "expected at least 1 JSONL event")

	// Verify camelCase property is correctly deserialized and output
	assert.Equal(t, "yes", events[0]["isFinished"])
}

