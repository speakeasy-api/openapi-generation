package tests

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

func TestJsonlStreamData(t *testing.T) {
	recordTest("jsonl-stream-data-envelope-http-responses")

	h := NewCLITestHarness(t)
	err := h.RunWithServer(getAPITestServiceURL(), []string{"jsonl", "jsonl-stream"})
	require.NoError(t, err)

	events := parseNDJSON(t, h.GetStdout())
	assert.Equal(t, 2, len(events), "expected 2 JSONL events")

	// Assert first event
	assert.Equal(t, "Peter", events[0]["name"])
	skills0, ok := events[0]["skills"].([]interface{})
	require.True(t, ok)
	assert.Equal(t, []interface{}{"Go", "Python"}, skills0)

	// Assert second event
	assert.Equal(t, "John", events[1]["name"])
	skills1, ok := events[1]["skills"].([]interface{})
	require.True(t, ok)
	assert.Equal(t, []interface{}{"Go", "Rust"}, skills1)
}

