func TestSchemaFlagStillPrintsBodySchema(t *testing.T) {
	s, count := newRequestTracker()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"cli-hygiene", "cli-arg-hygiene-post", "--schema"})
	require.NoError(t, err)
	assert.Contains(t, h.GetStdout(), `"code"`)
	assert.Equal(t, 0, *count, "printing the body schema must not send a request")
}

func TestGroupCommandNamesUseSourceSegments(t *testing.T) {
	tests := []struct {
		name string
		args []string
	}{
		{name: "top level", args: []string{"first", "get", "--help"}},
		{name: "nested", args: []string{"nested", "first", "get", "--help"}},
		{name: "nested with colliding parent", args: []string{"nest", "first", "get", "--help"}},
	}

	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			h := NewCLITestHarness(t)
			require.NoError(t, h.RunBare(tc.args))
		})
	}

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{"nested", "SDK-first"})
	require.Error(t, err)
	assert.Contains(t, err.Error(), `unknown command "SDK-first" for "cli nested"`)
}

func TestRootOperationExampleOmitsSDKClassName(t *testing.T) {
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunBare([]string{"ambiguous-query-param", "--help"}))

	help := h.GetStdout()
	assert.Contains(t, help, "cli ambiguous-query-param")
	assert.NotContains(t, help, "cli SDK ")
}
