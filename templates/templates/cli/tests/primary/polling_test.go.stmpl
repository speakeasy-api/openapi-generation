package tests

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// newPollingServer creates a test server that simulates polling endpoint responses.
// CLI doesn't implement automatic polling loops — these tests verify the commands
// can make single API calls and handle responses correctly.
func newPollingServer() *httptest.Server {
	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")

		switch {
		case strings.HasPrefix(r.URL.Path, "/polling/successCriteria/responseBody/nested"):
			json.NewEncoder(w).Encode(map[string]any{
				"nested": map[string]string{"status": "completed"},
			})
		case strings.HasPrefix(r.URL.Path, "/polling/successCriteria/responseBody"):
			json.NewEncoder(w).Encode(map[string]string{"status": "completed"})
		case strings.HasPrefix(r.URL.Path, "/polling/successCriteria/statusCode"):
			json.NewEncoder(w).Encode(map[string]string{"status": "completed"})
		case strings.HasPrefix(r.URL.Path, "/polling/failureCriteria/responseBody/nested"):
			json.NewEncoder(w).Encode(map[string]any{
				"nested": map[string]string{"status": "failed"},
			})
		case strings.HasPrefix(r.URL.Path, "/polling/failureCriteria/responseBody"):
			json.NewEncoder(w).Encode(map[string]string{"status": "failed"})
		case strings.HasPrefix(r.URL.Path, "/polling/failureCriteria/statusCode"):
			json.NewEncoder(w).Encode(map[string]string{"status": "completed"})
		default:
			// delay, interval, limit count paths
			json.NewEncoder(w).Encode(map[string]string{"status": "completed"})
		}
	}))
}

// --- Success Criteria: Response Body ---

func TestPollingSuccessCriteriaResponseBody(t *testing.T) {
	recordTest("polling-success-criteria-response-body")
	s := newPollingServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"polling", "success-criteria-response-body",
		"--request-id", "test-1",
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"completed"`)
}

