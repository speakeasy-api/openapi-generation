// --- Nullable Required Shared Object ---

func TestNullableRequiredSharedObjectPostAllSet(t *testing.T) {
	recordTest("request-bodies-post-nullable-required-shared-object-all-set")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"request-bodies", "nullable-required-shared-object-post",
		"--nullable-optional-obj", `{"required":1,"optional":"test"}`,
		"--nullable-required-obj", `{"required":1}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"NullableOptionalObj"`)
	assert.Contains(t, output, `"NullableRequiredObj"`)
}

