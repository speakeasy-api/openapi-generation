// --- Multipart File Upload ---

func TestRequestBodyPutMultipartFile(t *testing.T) {
	recordTest("request-bodies-put-multipart-file")
	s := newEchoServer()
	defer s.Close()

	// Create a temp file with test content
	tmpDir := t.TempDir()
	testFile := filepath.Join(tmpDir, "testUpload.json")
	err := os.WriteFile(testFile, []byte(`{"hello":"world"}`), 0644)
	require.NoError(t, err)

	h := NewCLITestHarness(t)
	err = h.RunWithServer(s.URL, []string{"request-bodies", "request-body-put-multipart-file",
		"--file", testFile,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	// Echo server returns raw multipart body in "data" field — verify it contains our file content
	assert.Contains(t, output, `hello`)
}

