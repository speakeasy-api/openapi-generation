// --- Wildcard No Content Type ---

func TestRequestBodyPostWildcardNoContentType(t *testing.T) {
	recordTest("request-bodies-wildcard-no-content-type")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	// POST with optional wildcard body — omit body entirely
	err := h.RunWithServer(s.URL, []string{"request-bodies", "request-body-post-wildcard",
		"--output-format", "json",
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	// No Content-Type header should be sent when body is nil
	assert.Empty(t, jsonGetString(output, "headers.Content-Type"))
}

