// --- JSON Map of Any ---

func TestRequestBodyPostApplicationJSONMapOfAny(t *testing.T) {
	recordTest("request-bodies-post-application-json-map-of-any")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	mapJSON := `{"mapElemArray":["array-test"],"mapElemBool":true,"mapElemNumber":123,"mapElemObject":{"property":"property-test"},"mapElemString":"string-test"}`
	err := h.RunWithServer(s.URL, []string{"request-bodies", "request-body-post-application-json-map-of-any",
		"--request", mapJSON,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"mapElemString"`)
	assert.Contains(t, output, `"string-test"`)
	assert.Contains(t, output, `"mapElemBool"`)
}

