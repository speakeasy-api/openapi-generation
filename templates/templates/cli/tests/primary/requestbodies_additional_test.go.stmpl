// --- flag defaults must not override --body / stdin ---

func TestRequestBodyFlagDefaultsDoNotOverrideBody(t *testing.T) {
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)

	// status defaults to "pending", count defaults to 42 — body supplies different values
	// and the dedicated flags are not set, so body values must win.
	err := h.RunWithServer(s.URL, []string{
		"request-bodies", "request-body-post-flag-defaults-body-merge",
		"--body", `{"name":"from-body","status":"active","count":7}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Equal(t, "from-body", jsonGetString(output, "json.name"))
	assert.Equal(t, "active", jsonGetString(output, "json.status"),
		"unchanged --status flag default must not overwrite --body value")
	assert.Equal(t, float64(7), jsonGetFloat64(output, "json.count"),
		"unchanged --count flag default must not overwrite --body value")
}

func TestRequestBodyFlagDefaultsDoNotOverrideStdin(t *testing.T) {
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)

	err := h.RunWithStdinServer(s.URL, []string{
		"request-bodies", "request-body-post-flag-defaults-body-merge",
	}, `{"name":"from-stdin","status":"archived","count":3}`)
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Equal(t, "from-stdin", jsonGetString(output, "json.name"))
	assert.Equal(t, "archived", jsonGetString(output, "json.status"),
		"unchanged --status flag default must not overwrite stdin value")
	assert.Equal(t, float64(3), jsonGetFloat64(output, "json.count"),
		"unchanged --count flag default must not overwrite stdin value")
}

func TestRequestBodyExplicitFlagOverridesBodyDefaultField(t *testing.T) {
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)

	// Explicit flags still win over --body (highest priority).
	err := h.RunWithServer(s.URL, []string{
		"request-bodies", "request-body-post-flag-defaults-body-merge",
		"--body", `{"name":"from-body","status":"active","count":7}`,
		"--status", "flagged",
		"--count", "99",
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Equal(t, "from-body", jsonGetString(output, "json.name"))
	assert.Equal(t, "flagged", jsonGetString(output, "json.status"))
	assert.Equal(t, float64(99), jsonGetFloat64(output, "json.count"))
}

func TestRequestBodyFlagDefaultsAppliedWithoutBody(t *testing.T) {
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)

	// No --body/stdin: schema defaults on unchanged flags should still be sent.
	err := h.RunWithServer(s.URL, []string{
		"request-bodies", "request-body-post-flag-defaults-body-merge",
		"--name", "flags-only",
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Equal(t, "flags-only", jsonGetString(output, "json.name"))
	assert.Equal(t, "pending", jsonGetString(output, "json.status"),
		"schema default should apply when building from flags alone")
	assert.Equal(t, float64(42), jsonGetFloat64(output, "json.count"),
		"schema default should apply when building from flags alone")
}

// --- Repeatable flag examples ---

func renderedExample(t *testing.T, path ...string) string {
	t.Helper()
	root, err := cli.NewRootCommand()
	require.NoError(t, err)
	cmd, remaining, err := root.Find(path)
	require.NoError(t, err)
	require.Empty(t, remaining)
	return cmd.Example
}

func renderedExampleArgs(t *testing.T, path ...string) []string {
	t.Helper()
	example := strings.TrimSpace(renderedExample(t, path...))
	invocation, ok := parseReadmeInvocation(example)
	require.True(t, ok, "example must parse as a single CLI invocation: %s", example)
	return invocation.args
}

func TestRepeatableFlagExampleRendersOneOccurrencePerElement(t *testing.T) {
	example := renderedExample(t, "request-bodies", "cli-repeatable-flag-examples-post")
	assert.Contains(t, example, `--labels 'release candidate' --labels 'owner'\''s pick'`)
	assert.Contains(t, example, "--events item.created")
	assert.Contains(t, example, `--weights '[1.5,2]'`)
	assert.Contains(t, example, "--channels email")
	assert.NotContains(t, example, `--labels '[`)
	assert.NotContains(t, example, `--events '[`)
	assert.NotContains(t, example, `--channels '[`)
}

func TestRepeatableFlagExampleSendsArrayElements(t *testing.T) {
	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	args := renderedExampleArgs(t, "request-bodies", "cli-repeatable-flag-examples-post")
	require.NoError(t, h.RunWithServer(s.URL, args), "rendered example must run: %v", args)
	labels, ok := jsonGet(h.GetStdout(), "json.labels").([]interface{})
	require.True(t, ok, "labels must be an array: %s", h.GetStdout())
	assert.Equal(t, []interface{}{"release candidate", "owner's pick"}, labels)
	events, ok := jsonGet(h.GetStdout(), "json.events").([]interface{})
	require.True(t, ok, "events must be an array: %s", h.GetStdout())
	assert.Equal(t, []interface{}{"item.created"}, events)
	weights, ok := jsonGet(h.GetStdout(), "json.weights").([]interface{})
	require.True(t, ok, "weights must be an array: %s", h.GetStdout())
	assert.Equal(t, []interface{}{1.5, 2.0}, weights)
	channels, ok := jsonGet(h.GetStdout(), "json.channels").([]interface{})
	require.True(t, ok, "channels must be an array: %s", h.GetStdout())
	assert.Equal(t, []interface{}{"email"}, channels)
}
