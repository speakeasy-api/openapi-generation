func TestSelectServerWithIDValid(t *testing.T) {
	recordTest("servers-select-server-with-id-valid")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	// Operation SelectServerWithID has map-based servers: "valid" → localhost:35123
	// Use --server-url to redirect to our echo server (takes precedence over --server)
	err := h.RunWithServer(s.URL, []string{"servers", "select-server-with-ID"})
	require.NoError(t, err)
	assert.NotEmpty(t, h.GetStdout())
}

func TestSelectServerWithIDBroken(t *testing.T) {
	recordTest("servers-select-server-with-id-broken")

	h := NewCLITestHarness(t)
	// Operation SelectServerWithID: "broken" → "http://broken"
	err := h.RunBare([]string{"servers", "select-server-with-ID", "--server", "broken"})
	assert.Error(t, err)
}

func TestServerWithTemplatesDefaults(t *testing.T) {
	recordTest("servers-server-with-templates-defaults")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"servers", "server-with-templates"})
	require.NoError(t, err)
	assert.NotEmpty(t, h.GetStdout())
}

func TestServerWithTemplates(t *testing.T) {
	recordTest("servers-server-with-templates")

	s := newEchoServer()
	defer s.Close()

	host, port := serverHostPort(s.URL)
	h := NewCLITestHarness(t)
	// Operation ServerWithTemplates has array-based server [0] = "http://{hostname}:{port}"
	err := h.RunBare([]string{"servers", "server-with-templates", "--server", "0", "--hostname", host, "--port", port})
	require.NoError(t, err)
	assert.NotEmpty(t, h.GetStdout())
}

