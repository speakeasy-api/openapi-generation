package tests

import (
	"net/url"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// serverHostPort extracts the hostname and port from a server URL string.
func serverHostPort(serverURL string) (host, port string) {
	u, err := url.Parse(serverURL)
	if err != nil {
		return "localhost", "35123"
	}
	return u.Hostname(), u.Port()
}

func TestSelectGlobalServerValid(t *testing.T) {
	recordTest("servers-select-global-server-valid")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"servers", "select-global-server"})
	require.NoError(t, err)
	assert.NotEmpty(t, h.GetStdout())
}

func TestSelectGlobalServerBroken(t *testing.T) {
	recordTest("servers-select-global-server-broken")

	h := NewCLITestHarness(t)
	// Server index 1 is "http://broken" — expect connection error
	err := h.RunBare([]string{"servers", "select-global-server", "--server", "1"})
	assert.Error(t, err)
}

func TestSelectServerWithIDDefault(t *testing.T) {
