func TestGlobalServerWithTemplatedProtocol(t *testing.T) {
	recordTest("servers-global-server-with-templated-protocol")

	s := newEchoServer()
	defer s.Close()

	host, port := serverHostPort(s.URL)
	h := NewCLITestHarness(t)
	// Global server index 4 is "{protocol}://{hostname}:{port}"
	err := h.RunBare([]string{"servers", "select-global-server", "--server", "4", "--protocol", "http", "--hostname", host, "--port", port})
	require.NoError(t, err)
	assert.NotEmpty(t, h.GetStdout())
}

func TestGlobalServerWithInvalidTemplatedProtocol(t *testing.T) {
	recordTest("servers-global-server-with-invalid-templated-protocol")

	h := NewCLITestHarness(t)
	// Global server index 4 with invalid protocol — should fail to connect
	err := h.RunBare([]string{"servers", "select-global-server", "--server", "4", "--protocol", "invalid", "--hostname", "localhost", "--port", "35123"})
	assert.Error(t, err)
}

func TestServerWithProtocolTemplate(t *testing.T) {
	recordTest("servers-server-with-protocol-template")

	s := newEchoServer()
	defer s.Close()

	host, port := serverHostPort(s.URL)
	h := NewCLITestHarness(t)
	// Operation ServerWithProtocolTemplate has map-based server "main" = "{protocol}://{hostname}:{port}"
	err := h.RunBare([]string{"servers", "server-with-protocol-template", "--server", "main", "--protocol", "http", "--hostname", host, "--port", port})
