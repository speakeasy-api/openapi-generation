package tests

import (
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	"{{getGolangPackage}}/internal/clierrors"
)

// Request-shape guards: a whole-body JSON document supplied by the caller
// (--body, stdin, or the whole-body metadata flag) is never silently reshaped
// into a request the caller did not write. Fixture: cliInteract (mixed
// param+body operation whose body is a non-discriminated union selected by
// "model" | "agent", model carrying a schema default), cliOpenNote (open
// additionalProperties body), and the declared "generate" intent command bound
// to the model variant (tests/specs/fragments/primary/cli-request-shape.yaml,
// tests/overlays/primary/cli/overlay.yaml).

// --- Key loss (--body / stdin / whole-body flag) ---

func TestBodyTypoKeyIsRejectedWithSuggestion(t *testing.T) {
	recordTest("request-shape-body-typo-key-rejected")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	// "agnet" would be dropped and the schema's default model merged in:
	// the request would run the wrong target.
	err := h.RunWithServer(s.URL, []string{"request-bodies", "cli-interact",
		"--body", `{"agnet":"research-bot","input":"hello"}`,
	})
	require.Error(t, err)
	assert.Contains(t, err.Error(), `--body`)
	assert.Contains(t, err.Error(), `"agnet"`)
	assert.Contains(t, err.Error(), `did you mean "agent"`)
}

func TestStdinTypoKeyIsRejected(t *testing.T) {
	recordTest("request-shape-stdin-typo-key-rejected")
	s := newEchoServer()
	defer s.Close()
