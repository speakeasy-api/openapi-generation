func TestNestedUnionExplicitAgentSelectorDoesNotMergeDefault(t *testing.T) {
	recordTest("request-shape-nested-union-agent-selector-no-default")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"request-bodies", "cli-create-interaction-trigger",
		"--body", `{"cron":"* * * * *","interaction":{"agent":"research-bot","input":"hi"}}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	assert.Equal(t, "research-bot", jsonGetString(output, "json.interaction.agent"))
	assert.False(t, jsonExists(output, "json.interaction.model"), "no default model merged when the agent selector is named")
}

func TestNestedUnionOwnFlagDefaultSelectorMerges(t *testing.T) {
