// --- Nested union defaults ---

func TestNestedUnionBodyDefaultSelectorMerges(t *testing.T) {
	recordTest("request-shape-nested-union-body-default-selector-merges")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"request-bodies", "cli-create-interaction-trigger",
		"--body", `{"cron":"* * * * *","interaction":{"input":"hello"}}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	assert.Equal(t, "model-default-1", jsonGetString(output, "json.interaction.model"))
	assert.Equal(t, "hello", jsonGetString(output, "json.interaction.input"))
}

