func TestIntentEmptyStdinIsUsageError(t *testing.T) {
	recordTest("request-shape-intent-empty-stdin-usage")
	s, count := newRequestTracker()
	defer s.Close()
	h := NewCLITestHarness(t)
	// A pipe that closes without data (EOF) is not a body: it has the same
	// structured usage outcome as a bare invocation and sends no request.
	err := h.RunWithStdinServer(s.URL, []string{"generate"}, "")
	require.Error(t, err)
	assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
	assert.Empty(t, strings.TrimSpace(h.GetStdout()))
	envelope := agentEnvelope(t, h.GetStderr())
	assert.Equal(t, float64(clierrors.ExitUsage), envelope["exit_code"])
	assert.Contains(t, h.GetStderr(), "generate --help")
	assert.Equal(t, 0, *count)
}

func TestIntentBareInvocationIsUsageError(t *testing.T) {
	recordTest("request-shape-intent-bare-usage")
	s, count := newRequestTracker()
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"generate"})
	require.Error(t, err)
	assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
	assert.Empty(t, strings.TrimSpace(h.GetStdout()))
	envelope := agentEnvelope(t, h.GetStderr())
	assert.Equal(t, float64(clierrors.ExitUsage), envelope["exit_code"])
	assert.Contains(t, h.GetStderr(), "generate --help")
	assert.Equal(t, 0, *count)
}

