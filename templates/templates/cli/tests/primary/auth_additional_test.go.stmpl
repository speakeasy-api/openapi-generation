package tests

import (
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

{{- if templateAuthUsageTestEnabled}}
func TestAuthLoginConfirmationUsesStdout(t *testing.T) {
	h := NewCLITestHarness(t)
	err := h.RunRaw([]string{"auth", "login", "--username", "test-user"})
	require.NoError(t, err)
	assert.Contains(t, h.GetStdout(), "Configuration saved to")
	assert.NotContains(t, h.GetStderr(), "Configuration saved to")
}
{{- end}}

func TestGlobalSecurityFieldsOrdering(t *testing.T) {
	recordTest("auth-global-security-fields-ordering")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"auth", "global-security-basic-http",
		"--api-key-auth", "testApiKey",
		"--username", "testUser",
		"--password", "testPass",
	})
	require.Error(t, err)
}

func TestHoistedSecurityBasicHttpOnly(t *testing.T) {
	recordTest("auth-hoisted-security-basic-http-only")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"auth", "hoisted-security-basic-http-only",
		"--api-key-auth", "testApiKey",
		"--username", "testUser",
		"--password", "testPass",
		"--access-token", "Bearer ghp_xxxx",
	})
	require.NoError(t, err)

	output := h.GetStdout()
	assert.Equal(t, true, jsonGetBool(output, "authenticated"))
	assert.Equal(t, "testUser", jsonGetString(output, "user"))
}

func TestHoistedSecurityAccessTokenOnly(t *testing.T) {
	recordTest("auth-hoisted-security-access-token-only")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"auth", "hoisted-security-access-token-only",
		"--api-key-auth", "testApiKey",
		"--username", "testUser",
		"--password", "testPass",
		"--access-token", "Bearer ghp_xxxx",
	})
	require.NoError(t, err)

	output := h.GetStdout()
	assert.Equal(t, "Bearer ghp_xxxx", jsonGetString(output, "token"))
}

