func TestCustomSchemeAppId_GlobalSecurityOption(t *testing.T) {
	recordTest("auth-custom-security-option-app-id")

	// Uses operation-level server (http://localhost:35456), so RunBare() to avoid
	// mock server override. The custom security hook sets X-Security-App-Id and
	// X-Security-Secret headers from the --app-id and --secret flags.
	h := NewCLITestHarness(t)
	err := h.RunBare([]string{
		"auth-new", "custom-scheme-app-id",
		"--app-id", "testAppID",
		"--secret", "testSecret",
	})
	require.NoError(t, err)
}

func TestFunctionCallbacksOAuthGlobalSecurity(t *testing.T) {
	recordTest("auth-function-callbacks-oauth-global-security")

	s := newEchoServer()
	defer s.Close()

	// CLI equivalent of WithSecuritySource callback: pass OAuth2 token via flag.
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"auth", "global-bearer-auth",
		"--oauth2", "Bearer global",
	})
	require.NoError(t, err)

	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, "Bearer global")
}
