// --- Open Union Forward Compatibility ---

func TestOpenUnionKnownVariant(t *testing.T) {
	recordTest("open-union-known-variant")
	s := newEchoServer()
	defer s.Close()

	// Known "car" discriminator → parses to Car variant
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"unions", "discriminated-one-multiple-memberships",
		"--vehicle", `{"vehicleType":"car","wheelsType":"four"}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"car"`)
	assert.Contains(t, output, `"four"`)

	// Known "bike" discriminator → parses to Bike variant
	h = NewCLITestHarness(t)
	err = h.RunWithServer(s.URL, []string{"unions", "discriminated-one-multiple-memberships",
		"--vehicle", `{"vehicleType":"bike","wheelsType":"two","colour":"red"}`,
	})
	require.NoError(t, err)
	output = strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"bike"`)
	assert.Contains(t, output, `"red"`)
}

