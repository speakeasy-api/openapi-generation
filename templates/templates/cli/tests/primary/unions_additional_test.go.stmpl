func TestOpenUnionMixedKnownAndUnknown(t *testing.T) {
	s := newEchoServer()
	defer s.Close()

	// Known car variant works
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"unions", "discriminated-one-multiple-memberships",
		"--vehicle", `{"vehicleType":"car","wheelsType":"four"}`,
