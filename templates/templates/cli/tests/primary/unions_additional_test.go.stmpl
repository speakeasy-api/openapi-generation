// --- Collection and Map Unions ---

func TestCollectionOneOfPost(t *testing.T) {
	recordTest("unions-collections-one-of-post")
	s := newEchoServer()
	defer s.Close()

	// Test 1: Array variant
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"unions", "collection-one-of-post",
		"--collection-one-of-object", `{"arrayOfAny":["one","two"]}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"one"`)

	// Test 2: Map variant
	h = NewCLITestHarness(t)
	err = h.RunWithServer(s.URL, []string{"unions", "collection-one-of-post",
		"--collection-one-of-object", `{"mapOfAny":{"1":"one","2":"two"}}`,
	})
	require.NoError(t, err)
	output = strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"one"`)
}

