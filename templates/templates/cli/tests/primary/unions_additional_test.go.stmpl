package tests

import (
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// simpleObjectWithTypeJSON is a SimpleObjectWithType with type discriminator.
var simpleObjectWithTypeJSON = `{"type":"simpleObjectWithType","str":"test","bool":true,"int":1,"int32":1,"intEnum":2,"int32Enum":55,"num":1.1,"float32":1.1,"enum":"one","any":"any","date":"2020-01-01","dateTime":"2020-01-01T00:00:00.000000001Z","boolOpt":true,"strOpt":"testOptional"}`

// simpleObjectJSON is a SimpleObject (no type field, includes bigint).
var unionSimpleObjectJSON = `{"str":"test","bool":true,"int":1,"int32":1,"intEnum":2,"int32Enum":55,"num":1.1,"float32":1.1,"enum":"one","any":"any","date":"2020-01-01","dateTime":"2020-01-01T00:00:00.000000001Z","boolOpt":true,"strOpt":"testOptional","bigint":8821239038968084,"bigintStr":"9223372036854775808"}`

// deepObjectWithTypeJSON is a DeepObjectWithType.
var deepObjectWithTypeJSON = `{"type":"deepObjectWithType","any":` + unionSimpleObjectJSON + `,"arr":[` + unionSimpleObjectJSON + `],"bool":true,"int":1,"map":{"key":` + unionSimpleObjectJSON + `},"num":1.1,"obj":` + unionSimpleObjectJSON + `,"str":"test"}`

// --- Strongly Typed OneOf ---

func TestStronglyTypedOneOfPost_Basic(t *testing.T) {
	recordTest("unions-strongly-typed-one-of-post-basic")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"unions", "strongly-typed-one-of-post",
		"--strongly-typed-one-of-object", simpleObjectWithTypeJSON,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"simpleObjectWithType"`)
}

func TestStronglyTypedOneOfPost_Deep(t *testing.T) {
	recordTest("unions-strongly-typed-one-of-post-deep")
