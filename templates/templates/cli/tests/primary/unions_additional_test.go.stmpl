	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"unions", "discriminated-one-multiple-memberships",
		"--vehicle", `{"vehicleType":"car","wheelsType":"four"}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"car"`)
	assert.Contains(t, output, `"four"`)
}

// --- Recursive OneOf ---

func TestCircularReferenceRecursiveOneOf(t *testing.T) {
	recordTest("unions-circular-reference-recursive-one-of")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"unions", "circular-reference-recursive-one-of",
		"--value", `["hello",{"nested":["world"]}]`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"hello"`)
	assert.Contains(t, output, `"nested"`)
	assert.Contains(t, output, `"world"`)
}
