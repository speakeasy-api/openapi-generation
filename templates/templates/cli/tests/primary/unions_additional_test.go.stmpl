}

func TestStronglyTypedOneOfPostWithNonStandardDiscriminatorName(t *testing.T) {
	recordTest("unions-strongly-typed-one-of-post-with-non-standard-discriminator-name")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	// Non-standard discriminator uses "obj.type" (with dot) instead of "type"
	obj := `{"obj.type":"simpleObjectWithNonStandardTypeName","str":"test","bool":true,"int":1,"int32":1,"intEnum":2,"int32Enum":55,"num":1.1,"float32":1.1,"enum":"one","any":"any","date":"2020-01-01","dateTime":"2020-01-01T00:00:00.000000001Z","boolOpt":true,"strOpt":"testOptional"}`
	err := h.RunWithServer(s.URL, []string{"unions", "strongly-typed-one-of-post-with-non-standard-discriminator-name",
		"--strongly-typed-one-of-object-with-non-standard-discriminator-name", obj,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"simpleObjectWithNonStandardTypeName"`)
}

func TestStronglyTypedNullableOneOfPost(t *testing.T) {
	recordTest("unions-strongly-typed-nullable-one-of-post")
	s := newEchoServer()
	defer s.Close()

	// Test 1: NestedEnumArray variant
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"unions", "strongly-typed-nullable-one-of-post",
		"--strongly-typed-nullable-one-of-object", `{"enums":["one","two"],"tags":"nestedEnumArray"}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"nestedEnumArray"`)

	// Test 2: NestedEnumMap variant
	h = NewCLITestHarness(t)
	err = h.RunWithServer(s.URL, []string{"unions", "strongly-typed-nullable-one-of-post",
		"--strongly-typed-nullable-one-of-object", `{"enums":{"key2":"two","key3":"three"},"tags":"nestedEnumMap"}`,
	})
	require.NoError(t, err)
	output = strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"nestedEnumMap"`)

	// Test 3: Null (omit body flag — nullable)
	h = NewCLITestHarness(t)
	err = h.RunWithServer(s.URL, []string{"unions", "strongly-typed-nullable-one-of-post"})
	require.NoError(t, err)
}

