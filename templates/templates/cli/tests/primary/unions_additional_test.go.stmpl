func TestNullableTypedObjectPost_Obj1(t *testing.T) {
	recordTest("unions-nullable-typed-object-post-obj1")
	s := newEchoServer()
	defer s.Close()
	// Uses metadata-driven flags
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"unions", "nullable-typed-object-post",
		"--type", "obj1", "--value", "one",
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"obj1"`)
}

func TestNullableTypedObjectPost_Null(t *testing.T) {
	recordTest("unions-nullable-typed-object-post-null")
	s := newEchoServer()
	defer s.Close()
	// CLI metadata marks --type and --value as required, so null variant means passing empty string for value.
	// The SDK passes nil pointer, but CLI can't omit required metadata flags.
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"unions", "nullable-typed-object-post",
		"--type", "obj1", "--value", "null",
	})
	require.NoError(t, err)
}

