// --- Extra JSON Properties / Overlapping Objects ---

func TestUnionExtraJsonProperties(t *testing.T) {
	recordTest("unions-extra-json-properties")
	s := newEchoServer()
	defer s.Close()

	// Test 1: Obj1 (field1 + field3, no field2)
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"unions", "one-of-overlapping-objects",
		"--field1", "test1", "--field3", "1",
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"test1"`)

	// Test 2: Obj2 (field1 + field2 + field3)
	h = NewCLITestHarness(t)
	err = h.RunWithServer(s.URL, []string{"unions", "one-of-overlapping-objects",
		"--field1", "test2", "--field2=true", "--field3", "1",
	})
	require.NoError(t, err)
	output = strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"test2"`)
}

