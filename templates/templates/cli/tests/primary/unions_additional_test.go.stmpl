}

func TestSmartUnionNestedUnion(t *testing.T) {
	recordTest("smart-union-nested-union")
	// This operation has its own server (http://localhost:35456), so use RunBare()
	// to avoid --server-url override. No request body — the test service returns a
	// hardcoded response with unknown enum values to test union resolution.
	h := NewCLITestHarness(t)
	err := h.RunBare([]string{"unions", "smart-union-nested-union"})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"unknown"`)
	assert.Contains(t, output, `"also_unknown"`)
}

