package tests

import (
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

func TestOpenEnumsRoundTrip(t *testing.T) {
	recordTest("open-enums-round-trip")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"enums", "enums-post-open-enum-unrecognized", "--color-param", "purple", "--icon", "tick", "--hero-width", "2160"})
	require.NoError(t, err)

	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)

	// Verify the response echoes back the enum values
	assert.Contains(t, output, `"purple"`)
	assert.Contains(t, output, `"tick"`)
	assert.Contains(t, output, "2160")
}

