package tests

import (
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

func TestStatusGetError_400(t *testing.T) {
	recordTest("errors-status-get-error-default-error-codes")

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"errors", "status-get-error", "--status-code", "400"})
	assert.Error(t, err)

	output := strings.TrimSpace(h.GetStderr())
	require.NotEmpty(t, output)
	// CLI outputs the error body JSON to stderr
	assert.Contains(t, output, `"error"`)
	assert.Contains(t, output, `"status_code"`)
	statusCode := jsonGetFloat64(output, "status_code")
	assert.Equal(t, float64(400), statusCode)
}

