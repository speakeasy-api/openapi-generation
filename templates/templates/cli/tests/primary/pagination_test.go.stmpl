// paginationPage represents a single page of pagination results.
type paginationPage struct {
	NumPages    int     `json:"numPages"`
	Next        *string `json:"next,omitempty"`
	ResultArray []int64 `json:"resultArray"`
}

// newPaginationServer creates a test server that serves paginated responses.
// Limit/offset pagination: returns pages based on ?page= param (3 pages total).
// Cursor pagination: returns pages based on ?cursor= param (items 1-3, cursor = last item).
func newPaginationServer() *httptest.Server {
	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")

		switch {
		case strings.HasPrefix(r.URL.Path, "/pagination/limitoffset/page"):
			page := 0
			if p := r.URL.Query().Get("page"); p != "" {
				page, _ = strconv.Atoi(p)
			}
			numPages := 3
			var results []int64
			switch page {
			case 0:
				results = []int64{1, 2, 3}
			case 1:
				results = []int64{4, 5, 6}
			case 2:
				results = []int64{7, 8, 9}
			default:
				results = []int64{}
			}
			json.NewEncoder(w).Encode(paginationPage{
				NumPages:    numPages,
				ResultArray: results,
			})

		case strings.HasPrefix(r.URL.Path, "/pagination/cursor"):
			cursor := 0
			if c := r.URL.Query().Get("cursor"); c != "" {
				cursor, _ = strconv.Atoi(c)
			}
			var results []int64
			switch {
			case cursor == 0:
				results = []int64{1, 2, 3}
			case cursor == 3:
				results = []int64{4, 5, 6}
			case cursor == 6:
				results = []int64{7, 8, 9}
			default:
				// Empty results → pagination ends
				results = []int64{}
			}
			resp := paginationPage{
				NumPages:    3,
				ResultArray: results,
			}
			json.NewEncoder(w).Encode(resp)

		default:
			http.NotFound(w, r)
		}
	}))
}

const paginationCursorHint = "Hint: more pages available. Use --all to fetch all results, or --cursor for manual pagination.\n"

// TestPaginationHintTruthfulness verifies that the hint is derived from the
// actual raw continuation value and is emitted only for human output.
func TestPaginationHintTruthfulness(t *testing.T) {
	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		results := []int64{1}
		if r.URL.Query().Get("cursor") == "99" {
			results = []int64{}
		}
		json.NewEncoder(w).Encode(paginationPage{NumPages: 2, ResultArray: results})
	}))
	defer s.Close()

	t.Run("pretty with numeric cursor", func(t *testing.T) {
		h := NewCLITestHarness(t)
		err := h.RunWithServer(s.URL, []string{
			"pagination", "pagination-cursor-params", "--cursor", "-1",
			"--output-format", "pretty",
		})
		require.NoError(t, err)
		assert.Equal(t, paginationCursorHint, h.GetStderr())
	})

	t.Run("terminal page", func(t *testing.T) {
		h := NewCLITestHarness(t)
		err := h.RunWithServer(s.URL, []string{
			"pagination", "pagination-cursor-params", "--cursor", "99",
			"--output-format", "pretty",
		})
		require.NoError(t, err)
		assert.Empty(t, h.GetStderr())
	})

	structured := []struct {
		name string
		args []string
	}{
		{name: "json", args: []string{"--output-format", "json"}},
		{name: "yaml", args: []string{"--output-format", "yaml"}},
		{name: "toon", args: []string{"--output-format", "toon"}},
		{name: "jq", args: []string{"--jq", ".resultArray"}},
		{name: "agent pretty", args: []string{"--agent-mode", "--output-format", "pretty"}},
	}
	for _, tt := range structured {
		t.Run(tt.name, func(t *testing.T) {
			h := NewCLITestHarness(t)
			args := []string{"pagination", "pagination-cursor-params", "--cursor", "-1"}
			args = append(args, tt.args...)
			err := h.RunWithServer(s.URL, args)
			require.NoError(t, err)
			assert.Empty(t, h.GetStderr())
		})
	}

	t.Run("dry run", func(t *testing.T) {
		h := NewCLITestHarness(t)
		err := h.RunWithServer(s.URL, []string{
			"pagination", "pagination-cursor-params", "--cursor", "-1",
			"--dry-run", "--output-format", "pretty",
		})
		require.NoError(t, err)
		assert.NotContains(t, h.GetStderr(), "Hint: more pages available")
	})
}

