// TestPaginationAllMaxPages verifies --max-pages limits the number of pages fetched.
func TestPaginationAllMaxPages(t *testing.T) {
	s := newPaginationServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunRaw([]string{"--server-url", s.URL, "pagination", "pagination-limit-offset-page-params",
		"--page", "0",
		"--all",
		"--max-pages", "1",
	})
	require.NoError(t, err)
	stdout := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, stdout)
	// Offset/page pagination carries no continuation evidence in the page
	// itself, so the truthful --max-pages diagnostic is not emitted here; the
	// cursor-based TestPaginationMaxPagesValidationAndRequestBound covers the message.

	var rendered []int
	for _, field := range strings.Fields(stdout) {
		if value, err := strconv.Atoi(field); err == nil {
			rendered = append(rendered, value)
		}
	}
	assert.Equal(t, []int{1, 2, 3}, rendered, "expected only the first page to be rendered")

	h2 := NewCLITestHarness(t)
	err = h2.RunWithServer(s.URL, []string{"pagination", "pagination-limit-offset-page-params",
		"--page", "0",
		"--all",
		"--max-pages", "1",
		"--output-format", "json",
	})
	require.NoError(t, err)
	assert.Empty(t, h2.GetStderr(), "machine-mode success must keep stderr silent")
}

func TestPaginationHintSilentInMachineMode(t *testing.T) {
	s := newPaginationServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"pagination", "pagination-limit-offset-page-params",
		"--page", "0",
		"--output-format", "json",
	})
	require.NoError(t, err)
	assert.NotEmpty(t, h.GetStdout())
	assert.Empty(t, h.GetStderr())
}

// ---------------------------------------------------------------------------
// Standard pagination variant tests — each records a test ID matching Go SDK
// tests so the coverage check sees them.
// These use RunBare (no --server-url override) so the operation-specific server
// URL (localhost:35456, the API test service) is used. The mock server at :18080
// does not serve pagination routes.
// ---------------------------------------------------------------------------

func TestPaginationLimitOffsetPageParams(t *testing.T) {
	recordTest("pagination-limit-offset-page-params")
	h := NewCLITestHarness(t)
	err := h.RunBare([]string{"pagination", "pagination-limit-offset-page-params", "--page", "1"})
	require.NoError(t, err)
	stdout := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, stdout)
	assert.True(t, json.Valid([]byte(stdout)), "expected valid JSON output")
}

