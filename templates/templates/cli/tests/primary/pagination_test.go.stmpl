func TestPaginationCursorNullableLimit(t *testing.T) {
	recordTest("pagination-cursor-nullable-limit")

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{"pagination", "pagination-cursor-nullable-limit", "--all"})
	require.NoError(t, err)
	stdout := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, stdout)

	// --all paginates through all pages and outputs NDJSON (one result per line).
	// The test service has 20 total items with a default limit of 10 per page.
	lines := strings.Split(stdout, "\n")
	assert.Equal(t, 20, len(lines), "expected 20 total results across all pages")
	for _, line := range lines {
		line = strings.TrimSpace(line)
		if line == "" {
			continue
		}
		assert.True(t, json.Valid([]byte(line)), "expected valid JSON line: %s", line)
	}
}

