package tests

import (
	"net/http"
	"net/http/httptest"
	"sync/atomic"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	"{{getGolangPackage}}/internal/clierrors"
)

// TestIntentSuppliedBodyRequiresDeclaredInputs checks that a caller-supplied
// body must still carry the intent's required inputs once the positional
// arguments and flags are merged into it.
func TestIntentSuppliedBodyRequiresDeclaredInputs(t *testing.T) {
	var requests atomic.Int32
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		requests.Add(1)
		w.WriteHeader(http.StatusInternalServerError)
	}))
	t.Cleanup(srv.Close)

	for _, tc := range []struct {
		name  string
		args  []string
		stdin string
		want  string
	}{
		{
			name: "empty body",
			args: []string{"generate", "--body", `{}`},
			want: `the request body from --body has no "input": pass the <prompt> argument or set "input" in the body`,
		},
		{
			name: "null body",
			args: []string{"generate", "--body", `null`},
			want: `the request body from --body has no "input"`,
		},
		{
			name: "body without input",
			args: []string{"generate", "--body", `{"model":"model-a"}`},
			want: `the request body from --body has no "input"`,
		},
		{
			name:  "stdin body without input",
			args:  []string{"generate"},
			stdin: `{"model":"model-a"}`,
			want:  `the request body from stdin has no "input"`,
		},
	} {
		t.Run(tc.name, func(t *testing.T) {
			h := NewCLITestHarness(t)
			err := h.RunWithStdinServer(srv.URL, append([]string{"--dry-run"}, tc.args...), tc.stdin)
			require.Error(t, err)
			assert.Contains(t, err.Error(), tc.want)
			assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
		})
	}

	for _, tc := range []struct {
		name  string
		args  []string
		stdin string
	}{
		{name: "body with input", args: []string{"generate", "--body", `{"input":"hello"}`}},
		{name: "argument merged into body", args: []string{"generate", "hello", "--body", `{"model":"model-a"}`}},
		{name: "stdin body with input", args: []string{"generate"}, stdin: `{"input":"hello"}`},
		{name: "argument merged into stdin body", args: []string{"generate", "hello"}, stdin: `{}`},
	} {
		t.Run(tc.name, func(t *testing.T) {
			h := NewCLITestHarness(t)
			err := h.RunWithStdinServer(srv.URL, append([]string{"--dry-run"}, tc.args...), tc.stdin)
			require.NoError(t, err, h.GetStderr())
		})
	}

	assert.Zero(t, requests.Load(), "validation and dry-run send no request")
}
