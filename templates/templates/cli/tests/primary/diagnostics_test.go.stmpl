func TestDryRunOutputFormatJSON(t *testing.T) {


	h := NewCLITestHarness(t)
	err := h.RunWithServer("http://127.0.0.1:1", []string{
		"--dry-run",
		"methods", "method-get",
	})
	require.NoError(t, err)

	assert.Empty(t, h.GetStderr(), "JSON dry-run stderr must be silent")
	stdout := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, stdout)
	var parsed map[string]interface{}
	require.NoError(t, json.Unmarshal([]byte(stdout), &parsed))
	assert.Equal(t, true, parsed["dry_run"])
	request, ok := parsed["request"].(map[string]interface{})
	require.True(t, ok)
	assert.Equal(t, "GET", request["method"])
	assert.Contains(t, request["url"], "/")
}

// Operation commands take no positional arguments. A stray token — most
// dangerously a safety flag demoted to a positional by "--" — must be
// rejected before the request is built, not silently swallowed while the
// live request goes out.
func TestOpCommandRejectsStrayPositionalAfterDoubleDash(t *testing.T) {
	s, count := newRequestTracker()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"methods", "method-delete", "--", "--dry-run"})
	require.Error(t, err)
	assert.Contains(t, err.Error(), `unknown command "--dry-run"`)
	assert.Equal(t, 0, *count, "a rejected invocation must not send the request")
}

func TestOpCommandRejectsStrayPositional(t *testing.T) {
	s, count := newRequestTracker()
	defer s.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"methods", "method-get", "extra"})
	require.Error(t, err)
	assert.Contains(t, err.Error(), `unknown command "extra"`)
	assert.Equal(t, 0, *count)
}

// Command groups reject stray tokens too — a typo'd subcommand is an error,
// not the group help page with a zero exit code.
func TestGroupCommandRejectsUnknownSubcommand(t *testing.T) {
	h := NewCLITestHarness(t)
	err := h.RunWithServer("http://127.0.0.1:1", []string{"methods", "method-bogus"})
	require.Error(t, err)
	assert.Contains(t, err.Error(), `unknown command "method-bogus"`)
}

// The informational commands emit one structured object under machine
// formats and keep the human text under pretty.
func TestVersionAndWhoamiMachineOutput(t *testing.T) {
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunBare([]string{"--output-format", "json", "version"}))
	var version map[string]any
	require.NoError(t, json.Unmarshal([]byte(h.GetStdout()), &version))
	assert.NotEmpty(t, version["version"])

	h = NewCLITestHarness(t)
	require.NoError(t, h.RunBare([]string{"--output-format", "json", "whoami"}))
	var whoami map[string]any
	require.NoError(t, json.Unmarshal([]byte(h.GetStdout()), &whoami))
	assert.NotEmpty(t, whoami["config_file"])

	h = NewCLITestHarness(t)
	require.NoError(t, h.RunRaw([]string{"version"}))
	assert.False(t, json.Valid([]byte(strings.TrimSpace(h.GetStdout()))),
		"pretty version output turned into JSON")
}
