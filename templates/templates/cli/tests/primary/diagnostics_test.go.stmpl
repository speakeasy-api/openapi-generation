}

func TestDryRunWithRequestBody(t *testing.T) {


	h := NewCLITestHarness(t)
	err := h.RunWithStdinServerRaw("http://127.0.0.1:1", []string{
		"--dry-run",
		"request-bodies", "request-body-post-application-json-map-of-any",
	}, `{"key": "value"}`)
	require.NoError(t, err)

	stderr := h.GetStderr()
	assert.Contains(t, stderr, "[DRY-RUN]", "stderr should contain dry-run prefix")
	assert.Contains(t, stderr, "POST", "stderr should show POST method")
	assert.Contains(t, stderr, "Network call skipped", "stderr should confirm no network call")
}

func TestDryRunRedactsSensitiveBodyKeys(t *testing.T) {


	h := NewCLITestHarness(t)
	body := `{"username": "admin", "password": "secret123", "data": "visible"}`
	err := h.RunWithStdinServerRaw("http://127.0.0.1:1", []string{
		"--dry-run",
		"request-bodies", "request-body-post-application-json-map-of-any",
	}, body)
	require.NoError(t, err)

	stderr := h.GetStderr()
	if strings.Contains(stderr, "Body:") {
		assert.NotContains(t, stderr, "secret123", "password field should be redacted in body")
		assert.Contains(t, stderr, "[REDACTED]", "sensitive body keys should show [REDACTED]")
		assert.Contains(t, stderr, "visible", "non-sensitive body values should remain visible")
	}
}

func TestDebugFlagAfterSubcommands(t *testing.T) {


	s := newDiagnosticsServer()
