package tests

import (
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

// newObjectPagesServer serves pagination-object-results-page-params: pages 0
// and 1 carry object results, page 2 is empty and ends pagination. Every
// response names its page in an X-Page header.
type objectPageRow map[string]any

func newObjectPagesServer(t *testing.T) *httptest.Server {
	t.Helper()
	pages := map[string][]objectPageRow{
		"0": {objectPageRow{"id": 1, "name": "alpha"}, objectPageRow{"id": 2, "name": "beta"}},
		"1": {objectPageRow{"id": 3, "name": "gamma"}},
	}
	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		page := r.URL.Query().Get("page")
		w.Header().Set("Content-Type", "application/json")
		w.Header().Set("X-Page", page)
		results := pages[page]
		if results == nil {
			results = []objectPageRow{}
		}
		_ = json.NewEncoder(w).Encode(map[string]any{"numPages": 2, "resultArray": results})
	}))
	t.Cleanup(s.Close)
	return s
}

func objectPagesArgs(extra ...string) []string {
	return append([]string{"pagination", "pagination-object-results-page-params", "--page", "0", "--all"}, extra...)
}

func TestPaginationAllIncludeHeadersEmitsPages(t *testing.T) {
	s := newObjectPagesServer(t)
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, objectPagesArgs("--include-headers", "--output-format", "json")), h.GetStderr())

	lines := strings.Split(strings.TrimSpace(h.GetStdout()), "\n")
	require.Len(t, lines, 3, h.GetStdout())
	for i, line := range lines {
		var page map[string]any
		require.NoError(t, json.Unmarshal([]byte(line), &page), line)
		assert.Contains(t, page, "resultArray", "with headers, whole pages are printed instead of items")
		headers, ok := page["_response_headers"].(map[string]any)
		require.True(t, ok, line)
		assert.Equal(t, []string{"0", "1", "2"}[i], headers["X-Page"])
	}
}

func TestPaginationAllIncludeHeadersYAMLAndJq(t *testing.T) {
	s := newObjectPagesServer(t)

	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, objectPagesArgs("--include-headers", "--output-format", "yaml")), h.GetStderr())
	assert.Equal(t, 3, strings.Count(h.GetStdout(), "_response_headers:"), h.GetStdout())

	h = NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, objectPagesArgs("--include-headers", "--jq", `._response_headers."X-Page"`)), h.GetStderr())
	assert.Equal(t, "\"0\"\n\"1\"\n\"2\"", strings.TrimSpace(h.GetStdout()))
}

func TestPaginationAllWithoutIncludeHeadersStreamsItems(t *testing.T) {
	s := newObjectPagesServer(t)
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, objectPagesArgs("--output-format", "json")), h.GetStderr())
	lines := strings.Split(strings.TrimSpace(h.GetStdout()), "\n")
	require.Len(t, lines, 3, h.GetStdout())
	assert.NotContains(t, h.GetStdout(), "_response_headers")
	assert.NotContains(t, h.GetStdout(), "resultArray")
}

func TestPaginationAllTableIncludeHeadersShowsLastPage(t *testing.T) {
	s := newObjectPagesServer(t)
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, objectPagesArgs("--include-headers", "--output-format", "table", "--color", "never")), h.GetStderr())

	out := h.GetStdout()
	table, headers, found := strings.Cut(out, "Response Headers (last page):")
	require.True(t, found, out)
	assert.Equal(t, []string{"ID", "NAME"}, strings.Fields(strings.Split(strings.TrimSpace(table), "\n")[0]))
	assert.Contains(t, table, "gamma")
	assert.Equal(t, 1, strings.Count(out, "Response Headers"), out)
	assert.Contains(t, headers, "X-Page:")
	assert.True(t, strings.HasSuffix(strings.TrimSpace(strings.Split(strings.Split(headers, "X-Page:")[1], "\n")[0]), "2"), headers)
}

func TestTableIncludeHeadersRendersTable(t *testing.T) {
	s := newResponseHeadersTestServer()
	t.Cleanup(s.Close)

	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, []string{
		"--include-headers", "--output-format", "table", "--color", "never",
		"response-headers", "response-headers",
		"--include-required-header", "--status-code", "200",
	}), h.GetStderr())
	out := h.GetStdout()
	assert.Equal(t, []string{"FIELD", "VALUE"}, strings.Fields(strings.Split(out, "\n")[0]), out)
	assert.NotContains(t, out, "token: test-token", "table output, not the pretty printer")
	assert.Contains(t, out, "Response Headers:")
	assert.Contains(t, out, "X-Required-Header")
}
