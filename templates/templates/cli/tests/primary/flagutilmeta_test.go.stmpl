	"{{getGolangPackage}}/internal/flagutil"
)

func TestNonBodyMeta(t *testing.T) {
	meta := []flagutil.FlagMeta{
		{FieldPath: "Trace"},
		{FieldPath: "Body"},
		{FieldPath: "Body.Interaction"},
	}

	// The expected literal stays multi-line: adjacent opening braces would
	// start a template action in this .stmpl file.
	expected := []flagutil.FlagMeta{
		{FieldPath: "Trace"},
	}
	assert.Equal(t, expected, flagutil.NonBodyMeta(meta, "Body"))
	assert.Empty(t, flagutil.NonBodyMeta(meta, ""))
}

type preflightUnionPart struct {
	Text string `json:"text"`
}

type preflightUnion struct {
	Text       *string              `union:"member"`
	Parts      []preflightUnionPart `union:"member"`
	UnknownRaw json.RawMessage      `json:"-" union:"unknown"`
}

func (u *preflightUnion) UnmarshalJSON(data []byte) error {
	if len(data) > 0 && data[0] == '"' {
		var text string
		if err := json.Unmarshal(data, &text); err != nil {
			return err
		}
		u.Text = &text
		return nil
	}
	var parts []preflightUnionPart
	if err := json.Unmarshal(data, &parts); err != nil {
		return err
	}
	u.Parts = parts
	return nil
}

func (u preflightUnion) MarshalJSON() ([]byte, error) {
	if u.Text != nil {
		return json.Marshal(*u.Text)
	}
	if u.Parts != nil {
		return json.Marshal(u.Parts)
	}
	if len(u.UnknownRaw) > 0 {
		return u.UnknownRaw, nil
	}
	return nil, errors.New("could not marshal preflight union: all fields are null")
}

type preflightNestedBody struct {
	Input preflightUnion `json:"input"`
}

type preflightBody struct {
	Input         preflightUnion       `json:"input"`
	Nested        *preflightNestedBody `json:"nested,omitempty"`
	OptionalInput *preflightUnion      `json:"optionalInput,omitempty"`
}

type preflightWrappedRequest struct {
	Body preflightBody `json:"body"`
}

func newPreflightBodyCommand() (*cobra.Command, []flagutil.FlagMeta) {
	cmd := &cobra.Command{}
	meta := []flagutil.FlagMeta{
		{
			FlagName: "input",
			FieldPath: "Input",
			Kind: flagutil.FlagKindUnion,
			Required: true,
			// A discriminated required union with no selector returns nil from
			// buildUnionField and is therefore the flags-only preflight shape.
			Union: &flagutil.UnionMeta{Discriminated: true},
		},
	}
	flagutil.RegisterFlags(cmd, meta)
	cmd.Flags().String("body", "", "body")
	return cmd, meta
}

func assertMissingPreflightField(t *testing.T, err error, path string) {
	t.Helper()
	require.Error(t, err)
	var missing *flagutil.MissingRequiredFieldError
	require.ErrorAs(t, err, &missing)
	assert.Equal(t, path, missing.Path)
	var typed interface{ CLIReason() string }
	require.ErrorAs(t, err, &typed)
	assert.Equal(t, "CLI_VALIDATION", typed.CLIReason())
}

func TestPreRequestRequiredUnionPreflightSources(t *testing.T) {
	cases := []struct {
		name string
		run func(t *testing.T) error
	}{
		{
			name: "body flag",
			run: func(t *testing.T) error {
				cmd, meta := newPreflightBodyCommand()
				require.NoError(t, cmd.Flags().Set("body", `{}`))
				_, err := flagutil.BuildRequest[preflightBody](cmd, meta, "", "body")
				return err
			},
		},
		{
			name: "stdin",
			run: func(t *testing.T) error {
				cmd, meta := newPreflightBodyCommand()
				cmd.SetIn(strings.NewReader(`{}`))
				_, err := flagutil.BuildRequest[preflightBody](cmd, meta, "", "body")
				return err
			},
		},
		{
			name: "whole body metadata flag",
			run: func(t *testing.T) error {
				cmd := &cobra.Command{}
				meta := []flagutil.FlagMeta{
					{FlagName: "request-body", FieldPath: "Body", Kind: flagutil.FlagKindJSON, Required: true},
					{FlagName: "input", FieldPath: "Body.Input", Kind: flagutil.FlagKindUnion, Required: true, Union: &flagutil.UnionMeta{Discriminated: true}},
				}
				flagutil.RegisterFlags(cmd, meta)
				require.NoError(t, cmd.Flags().Set("request-body", `{}`))
				_, err := flagutil.BuildRequest[preflightWrappedRequest](cmd, meta, "Body", "body")
				return err
			},
		},
		{
			name: "single whole body flag",
			run: func(t *testing.T) error {
				cmd := &cobra.Command{}
				cmd.Flags().String("request-body", "", "body")
				require.NoError(t, cmd.Flags().Set("request-body", `{}`))
				_, err := flagutil.BuildRequestBody[preflightBody](cmd, "request-body", "", true)
				return err
			},
		},
		{
			name: "individual flags",
			run: func(t *testing.T) error {
				cmd, meta := newPreflightBodyCommand()
				_, err := flagutil.BuildRequest[preflightBody](cmd, meta, "", "body")
				return err
			},
		},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			err := tc.run(t)
			assertMissingPreflightField(t, err, "input")
			assert.Contains(t, err.Error(), "input")
			if tc.name == "individual flags" {
				assert.Contains(t, err.Error(), "--input")
			}
		})
	}
}

func TestPreRequestRequiredUnionPreflightNestedPath(t *testing.T) {
	cmd, meta := newPreflightBodyCommand()
	require.NoError(t, cmd.Flags().Set("body", `{"input":"ok","nested":{}}`))
	_, err := flagutil.BuildRequest[preflightBody](cmd, meta, "", "body")
	assertMissingPreflightField(t, err, "nested.input")
}

func TestPreRequestRequiredUnionPreflightAllowsOptionalAndSelected(t *testing.T) {
	t.Run("optional union omitted", func(t *testing.T) {
		cmd, meta := newPreflightBodyCommand()
		require.NoError(t, cmd.Flags().Set("body", `{"input":"ok"}`))
		_, err := flagutil.BuildRequest[preflightBody](cmd, meta, "", "body")
		require.NoError(t, err)
	})

	t.Run("member selected by flag", func(t *testing.T) {
		cmd, meta := newPreflightBodyCommand()
		require.NoError(t, cmd.Flags().Set("input", `"ok"`))
		_, err := flagutil.BuildRequest[preflightBody](cmd, meta, "", "body")
		require.NoError(t, err)
	})

	t.Run("nested member selected", func(t *testing.T) {
		cmd, meta := newPreflightBodyCommand()
		require.NoError(t, cmd.Flags().Set("body", `{"input":"ok","nested":{"input":[{"text":"part"}]}}`))
		_, err := flagutil.BuildRequest[preflightBody](cmd, meta, "", "body")
		require.NoError(t, err)
	})
}

type preflightOmitZeroBody struct {
	Input preflightUnion `json:"input,omitzero"`
}

type preflightMultipartJSONBody struct {
	Input preflightUnion `multipartForm:"name=input,json"`
}

type preflightMultipartPlainBody struct {
	Input preflightUnion `multipartForm:"name=input"`
}

func TestPreRequestRequiredUnionPreflightMirrorsSerializerOmissions(t *testing.T) {
	t.Run("omitzero union is not serialized", func(t *testing.T) {
		cmd := &cobra.Command{}
		cmd.Flags().String("body", "", "body")
		require.NoError(t, cmd.Flags().Set("body", `{}`))
		_, err := flagutil.BuildRequest[preflightOmitZeroBody](cmd, nil, "", "body")
		require.NoError(t, err)
	})

	t.Run("multipart JSON union is serialized", func(t *testing.T) {
		cmd := &cobra.Command{}
		_, err := flagutil.BuildRequest[preflightMultipartJSONBody](cmd, nil, "", "")
		assertMissingPreflightField(t, err, "input")
	})

	t.Run("plain multipart field does not invoke union JSON", func(t *testing.T) {
		cmd := &cobra.Command{}
		_, err := flagutil.BuildRequest[preflightMultipartPlainBody](cmd, nil, "", "")
		require.NoError(t, err)
	})
}

type requiredParamsRequest struct {
	ID     string `pathParam:"style=simple,explode=false,name=id"`
	Filter string `queryParam:"style=form,explode=true,name=filter"`
	Token  string `header:"style=simple,explode=false,name=token"`
}

type requiredPathArrayRequest struct {
	IDs []string `pathParam:"style=simple,explode=false,name=ids"`
}

type requiredPathFormatRequest struct {
	Value string `pathParam:"style=simple,explode=false,name=value"`
}

type requiredParamsBody struct {
	Name string `json:"name" header:"name=name" pathParam:"name=name" queryParam:"name=name" form:"name=name"`
}

type requiredParamsBodyRequest struct {
	ID   string             `pathParam:"style=simple,explode=false,name=id"`
	Body requiredParamsBody `request:"mediaType=application/json"`
}

func newRequiredParamsCommand(meta []flagutil.FlagMeta) *cobra.Command {
	cmd := &cobra.Command{}
	flagutil.RegisterFlags(cmd, meta)
	cmd.Flags().String("body", "", "body")
	return cmd
}

func assertCLIValidation(t *testing.T, err error, flagName string) {
	t.Helper()
	require.Error(t, err)
	assert.Contains(t, err.Error(), "--"+flagName)
	var typed interface{ CLIReason() string }
	require.ErrorAs(t, err, &typed)
	assert.Equal(t, "CLI_VALIDATION", typed.CLIReason())
}

func TestBuildRequestKeepsRequiredParamsWhenNoFlagsGiven(t *testing.T) {
	for _, tc := range []struct {
		name     string
		flagName string
		meta     []flagutil.FlagMeta
	}{
		{
			name:     "path parameter",
			flagName: "id",
			meta: []flagutil.FlagMeta{
				{FlagName: "id", FieldPath: "ID", Kind: flagutil.FlagKindString, Required: true},
			},
		},
		{
			name:     "query parameter",
			flagName: "filter",
			meta: []flagutil.FlagMeta{
				{FlagName: "filter", FieldPath: "Filter", Kind: flagutil.FlagKindString, Required: true},
			},
		},
		{
			name:     "header parameter",
			flagName: "token",
			meta: []flagutil.FlagMeta{
				{FlagName: "token", FieldPath: "Token", Kind: flagutil.FlagKindString, Required: true},
			},
		},
	} {
		t.Run(tc.name, func(t *testing.T) {
			cmd := newRequiredParamsCommand(tc.meta)
			_, err := flagutil.BuildRequest[requiredParamsRequest](cmd, tc.meta, "", "")
			var missing *flagutil.MissingRequiredFlagError
			require.ErrorAs(t, err, &missing)
			assert.Equal(t, tc.flagName, missing.FlagName)
		})
	}
}

func TestBuildRequestKeepsRequiredPathParamWhenBodyProvided(t *testing.T) {
	meta := []flagutil.FlagMeta{
		{FlagName: "id", FieldPath: "ID", Kind: flagutil.FlagKindString, Required: true},
		{FlagName: "name", FieldPath: "Body.Name", Kind: flagutil.FlagKindString, Required: true},
	}
	for _, tc := range []struct {
		name string
		flag string
		value string
	}{
		{name: "whole body", flag: "body", value: `{"name":"widget"}`},
		{name: "body field", flag: "name", value: "widget"},
	} {
		t.Run(tc.name, func(t *testing.T) {
			cmd := newRequiredParamsCommand(meta)
			require.NoError(t, cmd.Flags().Set(tc.flag, tc.value))
			_, err := flagutil.BuildRequest[requiredParamsBodyRequest](cmd, meta, "Body", "body")
			var missing *flagutil.MissingRequiredFlagError
			require.ErrorAs(t, err, &missing)
			assert.Equal(t, "id", missing.FlagName)
		})
	}
}

func TestBuildRequestRelaxesRequiredBodyFieldsWhenNoFlagsGiven(t *testing.T) {
	meta := []flagutil.FlagMeta{
		{FlagName: "name", FieldPath: "Name", Kind: flagutil.FlagKindString, Required: true},
	}
	cmd := newRequiredParamsCommand(meta)
	_, err := flagutil.BuildRequest[requiredParamsBody](cmd, meta, "", "body")
	require.NoError(t, err)
}

func TestBuildRequestRejectsBlankRequiredPathParam(t *testing.T) {
	paramsMeta := []flagutil.FlagMeta{
		{FlagName: "id", FieldPath: "ID", Kind: flagutil.FlagKindString, Required: true},
	}
	bodyMeta := []flagutil.FlagMeta{
		{FlagName: "id", FieldPath: "ID", Kind: flagutil.FlagKindString, Required: true},
		{FlagName: "name", FieldPath: "Body.Name", Kind: flagutil.FlagKindString, Required: true},
	}
	for _, value := range []string{"", "   "} {
		t.Run("params only "+strconv.Quote(value), func(t *testing.T) {
			cmd := newRequiredParamsCommand(paramsMeta)
			require.NoError(t, cmd.Flags().Set("id", value))
			_, err := flagutil.BuildRequest[requiredParamsRequest](cmd, paramsMeta, "", "")
			assertCLIValidation(t, err, "id")
		})
		t.Run("body flags "+strconv.Quote(value), func(t *testing.T) {
			cmd := newRequiredParamsCommand(bodyMeta)
			require.NoError(t, cmd.Flags().Set("id", value))
			require.NoError(t, cmd.Flags().Set("name", "widget"))
			_, err := flagutil.BuildRequest[requiredParamsBodyRequest](cmd, bodyMeta, "Body", "body")
			assertCLIValidation(t, err, "id")
		})
		t.Run("whole body "+strconv.Quote(value), func(t *testing.T) {
			cmd := newRequiredParamsCommand(bodyMeta)
			require.NoError(t, cmd.Flags().Set("id", value))
			require.NoError(t, cmd.Flags().Set("body", `{"name":"widget"}`))
			_, err := flagutil.BuildRequest[requiredParamsBodyRequest](cmd, bodyMeta, "Body", "body")
			assertCLIValidation(t, err, "id")
		})
	}
}

func TestBuildRequestRejectsBlankRequiredPathParamArrayElements(t *testing.T) {
	meta := []flagutil.FlagMeta{
		{FlagName: "ids", FieldPath: "IDs", Kind: flagutil.FlagKindStringArray, Required: true},
	}
	for _, tc := range []struct {
		name   string
		values []string
	}{
		{name: "only blank", values: []string{"   "}},
		{name: "blank after value", values: []string{"item", "\t"}},
	} {
		t.Run(tc.name, func(t *testing.T) {
			cmd := newRequiredParamsCommand(meta)
			for _, value := range tc.values {
				require.NoError(t, cmd.Flags().Set("ids", value))
			}
			_, err := flagutil.BuildRequest[requiredPathArrayRequest](cmd, meta, "", "")
			assertCLIValidation(t, err, "ids")
		})
	}
}

func TestBuildRequestRejectsBlankRequiredJSONPathParamArrayElements(t *testing.T) {
	meta := []flagutil.FlagMeta{
		{FlagName: "ids", FieldPath: "IDs", Kind: flagutil.FlagKindJSON, Required: true},
	}
	for _, value := range []string{`[]`, `null`, `["   "]`, `["item","\t"]`} {
		t.Run(value, func(t *testing.T) {
			cmd := newRequiredParamsCommand(meta)
			require.NoError(t, cmd.Flags().Set("ids", value))
			_, err := flagutil.BuildRequest[requiredPathArrayRequest](cmd, meta, "", "")
			assertCLIValidation(t, err, "ids")
		})
	}
}

func TestBuildRequestAcceptsRequiredJSONPathParamArray(t *testing.T) {
	meta := []flagutil.FlagMeta{
		{FlagName: "ids", FieldPath: "IDs", Kind: flagutil.FlagKindJSON, Required: true},
	}
	cmd := newRequiredParamsCommand(meta)
	require.NoError(t, cmd.Flags().Set("ids", `["a","b"]`))
	req, err := flagutil.BuildRequest[requiredPathArrayRequest](cmd, meta, "", "")
	require.NoError(t, err)
	assert.Equal(t, []string{"a", "b"}, req.IDs)
}

type arrayQueryRequest struct {
	IDs []string `queryParam:"style=form,explode=true,name=ids"`
}

func TestBuildRequestRejectsEmptyRequiredJSONQueryParamArray(t *testing.T) {
	meta := []flagutil.FlagMeta{
		{FlagName: "ids", FieldPath: "IDs", Kind: flagutil.FlagKindJSON, Required: true},
	}
	cmd := newRequiredParamsCommand(meta)
	require.NoError(t, cmd.Flags().Set("ids", `[]`))
	_, err := flagutil.BuildRequest[arrayQueryRequest](cmd, meta, "", "")
	assertCLIValidation(t, err, "ids")
}

type int64ArrayQueryRequest struct {
	Codes []int64 `queryParam:"style=form,explode=true,name=codes"`
}

func TestBuildRequestValidatesInt64EnumArrayElementsExactly(t *testing.T) {
	meta := []flagutil.FlagMeta{
		{FlagName: "codes", FieldPath: "Codes", Kind: flagutil.FlagKindJSON, Required: true, EnumValues: []string{"9007199254740993", "1"}},
	}

	cmd := newRequiredParamsCommand(meta)
	require.NoError(t, cmd.Flags().Set("codes", `[9007199254740993]`))
	req, err := flagutil.BuildRequest[int64ArrayQueryRequest](cmd, meta, "", "")
	require.NoError(t, err)
	assert.Equal(t, []int64{9007199254740993}, req.Codes)

	cmd = newRequiredParamsCommand(meta)
	require.NoError(t, cmd.Flags().Set("codes", `[9007199254740992]`))
	_, err = flagutil.BuildRequest[int64ArrayQueryRequest](cmd, meta, "", "")
	require.Error(t, err)
	assert.Contains(t, err.Error(), `invalid value for --codes: "9007199254740992"; valid options: 9007199254740993, 1`)
}

type nullableElementArrayQueryRequest struct {
	Codes []*int64 `queryParam:"style=form,explode=true,name=codes"`
}

func TestBuildRequestRejectsNullElementsInNonNullableJSONArray(t *testing.T) {
	meta := []flagutil.FlagMeta{
		{FlagName: "codes", FieldPath: "Codes", Kind: flagutil.FlagKindJSON},
	}
	cmd := newRequiredParamsCommand(meta)
	require.NoError(t, cmd.Flags().Set("codes", `[1, null]`))
	_, err := flagutil.BuildRequest[int64ArrayQueryRequest](cmd, meta, "", "")
	assertCLIValidation(t, err, "codes")
	assert.Contains(t, err.Error(), "null element")

	cmd = newRequiredParamsCommand(meta)
	require.NoError(t, cmd.Flags().Set("codes", `[1, null]`))
	req, err := flagutil.BuildRequest[nullableElementArrayQueryRequest](cmd, meta, "", "")
	require.NoError(t, err)
	require.Len(t, req.Codes, 2)
	assert.Nil(t, req.Codes[1])
}

type nullableEnumItemArrayQueryRequest struct {
	Levels []*string `queryParam:"style=form,explode=true,name=levels"`
	Codes  []*int64  `queryParam:"style=form,explode=true,name=codes"`
}

func TestBuildRequestValidatesNullableEnumItemArrayElements(t *testing.T) {
	for _, tc := range []struct {
		flagName  string
		fieldPath string
		enum      []string
		valid     string
		invalid   string
	}{
		{flagName: "levels", fieldPath: "Levels", enum: []string{"low", "high"}, valid: `["low", null, "high"]`, invalid: `[null, "medium"]`},
		{flagName: "codes", fieldPath: "Codes", enum: []string{"1", "2"}, valid: `[1, null, 2]`, invalid: `[null, 3]`},
	} {
		t.Run(tc.flagName, func(t *testing.T) {
			meta := []flagutil.FlagMeta{
				{FlagName: tc.flagName, FieldPath: tc.fieldPath, Kind: flagutil.FlagKindJSON, EnumValues: tc.enum},
			}

			cmd := newRequiredParamsCommand(meta)
			require.NoError(t, cmd.Flags().Set(tc.flagName, tc.valid))
			_, err := flagutil.BuildRequest[nullableEnumItemArrayQueryRequest](cmd, meta, "", "")
			require.NoError(t, err)

			cmd = newRequiredParamsCommand(meta)
			require.NoError(t, cmd.Flags().Set(tc.flagName, tc.invalid))
			_, err = flagutil.BuildRequest[nullableEnumItemArrayQueryRequest](cmd, meta, "", "")
			require.Error(t, err)
			assert.Contains(t, err.Error(), "valid options")
		})
	}
}

func TestBuildRequestChecksArrayMinItems(t *testing.T) {
	for _, tc := range []struct {
		name   string
		kind   flagutil.FlagKind
		values []string
	}{
		{"repeatable", flagutil.FlagKindStringArray, []string{"a"}},
		{"json", flagutil.FlagKindJSON, []string{`["a"]`}},
	} {
		meta := []flagutil.FlagMeta{
			{FlagName: "ids", FieldPath: "IDs", Kind: tc.kind, Optional: true, MinItems: 2},
		}
		t.Run(tc.name+"/strict", func(t *testing.T) {
			cmd := newRequiredParamsCommand(meta)
			cmd.Annotations = map[string]string{"speakeasy_strict_body_keys": "true"}
			for _, value := range tc.values {
				require.NoError(t, cmd.Flags().Set("ids", value))
			}
			_, err := flagutil.BuildRequest[arrayQueryRequest](cmd, meta, "", "")
			require.Error(t, err)
			assert.Contains(t, err.Error(), "invalid value for --ids: 1 item(s), fewer than the minimum 2")
		})
		t.Run(tc.name+"/warn", func(t *testing.T) {
			cmd := newRequiredParamsCommand(meta)
			var stderr bytes.Buffer
			cmd.SetErr(&stderr)
			for _, value := range tc.values {
				require.NoError(t, cmd.Flags().Set("ids", value))
			}
			req, err := flagutil.BuildRequest[arrayQueryRequest](cmd, meta, "", "")
			require.NoError(t, err)
			assert.Equal(t, []string{"a"}, req.IDs)
			assert.Contains(t, stderr.String(), "Warning: invalid value for --ids: 1 item(s), fewer than the minimum 2")
		})
	}
}

func TestBuildRequestRejectsBlankRequiredFormattedPathParams(t *testing.T) {
	for _, tc := range []struct {
		name       string
		kind       flagutil.FlagKind
		enumValues []string
	}{
		{name: "enum", kind: flagutil.FlagKindEnum, enumValues: []string{"", "active"}},
		{name: "integer enum", kind: flagutil.FlagKindIntEnum, enumValues: []string{"1", "2"}},
		{name: "date", kind: flagutil.FlagKindDate},
		{name: "date-time", kind: flagutil.FlagKindDateTime},
	} {
		for _, value := range []string{"", "   "} {
			t.Run(tc.name+" "+strconv.Quote(value), func(t *testing.T) {
				meta := []flagutil.FlagMeta{
					{FlagName: "value", FieldPath: "Value", Kind: tc.kind, Required: true, EnumValues: tc.enumValues},
				}
				cmd := newRequiredParamsCommand(meta)
				require.NoError(t, cmd.Flags().Set("value", value))
				_, err := flagutil.BuildRequest[requiredPathFormatRequest](cmd, meta, "", "")
				assertCLIValidation(t, err, "value")
			})
		}
	}
}

func TestBuildRequestAllowsBlankRequiredNonPathParams(t *testing.T) {
	meta := []flagutil.FlagMeta{
		{FlagName: "id", FieldPath: "ID", Kind: flagutil.FlagKindString, Required: true},
		{FlagName: "filter", FieldPath: "Filter", Kind: flagutil.FlagKindString, Required: true},
	}
	cmd := newRequiredParamsCommand(meta)
	require.NoError(t, cmd.Flags().Set("id", "item"))
	require.NoError(t, cmd.Flags().Set("filter", ""))
	req, err := flagutil.BuildRequest[requiredParamsRequest](cmd, meta, "", "")
	require.NoError(t, err)
	assert.Equal(t, "item", req.ID)
	assert.Empty(t, req.Filter)
}
