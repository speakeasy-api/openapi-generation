// TestIntentDiscriminatedPartialBody exercises the second body surface being
// the union field flag of a mixed operation, the discriminator conflict, and
// the discriminator fill.
func TestIntentDiscriminatedPartialBody(t *testing.T) {
	recordTest("intents-discriminated-partial-body")
	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, []string{"model-job", "--variant-id", "v1",
		"--discriminated-variant-body", `{"input":"cat"}`}))
	body := echoedJSON(t, h.GetStdout())
	assert.Equal(t, "model", body["kind"])
	assert.Equal(t, "fixed-model", body["model"])
	assert.Equal(t, "cat", body["input"])

	h = NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"model-job", "--variant-id", "v1",
		"--body", `{"kind":"agent","agent":"a","input":"cat"}`})
	require.Error(t, err)
	assert.Contains(t, err.Error(), `"model-job" presets the BodyVariantModel request variant`)
}
