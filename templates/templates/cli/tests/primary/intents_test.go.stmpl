}

// TestIntentForeignSelectorAgentEnvelope: the conflict is a CLI-originated
// error, so in agent mode it must arrive in the reason-first envelope with the
// intent's declared CLI_VALIDATION hint.
func TestIntentForeignSelectorAgentEnvelope(t *testing.T) {
	recordTest("intents-foreign-selector-agent-envelope")
	resetAgentMode(t)
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"--agent-mode", "render", "--body", `{"agent":"helper"}`})
	require.Error(t, err)

	var envelope map[string]interface{}
	require.NoError(t, json.Unmarshal([]byte(strings.TrimSpace(h.GetStderr())), &envelope), "got: %s", h.GetStderr())
	assert.Equal(t, "validation_error", envelope["error_type"])
	assert.Equal(t, "CLI_VALIDATION", envelope["error_reason"])
	hints, _ := envelope["hints"].([]interface{})
	assert.Contains(t, hints, "Print the exact request schema with --schema")
}

