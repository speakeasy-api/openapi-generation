// The intent commands under test are declared in
// tests/overlays/primary/cli/overlay.yaml over the cliIntentRun operation
// (a non-discriminated union body: model variant | agent variant, model
// selector defaulted to "text-1") and the discriminated
// bodyVariantOverloadsDiscriminated operation.

// renderPreset mirrors the generated "render" intent: pinned to the model
// variant, presets model + output_modalities, agent is the foreign selector.
var renderPreset = flagutil.PresetMerge{
	Command: "render",
	Variant: "CliIntentModelRequest",
	Preset:  `{"model":"render-1","output_modalities":["image"]}`,
	Foreign: []string{"agent"},
	Escape:  "cli cli-intents cli-intent-run",
}

// TestIntentPresetMergeMatrix pins the merge matrix (preset x user key x
// selector presence) of flagutil.MergePresetBody.
func TestIntentPresetMergeMatrix(t *testing.T) {
	recordTest("intents-preset-merge-matrix")

	discriminated := flagutil.PresetMerge{
		Command:              "model-job",
		Variant:              "BodyVariantModel",
		Preset:               `{"model":"fixed-model"}`,
		Foreign:              []string{"agent"},
		DiscriminatorKey:     "kind",
		DiscriminatorValue:   `"model"`,
		DiscriminatorAliases: []string{`"model"`, `"llm"`},
		Escape:               "cli request-bodies body-variant-overloads-discriminated",
	}
	noPreset := flagutil.PresetMerge{Command: "alias", Variant: "CliIntentModelRequest", Foreign: []string{"agent"}}

	cases := []struct {
		name      string
		merge     flagutil.PresetMerge
		body      string
		want      string // canonical JSON of the merged body ("" when unchanged)
		wantErr   string // substring of the conflict error ("" = no error)
		untouched bool   // body returned byte-for-byte
	}{
		{name: "empty object: presets alone", merge: renderPreset, body: `{}`, want: `{"model":"render-1","output_modalities":["image"]}`},
		{name: "empty string counts as {}", merge: renderPreset, body: `  `, want: `{"model":"render-1","output_modalities":["image"]}`},
		{name: "partial body without selector: presets fill including the selector", merge: renderPreset, body: `{"input":"cat"}`, want: `{"input":"cat","model":"render-1","output_modalities":["image"]}`},
		{name: "own selector present: user wins, other presets fill", merge: renderPreset, body: `{"model":"other-2","input":"cat"}`, want: `{"input":"cat","model":"other-2","output_modalities":["image"]}`},
		{name: "user overrides a non-selector preset", merge: renderPreset, body: `{"output_modalities":["text"],"input":"cat"}`, want: `{"input":"cat","model":"render-1","output_modalities":["text"]}`},
		{name: "explicit null keeps the user's null (own selector)", merge: renderPreset, body: `{"model":null,"input":"cat"}`, want: `{"input":"cat","model":null,"output_modalities":["image"]}`},
		{name: "shallow merge: nested object replaced whole, not merged", merge: flagutil.PresetMerge{Command: "cfg", Preset: `{"config":{"a":1,"b":2}}`}, body: `{"config":{"c":3}}`, want: `{"config":{"c":3}}`},
		{name: "raw values are preserved (large integer, precise decimal)", merge: renderPreset, body: `{"input":"cat","n":12345678901234567890,"d":0.10000000000000000001}`, want: `{"d":0.10000000000000000001,"input":"cat","model":"render-1","n":12345678901234567890,"output_modalities":["image"]}`},
		{name: "foreign selector: hard usage error", merge: renderPreset, body: `{"agent":"helper","input":"cat"}`, wantErr: `"render" presets the CliIntentModelRequest request variant, but the supplied body names "agent"`},
		{name: "foreign selector alongside own selector: still an error", merge: renderPreset, body: `{"agent":"helper","model":"x"}`, wantErr: `names "agent"`},
		{name: "foreign selector set to null: presence selects the variant", merge: renderPreset, body: `{"agent":null}`, wantErr: `names "agent"`},
		{name: "conflict error names the escape hatch", merge: renderPreset, body: `{"agent":"a"}`, wantErr: `use "cli cli-intents cli-intent-run" to send that request`},
		{name: "array body: untouched, downstream parse error", merge: renderPreset, body: `[1,2]`, untouched: true},
		{name: "scalar body: untouched", merge: renderPreset, body: `"cat"`, untouched: true},
		{name: "malformed object: untouched, downstream parse error", merge: renderPreset, body: `{"input":`, untouched: true},
		{name: "no preset, no conflict: body passes through as an object", merge: noPreset, body: `{"input":"cat"}`, want: `{"input":"cat"}`},
		{name: "no preset, foreign selector: still an error", merge: noPreset, body: `{"agent":"a"}`, wantErr: `names "agent"`},
		{name: "discriminated: missing discriminator is filled with the pinned value", merge: discriminated, body: `{"input":"cat"}`, want: `{"input":"cat","kind":"model","model":"fixed-model"}`},
		{name: "discriminated: same value accepted (whitespace-insensitive)", merge: discriminated, body: `{"kind": "model", "input":"cat"}`, want: `{"input":"cat","kind":"model","model":"fixed-model"}`},
		{name: "discriminated: other value is a conflict", merge: discriminated, body: `{"kind":"agent","input":"cat"}`, wantErr: `sets "kind" to "agent", which selects a different variant`},
		{name: "discriminated: mapping alias of the pinned variant is accepted and kept", merge: discriminated, body: `{"kind":"llm","input":"cat"}`, want: `{"input":"cat","kind":"llm","model":"fixed-model"}`},
		{name: "discriminated: foreign key is a conflict even without the discriminator", merge: discriminated, body: `{"agent":"a"}`, wantErr: `names "agent"`},
	}

	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			got, err := flagutil.MergePresetBody(tc.body, tc.merge)
			if tc.wantErr != "" {
				require.Error(t, err)
				assert.Contains(t, err.Error(), tc.wantErr)
				var conflict *flagutil.PresetConflictError
				require.True(t, errors.As(err, &conflict), "conflict must be typed for the agent envelope")
				assert.Equal(t, "CLI_VALIDATION", conflict.CLIReason())
				return
			}
			require.NoError(t, err)
			if tc.untouched {
				assert.Equal(t, tc.body, got)
				return
			}
			assert.JSONEq(t, tc.want, got)
		})
	}
}

// echoedJSON returns the "json" reflection of the request body the echo
// server saw, decoded.
func echoedJSON(t *testing.T, stdout string) map[string]interface{} {
	t.Helper()
	var resp map[string]interface{}
	require.NoError(t, json.Unmarshal([]byte(strings.TrimSpace(stdout)), &resp), "stdout should be JSON, got: %s", stdout)
	body, _ := resp["json"].(map[string]interface{})
	require.NotNil(t, body, "echo server should reflect the request body, got: %s", stdout)
	return body
}

func TestIntentRouteDispatchFlagPathsAndPresets(t *testing.T) {
	recordTest("intent-route-dispatch-flag-paths")
	s := newEchoServer()
	defer s.Close()

	t.Run("model", func(t *testing.T) {
		h := NewCLITestHarness(t)
		require.NoError(t, h.RunWithServer(s.URL, []string{"cli-intents", "cli-intent-run", "draw a lighthouse", "--model", "text-2"}))
		body := echoedJSON(t, h.GetStdout())
		assert.Equal(t, "text-2", body["model"])
		assert.Equal(t, "draw a lighthouse", body["input"])
		assert.Equal(t, true, body["background"], "command preset applies to the model route")
		assert.Equal(t, []interface{}{"image"}, body["output_modalities"], "model preset applies only after model selection")
		assert.NotContains(t, body, "token_budget")
	})

	t.Run("agent", func(t *testing.T) {
		h := NewCLITestHarness(t)
		require.NoError(t, h.RunWithServer(s.URL, []string{"cli-intents", "cli-intent-run", "summarize", "--agent", "helper", "--agent-profile", "standard"}))
		body := echoedJSON(t, h.GetStdout())
		assert.Equal(t, "helper", body["agent"])
		assert.Equal(t, "standard", body["agent_profile"])
		assert.Equal(t, "summarize", body["input"])
		assert.Equal(t, true, body["background"], "command preset applies to the agent route")
		assert.Equal(t, float64(512), body["token_budget"], "agent preset applies only after agent selection")
		assert.NotContains(t, body, "output_modalities")
	})
}

func TestIntentRouteDispatchDefaultAndConditionalRequired(t *testing.T) {
	recordTest("intent-route-dispatch-default-required")
	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, []string{"cli-intents", "cli-intent-run", "use the default"}))
	body := echoedJSON(t, h.GetStdout())
	assert.Equal(t, "text-1", body["model"], "the union schema default is sent on the default route")
	assert.Equal(t, []interface{}{"image"}, body["output_modalities"])

	h = NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"cli-intents", "cli-intent-run", "--agent-profile", "standard"})
	require.Error(t, err)
	assert.Equal(t, "required flag --agent not set for the Agent variant", err.Error())
	assert.Empty(t, strings.TrimSpace(h.GetStdout()), "validation errors send no request")
}

func TestIntentRouteDispatchBareInvocationIsUsageError(t *testing.T) {
	recordTest("intent-route-dispatch-bare-help")
	h := NewCLITestHarness(t)
	// Like pinned intents, a bare required-input dispatch invocation is a
	// usage failure: help and the error go to stderr, stdout stays empty, and
	// the process exits 2. No request is attempted.
	err := h.RunRaw([]string{"cli-intents", "cli-intent-run"})
	require.Error(t, err)
	assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
	assert.Empty(t, strings.TrimSpace(h.GetStdout()), "bare usage must not print help on stdout")
	help := h.GetStderr()
	assert.Contains(t, help, "Request variants:")
	assert.Contains(t, help, "Usage:")
	assert.Contains(t, help, "cli cli-intents cli-intent-run [input] [flags]")
	assert.Contains(t, help, "Error: missing required argument <input>")

	// Structured modes return one envelope instead of the help page.
	h = NewCLITestHarness(t)
	err = h.RunBare([]string{"cli-intents", "cli-intent-run"})
	require.Error(t, err)
	assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
	assert.Contains(t, h.GetStderr(), `"error_reason": "CLI_VALIDATION"`)
	assert.Empty(t, strings.TrimSpace(h.GetStdout()))
}

func TestIntentRouteDispatchConflictingEvidence(t *testing.T) {
	recordTest("intent-route-dispatch-conflicting-evidence")

	cases := []struct {
		name string
		args []string
		want string
	}{
		{
			name: "model and agent flags",
			args: []string{"cli-intents", "cli-intent-run", "input", "--model", "text-2", "--agent", "helper"},
			want: "--model and --agent select different request variants; pass exactly one",
		},
		{
			name: "model flag and agent body key",
			args: []string{"cli-intents", "cli-intent-run", "--model", "text-2", "--body", `{"agent":"helper","input":"body input"}`},
			want: `--model and body key "agent" select different request variants; pass exactly one`,
		},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			h := NewCLITestHarness(t)
			err := h.RunBare(tc.args)
			require.Error(t, err)
			assert.Equal(t, tc.want, err.Error())
			assert.Empty(t, strings.TrimSpace(h.GetStdout()), "validation errors send no request")
		})
	}
}

func TestIntentRouteDispatchBodyEvidence(t *testing.T) {
	recordTest("intent-route-dispatch-body-evidence")
	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, []string{"cli-intents", "cli-intent-run", "--body", `{"agent":"helper","input":"from body"}`}))
	body := echoedJSON(t, h.GetStdout())
	assert.Equal(t, "helper", body["agent"])
	assert.Equal(t, "from body", body["input"])
	assert.Equal(t, true, body["background"])
	assert.Equal(t, float64(512), body["token_budget"])
	assert.NotContains(t, body, "output_modalities")

	h = NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"cli-intents", "cli-intent-run", "--body", `{"model":"text-2","agent":"helper","input":"conflict"}`})
	require.Error(t, err)
	assert.Contains(t, err.Error(), `body key "agent" and body key "model" select different request variants`)
	assert.Empty(t, strings.TrimSpace(h.GetStdout()))
}

func TestIntentRouteDispatchHelpAndUsageSurfaces(t *testing.T) {
	recordTest("intent-route-dispatch-help-usage")
	path := []string{"cli-intents", "cli-intent-run"}

	h := NewCLITestHarness(t)
	require.NoError(t, h.RunBare(append(path, "--help")))
	help := h.GetStdout()
	assert.Contains(t, help, "Model variant Flags:")
	assert.Contains(t, help, "Agent variant Flags:")
	modelGroup := strings.Index(help, "Model variant Flags:")
	agentGroup := strings.Index(help, "Agent variant Flags:")
	require.NotEqual(t, -1, modelGroup)
	require.NotEqual(t, -1, agentGroup)
	assert.Less(t, modelGroup, agentGroup, "variant help groups follow manifest route order")
	assert.Contains(t, help, "Request variants: Model (--model; default), Agent (--agent).")
	assert.NotContains(t, help, "--cli-intent-run-body")

	h = NewCLITestHarness(t)
	err := h.RunBare(append(path, "--cli-intent-run-body", `{}`))
	require.Error(t, err)
	assert.Contains(t, err.Error(), `unknown flag: --cli-intent-run-body`)

	h = NewCLITestHarness(t)
	require.NoError(t, h.RunBare(append(path, "--usage")))
	usageSchema := h.GetStdout()
	assert.Contains(t, usageSchema, `flag "-m --model <model>"`)
	assert.Contains(t, usageSchema, `flag "--agent <agent>"`)
	assert.Contains(t, usageSchema, `flag "--agent-profile <agent_profile>"`)
	assert.Contains(t, usageSchema, `flag "--body <body>"`)
	assert.Contains(t, usageSchema, `flag "--schema"`)
	assert.Contains(t, usageSchema, `flag "--trace <trace>"`)
	assert.NotContains(t, usageSchema, "cli-intent-run-body")
}

func TestIntentRouteDispatchAgentEnvelope(t *testing.T) {
	recordTest("intent-route-dispatch-agent-envelope")
