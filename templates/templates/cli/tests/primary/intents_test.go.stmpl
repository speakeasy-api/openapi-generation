func TestIntentRouteDispatchInteractivePromptPlan(t *testing.T) {
	recordTest("intent-route-dispatch-interactive-plan")
	p := &scriptedPrompter{answers: map[string][]string{"arg:input": {"interactive input"}}}
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunInteractive([]string{"--dry-run", "cli-intents", "cli-intent-run"}, p))
	require.Len(t, p.fields, 1)
	assert.Equal(t, []string{"arg:input"}, p.fields[0])
	assert.NotContains(t, p.fields[0], "flag:model")
	assert.NotContains(t, p.fields[0], "flag:agent")
	// The harness requests JSON, so the dry-run preview object is on stdout.
	assert.Contains(t, h.GetStdout(), `"input":"interactive input"`)
	assert.Contains(t, h.GetStdout(), `"model":"text-1"`)
}

// A complete request piped on stdin takes request control under
// --interactive: nothing is prompted for, and the piped body is the request.
func TestIntentInteractivePipedBodySkipsPrompts(t *testing.T) {
	recordTest("intent-interactive-piped-body-skips-prompts")
	withDelayedStdinPipe(t, 0, `{"input":"from stdin","model":"text-2"}`, true)

	p := &scriptedPrompter{}
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunInteractive([]string{"--dry-run", "cli-intents", "cli-intent-run"}, p))
	assert.Empty(t, p.fields, "prompted despite a piped whole body")
	assert.Contains(t, h.GetStdout(), `"input":"from stdin"`)
	assert.Contains(t, h.GetStdout(), `"model":"text-2"`)
}

func TestIntentRouteDispatchOverrideRegisteredOnce(t *testing.T) {
	recordTest("intent-route-dispatch-override-once")
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunBare([]string{"cli-intents", "--help"}))
	help := h.GetStdout()
	assert.Equal(t, 1, strings.Count(help, "\n  cli-intent-run "), "the generated operation registration is replaced, not duplicated")
	assert.Contains(t, help, "Run an interaction")
}

// TestIntentOrderingKeepsUndeclaredNestedGroupsAlphabetical verifies that
// disabling Cobra's global sorting for declared root commands does not change
// the established alphabetical order beneath an undeclared generated group,
// in either help or the mirrored KDL usage schema.
func TestIntentOrderingKeepsUndeclaredNestedGroupsAlphabetical(t *testing.T) {
	recordTest("intents-undeclared-nested-group-order")
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunBare([]string{"nested", "--help"}))

	help := h.GetStdout()
	first := strings.Index(help, "\n  first ")
	get := strings.Index(help, "\n  get ")
	second := strings.Index(help, "\n  second ")
	require.NotEqual(t, -1, first, "first command missing from nested help:\n%s", help)
	require.NotEqual(t, -1, get, "get command missing from nested help:\n%s", help)
	require.NotEqual(t, -1, second, "second command missing from nested help:\n%s", help)
	assert.Less(t, first, get)
	assert.Less(t, get, second)

	h = NewCLITestHarness(t)
	require.NoError(t, h.RunBare([]string{"nested", "--usage"}))
	schema := h.GetStdout()
	first = strings.Index(schema, `cmd "first"`)
	get = strings.Index(schema, `cmd "get"`)
	second = strings.Index(schema, `cmd "second"`)
	require.NotEqual(t, -1, first, "first command missing from nested usage:\n%s", schema)
	require.NotEqual(t, -1, get, "get command missing from nested usage:\n%s", schema)
	require.NotEqual(t, -1, second, "second command missing from nested usage:\n%s", schema)
	assert.Less(t, first, get)
	assert.Less(t, get, second)
}

func TestIntentPresetFromArgs(t *testing.T) {
	recordTest("intents-preset-from-args")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, []string{"render", "a lighthouse at dusk"}))
	body := echoedJSON(t, h.GetStdout())
	assert.Equal(t, "render-1", body["model"])
	assert.Equal(t, []interface{}{"image"}, body["output_modalities"])
	assert.Equal(t, "a lighthouse at dusk", body["input"])
}

// TestIntentPartialBodyKeepsPresets is the regression for the preset being
// dropped under --body: the union's default variant (model text-1) must not
// replace the intent's pinned model.
func TestIntentPartialBodyKeepsPresets(t *testing.T) {
	recordTest("intents-partial-body-keeps-presets")
	s := newEchoServer()
	defer s.Close()

	for _, surface := range []string{"--body", "--cli-intent-run-body"} {
		t.Run(surface, func(t *testing.T) {
			h := NewCLITestHarness(t)
			require.NoError(t, h.RunWithServer(s.URL, []string{"render", surface, `{"input":"cat"}`}))
			body := echoedJSON(t, h.GetStdout())
			assert.Equal(t, "render-1", body["model"], "preset selector must survive a partial body")
			assert.Equal(t, []interface{}{"image"}, body["output_modalities"])
			assert.Equal(t, "cat", body["input"])
		})
	}
}

func TestIntentPartialBodyUserKeysWin(t *testing.T) {
	recordTest("intents-partial-body-user-keys-win")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	// A positional and a --body that both set the bound key is a usage
	// error (nothing is silently dropped); the user's keys win over presets
	// once the body alone carries the input.
	err := h.RunWithServer(s.URL, []string{"render", "ignored positional", "--body", `{"model":"other-2","output_modalities":["text"],"input":"cat"}`})
	require.Error(t, err)
	assert.Contains(t, err.Error(), `"input"`)
	assert.Contains(t, err.Error(), "pass exactly one")

	h = NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, []string{"render", "--body", `{"model":"other-2","output_modalities":["text"],"input":"cat"}`}))
	body := echoedJSON(t, h.GetStdout())
	assert.Equal(t, "other-2", body["model"])
	assert.Equal(t, []interface{}{"text"}, body["output_modalities"])
	assert.Equal(t, "cat", body["input"])
}

func TestIntentBothBodySurfacesMerged(t *testing.T) {
	recordTest("intents-both-body-surfaces-merged")
	s := newEchoServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	// Supplying the request through both --body and the whole-body field
	// flag is ambiguous and rejected; each surface on its own is merged with
	// the presets.
	err := h.RunWithServer(s.URL, []string{"render",
		"--body", `{"input":"from-body"}`,
		"--cli-intent-run-body", `{"input":"from-field"}`})
	require.Error(t, err)
	assert.Contains(t, err.Error(), "--body")
	assert.Contains(t, err.Error(), "--cli-intent-run-body")

	h = NewCLITestHarness(t)
	require.NoError(t, h.RunWithServer(s.URL, []string{"render",
		"--cli-intent-run-body", `{"input":"from-field"}`}))
	body := echoedJSON(t, h.GetStdout())
	assert.Equal(t, "from-field", body["input"])
	assert.Equal(t, "render-1", body["model"])
}

func TestIntentForeignSelectorIsUsageError(t *testing.T) {
	recordTest("intents-foreign-selector-usage-error")
