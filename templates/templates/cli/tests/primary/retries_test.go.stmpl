func TestRetriesConnectError(t *testing.T) {
	recordTest("retries-connect-error")
	// Create and immediately close a server to get a guaranteed non-listening port
	closedServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
	closedServer.Close()

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{"retries", "retries-connect-error-get", "--server-url", closedServer.URL})
	assert.Error(t, err)
}

func TestRetriesGlobalConfigDisable(t *testing.T) {
	recordTest("retries-global-config-disable")
	s := newRetryServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	// --no-retries disables all retries, so the first 503 should be returned as an error
	err := h.RunWithServer(s.URL, []string{"retries", "retries-get",
		"--request-id", "test-global-disable",
		"--num-retries", "2",
		"--no-retries",
	})
	assert.Error(t, err)
}

func TestRetriesGlobalConfigSuccess(t *testing.T) {
	recordTest("retries-global-config-success")
	s := newRetryServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	// Override retry config via --retry-config JSON with generous maxElapsedTime
	err := h.RunWithServer(s.URL, []string{"retries", "retries-get",
		"--request-id", "test-global-success",
		"--num-retries", "20",
		"--retry-config", `{"strategy":"backoff","backoff":{"initialInterval":1,"maxInterval":50,"exponent":1.1,"maxElapsedTime":1000}}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"retries"`)
}

func TestRetriesGlobalConfigTimeout(t *testing.T) {
	recordTest("retries-global-config-timeout")
	s := newRetryServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	// Override retry config with a very short maxElapsedTime — retries should time out
	err := h.RunWithServer(s.URL, []string{"retries", "retries-get",
		"--request-id", "test-global-timeout",
		"--num-retries", "30",
		"--retry-config", `{"strategy":"backoff","backoff":{"initialInterval":1,"maxInterval":50,"exponent":1.1,"maxElapsedTime":100}}`,
	})
	assert.Error(t, err)
}

func TestRetriesTimeout(t *testing.T) {
	recordTest("retries-timeout")
	s := newRetryServer()
	defer s.Close()
	h := NewCLITestHarness(t)
	// Very short maxElapsedTime with huge num-retries — retries should time out
	err := h.RunWithServer(s.URL, []string{"retries", "retries-get",
		"--request-id", "test-timeout",
		"--num-retries", "1000000000",
		"--retry-config", `{"strategy":"backoff","backoff":{"initialInterval":1,"maxInterval":50,"exponent":1.1,"maxElapsedTime":100}}`,
	})
	assert.Error(t, err)
}

func TestRetriesRequestTimeout(t *testing.T) {
	recordTest("retries-request-timeout")
	// Server delays 2s before responding — the 1ms timeout should fire first
	s := newDelayServer(2 * time.Second)
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"retries", "retries-get",
		"--request-id", "test-request-timeout",
		"--timeout", "1ms",
	})
	assert.Error(t, err)
}

func TestRetriesRetryConnectionErrorsReject(t *testing.T) {
	recordTest("retries-retry-connection-errors-reject")
	// Fault server rejects 1 connection then succeeds.
	// The retriesGetRetryConnectionErrors operation has retryConnectionErrors: true in the spec,
	// so the SDK will automatically retry on connection errors.
	s := newFaultServer(1, "reject")
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"retries", "retries-get-retry-connection-errors",
		"--num-retries", "2",
		"--request-id", "test-reject",
		"--request-id-query-parameter", "test-reject",
		"--fault-settings", `{"reject_count": 1}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"retries"`)
}

func TestRetriesRetryConnectionErrorsReset(t *testing.T) {
	recordTest("retries-retry-connection-errors-reset")
	// Fault server resets 1 connection then succeeds.
	s := newFaultServer(1, "reset")
	defer s.Close()
	h := NewCLITestHarness(t)
	err := h.RunWithServer(s.URL, []string{"retries", "retries-get-retry-connection-errors",
		"--num-retries", "2",
		"--request-id", "test-reset",
		"--request-id-query-parameter", "test-reset",
		"--fault-settings", `{"reset_count": 1}`,
	})
	require.NoError(t, err)
	output := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, output)
	assert.Contains(t, output, `"retries"`)
}
