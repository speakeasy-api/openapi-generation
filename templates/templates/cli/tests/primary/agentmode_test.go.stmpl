// TestAgentModeEnvVarDetection verifies that FORCE_AGENT_MODE=1 triggers
// agent mode automatically and preserves structured JSON error output.
func TestAgentModeEnvVarDetection(t *testing.T) {
	resetAgentMode(t)

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t).WithEnv("FORCE_AGENT_MODE", "1")
	// RunRaw: no --output-format json, no --agent-mode flag.
	// FORCE_AGENT_MODE=1 should auto-detect and still produce JSON error output.
	err := h.RunRaw([]string{"--server-url", s.URL,
		"errors", "status-get-error", "--status-code", "400"})
	assert.Error(t, err)

	stderr := strings.TrimSpace(h.GetStderr())
	require.NotEmpty(t, stderr, "env-var-detected agent mode should output errors as JSON")
	assert.True(t, json.Valid([]byte(stderr)),
		"FORCE_AGENT_MODE=1 should produce valid JSON error output, got: %s", stderr)
}

// TestAgentModeEnvVarFalsey verifies that falsey env var values (e.g., "0")
// do NOT trigger agent mode.
func TestAgentModeEnvVarFalsey(t *testing.T) {
	resetAgentMode(t)

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t).WithEnv("FORCE_AGENT_MODE", "0")
	// RunRaw with FORCE_AGENT_MODE=0: should NOT activate agent mode.
	// In pretty mode, errors don't produce JSON on stderr for connection/token errors.
	err := h.RunRaw([]string{"--server-url", s.URL,
		"errors", "status-get-error", "--status-code", "400"})
	assert.Error(t, err)

	stderr := strings.TrimSpace(h.GetStderr())
	// Pretty mode for connection-type errors may produce no stderr or non-JSON stderr.
	if stderr != "" {
		assert.False(t, json.Valid([]byte(stderr)),
			"FORCE_AGENT_MODE=0 should NOT produce JSON error output, got: %s", stderr)
	}
}

// TestAgentModeFlagOverridesEnv verifies that --agent-mode=false overrides
// env var detection.
func TestAgentModeFlagOverridesEnv(t *testing.T) {
	resetAgentMode(t)

	h := NewCLITestHarness(t).WithEnv("FORCE_AGENT_MODE", "1")
	// Explicit --agent-mode=false should override the env var.
	_ = h.RunBare([]string{"--agent-mode=false", "version"})
	assert.False(t, output.IsAgentMode(), "--agent-mode=false should override FORCE_AGENT_MODE=1")
}
