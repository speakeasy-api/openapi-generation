// TestAgentModeEnvironmentIgnored verifies that explicit-mode CLIs do not infer
// agent mode from any legacy compatibility environment variable.
func TestAgentModeEnvironmentIgnored(t *testing.T) {
	for _, envVar := range []string{
		"CLAUDECODE", "CLAUDE_CODE", "CURSOR_AGENT", "CODEX", "AIDER", "CLINE",
		"WINDSURF_AGENT", "GITHUB_COPILOT", "AMAZON_Q", "GEMINI_CODE_ASSIST",
		"SRC_CODY", "FORCE_AGENT_MODE",
	} {
		t.Run(envVar, func(t *testing.T) {
			resetAgentMode(t)
			h := NewCLITestHarness(t).WithEnv(envVar, "1")
			_ = h.RunBare([]string{"version"})
			assert.False(t, output.IsAgentMode())
		})
	}
}
