// resetAgentMode resets agent mode state so each test re-evaluates detection.
func resetAgentMode(t *testing.T) {
	t.Helper()
	output.ResetAgentMode()
	t.Cleanup(func() { output.ResetAgentMode() })
}

type agentModeTestError struct {
	Body       string
	StatusCode int
}

func (e *agentModeTestError) Error() string { return "test API error" }

// TestAgentModeConfigureUsesFlagOnlyUsageError verifies that agent mode never
// opens a form and renders the ordinary no-flags error as a structured usage
// envelope.
func TestAgentModeConfigureUsesFlagOnlyUsageError(t *testing.T) {
	resetAgentMode(t)

	h := NewCLITestHarness(t)
	err := h.RunBare([]string{"--agent-mode", "configure"})
	assert.Error(t, err)

	stderr := strings.TrimSpace(h.GetStderr())
	require.NotEmpty(t, stderr)

	var envelope map[string]interface{}
	require.NoError(t, json.Unmarshal([]byte(stderr), &envelope),
		"configure error should be valid JSON in agent mode, got: %s", stderr)

	assert.Equal(t, "validation_error", envelope["error_type"])
	assert.Equal(t, "CLI_VALIDATION", envelope["error_reason"])
	assert.Contains(t, envelope["message"], "no flags provided")
	assert.Contains(t, envelope["message"], "--interactive")
	assert.NotContains(t, stderr, "configure_blocked")
}

// TestAgentModeConfigureAllowedWithoutFlag verifies that configure does not
// acquire the agent-mode error envelope when agent mode is inactive.
func TestAgentModeConfigureAllowedWithoutFlag(t *testing.T) {
	resetAgentMode(t)

	h := NewCLITestHarness(t)
	_ = h.RunBare([]string{"configure"})
	stderr := h.GetStderr()
	assert.NotContains(t, stderr, "configure_blocked")
}

// TestAgentModeStructuredJSONErrors verifies that --agent-mode preserves
// structured JSON error output even though success output defaults to TOON.
func TestAgentModeStructuredJSONErrors(t *testing.T) {
	resetAgentMode(t)

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	// RunRaw does NOT inject --output-format json. With --agent-mode, errors
	// should still be output as JSON to stderr.
	err := h.RunRaw([]string{"--agent-mode", "--server-url", s.URL,
		"errors", "status-get-error", "--status-code", "400"})
	// Operation will error (either from echo server or token failure) — that's expected.
	assert.Error(t, err)

	stderr := strings.TrimSpace(h.GetStderr())
	require.NotEmpty(t, stderr, "agent mode should output errors as JSON to stderr")
	assert.True(t, json.Valid([]byte(stderr)),
		"agent mode should produce valid JSON error output, got: %s", stderr)
}

// TestAgentModeDefaultsToToon verifies that agent mode uses TOON as the default
// success output format when no explicit output format is provided.
func TestAgentModeDefaultsToToon(t *testing.T) {
	resetAgentMode(t)

	s := newEchoServer()
	defer s.Close()

	h := NewCLITestHarness(t)
	// Use an operation whose response struct has content fields (not just
	// HTTPMeta) so the TOON formatter has something to render. The echo
	// server returns {"url": "..."} which maps to the response's URL field.
	err := h.RunRaw([]string{"--agent-mode", "--server-url", s.URL,
		"parameters", "duplicate-param", "--duplicate-param-request", "test"})
	require.NoError(t, err)

	stdout := strings.TrimSpace(h.GetStdout())
	require.NotEmpty(t, stdout, "agent mode should produce TOON output on stdout")
	assert.Contains(t, stdout, "url", "expected field name in TOON output")
	assert.Contains(t, stdout, ":", "expected TOON key-value formatting")
	assert.False(t, json.Valid([]byte(stdout)), "agent mode default stdout should not be JSON")
	assert.NotContains(t, stdout, "Response Headers:", "agent mode default stdout should not fall back to pretty output")
}

