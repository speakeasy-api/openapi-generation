// getAPITestServiceURL returns the URL of the API test service that serves
// SSE/JSONL endpoints. The mock server doesn't generate streaming handlers,
// so streaming tests connect directly to the API test service.
func getAPITestServiceURL() string {
	port := os.Getenv("API_TEST_SERVICE_PORT")
	if port == "" {
		port = "35456"
	}
	return "http://localhost:" + port
}

// parseNDJSON parses newline-delimited JSON output into a slice of maps.
func parseNDJSON(t *testing.T, stdout string) []map[string]interface{} {
	t.Helper()
	stdout = strings.TrimSpace(stdout)
	if stdout == "" {
		return nil
	}
	lines := strings.Split(stdout, "\n")
	var results []map[string]interface{}
	for _, line := range lines {
		line = strings.TrimSpace(line)
		if line == "" {
			continue
		}
		var obj map[string]interface{}
		require.NoError(t, json.Unmarshal([]byte(line), &obj), "failed to parse NDJSON line: %s", line)
		results = append(results, obj)
	}
	return results
}

func TestEventStreamJSONData(t *testing.T) {
	recordTest("event-stream-json-data")

	h := NewCLITestHarness(t)
	err := h.RunWithServer(getAPITestServiceURL(), []string{"eventstreams", "json"})
	require.NoError(t, err)

	events := parseNDJSON(t, h.GetStdout())
	assert.Equal(t, 4, len(events), "expected 4 JSON events")

	// Concatenate content from all events
	var msg string
	for _, event := range events {
		data, ok := event["data"].(map[string]interface{})
		require.True(t, ok, "event should have data object")
		msg += data["content"].(string)
	}
	assert.Equal(t, "Hello world!", msg)
}

