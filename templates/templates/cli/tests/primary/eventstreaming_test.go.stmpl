func TestEventStreamErrorResponse(t *testing.T) {
	recordTest("event-stream-error-response")

	// Create a server that returns a 418 teapot error instead of SSE
	teapotServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusTeapot)
		json.NewEncoder(w).Encode(map[string]interface{}{
			"message": "I'm a teapot",
			"code":    418,
		})
	}))
	defer teapotServer.Close()

	h := NewCLITestHarness(t)
	err := h.RunWithServer(teapotServer.URL, []string{"eventstreams", "text"})

	// Should return an error
	assert.Error(t, err)
}

