func TestEventStreamMixedData(t *testing.T) {
	recordTest("event-stream-mixed-data")

	h := NewCLITestHarness(t)
	err := h.RunWithServer(getAPITestServiceURL(), []string{"eventstreams", "mixed-data"})
	require.NoError(t, err)

	events := parseNDJSON(t, h.GetStdout())
	assert.Equal(t, 4, len(events), "expected 4 mixed data events")

	// Events: completion (JSON), text (string), loading (string), completion (JSON)
	assert.Equal(t, "completion", events[0]["event"])
	assert.Equal(t, "text", events[1]["event"])
	assert.Equal(t, "loading", events[2]["event"])
	assert.Equal(t, "completion", events[3]["event"])

	// First event: JSON data with messageEvent content
	data0, ok := events[0]["data"].(map[string]interface{})
	require.True(t, ok, "first event data should be a JSON object")
	assert.Equal(t, "Hello world", data0["content"])

	// Middle events: plain text string data
	assert.Equal(t, "Processing your request...", events[1]["data"])
	assert.Equal(t, "Almost done", events[2]["data"])

	// Last event: JSON data with messageEvent content
	data3, ok := events[3]["data"].(map[string]interface{})
	require.True(t, ok, "last event data should be a JSON object")
	assert.Equal(t, "Done!", data3["content"])
}

// Cross-cutting test: JSON error envelope for broken server
func TestEventStreamErrorJSON(t *testing.T) {
	// Create a server that returns a plain-text error. Non-JSON body forces
	// output.Error() to wrap it in a {"error": "..."} envelope.
	errorServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "text/plain")
		w.WriteHeader(http.StatusTeapot)
		w.Write([]byte("I'm a teapot"))
	}))
	defer errorServer.Close()

	h := NewCLITestHarness(t)
	// RunWithServer adds --output-format json
	err := h.RunWithServer(errorServer.URL, []string{"eventstreams", "text"})
	assert.Error(t, err)

	// Error should be written as JSON envelope to stderr
	stderr := strings.TrimSpace(h.GetStderr())
	require.NotEmpty(t, stderr, "expected JSON error envelope on stderr")
	assert.True(t, json.Valid([]byte(stderr)), "expected valid JSON error output: %s", stderr)

	var envelope map[string]interface{}
	require.NoError(t, json.Unmarshal([]byte(stderr), &envelope))
	_, hasError := envelope["error"]
	assert.True(t, hasError, "expected 'error' field in JSON envelope")
}

