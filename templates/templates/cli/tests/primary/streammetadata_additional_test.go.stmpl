func TestStreamMetadataGeneratedCommands(t *testing.T) {
	for _, command := range [][]string{
		{"generate", "hello"},
		{"stream-reply", "hello"},
		{"stream-reply", "hello", "--agent", "worker"},
		{"stream-metadata", "stream-metadata"},
		{"request-bodies", "cli-interact", "--body", `{"model":"model-a","input":"hello"}`, "--stream=true"},
	} {
		t.Run(strings.Join(command[:1], " "), func(t *testing.T) {
			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				w.Header().Set("Content-Type", "text/event-stream")
				fmt.Fprint(w, "data: {\"resource_id\":\"first\"}\n\ndata: {\"content\":\"Hello\"}\n\ndata: {\"resource_id\":\"last\"}\n\ndata: [DONE]\n\n")
			}))
			defer srv.Close()
			for _, mode := range []struct {
				name       string
				args       []string
				configured string
			}{
				{"default", nil, ""},
				{"configured pretty", nil, "pretty"},
				{"configured json", nil, "json"},
				{"configured toon", nil, "toon"},
				{"json", []string{"--output-format", "json"}, ""},
				{"pretty", []string{"--output-format", "pretty"}, ""},
				{"jq", []string{"--jq", ".", "--stream=true"}, ""},
				{"agent", []string{"--agent-mode"}, ""},
			} {
				t.Run(mode.name, func(t *testing.T) {
					t.Cleanup(config.ResetKeyring)
					h := NewCLITestHarness(t)
					h.resetAndSetupEnv()
					if mode.configured != "" {
						writeConfigFile(t, os.Getenv("HOME"), map[string]interface{}{"output_format": mode.configured})
					}
					root, err := cli.NewRootCommand()
					require.NoError(t, err)
					root.SetOut(h.stdout)
					root.SetErr(h.stderr)
					root.SetIn(strings.NewReader(""))
					args := append([]string{"--server-url", srv.URL, "--color", "never", "--no-interactive", "--no-keyring"}, command...)
					args = append(args, mode.args...)
					require.NoError(t, cli.ExecuteRoot(context.Background(), root, args), h.GetStderr())
					switch mode.name {
					case "default", "configured pretty", "configured json", "configured toon":
						assert.Equal(t, "Hello\n", h.GetStdout())
					case "json", "jq":
						assertMetadataJSONEvents(t, h.GetStdout(),
							`{"data":{"resource_id":"first"}}`,
							`{"data":{"content":"Hello"}}`,
							`{"data":{"resource_id":"last"}}`,
						)
					case "pretty", "agent":
						assert.Equal(t, 3, strings.Count(h.GetStdout(), "data:"))
						assert.Regexp(t, `resource_id:\s+first\b`, h.GetStdout())
						assert.Regexp(t, `content:\s+Hello\b`, h.GetStdout())
						assert.Regexp(t, `resource_id:\s+last\b`, h.GetStdout())
					}
					if mode.name == "default" || mode.name == "configured pretty" {
						assert.Equal(t, "Resource ID: \"last\"\n", h.GetStderr())
					} else {
						assert.Empty(t, h.GetStderr())
					}
				})
			}
		})
	}
}

func TestStreamMetadataReportsIncompleteStream(t *testing.T) {
	for _, tc := range []struct {
		name       string
		body       string
		wantStdout string
		wantStderr string
	}{
		{
			name:       "complete",
			body:       "data: {\"resource_id\":\"r1\",\"event_id\":\"e1\"}\n\ndata: {\"content\":\"Hello\",\"event_id\":\"e2\"}\n\ndata: {\"checkpoint\":{\"state\":\"running\",\"cursor\":\"c1\"},\"event_id\":\"e3\"}\n\ndata: {\"state\":\"done\",\"event_id\":\"e4\"}\n\ndata: [DONE]\n\n",
			wantStdout: "Hello\n",
			wantStderr: "Resource ID: \"r1\"\n",
		},
		{
			name:       "incomplete",
			body:       "data: {\"resource_id\":\"r1\",\"event_id\":\"e1\"}\n\ndata: {\"content\":\"Hel\",\"event_id\":\"e2\"}\n\ndata: {\"checkpoint\":{\"state\":\"running\",\"cursor\":\"c1\"},\"event_id\":\"e3\"}\n\ndata: {\"state\":\"truncated\",\"cursor\":\"c2\",\"event_id\":\"e4\"}\n\ndata: [DONE]\n\n",
			wantStdout: "Hel\n",
			wantStderr: "Resource ID: \"r1\"\nState: \"truncated\"\nCursor: \"c2\"\nLast event ID: \"e4\"\n",
		},
		{
			name:       "checkpoint only",
			body:       "data: {\"resource_id\":\"r1\",\"event_id\":\"e1\"}\n\ndata: {\"checkpoint\":{\"state\":\"running\",\"cursor\":\"c1\"},\"event_id\":\"e2\"}\n\ndata: [DONE]\n\n",
			wantStderr: "No output: 2 streamed events had no text at /data/content; use --output-format json to see the full events.\nResource ID: \"r1\"\nState: \"running\"\nCursor: \"c1\"\nLast event ID: \"e2\"\n",
		},
	} {
		t.Run(tc.name, func(t *testing.T) {
			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				w.Header().Set("Content-Type", "text/event-stream")
				fmt.Fprint(w, tc.body)
			}))
			defer srv.Close()
			t.Cleanup(config.ResetKeyring)
			h := NewCLITestHarness(t)
			h.resetAndSetupEnv()
			root, err := cli.NewRootCommand()
			require.NoError(t, err)
			root.SetOut(h.stdout)
			root.SetErr(h.stderr)
			root.SetIn(strings.NewReader(""))
			require.NoError(t, cli.ExecuteRoot(context.Background(), root, []string{
				"--server-url", srv.URL, "--color", "never", "--no-interactive", "--no-keyring", "--agent-mode=false",
				"stream-metadata", "stream-metadata",
			}), h.GetStderr())
			assert.Equal(t, tc.wantStdout, h.GetStdout())
			assert.Equal(t, tc.wantStderr, h.GetStderr())
		})
	}
}

func assertMetadataJSONEvents(t *testing.T, stdout string, want ...string) {
	t.Helper()
	decoder := json.NewDecoder(strings.NewReader(stdout))
	for _, event := range want {
		var got json.RawMessage
		require.NoError(t, decoder.Decode(&got))
		assert.JSONEq(t, event, string(got))
	}
	var extra json.RawMessage
	require.ErrorIs(t, decoder.Decode(&extra), io.EOF)
}

func TestStreamMetadataGeneratedCommandDecodeFailure(t *testing.T) {
	t.Cleanup(config.ResetKeyring)
	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "text/event-stream")
		fmt.Fprint(w, "data: {\"resource_id\":\"valid\",\"content\":\"Hello\"}\n\ndata: {\"resource_id\":12}\n\ndata: [DONE]\n\n")
	}))
	defer srv.Close()
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	root, err := cli.NewRootCommand()
	require.NoError(t, err)
	root.SetOut(h.stdout)
	root.SetErr(h.stderr)
	root.SetIn(strings.NewReader(""))
	err = cli.ExecuteRoot(context.Background(), root, []string{
		"--server-url", srv.URL, "--color", "never", "--no-interactive", "--no-keyring", "--agent-mode=false",
		"stream-metadata", "stream-metadata",
	})
	var decodeErr *json.UnmarshalTypeError
	require.ErrorAs(t, err, &decodeErr)
	assert.Equal(t, "number", decodeErr.Value)
	assert.Equal(t, "string", decodeErr.Type.String())
	classification, ok := output.ClassificationFrom(err)
	require.True(t, ok)
	assert.Equal(t, output.ErrorTypeProtocol, classification.Type)
	assert.Equal(t, output.ReasonCLIProtocol, classification.Reason)
	assert.Equal(t, "Hello\n", h.GetStdout())
	assert.Contains(t, h.GetStderr(), "CLI_PROTOCOL")
	assert.True(t, strings.HasPrefix(h.GetStderr(), "Resource ID: \"valid\"\n"), "metadata observed before the failure is reported ahead of the error: %q", h.GetStderr())
	assert.Equal(t, 1, strings.Count(h.GetStderr(), "Resource ID:"))
}

type metadataTestStream struct {
	items       []map[string]interface{}
	index       int
	err         error
	cancel      context.CancelFunc
	cancelAtEnd bool
}

func (s *metadataTestStream) Next() bool {
	if s.index == len(s.items) {
		if s.cancelAtEnd && s.cancel != nil {
			s.cancel()
		}
		return false
	}
	s.index++
	if s.cancel != nil && !s.cancelAtEnd {
		s.cancel()
	}
	return true
}
func (s *metadataTestStream) Value() map[string]interface{} { return s.items[s.index-1] }
func (s *metadataTestStream) Err() error                    { return s.err }
func (s *metadataTestStream) Close() error                  { return nil }

type metadataFailWriter struct{ finishOnly bool }

func (w metadataFailWriter) Write(p []byte) (int, error) {
	if !w.finishOnly || string(p) == "\n" {
		return 0, io.ErrShortWrite
	}
	return len(p), nil
}

func metadataTestCommand(t *testing.T, out io.Writer, stderr io.Writer) *cobra.Command {
	t.Helper()
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	cmd := &cobra.Command{Annotations: map[string]string{
		"speakeasy_stream_select":   "/text",
		"speakeasy_stream_metadata": `[{"label":"Resource ID","pointers":["/id"]}]`,
	}}
	cmd.SetContext(context.Background())
	cmd.SetOut(out)
	cmd.SetErr(stderr)
	cmd.Flags().String("output-format", "pretty", "")
	cmd.Flags().String("jq", "", "")
	cmd.Flags().Bool("raw-response", false, "")
	cmd.Flags().String("color", "never", "")
	return cmd
}

func TestStreamMetadataRetention(t *testing.T) {
	for _, tc := range []struct {
		name   string
		values []interface{}
		want   string
	}{
		{"absent", nil, ""},
		{"first", []interface{}{"first"}, "first"},
		{"repeated", []interface{}{"same", "same"}, "same"},
		{"latest", []interface{}{"first", "last"}, "last"},
		{"invalid after valid", []interface{}{"keep", nil, "", 12, map[string]interface{}{"id": "nested"}}, "keep"},
		{"escaping", []interface{}{"line\n\r\x1b[31m\u202e\u2028雪\"\\"}, "line\n\r\x1b[31m\u202e\u2028雪\"\\"},
	} {
		for _, text := range []bool{false, true} {
			t.Run(fmt.Sprintf("%s/text=%t", tc.name, text), func(t *testing.T) {
				var stdout, stderr bytes.Buffer
				cmd := metadataTestCommand(t, &stdout, &stderr)
				stream := &metadataTestStream{}
				for _, v := range tc.values {
					stream.items = append(stream.items, map[string]interface{}{"id": v})
				}
				if text {
					stream.items = append(stream.items, map[string]interface{}{"text": "hello"})
				}
				require.NoError(t, output.StreamResult(cmd, struct{ Stream *metadataTestStream }{stream}, "Stream"))
				if text {
					assert.Equal(t, "hello\n", stdout.String())
				} else {
					assert.Empty(t, stdout.String())
				}
				if tc.want == "" {
					assert.NotContains(t, stderr.String(), "Resource ID:")
				} else {
					assert.Equal(t, 1, strings.Count(stderr.String(), "Resource ID:"))
					assert.Contains(t, stderr.String(), "Resource ID: "+strconv.QuoteToASCII(tc.want)+"\n")
				}
			})
		}
	}
}

type metadataEvent = map[string]interface{}

func metadataEvents(events ...metadataEvent) []metadataEvent { return events }

func TestStreamMetadataStatusBoundaries(t *testing.T) {
	const annotation = `[{"label":"Cursor","pointers":["/cursor","/checkpoint/cursor"],"when":"incomplete"},{"label":"State","pointers":["/state"],"complete":["done","completed"]}]`
	for _, tc := range []struct {
		name   string
		events []metadataEvent
		err    error
		want   string
	}{
		{"first path wins", metadataEvents(metadataEvent{"state": "truncated", "cursor": "current", "checkpoint": metadataEvent{"cursor": "older"}}), nil, "Cursor: \"current\"\nState: \"truncated\"\n"},
		{"empty first path falls back", metadataEvents(metadataEvent{"state": "truncated", "cursor": "", "checkpoint": metadataEvent{"cursor": "older"}}), nil, "Cursor: \"older\"\nState: \"truncated\"\n"},
		{"non-string first path falls back", metadataEvents(metadataEvent{"state": "truncated", "cursor": 7, "checkpoint": metadataEvent{"cursor": "older"}}), nil, "Cursor: \"older\"\nState: \"truncated\"\n"},
		{"value retained", metadataEvents(metadataEvent{"cursor": "c1"}, metadataEvent{"state": "truncated", "cursor": nil}), nil, "Cursor: \"c1\"\nState: \"truncated\"\n"},
		{"no status", metadataEvents(metadataEvent{"cursor": "c1"}), nil, ""},
		{"second complete value", metadataEvents(metadataEvent{"cursor": "c1", "state": "completed"}), nil, ""},
		{"stream failure", metadataEvents(metadataEvent{"cursor": "c1", "state": "truncated"}), errors.New("stream interrupted"), "Cursor: \"c1\"\nState: \"truncated\"\n"},
	} {
		t.Run(tc.name, func(t *testing.T) {
			var stdout, stderr bytes.Buffer
			cmd := metadataTestCommand(t, &stdout, &stderr)
			cmd.Annotations["speakeasy_stream_metadata"] = annotation
			stream := &metadataTestStream{items: append(tc.events, metadataEvent{"text": "hello"}), err: tc.err}
			err := output.StreamResult(cmd, struct{ Stream *metadataTestStream }{stream}, "Stream")
			assert.Equal(t, "hello\n", stdout.String())
			if tc.err != nil {
				require.Error(t, err)
				assert.True(t, strings.HasPrefix(stderr.String(), tc.want), stderr.String())
				return
			}
			require.NoError(t, err)
			assert.Equal(t, tc.want, stderr.String())
		})
	}
}

func TestStreamMetadataOnFailure(t *testing.T) {
	for _, tc := range []struct {
		failure  string
		reported bool
	}{
		{"stream", true},
		{"text type", true},
		{"write", true},
		{"cancel", false},
		{"finish", false},
	} {
		t.Run(tc.failure, func(t *testing.T) {
			var stdout, stderr bytes.Buffer
			cmd := metadataTestCommand(t, &stdout, &stderr)
			stream := &metadataTestStream{items: []map[string]interface{}{map[string]interface{}{"id": "valid", "text": "hello"}}}
			switch tc.failure {
			case "stream":
				stream.err = errors.New("stream interrupted")
			case "cancel":
				ctx, cancel := context.WithCancel(context.Background())
				defer cancel()
				cmd.SetContext(ctx)
				stream.cancel = cancel
			case "text type":
				stream.items[0]["text"] = 17
			case "write":
				cmd.SetOut(metadataFailWriter{})
			case "finish":
				cmd.SetOut(metadataFailWriter{finishOnly: true})
			}
			require.Error(t, output.StreamResult(cmd, struct{ Stream *metadataTestStream }{stream}, "Stream"))
			if tc.reported {
				assert.True(t, strings.HasPrefix(stderr.String(), "Resource ID: \"valid\"\n"), stderr.String())
				assert.Equal(t, 1, strings.Count(stderr.String(), "Resource ID:"))
			} else {
				assert.NotContains(t, stderr.String(), "Resource ID:")
			}
		})
	}
}

func TestStreamMetadataProjectionBypass(t *testing.T) {
	for _, flag := range []string{"output-format", "jq", "raw-response"} {
		t.Run(flag, func(t *testing.T) {
			var stdout, stderr bytes.Buffer
			cmd := metadataTestCommand(t, &stdout, &stderr)
			value := map[string]string{"output-format": "json", "jq": ".", "raw-response": "true"}[flag]
			require.NoError(t, cmd.Flags().Set(flag, value))
			stream := &metadataTestStream{items: []map[string]interface{}{map[string]interface{}{"id": "valid", "text": "hello"}}}
			require.NoError(t, output.StreamResult(cmd, struct{ Stream *metadataTestStream }{stream}, "Stream"))
			if flag == "raw-response" {
				assert.Equal(t, "id:    valid\ntext:  hello\n", stdout.String())
			} else {
				assertMetadataJSONEvents(t, stdout.String(), `{"id":"valid","text":"hello"}`)
			}
			assert.Empty(t, stderr.String())
		})
	}
}

func TestStreamMetadataConfiguredMachineOutput(t *testing.T) {
	var stdout, stderr bytes.Buffer
	cmd := metadataTestCommand(t, &stdout, &stderr)
	t.Setenv("METADATA_TEST_OUTPUT_FORMAT", "json")
	require.NoError(t, config.Init("metadata-test", "METADATA_TEST"))
	stream := &metadataTestStream{items: []map[string]interface{}{map[string]interface{}{"id": "valid", "text": "hello"}}}
	require.NoError(t, output.StreamResult(cmd, struct{ Stream *metadataTestStream }{stream}, "Stream"))
	assertMetadataJSONEvents(t, stdout.String(), `{"id":"valid","text":"hello"}`)
	assert.Empty(t, stderr.String())
}

func TestStreamMetadataLateCancellationPreservesReturn(t *testing.T) {
	for _, mode := range []string{"metadata", "plain projection", "json", "raw"} {
		t.Run(mode, func(t *testing.T) {
			var stdout, stderr bytes.Buffer
			cmd := metadataTestCommand(t, &stdout, &stderr)
			switch mode {
			case "plain projection":
				delete(cmd.Annotations, "speakeasy_stream_metadata")
			case "json":
				require.NoError(t, cmd.Flags().Set("output-format", "json"))
			case "raw":
				require.NoError(t, cmd.Flags().Set("raw-response", "true"))
			}
			ctx, cancel := context.WithCancel(context.Background())
			defer cancel()
			cmd.SetContext(ctx)
			stream := &metadataTestStream{items: []map[string]interface{}{map[string]interface{}{"id": "valid", "text": "hello"}}, cancel: cancel, cancelAtEnd: true}
			require.NoError(t, output.StreamResult(cmd, struct{ Stream *metadataTestStream }{stream}, "Stream"))
			require.ErrorIs(t, ctx.Err(), context.Canceled)
			assert.NotContains(t, stderr.String(), "Resource ID:")
			if mode == "metadata" || mode == "plain projection" {
				assert.Equal(t, "hello\n", stdout.String())
			} else if mode == "raw" {
				assert.Equal(t, "id:    valid\ntext:  hello\n", stdout.String())
			} else {
				assertMetadataJSONEvents(t, stdout.String(), `{"id":"valid","text":"hello"}`)
			}
		})
	}
}
