package tests

import (
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	"{{getGolangPackage}}/internal/clierrors"
)

func TestServerURLRequiresHTTPSchemeAndHost(t *testing.T) {
	for _, tc := range []struct {
		value string
		want  string
	}{
		{value: "localhost:8080", want: "the URL must start with http:// or https://"},
		{value: "example.com", want: "the URL must start with http:// or https://"},
		{value: "ftp://example.com", want: `unsupported scheme "ftp": use http or https`},
		{value: "file:///etc/hosts", want: `unsupported scheme "file": use http or https`},
		{value: "http://", want: "the URL has no host"},
		{value: "https://:8443", want: "the URL has no host"},
	} {
		t.Run(tc.value, func(t *testing.T) {
			h := NewCLITestHarness(t)
			err := h.RunRaw([]string{"--dry-run", "--server-url", tc.value, "methods", "method-get"})
			require.Error(t, err)
			assert.Contains(t, err.Error(), `invalid --server-url "`+tc.value+`": `+tc.want)
			assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
		})
	}

	for _, value := range []string{"http://localhost:8080", "HTTPS://Example.com/v1"} {
		t.Run(value, func(t *testing.T) {
			h := NewCLITestHarness(t)
			require.NoError(t, h.RunRaw([]string{"--dry-run", "--server-url", value, "methods", "method-get"}), h.GetStderr())
		})
	}
}

func TestTimeoutMustBePositive(t *testing.T) {
	for _, value := range []string{"0s", "0", "-5s", "-1ms"} {
		t.Run(value, func(t *testing.T) {
			h := NewCLITestHarness(t)
			err := h.RunRaw([]string{"--dry-run", "--timeout", value, "methods", "method-get"})
			require.Error(t, err)
			assert.Contains(t, err.Error(), `invalid --timeout value "`+value+`": must be greater than zero`)
			assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
		})
	}

	h := NewCLITestHarness(t)
	require.NoError(t, h.RunRaw([]string{"--dry-run", "--timeout", "30s", "methods", "method-get"}), h.GetStderr())
}
