type operationStreamServer struct {
	*httptest.Server
	mu       sync.Mutex
	bodies   [][]byte
	sent     []time.Time
	timedOut bool
}

var operationStreamWireTokens = []string{ {{templateOperationStreamWireTokens}} }

const operationStreamSentinel = {{templateOperationStreamSentinel}}

func operationStreamPayload(chunk string) string {
	var value interface{} = chunk
	for i := len(operationStreamWireTokens) - 1; i >= 0; i-- {
		value = map[string]interface{}{operationStreamWireTokens[i]: value}
	}
	data, _ := json.Marshal(value)
	return string(data)
}

func newOperationStreamServer(t *testing.T, chunks []string, observed <-chan struct{}) *operationStreamServer {
	t.Helper()
	s := &operationStreamServer{}
	s.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		body, err := io.ReadAll(r.Body)
		require.NoError(t, err)
		s.mu.Lock()
		s.bodies = append(s.bodies, body)
		s.mu.Unlock()
		var request map[string]interface{}
	require.NoError(t, json.Unmarshal(body, &request))
		if stream, _ := request[{{templateOperationStreamToggleKey}}].(bool); !stream {
			w.Header().Set("Content-Type", "application/json")
			fmt.Fprint(w, `{"complete":true}`)
			return
		}

		flusher, ok := w.(http.Flusher)
		require.True(t, ok)
		w.Header().Set("Content-Type", "text/event-stream")
		w.WriteHeader(http.StatusOK)
		flusher.Flush()
		for i, chunk := range chunks {
			if i > 0 && observed != nil {
				select {
				case <-observed:
				case <-time.After(intentStreamHandshakeTimeout):
					s.mu.Lock()
					s.timedOut = true
					s.mu.Unlock()
					return
				}
				time.Sleep(intentStreamGap)
			}
			s.mu.Lock()
			s.sent = append(s.sent, time.Now())
			s.mu.Unlock()
			fmt.Fprintf(w, "data: %s\n\n", operationStreamPayload(chunk))
			flusher.Flush()
		}
		if operationStreamSentinel != "" {
			fmt.Fprintf(w, "data: %s\n\n", operationStreamSentinel)
			flusher.Flush()
		}
	}))
	t.Cleanup(s.Close)
	return s
}

func (s *operationStreamServer) lastBody(t *testing.T) map[string]interface{} {
	t.Helper()
	s.mu.Lock()
	defer s.mu.Unlock()
	require.NotEmpty(t, s.bodies)
	var body map[string]interface{}
	require.NoError(t, json.Unmarshal(s.bodies[len(s.bodies)-1], &body))
	return body
}

func runOperationStreamBody(t *testing.T, out io.Writer, serverURL, body string, extra ...string) (string, error) {
	t.Helper()
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	rootCmd, err := cli.NewRootCommand()
	require.NoError(t, err)
	rootCmd.SetOut(out)
	rootCmd.SetErr(h.stderr)
	args := append(baseArgs(), "--server-url", serverURL, "--color", "never")
	args = append(args, {{templateOperationStreamPathArgs}})
	args = append(args, "--{{templateOperationStreamBodyFlag}}", body)
	args = append(args, extra...)
	ctx, cancel := context.WithTimeout(context.Background(), intentStreamTestTimeout)
	defer cancel()
	err = cli.ExecuteRoot(ctx, rootCmd, args)
	return h.GetStderr(), err
}

func runOperationStream(t *testing.T, out io.Writer, serverURL string, extra ...string) (string, error) {
	return runOperationStreamBody(t, out, serverURL, {{templateOperationStreamBodyJSON}}, extra...)
}

func runOperationStreamWithoutBody(t *testing.T, extra ...string) (string, string, error) {
	t.Helper()
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	rootCmd, err := cli.NewRootCommand()
	require.NoError(t, err)
	rootCmd.SetOut(h.stdout)
	rootCmd.SetErr(h.stderr)
	args := append(baseArgs(), {{templateOperationStreamPathArgs}})
	args = append(args, extra...)
	err = cli.ExecuteRoot(context.Background(), rootCmd, args)
	return h.GetStdout(), h.GetStderr(), err
}

{{- if and (isInteractiveModeEnabled) (templateOperationStreamPromptTestEnabled)}}
type operationStreamPrompter struct {
	answers map[string][]string
	fields  []interactive.PromptField
}

func (p *operationStreamPrompter) Prompt(_ *cobra.Command, fields []interactive.PromptField) ([]interactive.PromptAnswer, error) {
	p.fields = append([]interactive.PromptField(nil), fields...)
	answers := make([]interactive.PromptAnswer, len(fields))
	for i, field := range fields {
		if values, ok := p.answers[field.ID]; ok {
			answers[i] = interactive.PromptAnswer{Set: true, Values: values}
		}
	}
	return answers, nil
}

func runPromptedOperationStream(t *testing.T, out io.Writer, serverURL string, p interactive.Prompter) (string, error) {
	t.Helper()
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	rootCmd, err := cli.NewRootCommand()
	require.NoError(t, err)
	rootCmd.SetOut(out)
	rootCmd.SetErr(h.stderr)
	// Prompting is opt-in at runtime (--interactive; interactiveByDefault may be false).
	args := []string{"--interactive", "--server-url", serverURL, "--color", "never"}
	args = append(args, {{templateOperationStreamPathArgs}})
	ctx, cancel := context.WithTimeout(context.Background(), intentStreamTestTimeout)
	defer cancel()
	ctx = interactive.WithPrompter(ctx, p)
	err = cli.ExecuteRoot(ctx, rootCmd, args)
	return h.GetStderr(), err
}
{{- end}}

func TestOperationStream_DefaultProjectsIncrementally(t *testing.T) {
	chunks := []string{"operation ", "streams ", "by default"}
	rec := newRecordingWriter()
	srv := newOperationStreamServer(t, chunks, rec.observed)
	stderr, err := runOperationStream(t, rec, srv.URL)
	require.NoError(t, err, "stderr: %s", stderr)
	assert.Equal(t, true, srv.lastBody(t)[{{templateOperationStreamToggleKey}}], "the SDK schema default must be materialized on the wire")
	assert.Equal(t, strings.Join(chunks, "")+"\n", rec.String())
	writes := rec.snapshot()
	require.GreaterOrEqual(t, len(writes), len(chunks))
	srv.mu.Lock()
	timedOut := srv.timedOut
	sent := append([]time.Time(nil), srv.sent...)
	srv.mu.Unlock()
	require.False(t, timedOut, "operation projection did not deliver incrementally")
	for i := 1; i < len(chunks); i++ {
		assert.GreaterOrEqual(t, writes[i].at.Sub(writes[i-1].at), intentStreamMinGap)
		assert.True(t, writes[i-1].at.Before(sent[i]))
	}
}

func TestOperationStream_DryRunSuppressesSyntheticStreamInPretty(t *testing.T) {
	srv := newOperationStreamServer(t, nil, nil)
	var out bytes.Buffer
	stderr, err := runOperationStream(t, &out, srv.URL, "--dry-run")
	require.NoError(t, err, "stderr: %s", stderr)
	assert.Empty(t, out.String())
}

func TestOperationStream_DryRunJSONPrintsPreview(t *testing.T) {
	srv := newOperationStreamServer(t, nil, nil)
	var out bytes.Buffer
	stderr, err := runOperationStream(t, &out, srv.URL, "--dry-run", "--output-format", "json")
	require.NoError(t, err, "stderr: %s", stderr)
	// An explicit JSON dry-run selects the machine preview protocol: one
	// {"dry_run":true,"request":{...}} object on stdout, never a stream.
	var preview struct {
		DryRun  bool `json:"dry_run"`
		Request struct {
			Method string `json:"method"`
		} `json:"request"`
	}
	require.NoError(t, json.Unmarshal([]byte(strings.TrimSpace(out.String())), &preview), "stdout: %s", out.String())
	assert.True(t, preview.DryRun)
	assert.Equal(t, "POST", preview.Request.Method)
}

{{- if and (isInteractiveModeEnabled) (templateOperationStreamPromptTestEnabled)}}
func TestOperationStream_PromptedBodyAndDeclaredFlagProjectIncrementally(t *testing.T) {
	chunks := []string{"prompted ", "operation ", "streams"}
	rec := newRecordingWriter()
	srv := newOperationStreamServer(t, chunks, rec.observed)
	var promptedBody map[string]interface{}
	require.NoError(t, json.Unmarshal([]byte({{templateOperationStreamBodyJSON}}), &promptedBody))
	assert.NotContains(t, promptedBody, {{templateOperationStreamToggleKey}}, "the prompted whole body must leave the stream toggle to the declared flag")
	p := &operationStreamPrompter{answers: map[string][]string{
		"flag:{{templateOperationStreamBodyFlag}}": { {{templateOperationStreamBodyJSON}} },
		"flag:{{templateOperationStreamToggleFlag}}": {"true"},
	}}
	stderr, err := runPromptedOperationStream(t, rec, srv.URL, p)
	require.NoError(t, err, "the prompted operation flag must merge into the prompted whole body: %s", stderr)
	assert.Equal(t, true, srv.lastBody(t)[{{templateOperationStreamToggleKey}}])
	assert.Equal(t, strings.Join(chunks, "")+"\n", rec.String())
	writes := rec.snapshot()
	require.GreaterOrEqual(t, len(writes), len(chunks))
	srv.mu.Lock()
	timedOut := srv.timedOut
	sent := append([]time.Time(nil), srv.sent...)
	srv.mu.Unlock()
	require.False(t, timedOut, "prompted operation projection did not deliver incrementally")
	for i := 1; i < len(chunks); i++ {
		assert.GreaterOrEqual(t, writes[i].at.Sub(writes[i-1].at), intentStreamMinGap)
		assert.True(t, writes[i-1].at.Before(sent[i]))
	}

	foundBody, foundStream := false, false
	for _, field := range p.fields {
		foundBody = foundBody || field.ID == "flag:{{templateOperationStreamBodyFlag}}"
		if field.ID == "flag:{{templateOperationStreamToggleFlag}}" {
			foundStream = true
			assert.False(t, field.Direct, "the op-declared flag remains behind the optional-fields gate")
		}
	}
	assert.True(t, foundBody, "the required whole-body flag must be promptable")
	assert.True(t, foundStream, "the op-declared optional stream flag must reach the semantic prompt plan")
}
{{- end}}

func TestOperationStream_ExplicitJSONKeepsNDJSON(t *testing.T) {
	chunks := []string{"one", "two"}
	srv := newOperationStreamServer(t, chunks, nil)
	var out bytes.Buffer
	stderr, err := runOperationStream(t, &out, srv.URL, "--output-format", "json")
	require.NoError(t, err, "stderr: %s", stderr)
	lines := strings.Split(strings.TrimSpace(out.String()), "\n")
	require.Len(t, lines, len(chunks))
	for _, line := range lines {
		var event map[string]interface{}
		require.NoError(t, json.Unmarshal([]byte(line), &event), "NDJSON line: %s", line)
	}
}

func TestOperationStream_FalseFallsBackToNormalJSONResult(t *testing.T) {
	srv := newOperationStreamServer(t, []string{"must not stream"}, nil)
	var out bytes.Buffer
	stderr, err := runOperationStream(t, &out, srv.URL, "--{{templateOperationStreamToggleFlag}}=false", "--output-format", "json")
	require.NoError(t, err, "stderr: %s", stderr)
	assert.Equal(t, false, srv.lastBody(t)[{{templateOperationStreamToggleKey}}])
	var result map[string]interface{}
	require.NoError(t, json.Unmarshal(bytes.TrimSpace(out.Bytes()), &result), "normal JSON output: %s", out.String())
	assert.NotNil(t, result)
	assert.NotContains(t, out.String(), "must not stream")
}

func TestOperationStream_BodyFalseFallsBackToNormalJSONResult(t *testing.T) {
	var request map[string]interface{}
	require.NoError(t, json.Unmarshal([]byte({{templateOperationStreamBodyJSON}}), &request))
	request[{{templateOperationStreamToggleKey}}] = false
	body, err := json.Marshal(request)
	require.NoError(t, err)
	srv := newOperationStreamServer(t, nil, nil)
	var out bytes.Buffer
	stderr, err := runOperationStreamBody(t, &out, srv.URL, string(body), "--output-format", "json")
	require.NoError(t, err, "stderr: %s", stderr)
	assert.Equal(t, false, srv.lastBody(t)[{{templateOperationStreamToggleKey}}])
	var result map[string]interface{}
	require.NoError(t, json.Unmarshal(bytes.TrimSpace(out.Bytes()), &result))
}

func TestOperationStream_DeclaredFlagAndBodyKeepDuplicateSourceRule(t *testing.T) {
	var request map[string]interface{}
	require.NoError(t, json.Unmarshal([]byte({{templateOperationStreamBodyJSON}}), &request))
	request[{{templateOperationStreamToggleKey}}] = true
	body, err := json.Marshal(request)
	require.NoError(t, err)
	srv := newOperationStreamServer(t, nil, nil)
	var out bytes.Buffer
	_, err = runOperationStreamBody(t, &out, srv.URL, string(body), "--{{templateOperationStreamToggleFlag}}=false")
	require.Error(t, err)
	// The runtime formats the duplicate-source key with %q; build the expected
	// text the same way so keys with Go-string special characters still match.
	assert.Contains(t, err.Error(), fmt.Sprintf("key %q is set both by --%s", {{templateOperationStreamToggleKey}}, {{goStringLiteral (templateOperationStreamToggleFlag)}}))
}

func TestOperationStream_DeclaredFlagMergesIntoBodyFile(t *testing.T) {
	bodyPath := filepath.Join(t.TempDir(), "request.json")
	require.NoError(t, os.WriteFile(bodyPath, []byte({{templateOperationStreamBodyJSON}}), 0o600))
	srv := newOperationStreamServer(t, nil, nil)
	var out bytes.Buffer
	stderr, err := runOperationStreamBody(t, &out, srv.URL, "@"+bodyPath, "--{{templateOperationStreamToggleFlag}}=false", "--output-format", "json")
	require.NoError(t, err, "stderr: %s", stderr)
	assert.Equal(t, false, srv.lastBody(t)[{{templateOperationStreamToggleKey}}])
}

func TestOperationStream_RequiredBodyIsNotSynthesizedFromDeclaredFlag(t *testing.T) {
	_, _, err := runOperationStreamWithoutBody(t, "--{{templateOperationStreamToggleFlag}}=false")
	require.Error(t, err)
	assert.Contains(t, err.Error(), "missing required flag")
	assert.Contains(t, err.Error(), "{{templateOperationStreamBodyFlag}}")
}

func TestOperationStream_UsageAndHelpDescribeProjection(t *testing.T) {
	stdout, _, err := runOperationStreamWithoutBody(t, "--usage")
	require.NoError(t, err)
	assert.Contains(t, stdout, `flag "--{{templateOperationStreamToggleFlag}}"`)
	assert.Contains(t, stdout, {{templateOperationStreamToggleSummary}})

	stdout, _, err = runOperationStreamWithoutBody(t, "--help")
	require.NoError(t, err)
	assert.Contains(t, stdout, "write the string selected by")
	assert.Contains(t, stdout, "--{{templateOperationStreamToggleFlag}}=false")
	assert.Contains(t, stdout, "-o json")
}
