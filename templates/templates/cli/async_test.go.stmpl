func TestAsyncResume_DoesNotReadOpenStdin(t *testing.T) {
	stub := newAsyncStub(t, asyncCreateTestBody, asyncSuccessTestBody)
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	root, err := cli.NewRootCommand()
	require.NoError(t, err)
	root.SetOut(h.stdout)
	root.SetErr(h.stderr)
	read, write, err := os.Pipe()
	require.NoError(t, err)
	defer read.Close()
	defer write.Close()
	original := os.Stdin
	os.Stdin = read
	defer func() { os.Stdin = original }()
	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
	defer cancel()
	stopWatchdog := make(chan struct{})
	defer close(stopWatchdog)
	go func() {
		select { case <-ctx.Done(): _ = write.Close(); case <-stopWatchdog: }
	}()
	err = cli.ExecuteRoot(ctx, root, []string{ {{templateAsyncTestPathArgs}}, "--resume", asyncTestHandle, "--dry-run", "--output-format", "json", "--server-url", stub.server.URL})
	require.NoError(t, err)
	require.NoError(t, ctx.Err())
	creates, polls, _ := stub.counts()
	assert.Zero(t, creates)
	assert.Zero(t, polls)
}

func TestAsyncResume_HelpAndUsageDescribeAlternateInput(t *testing.T) {
	for _, flag := range []string{"--help", "--usage"} {
		h := NewCLITestHarness(t)
		require.NoError(t, h.RunWithStdinServerRaw("http://localhost:1", []string{ {{templateAsyncTestPathArgs}}, flag }, ""))
		assert.Contains(t, h.GetStdout(), "resume")
		assert.Contains(t, strings.ToLower(h.GetStdout()), "creat")
