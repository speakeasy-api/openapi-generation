{{- if $a.AsyncFailureTestJSON}}
func TestAsyncIntent_FailureUsesSharedMachineErrorEnvelope(t *testing.T) {
	for _, args := range [][]string{
		{"--agent-mode", "--output-format", "json"},
		{"--output-format", "json"},
	} {
		stub := newAsyncStub(t, asyncCreateTestBody, {{goStringLiteral $a.AsyncFailureTestJSON}})
		h := NewCLITestHarness(t)
		err := runAsyncIntent(t, h, stub.server.URL, args...)
		require.Error(t, err)
		assert.Empty(t, h.GetStdout())
		assert.Equal(t, asyncTestHandle, jsonGetString(h.GetStderr(), "id"))
		assert.Contains(t, jsonGetString(h.GetStderr(), "resume"), {{goStringLiteral $a.AsyncResume}}+" "+asyncTestHandle)
		if args[0] == "--agent-mode" {
			assert.Equal(t, "CLI_ASYNC_FAILED", jsonGetString(h.GetStderr(), "error_reason"))
			{{- if $a.AsyncFailureHint}}
			assert.Contains(t, h.GetStderr(), {{goStringLiteral $a.AsyncFailureHint}})
			{{- end}}
		}
	}

	stub := newAsyncStub(t, asyncCreateTestBody, {{goStringLiteral $a.AsyncFailureTestJSON}})
	h := NewCLITestHarness(t)
	err := runAsyncIntent(t, h, stub.server.URL)
	require.Error(t, err)
	diagnostic := strings.TrimSpace(h.GetStderr())
	assert.Contains(t, diagnostic, asyncTestHandle)
	assert.Contains(t, diagnostic, {{goStringLiteral $a.AsyncResume}}+" "+asyncTestHandle)
	assert.Zero(t, strings.Count(diagnostic, string(rune(10))))
}
{{- end}}

func TestAsyncIntent_UnknownAndMissingStatesAreErrors(t *testing.T) {
	for name, test := range map[string]struct{ body, reason string }{
		"unknown": {asyncUnknownTestBody, "CLI_ASYNC_UNKNOWN_STATE"},
		"missing": {asyncMissingStateBody, "CLI_PROTOCOL"},
	} {
		t.Run(name, func(t *testing.T) {
			stub := newAsyncStub(t, asyncCreateTestBody, test.body)
			h := NewCLITestHarness(t)
			err := runAsyncIntent(t, h, stub.server.URL, "--agent-mode", "--output-format", "json")
			require.Error(t, err)
			assert.Empty(t, h.GetStdout())
			assert.Equal(t, test.reason, jsonGetString(h.GetStderr(), "error_reason"))
			assert.Equal(t, asyncTestHandle, jsonGetString(h.GetStderr(), "id"))
			assert.Contains(t, jsonGetString(h.GetStderr(), "resume"), {{goStringLiteral $a.AsyncResume}}+" "+asyncTestHandle)
		})
	}
}

func TestAsyncIntent_MissingHandleAndCreateStreamAreProtocolErrors(t *testing.T) {
	for name, configure := range map[string]func(*asyncStub){
		"missing handle": func(stub *asyncStub) { stub.createBody = asyncMissingIDBody },
		"create stream": func(stub *asyncStub) { stub.createType = "text/event-stream" },
	} {
		t.Run(name, func(t *testing.T) {
			stub := newAsyncStub(t, asyncCreateTestBody, asyncSuccessTestBody)
			configure(stub)
			h := NewCLITestHarness(t)
			err := runAsyncIntent(t, h, stub.server.URL, "--agent-mode", "--output-format", "json")
			require.Error(t, err)
			assert.Empty(t, h.GetStdout())
			assert.Equal(t, "CLI_PROTOCOL", jsonGetString(h.GetStderr(), "error_reason"))
			assert.Equal(t, "<missing>", jsonGetString(h.GetStderr(), "id"))
		})
	}
}

{{- if $a.AsyncPendingTestJSON}}
func TestAsyncIntent_TimeoutAndCancelStopPendingPolls(t *testing.T) {
	pending := {{goStringLiteral $a.AsyncPendingTestJSON}}
	stub := newAsyncStub(t, asyncCreateTestBody, pending)
	h := NewCLITestHarness(t)
	started := time.Now()
	err := runAsyncIntent(t, h, stub.server.URL, "--agent-mode", "--output-format", "json", "--poll-timeout", "150ms")
	require.Error(t, err)
	assert.Less(t, time.Since(started), 20*time.Second)
	assert.Equal(t, "CLI_ASYNC_TIMEOUT", jsonGetString(h.GetStderr(), "error_reason"))

	stub = newAsyncStub(t, asyncCreateTestBody, pending)
	h = NewCLITestHarness(t)
	h.resetAndSetupEnv()
	root, err := cli.NewRootCommand()
	require.NoError(t, err)
	root.SetOut(h.stdout)
	root.SetErr(h.stderr)
	args := append(baseArgs(), "--server-url", stub.server.URL, "--agent-mode", "--output-format", "json", "--color", "never", {{templateAsyncTestArgs}}, "--poll-interval", "20ms", "--poll-timeout", "5s")
	ctx, cancel := context.WithCancel(context.Background())
	time.AfterFunc(60*time.Millisecond, cancel)
	err = cli.ExecuteRoot(ctx, root, args)
	require.Error(t, err)
	assert.NotContains(t, h.GetStderr(), "CLI_ASYNC_TIMEOUT")
	assert.Contains(t, h.GetStderr(), "canceled")
}
{{- end}}

func TestAsyncIntent_DryRunDoesNotCallOrRender(t *testing.T) {
	for _, extra := range [][]string{
		{"--dry-run", "--output-format", "json"},
		{"--async", "--dry-run", "--output-format", "json"},
	} {
		stub := newAsyncStub(t, asyncCreateTestBody, asyncSuccessTestBody)
		h := NewCLITestHarness(t)
		require.NoError(t, runAsyncIntent(t, h, stub.server.URL, extra...))
		// An explicit JSON dry-run prints the create-request preview object and
		// nothing else: no create call, no polling, no synthetic handle.
		var preview struct {
			DryRun  bool `json:"dry_run"`
			Request struct {
				Method string `json:"method"`
			} `json:"request"`
		}
		require.NoError(t, json.Unmarshal([]byte(strings.TrimSpace(h.GetStdout())), &preview), "stdout: %s", h.GetStdout())
		assert.True(t, preview.DryRun)
		assert.Equal(t, "POST", preview.Request.Method)
		assert.Equal(t, 1, strings.Count(strings.TrimSpace(h.GetStdout()), "\n")+1, "exactly one preview line")
		createCalls, pollCalls, _ := stub.counts()
		assert.Zero(t, createCalls)
		assert.Zero(t, pollCalls)
	}
}

