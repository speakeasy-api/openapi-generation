{{- $a := templateAsyncTestCommand -}}
{{- if $a}}
package tests

import (
	{{- if $a.AsyncPendingTestJSON}}
	"context"
	{{- end}}
	"encoding/json"
	"net/http"
	"net/http/httptest"
	{{- if $a.ArtifactJSON}}
	"os"
	"path/filepath"
	{{- end}}
	"strings"
	"sync"
	"testing"
	"time"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	{{- if $a.AsyncPendingTestJSON}}
	"{{getGolangPackage}}/internal/cli"
	{{- end}}
	"{{getGolangPackage}}/internal/flagutil"
	"{{getGolangPackage}}/internal/sdk/types"
)

const (
	asyncTestHandle       = "async-test-handle"
	asyncCreateTestBody   = {{goStringLiteral $a.AsyncCreateTestJSON}}
	asyncSuccessTestBody  = {{goStringLiteral $a.AsyncSuccessTestJSON}}
	asyncUnknownTestBody  = {{goStringLiteral $a.AsyncUnknownTestJSON}}
	asyncMissingStateBody = {{goStringLiteral $a.AsyncMissingStateTestJSON}}
	asyncMissingIDBody    = {{goStringLiteral $a.AsyncMissingHandleTestJSON}}
)

type asyncStub struct {
	server       *httptest.Server
	mu           sync.Mutex
	createBody   string
	createType   string
	pollBodies   []string
	createStatus int
	pollStatus   int
	createCalls  int
	pollCalls    int
	firstPoll    time.Time
}

func newAsyncStubWithStatus(t *testing.T, createStatus, pollStatus int, createBody string, pollBodies ...string) *asyncStub {
	t.Helper()
	stub := &asyncStub{
		createBody: createBody, createType: "application/json", pollBodies: pollBodies,
		createStatus: createStatus, pollStatus: pollStatus,
	}
	stub.server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		stub.mu.Lock()
		defer stub.mu.Unlock()
		body := stub.createBody
		contentType := stub.createType
		status := stub.createStatus
		if r.Method == http.MethodGet {
			stub.pollCalls++
			status = stub.pollStatus
			{{- if eq $a.AsyncParameterIn "query"}}
			assert.Equal(t, asyncTestHandle, r.URL.Query().Get({{goStringLiteral $a.AsyncParameterName}}))
			{{- else}}
			assert.Contains(t, r.URL.EscapedPath(), asyncTestHandle)
			{{- end}}
			if stub.firstPoll.IsZero() {
				stub.firstPoll = time.Now()
			}
			{{- range $a.AsyncParams}}
			{{- if eq .In "query"}}
			assert.Equal(t, {{goStringLiteral .Expected}}, r.URL.Query().Get({{goStringLiteral .Name}}))
			{{- else if eq .In "header"}}
			assert.Equal(t, {{goStringLiteral .Expected}}, r.Header.Get({{goStringLiteral .Name}}))
			{{- end}}
			{{- end}}
			if len(stub.pollBodies) > 0 {
				index := stub.pollCalls - 1
				if index >= len(stub.pollBodies) {
					index = len(stub.pollBodies) - 1
				}
				body = stub.pollBodies[index]
			}
		} else {
			stub.createCalls++
		}
		w.Header().Set("Content-Type", contentType)
		w.WriteHeader(status)
		_, _ = w.Write([]byte(body))
	}))
	t.Cleanup(stub.server.Close)
	return stub
}

func newAsyncStub(t *testing.T, createBody string, pollBodies ...string) *asyncStub {
	t.Helper()
	return newAsyncStubWithStatus(t, {{$a.AsyncCreateResponseCode}}, {{$a.AsyncResponseCode}}, createBody, pollBodies...)
}

func (s *asyncStub) counts() (int, int, time.Time) {
	s.mu.Lock()
	defer s.mu.Unlock()
	return s.createCalls, s.pollCalls, s.firstPoll
}

func runAsyncIntent(t *testing.T, h *CLITestHarness, serverURL string, extra ...string) error {
	t.Helper()
	args := []string{ {{templateAsyncTestArgs}} }
	args = append(args, "--poll-interval", "20ms", "--poll-timeout", "5s")
	args = append(args, extra...)
	return h.RunWithStdinServerRaw(serverURL, args, "")
}

{{- if $a.ArtifactJSON}}
func withAsyncWorkingDir(t *testing.T) string {
	t.Helper()
	dir := t.TempDir()
	original, err := os.Getwd()
	require.NoError(t, err)
	require.NoError(t, os.Chdir(dir))
	t.Cleanup(func() { _ = os.Chdir(original) })
	return dir
}
{{- end}}

func TestAsyncIntent_SuccessRendersTerminalResponse(t *testing.T) {
	stub := newAsyncStub(t, asyncCreateTestBody{{if $a.AsyncPendingTestJSON}}, {{goStringLiteral $a.AsyncPendingTestJSON}}{{end}}, asyncSuccessTestBody)
	{{- if $a.ArtifactJSON}}
	dir := withAsyncWorkingDir(t)
	{{- end}}
	h := NewCLITestHarness(t)
	started := time.Now()

	require.NoError(t, runAsyncIntent(t, h, stub.server.URL))
	{{- if $a.ArtifactJSON}}
	path := strings.TrimSpace(h.GetStdout())
	require.True(t, filepath.IsAbs(path))
	info, err := os.Stat(path)
	require.NoError(t, err)
	assert.Greater(t, info.Size(), int64(0))
	resolvedDir, err := filepath.EvalSymlinks(dir)
	require.NoError(t, err)
	resolvedPathDir, err := filepath.EvalSymlinks(filepath.Dir(path))
	require.NoError(t, err)
	assert.Equal(t, resolvedDir, resolvedPathDir)
	{{- else}}
	assert.JSONEq(t, asyncSuccessTestBody, h.GetStdout())
	{{- end}}
	createCalls, pollCalls, firstPoll := stub.counts()
	assert.Equal(t, 1, createCalls)
	assert.Equal(t, {{if $a.AsyncPendingTestJSON}}2{{else}}1{{end}}, pollCalls)
	assert.GreaterOrEqual(t, firstPoll.Sub(started), 10*time.Millisecond)
	{{- if $a.AsyncPendingTestJSON}}
	assert.Equal(t, 1, strings.Count(h.GetStderr(), "Waiting for {{$a.CommandDisplay}}"))
	{{- end}}
}

{{- if $a.ArtifactJSON}}
func TestAsyncIntent_JSONSuccessWritesArtifactEnvelopeSilently(t *testing.T) {
	stub := newAsyncStub(t, asyncCreateTestBody, asyncSuccessTestBody)
	withAsyncWorkingDir(t)
	h := NewCLITestHarness(t)

	require.NoError(t, runAsyncIntent(t, h, stub.server.URL, "--output-format", "json"))
	path := jsonGetString(h.GetStdout(), "path")
	require.NotEmpty(t, path)
	info, err := os.Stat(path)
	require.NoError(t, err)
	assert.Greater(t, info.Size(), int64(0))
	assert.Empty(t, h.GetStderr())
}
{{- else}}
func TestAsyncIntent_JSONSuccessRendersTerminalPayloadSilently(t *testing.T) {
	stub := newAsyncStub(t, asyncCreateTestBody, asyncSuccessTestBody)
	h := NewCLITestHarness(t)

	require.NoError(t, runAsyncIntent(t, h, stub.server.URL, "--output-format", "json"))
	assert.JSONEq(t, asyncSuccessTestBody, h.GetStdout())
	assert.Empty(t, h.GetStderr())
}
{{- end}}

func TestAsyncIntent_EscapeReturnsCreateResponseWithoutPolling(t *testing.T) {
	stub := newAsyncStub(t, asyncCreateTestBody, asyncSuccessTestBody)
	h := NewCLITestHarness(t)
	require.NoError(t, runAsyncIntent(t, h, stub.server.URL, "--async"))
	assert.Equal(t, asyncTestHandle, strings.TrimSpace(h.GetStdout()))
	assert.Empty(t, h.GetStderr())
	_, polls, _ := stub.counts()
	assert.Zero(t, polls)

	h = NewCLITestHarness(t)
	require.NoError(t, runAsyncIntent(t, h, stub.server.URL, "--async", "--output-format", "json"))
	assert.JSONEq(t, asyncCreateTestBody, h.GetStdout())
	assert.Empty(t, h.GetStderr())

	for name, args := range map[string][]string{
		"yaml": {"--async", "--output-format", "yaml"},
		"toon": {"--async", "--output-format", "toon"},
		"jq": {"--async", "--jq", "."},
		"agent": {"--agent-mode", "--async"},
	} {
		t.Run(name, func(t *testing.T) {
			h := NewCLITestHarness(t)
			require.NoError(t, runAsyncIntent(t, h, stub.server.URL, args...))
			assert.Contains(t, h.GetStdout(), asyncTestHandle)
			assert.Empty(t, h.GetStderr())
		})
	}
}

{{- if $a.AsyncHandoffTestJSON}}
func TestAsyncIntent_HandoffReturnsPayloadWithoutArtifact(t *testing.T) {
	stub := newAsyncStub(t, asyncCreateTestBody, {{goStringLiteral $a.AsyncHandoffTestJSON}})
	{{- if $a.ArtifactJSON}}
	withAsyncWorkingDir(t)
	{{- end}}
	h := NewCLITestHarness(t)

	require.NoError(t, runAsyncIntent(t, h, stub.server.URL, "--output-format", "json"))
	assert.JSONEq(t, {{goStringLiteral $a.AsyncHandoffTestJSON}}, h.GetStdout())
	assert.NotContains(t, h.GetStdout(), `"path"`)
}
