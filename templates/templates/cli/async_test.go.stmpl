func TestAsyncIntent_DeclaredJQAppliesOnlyToTerminalResponse(t *testing.T) {
	stub := newAsyncStubWithStatus(t, {{$j.AsyncCreateResponseCode}}, {{$j.AsyncResponseCode}}, {{goStringLiteral $j.AsyncCreateTestJSON}}, {{goStringLiteral $j.AsyncSuccessTestJSON}})
	h := NewCLITestHarness(t)
	commandArgs := []string{ {{templateIntentAsyncTestArgs $j}} }
	commandArgs = append(commandArgs, "--poll-interval", "20ms", "--poll-timeout", "5s", "--async")
	require.NoError(t, h.RunWithStdinServerRaw(stub.server.URL, commandArgs, ""))
	assert.Equal(t, asyncTestHandle, strings.TrimSpace(h.GetStdout()))
	_, polls, _ := stub.counts()
	assert.Zero(t, polls)

	stub = newAsyncStubWithStatus(t, {{$j.AsyncCreateResponseCode}}, {{$j.AsyncResponseCode}}, {{goStringLiteral $j.AsyncCreateTestJSON}}, {{goStringLiteral $j.AsyncSuccessTestJSON}})
	h = NewCLITestHarness(t)
	commandArgs = commandArgs[:len(commandArgs)-1]
	commandArgs = append(commandArgs, "--jq", ".")
	require.NoError(t, h.RunWithStdinServerRaw(stub.server.URL, commandArgs, ""))
	assert.JSONEq(t, {{goStringLiteral $j.AsyncSuccessTestJSON}}, h.GetStdout())
}
{{- end}}

func runAsyncResume(t *testing.T, h *CLITestHarness, serverURL string, extra ...string) error {
	t.Helper()
	args := []string{ {{templateAsyncTestPathArgs}}, "--resume", asyncTestHandle, "--poll-interval", "20ms", "--poll-timeout", "5s" }
	return h.RunWithStdinServerRaw(serverURL, append(args, extra...), "")
}

func TestAsyncResume_SavesTerminalResultWithoutCreate(t *testing.T) {
	stub := newAsyncStub(t, asyncCreateTestBody{{if $a.AsyncPendingTestJSON}}, {{goStringLiteral $a.AsyncPendingTestJSON}}{{end}}, asyncSuccessTestBody)
	h := NewCLITestHarness(t)
	{{- if $a.ArtifactJSON}}
	target := filepath.Join(t.TempDir(), "resumed{{templateArtifactTestExt}}")
	require.NoError(t, runAsyncResume(t, h, stub.server.URL, "--out", target))
	data, err := os.ReadFile(strings.TrimSpace(h.GetStdout()))
	require.NoError(t, err)
	assert.Equal(t, "async-artifact", string(data))
	{{- else}}
	require.NoError(t, runAsyncResume(t, h, stub.server.URL, "--output-format", "json"))
	assert.JSONEq(t, asyncSuccessTestBody, h.GetStdout())
	{{- end}}
	creates, polls, _ := stub.counts()
	assert.Zero(t, creates)
	assert.GreaterOrEqual(t, polls, 1)
}

func TestAsyncResume_RejectsConflictsBeforeRequests(t *testing.T) {
	cases := [][]string{
		{"--resume="}, {"--resume", "  "}, {"unexpected prompt"}, {"--async"},
		{"--poll-interval", "0s"}, {"--poll-timeout", "1ms"},
		{{- if $a.BodyFlag}}
		{"--{{$a.BodyFlag}}", "@/nonexistent-resume-input.json"}, {"--{{$a.BodyFlag}}", "@-"},
		{{- end}}
		{{- range $a.Flags}}
		{"--{{.Name}}={{if eq .Type "bool"}}true{{else if or (eq .Type "int") (eq .Type "float")}}1{{else}}conflicting{{end}}"},
		{{- end}}
		{{- if $a.ArtifactJSON}}
		{"--out", "unused", "--raw-response"},
		{{- end}}
	}
	for _, extra := range cases {
		t.Run(strings.Join(extra, " "), func(t *testing.T) {
			stub := newAsyncStub(t, asyncCreateTestBody, asyncSuccessTestBody)
			h := NewCLITestHarness(t)
			err := runAsyncResume(t, h, stub.server.URL, extra...)
			require.Error(t, err)
			assert.NotContains(t, err.Error(), "no such file")
			creates, polls, _ := stub.counts()
			assert.Zero(t, creates)
			assert.Zero(t, polls)
		})
	}
}

