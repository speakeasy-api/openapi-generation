func TestExploreGuardsBeforeBubbleTea(t *testing.T) {
	for name, args := range map[string][]string{
		"no-interactive":    {"--no-interactive", "explore"},
		"interactive-false": {"--interactive=false", "explore"},
	} {
		t.Run(name, func(t *testing.T) {
			h := NewCLITestHarness(t)
			err := h.RunPolicyDefault(args)
			require.EqualError(t, err, "explore conflicts with --no-interactive/--interactive=false")
		})
	}

	t.Run("non-terminal", func(t *testing.T) {
		h := NewCLITestHarness(t)
		err := h.RunPolicyDefault([]string{"explore"})
		require.EqualError(t, err, "explore requires an interactive terminal (stdin and stdout must be a TTY)")
	})

	t.Run("usage", func(t *testing.T) {
		h := NewCLITestHarness(t)
		require.NoError(t, h.RunPolicyDefault([]string{"explore", "--usage"}))
		assert.Contains(t, h.GetStdout(), `cmd "explore"`)
	})
}
{{- end}}

{{- if not (agentEnvironmentDetection)}}

// TestAgentEnvironmentVariablesDoNotEnableAgentMode verifies that explicit-only
// builds never infer caller identity from the built-in compatibility allowlist.
func TestAgentEnvironmentVariablesDoNotEnableAgentMode(t *testing.T) {
	for _, envVar := range []string{
		"CLAUDECODE", "CLAUDE_CODE", "CURSOR_AGENT", "CODEX", "AIDER", "CLINE",
		"WINDSURF_AGENT", "GITHUB_COPILOT", "AMAZON_Q", "GEMINI_CODE_ASSIST",
		"SRC_CODY", "FORCE_AGENT_MODE",
	} {
		t.Run(envVar, func(t *testing.T) {
			h := NewCLITestHarness(t).WithEnv(envVar, "1")
			h.resetAndSetupEnv()
			root, err := cli.NewRootCommand()
			assert.NoError(t, err)
			root.SetOut(h.stdout)
			root.SetErr(h.stderr)

			err = cli.ExecuteRoot(context.Background(), root, []string{"no-such-command"})
			assert.Error(t, err)
			assert.False(t, output.IsAgentMode())
			{{- if classifiedErrors}}
			assert.True(t, output.IsRendered(err))
			assert.Contains(t, h.stderr.String(), "Error (validation_error):")
			assert.NotContains(t, h.stderr.String(), `"error_type"`,
				"ignored environment variables must not select the agent JSON renderer")
			{{- else}}
			assert.False(t, output.IsRendered(err))
			assert.Empty(t, strings.TrimSpace(h.stderr.String()))
			{{- end}}
		})
	}
}

// TestExplicitAgentModeRendersPreparseErrors verifies that removing environment
// detection does not weaken the explicit flag's early-error contract.
func TestExplicitAgentModeRendersPreparseErrors(t *testing.T) {
	h := NewCLITestHarness(t)
	t.Cleanup(output.ResetAgentMode)
	err := h.RunRaw([]string{"--agent-mode", "no-such-command"})
	assert.Error(t, err)
	assert.True(t, output.IsRendered(err))
	assert.Contains(t, h.stderr.String(), `"error_reason": "CLI_VALIDATION"`)
}
{{- end}}

// TestUsageHelpErrorPreservesWriterInheritance verifies that rendering help to
// stderr does not pin a resolved parent writer onto a child that inherits its
// output: after the root's writer is re-pointed, the child must follow it.
func TestUsageHelpErrorPreservesWriterInheritance(t *testing.T) {
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	root := &cobra.Command{Use: "root"}
	child := &cobra.Command{Use: "child", RunE: func(*cobra.Command, []string) error { return nil }}
	root.AddCommand(child)
	root.SetOut(h.stdout)
	root.SetErr(h.stderr)

	rendered := output.UsageHelpError(child, fmt.Errorf("missing required argument"))
	assert.Error(t, rendered)
	assert.Contains(t, h.stderr.String(), "Usage:")
	assert.Empty(t, h.stdout.String())

	redirected := new(bytes.Buffer)
	root.SetOut(redirected)
	assert.NoError(t, child.Help())
	assert.Contains(t, redirected.String(), "Usage:")
	assert.Empty(t, h.stdout.String())
}

// nonComparableWriter is a func-adapter io.Writer whose dynamic type is not
// comparable. Interface equality between two values of such a type panics at
// runtime, so writer bookkeeping must never compare them with ==.
type nonComparableWriter func(p []byte) (int, error)

func (w nonComparableWriter) Write(p []byte) (int, error) { return w(p) }

// TestUsageHelpErrorNonComparableWriter verifies that resolving the local
// output writer does not panic when a child inherits a writer whose dynamic
// type is non-comparable: both sides of the inheritance check then hold the
// same non-comparable type, which raw interface equality cannot handle.
func TestUsageHelpErrorNonComparableWriter(t *testing.T) {
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	root := &cobra.Command{Use: "root"}
	child := &cobra.Command{Use: "child", RunE: func(*cobra.Command, []string) error { return nil }}
	root.AddCommand(child)
	root.SetOut(nonComparableWriter(h.stdout.Write))
	root.SetErr(h.stderr)

	rendered := output.UsageHelpError(child, fmt.Errorf("missing required argument"))
	assert.Error(t, rendered)
	assert.Contains(t, h.stderr.String(), "Usage:")
	assert.Empty(t, h.stdout.String())
}

type machineOutputTestError struct {
	Body       string
	StatusCode int
}

func (e *machineOutputTestError) Error() string { return "test API error" }

{{- if classifiedErrors}}

// TestMachineOutputClassifiesCLIError verifies that explicit JSON, TOON, and
// jq requests receive reason-first errors without identifying the caller.
func TestMachineOutputClassifiesCLIError(t *testing.T) {
	cases := [][]string{
		{"--output-format", "json", "no-such-command"},
		{"--output-format", "toon", "no-such-command"},
		{"--jq", ".error_type", "no-such-command"},
	}
	for _, args := range cases {
		t.Run(strings.Join(args, " "), func(t *testing.T) {
			h := NewCLITestHarness(t)
			err := h.RunRaw(args)
			assert.Error(t, err)
			assert.True(t, output.IsRendered(err))
			assert.Contains(t, h.stderr.String(), `"error_type": "validation_error"`)
			assert.Contains(t, h.stderr.String(), `"error_reason": "CLI_VALIDATION"`)
			assert.False(t, output.IsAgentMode())
		})
	}
}

{{- $carrier := cliErrorReasonCarrier}}
{{- $typedRule := cliErrorFirstTypedRule}}
{{- if $typedRule}}

// TestMachineOutputClassifiesDeclaredReason verifies the first type-bearing
// x-speakeasy-cli-errors rule fires from the reason carrier
// ({{$carrier.Display}}) ahead of HTTP status classification.
func TestMachineOutputClassifiesDeclaredReason(t *testing.T) {
	for _, format := range []string{"json", "toon"} {
		t.Run(format, func(t *testing.T) {
			h := NewCLITestHarness(t)
			h.resetAndSetupEnv()
			root, err := cli.NewRootCommand()
			assert.NoError(t, err)
			root.SetOut(h.stdout)
			root.SetErr(h.stderr)
			target := &cobra.Command{Use: "target"}
			root.AddCommand(target)
			target.InheritedFlags()
			assert.NoError(t, root.PersistentFlags().Set("output-format", format))

			body := {{goStringLiteral (cliErrorCarrierTestBody $typedRule.Reason)}}
			rendered := output.Error(target, &machineOutputTestError{
				Body:       body,
				StatusCode: 400,
			})
			assert.Error(t, rendered)

			var envelope map[string]interface{}
			assert.NoError(t, json.Unmarshal(h.stderr.Bytes(), &envelope))
			assert.Equal(t, float64(400), envelope["status_code"])
			assert.Equal(t, {{goStringLiteral $typedRule.Type}}, envelope["error_type"])
			assert.Equal(t, {{goStringLiteral $typedRule.Reason}}, envelope["error_reason"])
			assert.False(t, output.IsAgentMode())
		})
	}
}
{{- end}}
{{- if $carrier.Declared}}

// TestMachineOutputPromotesDeclaredCarrierReason verifies that, because this
// document declares its reason carrier ({{$carrier.Display}}), a reason code
// found there is surfaced verbatim as error_reason even without a matching
// declared rule, while the type still comes from the HTTP status.
func TestMachineOutputPromotesDeclaredCarrierReason(t *testing.T) {
	for _, format := range []string{"json", "toon"} {
		t.Run(format, func(t *testing.T) {
			h := NewCLITestHarness(t)
			h.resetAndSetupEnv()
			root, err := cli.NewRootCommand()
			assert.NoError(t, err)
			root.SetOut(h.stdout)
			root.SetErr(h.stderr)
			target := &cobra.Command{Use: "target"}
			root.AddCommand(target)
			target.InheritedFlags()
			assert.NoError(t, root.PersistentFlags().Set("output-format", format))

			body := {{goStringLiteral (cliErrorCarrierTestBody "TEST_REASON_CODE")}}
			rendered := output.Error(target, &machineOutputTestError{
				Body:       body,
				StatusCode: 401,
			})
			assert.Error(t, rendered)

			var envelope map[string]interface{}
			assert.NoError(t, json.Unmarshal(h.stderr.Bytes(), &envelope))
			assert.Equal(t, float64(401), envelope["status_code"])
			assert.Equal(t, "authentication_error", envelope["error_type"])
			assert.Equal(t, "TEST_REASON_CODE", envelope["error_reason"])
			assert.False(t, output.IsAgentMode())
		})
	}
}
{{- else}}

// TestMachineOutputDoesNotPromoteUndeclaredReasons verifies a reason code
// found at the default carrier ({{$carrier.Display}}) is not surfaced as
// error_reason: without a matching x-speakeasy-cli-errors rule or a declared
// reasonPointer, the type comes from the HTTP status and no reason is
// promoted from the body.
func TestMachineOutputDoesNotPromoteUndeclaredReasons(t *testing.T) {
	for _, format := range []string{"json", "toon"} {
		t.Run(format, func(t *testing.T) {
			h := NewCLITestHarness(t)
			h.resetAndSetupEnv()
			root, err := cli.NewRootCommand()
			assert.NoError(t, err)
			root.SetOut(h.stdout)
			root.SetErr(h.stderr)
			target := &cobra.Command{Use: "target"}
			root.AddCommand(target)
			target.InheritedFlags()
			assert.NoError(t, root.PersistentFlags().Set("output-format", format))

			body := {{goStringLiteral (cliErrorCarrierTestBody "TEST_REASON_CODE")}}
			rendered := output.Error(target, &machineOutputTestError{
				Body:       body,
				StatusCode: 401,
			})
			assert.Error(t, rendered)

			var envelope map[string]interface{}
			assert.NoError(t, json.Unmarshal(h.stderr.Bytes(), &envelope))
			assert.Equal(t, float64(401), envelope["status_code"])
			assert.Equal(t, "authentication_error", envelope["error_type"])
			assert.NotContains(t, envelope, "error_reason",
				"an undeclared body reason must not be promoted under the http profile")
			assert.False(t, output.IsAgentMode())
		})
	}
}
{{- end}}

