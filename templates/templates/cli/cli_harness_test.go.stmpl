// CLITestHarness executes CLI commands in-process for testing.
type CLITestHarness struct {
	t            *testing.T
	stdout       *bytes.Buffer
	stderr       *bytes.Buffer
	testName     string
	instanceID   string
	envOverrides map[string]string
}

// NewCLITestHarness creates a new test harness for CLI command execution.
func NewCLITestHarness(t *testing.T) *CLITestHarness {
	t.Helper()
	return &CLITestHarness{
		t:          t,
		stdout:     new(bytes.Buffer),
		stderr:     new(bytes.Buffer),
		instanceID: genTestInstanceID(),
	}
}

{{- if and (isInteractiveModeEnabled) (not (interactiveByDefault))}}

type interactionGatePrompter struct {
	calls int
	value string
	err   error
}

func (p *interactionGatePrompter) Prompt(_ *cobra.Command, fields []interactive.PromptField) ([]interactive.PromptAnswer, error) {
	p.calls++
	if p.err != nil {
		return nil, p.err
	}
	answers := make([]interactive.PromptAnswer, len(fields))
	for i, field := range fields {
		if field.Required {
			answers[i] = interactive.PromptAnswer{Set: true, Values: []string{p.value}}
		}
	}
	return answers, nil
}

// TestNonInteractiveDefaultRequiresExplicitOptIn covers the false-default
// runtime contract even for generated variants that do not copy a group-specific
// test directory. An injected prompter bypasses only the TTY check, so the
// --interactive flag remains the required opt-in and --no-interactive still wins.
func TestNonInteractiveDefaultRequiresExplicitOptIn(t *testing.T) {
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	root, err := cli.NewRootCommand()
	assert.NoError(t, err)
	ctx := interactive.WithPrompter(context.Background(), &interactionGatePrompter{})
	root.SetContext(ctx)

	assert.False(t, interactive.IsInteractive(root))
	assert.NoError(t, root.PersistentFlags().Set("interactive", "true"))
	assert.True(t, interactive.IsInteractive(root))
	assert.NoError(t, root.PersistentFlags().Set("no-interactive", "true"))
	assert.False(t, interactive.IsInteractive(root))
}

func TestExplorerHandoffPreservesInteractionIntent(t *testing.T) {
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()

	t.Run("opts the selected command into prompting", func(t *testing.T) {
		sourceRoot, err := cli.NewRootCommand()
		assert.NoError(t, err)
		freshRoot, err := cli.NewRootCommand()
		assert.NoError(t, err)

		var executedArgs []string
		selectedCmd := &cobra.Command{
			Use:  "selected-command <value>",
			Args: cobra.ExactArgs(1),
			Run: func(_ *cobra.Command, args []string) {
				executedArgs = append([]string(nil), args...)
			},
		}
		argSpecs := []interactive.ArgSpec{
			{Name: "value", Required: true},
		}
		assert.NoError(t, interactive.Declare(selectedCmd, interactive.CommandSpec{Args: argSpecs}))
		freshRoot.AddCommand(selectedCmd)
		interactive.Intercept(selectedCmd)

		prompter := &interactionGatePrompter{value: "prompted-value"}
		selected := []string{"selected-command"}
		ctx := interactive.WithPrompter(context.Background(), prompter)
		err = cli.ExecuteRoot(ctx, freshRoot, cli.ExplorerHandoffArgs(sourceRoot, selected))

		assert.NoError(t, err)
		assert.Equal(t, 1, prompter.calls)
		assert.Equal(t, []string{"prompted-value"}, executedArgs)
		assert.Equal(t, []string{"selected-command"}, selected, "handoff must not mutate explorer-owned args")
	})

	t.Run("selected no-interactive override suppresses prompting", func(t *testing.T) {
		sourceRoot, err := cli.NewRootCommand()
		assert.NoError(t, err)
		freshRoot, err := cli.NewRootCommand()
		assert.NoError(t, err)

		executed := false
		selectedCmd := &cobra.Command{
			Use:  "selected-command <value>",
			Args: cobra.ExactArgs(1),
			Run: func(_ *cobra.Command, _ []string) {
				executed = true
			},
		}
		argSpecs := []interactive.ArgSpec{
			{Name: "value", Required: true},
		}
		assert.NoError(t, interactive.Declare(selectedCmd, interactive.CommandSpec{Args: argSpecs}))
		freshRoot.AddCommand(selectedCmd)
		interactive.Intercept(selectedCmd)

		prompter := &interactionGatePrompter{value: "prompted-value"}
		ctx := interactive.WithPrompter(context.Background(), prompter)
		err = cli.ExecuteRoot(ctx, freshRoot, cli.ExplorerHandoffArgs(sourceRoot, []string{
			"selected-command", "--no-interactive",
		}))

		assert.Error(t, err)
		assert.Zero(t, prompter.calls)
		assert.False(t, executed)
	})

	t.Run("source no-interactive override survives handoff", func(t *testing.T) {
		sourceRoot, err := cli.NewRootCommand()
		assert.NoError(t, err)
		assert.NoError(t, sourceRoot.PersistentFlags().Set("no-interactive", "true"))
		freshRoot, err := cli.NewRootCommand()
		assert.NoError(t, err)

		executed := false
		selectedCmd := &cobra.Command{
			Use:  "selected-command <value>",
			Args: cobra.ExactArgs(1),
			Run: func(_ *cobra.Command, _ []string) {
				executed = true
			},
		}
		argSpecs := []interactive.ArgSpec{
			{Name: "value", Required: true},
		}
		assert.NoError(t, interactive.Declare(selectedCmd, interactive.CommandSpec{Args: argSpecs}))
		freshRoot.AddCommand(selectedCmd)
		interactive.Intercept(selectedCmd)

		prompter := &interactionGatePrompter{value: "prompted-value"}
		ctx := interactive.WithPrompter(context.Background(), prompter)
		err = cli.ExecuteRoot(ctx, freshRoot, cli.ExplorerHandoffArgs(sourceRoot, []string{"selected-command"}))

		assert.Error(t, err)
		assert.Zero(t, prompter.calls)
		assert.False(t, executed)
	})
}

// The explore hand-off executes the selected command on a fresh command tree
// in the same process. Rendering flags given to the explore invocation must
// still shape the selected command's output: ExplorerHandoffArgs forwards
// them in argv and the fresh ExecuteRoot captures them again. The source
// root's flags are set directly (as the other hand-off tests do) so the test
// never launches explore and stays independent of whether a TTY is attached.
func TestExplorerHandoffPreservesRenderingFlags(t *testing.T) {
	h := NewCLITestHarness(t)

	handoff := func(t *testing.T, sourceFlags map[string]string, selected []string) (string, []string) {
		t.Helper()
		sourceRoot, err := cli.NewRootCommand()
		require.NoError(t, err)
		for name, value := range sourceFlags {
			require.NoError(t, sourceRoot.PersistentFlags().Set(name, value))
		}

		freshRoot, err := cli.NewRootCommand()
		require.NoError(t, err)
		var stdout bytes.Buffer
		freshRoot.SetOut(&stdout)
		freshRoot.SetErr(io.Discard)
		freshRoot.AddCommand(&cobra.Command{
			Use: "selected-command",
			RunE: func(cmd *cobra.Command, _ []string) error {
				return output.Result(cmd, map[string]interface{}{"name": "selected", "count": 2})
			},
		})
		args := cli.ExplorerHandoffArgs(sourceRoot, selected)
		require.NoError(t, cli.ExecuteRoot(context.Background(), freshRoot, args))
		return stdout.String(), args
	}

	t.Run("output-format json reaches the selected command", func(t *testing.T) {
		h.resetAndSetupEnv()
		stdout, args := handoff(t, map[string]string{"output-format": "json"}, []string{"selected-command"})
		assert.Contains(t, args, "--output-format=json")
		var decoded map[string]interface{}
		require.NoError(t, json.Unmarshal([]byte(stdout), &decoded), stdout)
		assert.Equal(t, "selected", decoded["name"])
	})

	t.Run("jq projection reaches the selected command", func(t *testing.T) {
		h.resetAndSetupEnv()
		stdout, args := handoff(t, map[string]string{"output-format": "json", "jq": ".count"}, []string{"selected-command"})
		assert.Contains(t, args, "--jq=.count")
		assert.Equal(t, "2", strings.TrimSpace(stdout))
	})

	t.Run("raw-output reaches the selected command", func(t *testing.T) {
		h.resetAndSetupEnv()
		quoted, _ := handoff(t, map[string]string{"output-format": "json", "jq": ".name"}, []string{"selected-command"})
		assert.Equal(t, `"selected"`, strings.TrimSpace(quoted))

		h.resetAndSetupEnv()
		raw, args := handoff(t, map[string]string{"output-format": "json", "jq": ".name", "raw-output": "true"}, []string{"selected-command"})
		assert.Contains(t, args, "--raw-output=true")
		assert.Equal(t, "selected", strings.TrimSpace(raw))
	})

	t.Run("color reaches the selected command", func(t *testing.T) {
		h.resetAndSetupEnv()
		_, args := handoff(t, map[string]string{"color": "never"}, []string{"selected-command"})
		assert.Contains(t, args, "--color=never")
	})

	t.Run("no rendering flags leaves the selected command untouched", func(t *testing.T) {
		h.resetAndSetupEnv()
		_, args := handoff(t, nil, []string{"selected-command"})
		for _, arg := range args {
			assert.NotContains(t, arg, "--output-format")
			assert.NotContains(t, arg, "--jq")
			assert.NotContains(t, arg, "--raw-output")
			assert.NotContains(t, arg, "--color")
		}
	})

	t.Run("a later invocation does not inherit earlier rendering flags", func(t *testing.T) {
		h.resetAndSetupEnv()
		projected, _ := handoff(t, map[string]string{"output-format": "json", "jq": ".count"}, []string{"selected-command"})
		assert.Equal(t, "2", strings.TrimSpace(projected))
		// Same process, no harness reset: the next parse must start clean.
		plain, _ := handoff(t, nil, []string{"selected-command"})
		assert.NotEqual(t, "2", strings.TrimSpace(plain))
		assert.Contains(t, plain, "selected")
	})
}

// These command-specific cases pin the review fixture contract and skip on other generated APIs.
func skipUnlessCommand(t *testing.T, name string) {
	t.Helper()
	root, err := cli.NewRootCommand()
	if err != nil {
		t.Fatalf("build command tree: %v", err)
	}
	if _, _, err := root.Find([]string{name}); err != nil {
		t.Skipf("command %q is not generated", name)
	}
}

func TestNonInteractiveDefaultDoesNotCallPrompterForRequiredOperation(t *testing.T) {
	skipUnlessCommand(t, "update-user")
	p := &interactionGatePrompter{}
	h := NewCLITestHarness(t)
	err := h.RunWithPrompter([]string{"update-user"}, p)
	require.Error(t, err)
	var missing *flagutil.MissingRequiredFlagError
	require.ErrorAs(t, err, &missing)
	assert.Equal(t, "missing required flag: --id", missing.Error())
	assert.Zero(t, p.calls)
}

func TestNonInteractiveDefaultBareRequiredIntentIsUsageError(t *testing.T) {
	skipUnlessCommand(t, "invite")
	p := &interactionGatePrompter{}
	h := NewCLITestHarness(t)
	err := h.RunWithPrompter([]string{"invite"}, p)
	// A bare required-input intent that cannot prompt is a usage failure:
	// help goes to stderr, stdout stays empty, and the process exits 2.
	require.Error(t, err)
	assert.Zero(t, p.calls)
	assert.Equal(t, clierrors.ExitUsage, clierrors.ExitCode(err))
	assert.Contains(t, h.GetStderr(), "Usage:")
	assert.Empty(t, strings.TrimSpace(h.GetStdout()))
}

func TestExplicitInteractivePromptsForRequiredOperation(t *testing.T) {
	skipUnlessCommand(t, "update-user")
	stop := fmt.Errorf("stop after prompt")
	p := &interactionGatePrompter{err: stop}
	h := NewCLITestHarness(t)
	err := h.RunWithPrompter([]string{"--interactive", "update-user"}, p)
	require.ErrorIs(t, err, stop)
	assert.Equal(t, 1, p.calls)
}

func TestExplicitInteractiveUsageDoesNotPrompt(t *testing.T) {
	skipUnlessCommand(t, "update-user")
	p := &interactionGatePrompter{}
	h := NewCLITestHarness(t)
	require.NoError(t, h.RunWithPrompter([]string{"--interactive", "update-user", "--usage"}, p))
	assert.Zero(t, p.calls)
	assert.Contains(t, h.GetStdout(), `cmd "update-user"`)
}

type countingReader struct {
	reads int
}

func (r *countingReader) Read(_ []byte) (int, error) {
	r.reads++
	return 0, io.EOF
}

func TestNonInteractiveDefaultConfigureUsesFlagOnlyPath(t *testing.T) {
	t.Run("no flags never reads stdin or writes config", func(t *testing.T) {
		in := &countingReader{}
		h := NewCLITestHarness(t)
		err := h.RunPolicyDefaultWithInput([]string{"configure"}, in)
		require.Error(t, err)
		assert.Zero(t, in.reads)
		{{- if isInteractiveAuthEnabled}}
		assert.Contains(t, err.Error(), "--interactive")
		{{- end}}
		assert.Contains(t, err.Error(), config.GetConfigPath())
		_, statErr := os.Stat(config.GetConfigPath())
		assert.True(t, os.IsNotExist(statErr), "configure without values must not create a config file")
	})

	{{- if and (hasGlobalSecurity) (templatePolicyTestSecurityFlag)}}
	t.Run("credential flag stores", func(t *testing.T) {
		h := NewCLITestHarness(t)
		require.NoError(t, h.RunPolicyDefault([]string{"configure", "--{{templatePolicyTestSecurityFlag}}", "configured-value"}))
		_, err := os.Stat(config.GetConfigPath())
		require.NoError(t, err)
	})
	{{- end}}
}

{{- if and (isInteractiveAuthEnabled) (hasGlobalSecurity)}}
func TestNonInteractiveDefaultAuthLoginUsesFlagOnlyPath(t *testing.T) {
	t.Run("no flags never reads stdin", func(t *testing.T) {
		in := &countingReader{}
		h := NewCLITestHarness(t)
		err := h.RunPolicyDefaultWithInput([]string{"auth", "login"}, in)
		require.Error(t, err)
		assert.Zero(t, in.reads)
		assert.Contains(t, err.Error(), "--interactive")
		assert.Contains(t, err.Error(), config.GetConfigPath())
	})

	{{- if templatePolicyTestSecurityFlag}}
	t.Run("credential flag stores", func(t *testing.T) {
		h := NewCLITestHarness(t)
		require.NoError(t, h.RunPolicyDefault([]string{"auth", "login", "--{{templatePolicyTestSecurityFlag}}", "auth-value"}))
		_, err := os.Stat(config.GetConfigPath())
		require.NoError(t, err)
	})
	{{- end}}

	t.Run("agent mode no flags uses the ordinary structured usage error", func(t *testing.T) {
		h := NewCLITestHarness(t)
		err := h.RunPolicyDefault([]string{"--agent-mode", "auth", "login"})
		require.Error(t, err)
		assert.Contains(t, h.GetStderr(), `"error_reason": "CLI_VALIDATION"`)
		assert.Contains(t, h.GetStderr(), "--interactive")
		assert.NotContains(t, h.GetStderr(), "auth_login_blocked")
	})

	{{- if templatePolicyTestSecurityFlag}}
	t.Run("agent mode credential flag stores", func(t *testing.T) {
		h := NewCLITestHarness(t)
		require.NoError(t, h.RunPolicyDefault([]string{"--agent-mode", "auth", "login", "--{{templatePolicyTestSecurityFlag}}", "agent-auth-value"}))
		_, err := os.Stat(config.GetConfigPath())
		require.NoError(t, err)
	})
	{{- end}}
}
{{- end}}

