func genTestInstanceID() string {
	b := make([]byte, 16)
	rand.Read(b)
	return fmt.Sprintf("%X-%X-%X-%X-%X", b[0:4], b[4:6], b[6:8], b[8:10], b[10:])
}

// GetStdout returns captured stdout.
func (h *CLITestHarness) GetStdout() string {
	return h.stdout.String()
}

// GetStderr returns captured stderr.
func (h *CLITestHarness) GetStderr() string {
	return h.stderr.String()
}

// jsonGet parses a JSON string and navigates a dot-separated path.
// Supports map key access and array index access (numeric path segments).
// Returns nil if the path doesn't exist or the JSON is invalid.
func jsonGet(jsonStr string, path string) interface{} {
	if path == "" {
		return nil
	}
	var data interface{}
	if err := json.Unmarshal([]byte(jsonStr), &data); err != nil {
		return nil
	}
	parts := strings.Split(path, ".")
	for _, part := range parts {
		switch v := data.(type) {
		case map[string]interface{}:
			data = v[part]
		case []interface{}:
			idx, err := strconv.Atoi(part)
			if err != nil || idx < 0 || idx >= len(v) {
				return nil
			}
			data = v[idx]
		default:
			return nil
		}
	}
	return data
}

// jsonGetString extracts a string value from a JSON string at the given dot-path.
func jsonGetString(jsonStr string, path string) string {
	v := jsonGet(jsonStr, path)
	if v == nil {
		return ""
	}
	switch val := v.(type) {
	case string:
		return val
	case float64:
		// Handle numbers stored as JSON numbers but expected as strings
		if val == float64(int64(val)) {
			return strconv.FormatInt(int64(val), 10)
		}
		return strconv.FormatFloat(val, 'f', -1, 64)
	case bool:
		return strconv.FormatBool(val)
	default:
		b, _ := json.Marshal(val)
		return string(b)
	}
}

// jsonGetFloat64 extracts a float64 value from a JSON string at the given dot-path.
func jsonGetFloat64(jsonStr string, path string) float64 {
	v := jsonGet(jsonStr, path)
	if v == nil {
		return 0
	}
	if f, ok := v.(float64); ok {
		return f
	}
	return 0
}

// jsonGetBool extracts a boolean value from a JSON string at the given dot-path.
func jsonGetBool(jsonStr string, path string) bool {
	v := jsonGet(jsonStr, path)
	if v == nil {
		return false
	}
	if b, ok := v.(bool); ok {
		return b
	}
	return false
}

// jsonExists checks if a value exists (is non-nil) at the given dot-path in the JSON string.
func jsonExists(jsonStr string, path string) bool {
	return jsonGet(jsonStr, path) != nil
}

// toJSON marshals a value to a JSON string for use with assert.JSONEq.
func toJSON(v interface{}) string {
	if v == nil {
		return "null"
	}
	b, err := json.Marshal(v)
	if err != nil {
		return "null"
	}
	return string(b)
}

// jsonSet sets a top-level field in a JSON object string and returns the modified JSON.
func jsonSet(jsonStr string, key string, value interface{}) string {
	var data map[string]interface{}
	if err := json.Unmarshal([]byte(strings.TrimSpace(jsonStr)), &data); err != nil {
		return jsonStr
	}
	data[key] = value
	result, err := json.Marshal(data)
	if err != nil {
		return jsonStr
	}
	return string(result)
}

// jsonMarshal marshals a value to a JSON string. Convenience wrapper for tests.
func jsonMarshal(v interface{}) string {
	b, err := json.Marshal(v)
	if err != nil {
		return "{}"
	}
	return string(b)
}

// jsonContains checks that every key/value in expectedJSON exists in actualJSON.
// Used for responses with additional properties where the actual response may have
// extra fields not in the expected data.
func jsonContains(t *testing.T, expectedJSON, actualJSON string) {
	t.Helper()
	var expected, actual interface{}
	if err := json.Unmarshal([]byte(expectedJSON), &expected); err != nil {
		t.Fatalf("jsonContains: failed to parse expected JSON: %v", err)
	}
	if err := json.Unmarshal([]byte(actualJSON), &actual); err != nil {
		t.Fatalf("jsonContains: failed to parse actual JSON: %v", err)
	}
	assertContains(t, "", expected, actual)
}

func assertContains(t *testing.T, path string, expected, actual interface{}) {
	t.Helper()
	switch e := expected.(type) {
	case map[string]interface{}:
		a, ok := actual.(map[string]interface{})
		if !ok {
			t.Errorf("at %s: expected object, got %T", path, actual)
			return
		}
		for k, v := range e {
			p := path + "." + k
			av, exists := a[k]
			if !exists {
				t.Errorf("at %s: key %q missing in actual", p, k)
				continue
			}
			assertContains(t, p, v, av)
		}
	case []interface{}:
		a, ok := actual.([]interface{})
		if !ok {
			t.Errorf("at %s: expected array, got %T", path, actual)
			return
		}
		if len(e) != len(a) {
			t.Errorf("at %s: expected array length %d, got %d", path, len(e), len(a))
			return
		}
		for i, v := range e {
			assertContains(t, fmt.Sprintf("%s[%d]", path, i), v, a[i])
		}
	default:
		assert.Equal(t, expected, actual, "at path %s", path)
	}
}
