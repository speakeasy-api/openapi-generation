// RunWithStdin executes a CLI command with the given args and piped stdin data.
// This enables testing the stdin + flags merge behavior.
// Uses cmd.SetIn() instead of replacing os.Stdin, making it safe for parallel tests.
func (h *CLITestHarness) RunWithStdin(args []string, stdinData string) error {
