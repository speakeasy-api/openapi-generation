	rootCmd.SetOut(h.stdout)
	rootCmd.SetErr(h.stderr)
	rootCmd.SetIn(strings.NewReader(stdinData))

	fullArgs := append(append(baseArgs(), "--server-url", getTestServerURL(), "--output-format", "json", "--color", "never"), args...)
	return cli.ExecuteRoot(context.Background(), rootCmd, fullArgs)
}

