// TestMachineOutputDoesNotClassifyMultipleInlineErrors verifies ambiguous
// arrays never inherit a reason from only their first error object.
func TestMachineOutputDoesNotClassifyMultipleInlineErrors(t *testing.T) {
	assertAmbiguousBodyUsesStatusClassification(t,
		`{"error":[{"details":[{"reason":"FIRST_REASON"}]},{"details":[{"reason":"SECOND_REASON"}]}]}`)
}
{{- if cliErrorUnwrapDeclared}}

// TestMachineOutputUnwrapsArrayWrappedErrors verifies the declared
// unwrapErrorArray normalization: a single-element [{"error": {...}}] body
// is unwrapped to its sole element, so its nested message is extracted and
// no compatibility body split remains.
func TestMachineOutputUnwrapsArrayWrappedErrors(t *testing.T) {
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	root, err := cli.NewRootCommand()
	assert.NoError(t, err)
	root.SetOut(h.stdout)
	root.SetErr(h.stderr)
	target := &cobra.Command{Use: "target"}
	root.AddCommand(target)
	target.InheritedFlags()
	assert.NoError(t, root.PersistentFlags().Set("output-format", "json"))

	rendered := output.Error(target, &machineOutputTestError{
		Body:       `[{"error":{"message":"wrapped failure"}}]`,
		StatusCode: 400,
	})
	assert.Error(t, rendered)

	var envelope map[string]interface{}
	assert.NoError(t, json.Unmarshal(h.stderr.Bytes(), &envelope))
	assert.Equal(t, "wrapped failure", envelope["message"],
		"the unwrapped error object's message must be extracted")
	assert.NotContains(t, envelope, "body")
	assert.Equal(t, "validation_error", envelope["error_type"])
	assert.False(t, output.IsAgentMode())
}

// TestMachineOutputDoesNotUnwrapMultipleErrorEnvelopes verifies the declared
// unwrap stays limited to single-element arrays: a multi-element array is
// ambiguous and never supplies a reason.
func TestMachineOutputDoesNotUnwrapMultipleErrorEnvelopes(t *testing.T) {
	assertAmbiguousBodyUsesStatusClassification(t,
		`[{"error":{"details":[{"reason":"FIRST_REASON"}]}},{"error":{"details":[{"reason":"SECOND_REASON"}]}}]`)
}
{{- else}}

// TestMachineOutputDoesNotUnwrapArrayWrappedErrors verifies array-wrapped
// bodies are preserved as-is: this document does not declare the
// unwrapErrorArray normalization, so the array is kept as the body and
// classification uses the status.
func TestMachineOutputDoesNotUnwrapArrayWrappedErrors(t *testing.T) {
	assertAmbiguousBodyUsesStatusClassification(t,
		`[{"error":{"details":[{"reason":"FIRST_REASON"}]}}]`)
}
{{- end}}

func assertAmbiguousBodyUsesStatusClassification(t *testing.T, body string) {
	t.Helper()
	h := NewCLITestHarness(t)
	h.resetAndSetupEnv()
	root, err := cli.NewRootCommand()
	assert.NoError(t, err)
	root.SetOut(h.stdout)
	root.SetErr(h.stderr)
	target := &cobra.Command{Use: "target"}
	root.AddCommand(target)
	target.InheritedFlags()
	assert.NoError(t, root.PersistentFlags().Set("output-format", "json"))

	rendered := output.Error(target, &machineOutputTestError{Body: body, StatusCode: 400})
	assert.Error(t, rendered)

	var envelope map[string]interface{}
	assert.NoError(t, json.Unmarshal(h.stderr.Bytes(), &envelope))
	assert.Equal(t, "validation_error", envelope["error_type"])
	assert.NotContains(t, envelope, "error_reason",
		"HTTP 400 is an API validation failure, not local CLI_VALIDATION")
	if strings.HasPrefix(body, "[") {
		var expectedBody interface{}
		assert.NoError(t, json.Unmarshal([]byte(body), &expectedBody))
		assert.Equal(t, expectedBody, envelope["body"])
		assert.Equal(t, float64(400), envelope["status_code"])
	}
}
{{- else}}

// TestMachineOutputKeepsUnclassifiedErrors verifies the compatibility default: JSON
// remains structured but unclassified, while TOON does not change error output.
func TestMachineOutputKeepsUnclassifiedErrors(t *testing.T) {
	t.Run("json", func(t *testing.T) {
		h := NewCLITestHarness(t)
		err := h.RunRaw([]string{"--output-format", "json", "no-such-command"})
		assert.Error(t, err)
		assert.True(t, output.IsRendered(err))
		classification, ok := output.ClassificationFrom(err)
		assert.True(t, ok)
		assert.Equal(t, output.ErrorTypeValidation, classification.Type)
		assert.Equal(t, output.ErrorOriginCLI, classification.Origin)
		assert.Contains(t, h.stderr.String(), `"error":`)
		assert.NotContains(t, h.stderr.String(), `"error_type":`)
		assert.NotContains(t, h.stderr.String(), `"error_reason":`)
	})

	t.Run("toon", func(t *testing.T) {
		h := NewCLITestHarness(t)
		err := h.RunRaw([]string{"--output-format", "toon", "no-such-command"})
		assert.Error(t, err)
		assert.False(t, output.IsRendered(err))
		classification, ok := output.ClassificationFrom(err)
		assert.True(t, ok)
		assert.Equal(t, output.ErrorTypeValidation, classification.Type)
		assert.Equal(t, output.ErrorOriginCLI, classification.Origin)
		assert.Empty(t, strings.TrimSpace(h.stderr.String()))
	})

	t.Run("jq", func(t *testing.T) {
		h := NewCLITestHarness(t)
		err := h.RunRaw([]string{"--jq", ".x", "no-such-command"})
		assert.Error(t, err)
		assert.Contains(t, h.stderr.String(), `"error":`)
		assert.NotContains(t, h.stderr.String(), `"error_type":`)
		assert.NotContains(t, h.stderr.String(), `"error_reason":`)
	})

	t.Run("api 401 keeps the configure hint", func(t *testing.T) {
		h := NewCLITestHarness(t)
		h.resetAndSetupEnv()
		root, err := cli.NewRootCommand()
		assert.NoError(t, err)
		root.SetOut(h.stdout)
		root.SetErr(h.stderr)
		target := &cobra.Command{Use: "target"}
		root.AddCommand(target)
		target.InheritedFlags()
		assert.NoError(t, root.PersistentFlags().Set("output-format", "json"))

		rendered := output.Error(target, &machineOutputTestError{Body: `{"error":"unauthorized"}`, StatusCode: 401})
		assert.Error(t, rendered)

		var envelope map[string]interface{}
		assert.NoError(t, json.Unmarshal(h.stderr.Bytes(), &envelope))
		assert.Contains(t, envelope, "_hint")
		assert.NotContains(t, envelope, "error_type")
		assert.NotContains(t, envelope, "error_reason")
	})
}
{{- end}}

// WithTestName sets the test name for mock server routing.
func (h *CLITestHarness) WithTestName(name string) *CLITestHarness {
	h.testName = name
	return h
}

// WithEnv sets environment variable overrides that are applied after
// resetAndSetupEnv clears the environment. This ensures env vars survive
// the harness cleanup and are present when the command executes.
func (h *CLITestHarness) WithEnv(key, value string) *CLITestHarness {
	if h.envOverrides == nil {
		h.envOverrides = make(map[string]string)
	}
	h.envOverrides[key] = value
	return h
}

// resetAndSetupEnv resets output buffers, config state, and agent mode,
// then configures test environment variables. It also isolates from the
// user's real HOME directory to prevent stale config files from interfering
// with tests. Uses t.Setenv for automatic cleanup and to panic loudly if
// t.Parallel() is ever added (env mutations are not parallel-safe).
func (h *CLITestHarness) resetAndSetupEnv() {
	h.t.Helper()
	h.stdout.Reset()
	h.stderr.Reset()
	config.Reset()
	output.ResetAgentMode()
	output.ResetPreparsedRendering()

	for _, envVar := range []string{
		{{- if agentEnvironmentDetection}}
		"CLAUDECODE",
		"CLAUDE_CODE",
		"CURSOR_AGENT",
		"CODEX",
		"AIDER",
		"CLINE",
		"WINDSURF_AGENT",
		"GITHUB_COPILOT",
		"AMAZON_Q",
		"GEMINI_CODE_ASSIST",
		"SRC_CODY",
		"FORCE_AGENT_MODE",
		{{- end}}
		"{{.Global.Config.EnvVarPrefix}}_OUTPUT_FORMAT",
	} {
		h.t.Setenv(envVar, "")
	}

	// Isolate from user config: point HOME at a temp directory so
	// config.Init does not read ~/.config/<cli>/config.yaml.
	tmpHome, _ := os.MkdirTemp("", "cli-test-home-*")
	h.t.Cleanup(func() { os.RemoveAll(tmpHome) })
	h.t.Setenv("HOME", tmpHome)

	if h.testName != "" {
		h.t.Setenv("SPEAKEASY_TEST_NAME", h.testName)
		h.t.Setenv("SPEAKEASY_TEST_INSTANCE_ID", h.instanceID)
	}

	for k, v := range h.envOverrides {
		h.t.Setenv(k, v)
	}
}

// getTestServerURL returns the mock server URL from env or the default.
func getTestServerURL() string {
	serverURL := os.Getenv("TEST_SERVER_URL")
	if serverURL == "" {
		return "http://localhost:18080"
	}
	return serverURL
}

// baseArgs returns the standard test arguments. Compatibility-mode fixtures
// still disable their interactive default explicitly; non-interactive-by-default
// fixtures exercise that default without injecting either interaction flag.
func baseArgs() []string {
	args := []string{}
	{{- if and (isAnyInteractiveEnabled) (interactiveByDefault)}}
	args = append(args, "--no-interactive")
	{{- end}}
	return args
}

// Run executes a CLI command with the given args.
func (h *CLITestHarness) Run(args []string) error {
	h.resetAndSetupEnv()

	rootCmd, err := cli.NewRootCommand()
	if err != nil {
		return err
	}
	rootCmd.SetOut(h.stdout)
	rootCmd.SetErr(h.stderr)

	fullArgs := append(append(baseArgs(), "--server-url", getTestServerURL(), "--output-format", "json", "--color", "never"), args...)
	return cli.ExecuteRoot(context.Background(), rootCmd, fullArgs)
}

// RunPolicyDefault executes exactly the supplied arguments, without injecting
// an interaction override or output-format flag.
func (h *CLITestHarness) RunPolicyDefault(args []string) error {
	h.resetAndSetupEnv()
	if args == nil {
		args = []string{}
	}

	rootCmd, err := cli.NewRootCommand()
	if err != nil {
		return err
	}
	rootCmd.SetOut(h.stdout)
	rootCmd.SetErr(h.stderr)
	return cli.ExecuteRoot(context.Background(), rootCmd, args)
}

{{- if isAnyInteractiveEnabled}}
// RunPolicyDefaultWithInput is RunPolicyDefault with an observable command
// input stream for proving disabled forms never read stdin.
func (h *CLITestHarness) RunPolicyDefaultWithInput(args []string, in io.Reader) error {
	h.resetAndSetupEnv()
	rootCmd, err := cli.NewRootCommand()
	if err != nil {
		return err
	}
	rootCmd.SetOut(h.stdout)
	rootCmd.SetErr(h.stderr)
	rootCmd.SetIn(in)
	return cli.ExecuteRoot(context.Background(), rootCmd, args)
}
{{- end}}

{{- if isInteractiveModeEnabled}}
// RunWithPrompter executes exactly the supplied arguments with a context-scoped
// semantic prompter. The prompter supplies terminal capability only; it does
// not opt the invocation into interaction.
func (h *CLITestHarness) RunWithPrompter(args []string, prompter interactive.Prompter) error {
	h.resetAndSetupEnv()
	rootCmd, err := cli.NewRootCommand()
	if err != nil {
		return err
	}
	rootCmd.SetOut(h.stdout)
	rootCmd.SetErr(h.stderr)
	ctx := interactive.WithPrompter(context.Background(), prompter)
	return cli.ExecuteRoot(ctx, rootCmd, args)
}

// RunInteractive executes with a context-scoped semantic prompter and the
// explicit --interactive opt-in. The injected prompter substitutes only for
// the terminal check; --no-interactive and agent mode still suppress prompting.
func (h *CLITestHarness) RunInteractive(args []string, prompter interactive.Prompter) error {
	h.resetAndSetupEnv()

	rootCmd, err := cli.NewRootCommand()
	if err != nil {
		return err
	}
	rootCmd.SetOut(h.stdout)
	rootCmd.SetErr(h.stderr)

	fullArgs := append([]string{"--interactive", "--server-url", getTestServerURL(), "--output-format", "json", "--color", "never"}, args...)
	ctx := interactive.WithPrompter(context.Background(), prompter)
	return cli.ExecuteRoot(ctx, rootCmd, fullArgs)
}
{{- end}}

