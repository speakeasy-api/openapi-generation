{{- recurse 1 -}}
{{- $java8 := isJava8 -}}
{{- $okHttp := useOkHttp -}}
package {{templatePackageName}}.hooks;


import java.io.InputStream;
import java.lang.reflect.InvocationTargetException;
import java.net.HttpURLConnection;
import java.net.URI;
{{- if not $okHttp}}
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
{{- end}}
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Objects;
import java.util.Optional;
import java.util.stream.Collectors;

import {{templatePackageName}}.SecuritySource;
{{- if not $okHttp}}
import {{templatePackageName}}.utils.Helpers;
{{- end}}
import {{templatePackageName}}.utils.HTTPClient;
import {{templatePackageName}}.utils.Hook.AfterError;
import {{templatePackageName}}.utils.Hook.AfterErrorContext;
import {{templatePackageName}}.utils.Hook.BeforeRequest;
import {{templatePackageName}}.utils.Hook.BeforeRequestContext;
import {{templatePackageName}}.utils.Hook.SdkInit;
import {{templatePackageName}}.utils.Hook.SdkInitData;
{{- if $java8}}
import {{templatePackageName}}.utils.Java8Compat;
{{- end}}
import {{templatePackageName}}.utils.SessionManager;
import {{templatePackageName}}.utils.SessionManager.HasSessionKey;
import {{templatePackageName}}.utils.SessionManager.Session;
import {{templatePackageName}}.utils.Utils;
import {{templatePackageName}}.utils.Security;
{{- if $okHttp}}
import {{templatePackageName}}.utils.transport.HttpRequest;
import {{templatePackageName}}.utils.transport.HttpResponse;
{{- end}}

public final class OAuth2PasswordHook implements SdkInit, BeforeRequest, AfterError {

    private final SessionManager<Credentials> sessions;

    // set by sdkInit
    private String baseUrl;
    private HTTPClient client;

    public OAuth2PasswordHook() {
        this.sessions = new SessionManager<>();
    }

    @Override
    public SdkInitData sdkInit(SdkInitData data) {
        baseUrl = data.baseUrl();
        client = data.client();
        return new SdkInitData(baseUrl, client);
    }

    @Override
    public HttpRequest beforeRequest(BeforeRequestContext context, HttpRequest request) throws Exception {
        if (!context.oauthScopes().isPresent()) {
            // OAuth2 not in use (scopes must be defined, and can be an empty array)
            return request;
        }
        final CredentialsOrToken credentialsOrToken;
        Optional<CredentialsOrToken> c = credentials(context.securitySource());
        if (c.isPresent()) {
            credentialsOrToken = c.get();
        } else {
            return request;
        }

        final String token;
        if (credentialsOrToken.token.isPresent()) {
            token = credentialsOrToken.token.get();
        } else {
            Credentials credentials = credentialsOrToken.credentials.get();
            Session<Credentials> session = sessions.getSession(credentials, context.oauthScopes().orElse({{jdkCompat "List.of"}}()),
                    scopes -> doTokenRequest(baseUrl, client, credentials, scopes));
            token = session.token().get();
        }
        return {{if $okHttp}}request.toBuilder(){{else}}Helpers.copy(request){{end}} //
                // overwrites any previous value
                .setHeader("Authorization", "Bearer " + token) //
                .build();
    }

    @Override
    public HttpResponse<InputStream> afterError(AfterErrorContext context, Optional<HttpResponse<InputStream>> response,
            Optional<Exception> error) throws Exception {
        if (error.isPresent()) {
            throw error.get();
        } else if (!context.oauthScopes().isPresent()) {
            return response.get();
        }

        Optional<CredentialsOrToken> credentialsOrToken = credentials(context.securitySource());
        if (!credentialsOrToken.isPresent() || credentialsOrToken.get().token.isPresent()) {
            return response.get();
        }

        if (response.get().statusCode() == HttpURLConnection.HTTP_UNAUTHORIZED) {
            String sessionKey = credentialsOrToken.get().credentials.get().sessionKey();
            sessions.remove(sessionKey);
        }
        return response.get();
    }

    private static Session<Credentials> doTokenRequest(String baseUrl, HTTPClient client, Credentials credentials,
            List<String> scopes) {
        Map<String, String> payload = new HashMap<>();
        payload.put("grant_type", "password");
        payload.put("username", credentials.username);
        payload.put("password", credentials.password);
        credentials.clientId.ifPresent(x -> payload.put("client_id", x));
        credentials.clientSecret.ifPresent(x -> payload.put("client_secret", x));
        if (scopes.size() > 0) {
            payload.put("scope", scopes.stream().collect(Collectors.joining(" ")));
        }
        URI tokenUri = URI.create(baseUrl).resolve(credentials.tokenUrl);
        return SessionManager.requestOAuth2Token(client, credentials, scopes, payload, {{jdkCompat "Map.of"}}(), tokenUri);
    }

    final static class CredentialsOrToken {
        final Optional<Credentials> credentials;
        final Optional<String> token;

        CredentialsOrToken(Credentials credentials) {
            Objects.requireNonNull(credentials);
            this.credentials = Optional.of(credentials);
            this.token = Optional.empty();
        }

        CredentialsOrToken(String token) {
            Objects.requireNonNull(token);
            this.credentials = Optional.empty();
            this.token = Optional.of(token);
        }
    }

    // VisibleForTesting
    final static class Credentials implements HasSessionKey {
        final String username;
        final String password;
        final Optional<String> clientId;
        final Optional<String> clientSecret;
        final String tokenUrl;

        Credentials(String username, String password, Optional<String> clientId, Optional<String> clientSecret,
                String tokenUrl) {
            Utils.checkNotNull(username, "username");
            Utils.checkNotNull(password, "password");
            Utils.checkNotNull(clientId, "clientId");
            Utils.checkNotNull(clientSecret, "clientSecret");
            Utils.checkNotNull(tokenUrl, "tokenUrl");
            this.username = username;
            this.password = password;
            this.clientId = clientId;
            this.clientSecret = clientSecret;
            this.tokenUrl = tokenUrl;
        }

        @Override
        public String sessionKey() {
            return Utils.sessionKey(username, password, clientId.orElse(""), clientSecret.orElse(""));
        }
    }

    private static Optional<CredentialsOrToken> credentials(Optional<SecuritySource> source) {
        if (!source.isPresent()) {
            return Optional.empty();
        }
        
        Object security = source.get().getSecurity();
        
        // To find credentials we use reflection-based inspection of the SpeakeasyMetadata 
        // annotated fields in the object graph of `security`. 

        // Look recursively for a non-empty complex field (not just a String) that holds 
        // client credentials and use the first one found. If present then is nested security
        // and we treat the field value as the security object when we search for the client credentials specific fields.
        
        Object sec = Security.findComplexObjectWithNonEmptyAnnotatedField(
                        security, 
                        "\\bscheme=true\\b",
                        "\\btype=oauth2\\b", 
                        "\\bsubtype=password\\b")
                    .orElse(security);
        
        Optional<Object> oauthValue = oauth2Value(security);
        if ({{if $java8}}!oauthValue.isPresent(){{else}}oauthValue.isEmpty(){{end}}) {
            return Optional.empty();
        } else if (oauthValue.get() instanceof String) {
            return Optional.of(new CredentialsOrToken((String) oauthValue.get()));
        } else {
            Object creds = oauthValue.get();
            // Example annotation:
            // @SpeakeasyMetadata("security:name=username")
            Optional<String> username = oauth2FieldValue(creds, "username");
            Optional<String> password = oauth2FieldValue(creds, "password");
            Optional<String> clientId = oauth2FieldValue(creds, "clientID");
            Optional<String> clientSecret = oauth2FieldValue(creds, "clientSecret");
            Optional<String> tokenUrl = oauth2FieldValue(creds, "tokenURL");
            if ({{if $java8}}!username.isPresent() || !password.isPresent() || !tokenUrl.isPresent(){{else}}username.isEmpty() || password.isEmpty() || tokenUrl.isEmpty(){{end}}) {
                return Optional.empty();
            } else {
                return Optional.of(new CredentialsOrToken(
                        new Credentials(username.get(), password.get(), clientId, clientSecret, tokenUrl.get())));
            }
        }
    }

    // VisibleForTesting
    public static Optional<String> oauth2FieldValue(Object security, String name) {
        return Security.findStringValueWhereMetadataNameIs(security, name);
    }

    /**
     * If found returns the result of calling {@code .value()} on the first
     * non-empty oauth2:password annotated field (a oneOf) in the security object.
     * That value will be either a String (an explicit token) or the oauth
     * credentials object (username, password, tokenUrl, etc).
     * 
     * @param security
     * @return explicit token or the oauth credentials object or
     *         {@code Optional.empty()}
     */
    // VisibleForTesting
    public static Optional<Object> oauth2Value(Object security) {
        // Example annotation:
        // @SpeakeasyMetadata("security:scheme=true,type=oauth2,subtype=password,name=Authorization"

        return Security.findValueWhereMetadataContainsRegexes(
                    security,
                    "\\bscheme=true\\b",
                    "\\btype=oauth2\\b",
                    "\\bsubtype=password\\b")
                .map(x -> {
                    try {
{{- if .Global.Config.GenerateOptionalUnionAccessors}}
                        {{- /* With optional accessors enabled, access the TypedObject field directly */}}
                        java.lang.reflect.Field field = x.getClass().getDeclaredField("value");
                        field.setAccessible(true);
                        Object typedObject = field.get(x);
                        return typedObject.getClass().getMethod("value").invoke(typedObject);
                    } catch (IllegalAccessException | IllegalArgumentException | InvocationTargetException
                            | NoSuchMethodException | SecurityException | NoSuchFieldException e) {
                        throw new RuntimeException(e);
                    }
{{- else}}
                        {{- /* Legacy approach: call value() method directly on the union */}}
                        return x.getClass().getMethod("value").invoke(x);
                    } catch (IllegalAccessException | IllegalArgumentException | InvocationTargetException
                            | NoSuchMethodException | SecurityException e) {
                        throw new RuntimeException(e);
                    }
{{- end}}
                });
    }
}
