.retryConfig({{javaImportLocal "utils.RetryConfig"}}.builder()
    .backoff({{javaImportLocal "utils.BackoffStrategy"}}.builder()
        .initialInterval(1L, {{javaImport "java.util.concurrent.TimeUnit"}}.MILLISECONDS)
        .maxInterval(50L, {{javaImport "java.util.concurrent.TimeUnit"}}.MILLISECONDS)
        .maxElapsedTime(1000L, {{javaImport "java.util.concurrent.TimeUnit"}}.MILLISECONDS)
        .baseFactor(1.1)
        .jitterFactor(0.15)
        .retryConnectError(false)
        .build())
    .build())