package {{templatePackageName}}.utils;

import java.io.IOException;

/**
 * Thrown when a response body exceeds the configured maximum number of bytes.
 *
 * @see HTTPClient#setMaxResponseBodyBytes(long)
 */
public class ResponseTooLargeException extends IOException {

    private static final long serialVersionUID = 1L;

    private final long maxBytes;

    public ResponseTooLargeException(long maxBytes) {
        super("response body exceeded the configured maximum of " + maxBytes + " bytes");
        this.maxBytes = maxBytes;
    }

    public long maxBytes() {
        return maxBytes;
    }
}
