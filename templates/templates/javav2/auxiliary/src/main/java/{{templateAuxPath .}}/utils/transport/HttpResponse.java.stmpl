{{- if useOkHttp -}}
package {{templatePackageName}}.utils.transport;

import java.util.Optional;

import {{templatePackageName}}.utils.Headers;
import {{templatePackageName}}.utils.Utils;

/**
 * An HTTP response that is independent of the underlying HTTP client.
 *
 * <p>The response body is an {@code InputStream}; callers are responsible for
 * consuming and closing it.
 */
public final class HttpResponse<T> {

    private final HttpRequest request;
    private final int statusCode;
    private final Headers headers;
    private final T body;

    public HttpResponse(HttpRequest request, int statusCode, Headers headers, T body) {
        Utils.checkNotNull(request, "request");
        Utils.checkNotNull(headers, "headers");
        Utils.checkNotNull(body, "body");
        this.request = request;
        this.statusCode = statusCode;
        this.headers = headers;
        this.body = body;
    }

    /**
     * Returns the request that produced this response.
     */
    public HttpRequest request() {
        return request;
    }

    public int statusCode() {
        return statusCode;
    }

    /**
     * Returns a copy of the response headers. Header names are case-insensitive.
     * Mutating the returned {@link Headers} does not affect this response.
     */
    public Headers headers() {
        return copyOf(headers);
    }

    private static Headers copyOf(Headers headers) {
        Headers copy = new Headers();
        headers.forEach((name, values) -> values.forEach(value -> copy.add(name, value)));
        return copy;
    }

    /**
     * Returns the value of the Content-Type header, if present.
     */
    public Optional<String> contentType() {
        return headers.first("Content-Type");
    }

    /**
     * Returns the response body. Every call returns the same body instance;
     * for one-shot bodies (streams{{if not asyncEnabled}}, blobs{{end}}) the caller is responsible for
     * consuming it at most once and closing it where applicable.
     */
    public T body() {
        return body;
    }

    @Override
    public String toString() {
        return "HttpResponse[" + statusCode + ", " + request.method() + " " + request.uri() + "]";
    }
}
{{- end -}}
