////////////////////////////////////////////////////////////////////////////////////////////
// This file is generated by Speakeasy and any edits will be lost in generation updates.
//
// If you wish to customize this file then place those customizations in `build-extras.gradle` which 
// is not touched by generation updates.
//
// Additions to the plugins block can be made by setting the `additionalPlugins` property (an array 
// of string where each string value is an additional line in the block) in gen.yaml.
////////////////////////////////////////////////////////////////////////////////////////////


plugins {
    // Apply the java-library plugin for API and implementation separation.
    id 'java-library'
    id 'maven-publish'
    id 'signing'
    {{- if and .Global.Config.Published (not .Global.Config.OssrhURL) }}
    // V2 publishing plugin (Sonatype Central Portal)
    id 'cl.franciscosolis.sonatype-central-upload' version '1.0.3'
    {{- end}}
    {{- if sdkHasTests .Global.AST}}
    id "com.adarshr.test-logger" version "4.0.0"
    {{- end}}
    {{- if springBootStarterEnabled}}
    id "io.spring.dependency-management" version "1.1.6" apply false
    {{- end}}
    {{- templateAdditionalPlugins }}
}

compileJava.options.encoding = "UTF-8"
compileJava.options.compilerArgs += '-Xlint:unchecked'
compileTestJava.options.encoding = "UTF-8"

repositories {
    // Use Maven Central for resolving dependencies.
    mavenCentral()
}

java {
    withSourcesJar()
    withJavadocJar()
}

version = "${version}"
group = "${groupId}"

jar {
    dependsOn 'generatePomFileForMavenPublication'
    {{- if and .Global.Config.Published (not .Global.Config.OssrhURL) }}
    archiveBaseName = "${artifactId}"
    {{- end }}

    into("META-INF/maven/{{.Global.Config.GroupID}}/{{.Global.Config.ArtifactID}}") {
        from(layout.buildDirectory.file("pom.xml")) {
            // Only include if it exists to avoid build ordering issues
            duplicatesStrategy = DuplicatesStrategy.INCLUDE
        }
    }
}

javadoc {
    options.encoding = "UTF-8"

    if(JavaVersion.current().isJava9Compatible()) {
        options.addBooleanOption('html5', true)
    }
    options.addStringOption('Xdoclint:none', '-quiet')
}

tasks.withType(Javadoc).configureEach {
  failOnError = false
  options.addStringOption('Xdoclint:none', '-quiet')
}

tasks.withType(JavaCompile).configureEach {
{{- if isJava8}}
    sourceCompatibility = "1.8"
    targetCompatibility = "1.8"
{{- else}}
    options.release = {{.Global.Config.LanguageVersion}}
{{- end}}
}

sourcesJar {
    archiveBaseName = "${artifactId}"
}

javadocJar {
    archiveBaseName = "${artifactId}"
}

{{- if sdkHasTests .Global.AST}}

tasks.named('test') {
    // Use JUnit Platform for unit tests.
    useJUnitPlatform()
}

testlogger  {
    showStandardStreams = true
}

test {    
    maxParallelForks = Runtime.runtime.availableProcessors().intdiv(2) ?: 1
    finalizedBy 'mergeJUnitReports'
}

configurations {
    antJUnit
}

task mergeJUnitReports {
    ext {
        resultsDir = file("$buildDir/test-results/test")
        targetDir = file(".speakeasy/reports"){{/* TODO: the output folder for the tests report should probably be templated based on whether .speakeasy or .gen is used */}}
    }

    doLast {
        ant.taskdef(
            name: 'junitreport',
            classname: 'org.apache.tools.ant.taskdefs.optional.junit.XMLResultAggregator',
            classpath: configurations.antJUnit.asPath
        )

        mkdir targetDir

        ant.junitreport(todir: targetDir, tofile: 'tests.xml') {
            fileset(dir: resultsDir, includes: 'TEST-*.xml')
        }
    }
}
{{end}}

{{templateDependencies}}

{{- if springBootStarterEnabled}}

ext {
    springBootVersion = '3.5.14'
}

subprojects {
    if (name in [
            '{{templateProjectName .}}-spring-boot-autoconfigure',
            '{{templateProjectName .}}-spring-boot-starter'
    ]) {
        // Ensure subprojects use the same group and version as root project
        group = rootProject.group
        version = rootProject.version

        apply {
            plugin "java-library"
            plugin "io.spring.dependency-management"
            plugin "maven-publish"
            plugin "signing"
            {{- if and .Global.Config.Published (not .Global.Config.OssrhURL) }}
            plugin "cl.franciscosolis.sonatype-central-upload"
            {{- end}}
        }
        dependencyManagement {
            imports {
                mavenBom "org.springframework.boot:spring-boot-dependencies:${rootProject.springBootVersion}"
            }
        }
        repositories {
            mavenCentral()
        }
        java {
            withSourcesJar()
            withJavadocJar()
        }
        tasks.withType(JavaCompile).configureEach {
{{- if isJava8}}
            sourceCompatibility = "1.8"
            targetCompatibility = "1.8"
{{- else}}
            options.release = {{.Global.Config.LanguageVersion}}
{{- end}}
        }

        // Apply publishing configuration to all subprojects - they'll check for publishingConfig internally
        apply from: rootProject.file('publishing.gradle')
    }
}
{{- end}}

ext {
    publishingConfig = [
        groupId: group,
        artifactId: artifactId,
        version: version,
        name: "{{.Global.Config.CompanyName}} Java SDK",
        description: {{if .Global.Config.Description}}"{{.Global.Config.Description}}"{{else}}"SDK enabling Java developers to easily integrate with the {{.Global.Config.CompanyName}} API."{{end}},
        publicationName: "maven"
    ]
}

apply from: 'publishing.gradle'

apply from: 'build-extras.gradle'