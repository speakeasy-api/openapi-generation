/*
 * This file was generated by the Gradle 'init' task.
 *
 * The settings file is used to specify which projects to include in your build.
 *
 * Detailed information about configuring a multi-project build in Gradle can be found
 * in the user manual at https://docs.gradle.org/7.5.1/userguide/multi_project_builds.html
 */

rootProject.name = '{{templateProjectName}}'
{{- if springBootStarterEnabled}}

include '{{templateProjectName}}-spring-boot-autoconfigure'
include '{{templateProjectName}}-spring-boot-starter'

project(':{{templateProjectName}}-spring-boot-autoconfigure').projectDir = file('spring/{{templateProjectName}}-spring-boot-autoconfigure')
project(':{{templateProjectName}}-spring-boot-starter').projectDir = file('spring/{{templateProjectName}}-spring-boot-starter')
{{- end}}

// Apply additional settings if the file exists
if (file('settings-extra.gradle').exists()) {
    apply from: 'settings-extra.gradle'
}