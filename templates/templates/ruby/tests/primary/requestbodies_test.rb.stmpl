    def test_request_body_post_empty_object
      record_test('request-bodies-post-empty-object')

      res = @sdk.request_bodies.request_body_post_empty_object(
        request: Models::Operations::RequestBodyPostEmptyObjectRequestBody.new(
          empty: Models::Operations::Empty.new,
          empty_with_empty_properties: Models::Operations::EmptyWithEmptyProperties.new
        )
      )
