      assert_equal(obj, res.res['mapElem2'])
    end

    def test_request_body_post_application_json_map_of_map
      record_test('request-bodies-post-application-json-map-of-map')

      obj = create_simple_object

      res = @sdk.request_bodies.request_body_post_application_json_map_of_map(request: {
        "mapElem1": {
          "subMapElem1": obj,
          "subMapElem2": obj,
        },
        "mapElem2": {
            "subMapElem1": obj,
            "subMapElem2": obj,
        },
      })

      refute_nil(res)
      assert_equal(Rack::Utils.status_code(:ok), res.http_meta.response.status)
      refute_nil(res.res)
      assert_equal(obj, res.res['mapElem1']['subMapElem1'])
      assert_equal(obj, res.res['mapElem1']['subMapElem2'])
      assert_equal(obj, res.res['mapElem2']['subMapElem1'])
      assert_equal(obj, res.res['mapElem2']['subMapElem2'])
    end

    def test_request_body_post_application_json_map_of_any
      record_test('request-bodies-post-application-json-map-of-any')

      res = @sdk.request_bodies.request_body_post_application_json_map_of_any(request: {
        "mapElemArray": ['array-test'],
        "mapElemBool": true,
        "mapElemNumber": 123,
        "mapElemObject": {
          "property": 'property-test',
        },
        "mapElemString": 'string-test',
      })

      refute_nil(res)
      assert_equal(Rack::Utils.status_code(:ok), res.http_meta.response.status)
      refute_nil(res.res)
      assert_equal('array-test', res.res['mapElemArray'][0])
      assert(res.res['mapElemBool'])
      assert_equal(123, res.res['mapElemNumber'])
      assert_equal('property-test', res.res['mapElemObject']['property'])
      assert_equal('string-test', res.res['mapElemString'])
    end

    def test_request_body_post_application_json_map_of_array
