    def test_request_body_post_nullable_required_empty_object
      tests = [
        {
          'name' => 'Required field initialized only',
          'arg' => Models::Operations::NullableRequiredEmptyObjectPostRequestBody.new(
            required_obj: Models::Operations::RequiredObj.new
          ),
          'want' => '{"NullableRequiredObj":null,"RequiredObj":{}}',
          'test_id' => 'request-bodies-post-nullable-required-empty-object-nullable-set'
        },
        {
          'name' => 'Optional field initialized only',
          'arg' => Models::Operations::NullableRequiredEmptyObjectPostRequestBody.new(
            required_obj: Models::Operations::RequiredObj.new,
            nullable_optional_obj: Models::Operations::NullableOptionalObj.new
          ),
          'want' => '{"NullableOptionalObj":{},"NullableRequiredObj":null,"RequiredObj":{}}',
          'test_id' => 'request-bodies-post-nullable-required-empty-object-optional-set'
        },
        {
          'name' => 'All fields initialized',
          'arg' => Models::Operations::NullableRequiredEmptyObjectPostRequestBody.new(
            required_obj: Models::Operations::RequiredObj.new,
            nullable_optional_obj: Models::Operations::NullableOptionalObj.new,
            nullable_required_obj: Models::Operations::NullableRequiredObj.new
          ),
          'want' => '{"NullableOptionalObj":{},"NullableRequiredObj":{},"RequiredObj":{}}',
          'test_id' => 'request-bodies-post-nullable-required-empty-object-all-set'
        }
      ]

      @sdk = OpenApiSDK::SDK.new
      tests.each do |test|
        if !(!test.key?('test_id') && test['test_id'].empty?)
          record_test(test['test_id'])
        end

        req = test['arg']

        res = @sdk.request_bodies.nullable_required_empty_object_post(request: req)

        refute_nil(res)
        assert_equal(Rack::Utils.status_code(:ok), res.http_meta.response.status)
        _, body, = OpenApiSDK::Utils.serialize_request_body(req, true, true, :request, :json)
        assert_equal(test['want'], body)
      end
    end

