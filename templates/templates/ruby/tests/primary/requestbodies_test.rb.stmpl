      assert_equal(Rack::Utils.status_code(:ok), res.http_meta.response.status)
      refute_nil(res.res)
      assert_equal(obj, res.res['mapElem1'][0])
      assert_equal(obj, res.res['mapElem1'][1])
      assert_equal(obj, res.res['mapElem2'][0])
      assert_equal(obj, res.res['mapElem2'][1])
    end

    def test_request_body_post_application_json_array_of_map
