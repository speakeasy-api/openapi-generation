    def test_request_body_post_nullable_required_property
      tests = [
        {
          'name' => 'Empty initializer',
          'arg' => Models::Operations::NullableRequiredPropertyPostRequestBody.new,
          'want' => '{"NullableRequiredArray":null,"NullableRequiredBigIntStr":null,"NullableRequiredDateTime":null,"NullableRequiredDecimalStr":null,"NullableRequiredEnum":null,"NullableRequiredInt":null}',
          'test_id' => 'request-bodies-post-nullable-optional-fields'
        },
        {
          'name' => 'All fields set to null',
          'arg' => Models::Operations::NullableRequiredPropertyPostRequestBody.new(
            nullable_optional_int: nil,
            nullable_required_array: nil,
            nullable_required_enum: nil,
            nullable_required_int: nil,
            nullable_required_date_time: nil,
            nullable_required_big_int_str: nil,
            nullable_required_decimal_str: nil
          ),
          'want' => '{"NullableRequiredArray":null,"NullableRequiredBigIntStr":null,"NullableRequiredDateTime":null,"NullableRequiredDecimalStr":null,"NullableRequiredEnum":null,"NullableRequiredInt":null}',
          'test_id' => 'request-bodies-post-nullable-required-property-all-null'
        },
        {
          'name' => 'Optional field initialized',
          'arg' => Models::Operations::NullableRequiredPropertyPostRequestBody.new(
            nullable_optional_int: 0
          ),
          'want' => '{"NullableOptionalInt":0,"NullableRequiredArray":null,"NullableRequiredBigIntStr":null,"NullableRequiredDateTime":null,"NullableRequiredDecimalStr":null,"NullableRequiredEnum":null,"NullableRequiredInt":null}'
        },
        # TODO: need bigint and decimal support
        # {
        #   'name' => 'All fields set to non-null value',
        #   'arg' => Models::Operations::NullableRequiredPropertyPostRequestBody.new(
        #     nullable_optional_int: 0,
        #     nullable_required_array: [1.1, 2.2, 3.3],
        #     nullable_required_enum: Models::Operations::NullableRequiredEnum::Second,
        #     nullable_required_int: 1,
        #     nullable_required_date_time: DateTime.parse('2020-01-01T00:00:00.000001Z'),
        #     nullable_required_big_int_str: Brick::Math::BigInteger.of('9223372036854775807'),
        #     nullable_required_decimal_str: Brick::Math::BigDecimal.of('3.1415926535897932384626433833')
        #   ),
        #   'test_id' => "request-bodies-post-nullable-required-property-all-set"
        # }
      ]
      @sdk = OpenApiSDK::SDK.new
      tests.each do |test|
        if test.key?('test_id') && !test['test_id'].empty?
          record_test(test['test_id'])
        end

        req = test['arg']

        _, body, __ = OpenApiSDK::Utils.serialize_request_body(req, true, true, :request, :json)
        assert_equal(test['want'], body)

        res = @sdk.request_bodies.nullable_required_property_post(request: req)
        refute_nil(res)
        assert_equal(Rack::Utils.status_code(:ok), res.http_meta.response.status)
      end
    end

    def test_required_body_post_nullable_required_shared_object
      tests = [
