        assert_equal(Rack::Utils.status_code(:ok), res.http_meta.response.status)
      end
    end

    def test_request_body_default_and_consts
      record_test('request-bodies-defaults-and-consts')

      req = Models::Shared::DefaultsAndConsts.new(
        normal_field: 'normal',
        default_str: 'not default',
        const_big_int: 9_007_199_254_740_991,
        const_big_int_str: '9223372036854775807',
        const_bool: true,
        const_date: Date.new(2020, 1, 1),
        const_date_time: DateTime.new(2020, 1, 1, 0, 0, 1 / 1_000_000_000.0),
        const_decimal: 3.141592653589793,
        const_decimal_str: '3.141592653589793238462643383279',
        const_enum_int: Models::Shared::ConstEnumInt::TWO,
        const_enum_str: Models::Shared::ConstEnumStr::TWO,
        const_int: 123,
        const_num: 123.456,
        const_str: 'const',
        const_str_backticks: 'const with `backticks`',
        const_str_brackets: 'const with ${<brackets>}',
        const_str_d_quotes: 'const with "double quotes"',
        const_str_null: nil,
        const_str_s_quotes: 'const with \'single quotes\''
      )
      res = @sdk.request_bodies.request_body_post_defaults_and_consts(request: req)

      refute_nil(res)
      assert_equal(Rack::Utils.status_code(:ok), res.http_meta.response.status)
      refute_nil(res.object)
      assert_equal('normal', res.object.json.normal_field)
      assert_equal(9_007_199_254_740_991, res.object.json.const_big_int)
      # assert_equal(9_223_372_036_854_775_807, res.object.json.const_big_int_str) TODO: requires bigint support
      assert(res.object.json.const_bool)
      assert_equal(Date.new(2020, 1, 1), res.object.json.const_date)
      assert_in_delta(DateTime.new(2020, 1, 1, 0, 0, 1 / 1_000_000_000.0), res.object.json.const_date_time, 1)
      assert_equal(3.141592653589793, res.object.json.const_decimal)
      # assert_equal(3.141592653589793238462643383279, res.object.json.const_decimal_str) TODO: requires decimal support
      assert_equal(Models::Shared::ConstEnumInt::TWO, res.object.json.const_enum_int)
      assert_equal(Models::Shared::ConstEnumStr::TWO, res.object.json.const_enum_str)
      assert_equal(123, res.object.json.const_int)
      assert_equal(123.456, res.object.json.const_num)
      assert_nil(res.object.json.const_str_null)

      assert_equal(9_007_199_254_740_991, res.object.json.default_big_int)
      # assert_equal(9_223_372_036_854_775_807, res.object.json.default_big_int_str) TODO: requires bigint support
      assert(res.object.json.default_bool)
      assert_equal(Date.new(2020, 1, 1), res.object.json.default_date)
      assert_in_delta(DateTime.new(2020, 1, 1, 0, 0, 1 / 1_000_000_000.0), res.object.json.default_date_time, 1)
      assert_equal(3.141592653589793, res.object.json.default_decimal)
      # assert_equal(3.141592653589793238462643383279, res.object.json.default_decimal_str) TODO: requires decimal support
      assert_equal(Models::Shared::DefaultEnumInt::TWO, res.object.json.default_enum_int)
      assert_equal(Models::Shared::DefaultEnumStr::TWO, res.object.json.default_enum_str)
      assert_equal(123, res.object.json.default_int)
      assert_equal(123.456, res.object.json.default_num)
      assert_equal('not default', res.object.json.default_str)
      assert_nil(res.object.json.default_str_nullable)
      assert_equal('default', res.object.json.default_str_optional)
    end

