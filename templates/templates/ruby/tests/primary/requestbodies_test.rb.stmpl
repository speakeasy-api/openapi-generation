    def test_request_body_put_multipart_files_array
      record_test('request-bodies-post-multipart-files-array')

      # Load test file content
      data = File.open('test/testdata/testUpload.json').read

      # Create SDK instance with specific server URL (matching Go test)
      sdk = OpenApiSDK::SDK.new(
        server_url: CommonHelpers.api_test_service_url
      )

      # Create request with array of files
      res = sdk.request_bodies.request_body_put_multipart_files_array(
        request: Models::Operations::RequestBodyPutMultipartFilesArrayRequestBody.new(
          files: [
            Models::Operations::Files.new(
              content: data,
              file_name: 'testUpload.json'
            ),
            Models::Operations::Files.new(
              content: data,
              file_name: 'some-other-name.json'
            )
          ]
        )
      )

      # Assertions
      refute_nil(res)
      assert_equal(Rack::Utils.status_code(:ok), res.http_meta.response.status)
      refute_nil(res.res)

      # Verify response structure
      assert_equal(2, res.res.files.length)

      # Verify first file
      first_file = res.res.files[0]
      assert_equal('ewogICJzb21lIjogImpzb24iLAogICJ0byI6ICJiZSIsCiAgInVwbG9hZGVkIjogImluIiwKICAiYSI6ICJmaWxlIgp9Cg==', first_file.content)
      assert_equal('application/octet-stream', first_file.content_type)
      assert_equal({{if eq .Global.Config.MultipartArrayFormat "legacy"}}"files[]"{{else}}'files'{{end}}, first_file.field_name)
      assert_equal('testUpload.json', first_file.filename)
      assert_equal(70, first_file.size)

      # Verify second file
      second_file = res.res.files[1]
      assert_equal('ewogICJzb21lIjogImpzb24iLAogICJ0byI6ICJiZSIsCiAgInVwbG9hZGVkIjogImluIiwKICAiYSI6ICJmaWxlIgp9Cg==', second_file.content)
      assert_equal({{if eq .Global.Config.MultipartArrayFormat "legacy"}}"files[]"{{else}}'files'{{end}}, second_file.field_name)
      assert_equal('application/octet-stream', second_file.content_type)
      assert_equal('some-other-name.json', second_file.filename)
      assert_equal(70, second_file.size)

      # Verify form fields
      assert_empty(res.res.form_fields)
    end
  end
end
