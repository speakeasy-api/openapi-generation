        {
          'name' => 'Both fields set to non-null value',
          'arg' => Models::Operations::NullableRequiredSharedObjectPostRequestBody.new(
            nullable_optional_obj: Models::Shared::NullableOptionalObject.new(
              required: 1,
              optional: 'test'
            ),
            nullable_required_obj: Models::Shared::NullableObject.new(
              required: 2
            )
          ),
          'want' => '{"NullableOptionalObj":{"optional":"test","required":1},"NullableRequiredObj":{"required":2}}',
          'test_id' => 'request-bodies-post-nullable-required-shared-object-all-set'
        }
      ]
