{{typedDirective}}
# frozen_string_literal: true

require_relative './types'

{{- if accountHasFeatureAccess "sdkHooks" }}
require_relative './registration'
  {{- if .Local.HasAvailableOAuth2Scopes }}
require_relative './oauth2scopes'
  {{- end }}
{{- end }}
{{- if hasClientCredentials }}
require_relative './clientcredentials'
{{- end }}
{{- if hasOAuth2PasswordFlow }}
require_relative './oauth2password'
{{- end }}

module {{sanitizeModuleName .Global.Config.Module}}
  module SDKHooks
    class Hooks
      {{sorbetTSig}}

      {{if sorbetEnabled}}sig { void }{{end}}
      def initialize
        @sdk_init_hooks = {{sorbetLet "[]" "T::Array[AbstractSDKHook]"}}
        @before_request_hooks = {{sorbetLet "[]" "T::Array[AbstractSDKHook]"}}
        @after_success_hooks = {{sorbetLet "[]" "T::Array[AbstractSDKHook]"}}
        @after_error_hooks = {{sorbetLet "[]" "T::Array[AbstractSDKHook]"}}
        {{- if hasClientCredentials }}
        cc_hook = ClientCredentialsHook.new
        register_sdk_init_hook cc_hook
        register_before_request_hook cc_hook
        register_after_error_hook cc_hook
        {{- end }}
        {{- if hasOAuth2PasswordFlow }}
        pw_hook = OAuth2PasswordHook.new
        register_sdk_init_hook pw_hook
        register_before_request_hook pw_hook
        register_after_error_hook pw_hook
        {{- end }}
        {{- if accountHasFeatureAccess "sdkHooks" }}
        Registration.init_hooks self
        {{- end }}
      end

      {{if sorbetEnabled}}sig { params(hook: AbstractSDKHook).void }{{end}}
      def register_sdk_init_hook(hook)
        @sdk_init_hooks << hook
      end

      {{if sorbetEnabled}}sig { params(hook: AbstractSDKHook).void }{{end}}
      def register_before_request_hook(hook)
        @before_request_hooks << hook
      end

      {{if sorbetEnabled}}sig { params(hook: AbstractSDKHook).void }{{end}}
      def register_after_success_hook(hook)
        @after_success_hooks << hook
      end

      {{if sorbetEnabled}}sig { params(hook: AbstractSDKHook).void }{{end}}
      def register_after_error_hook(hook)
        @after_error_hooks << hook
      end

      {{if sorbetEnabled}}sig { params(config: SDKConfiguration).returns(SDKConfiguration) }{{end}}
      def sdk_init(config:)
        @sdk_init_hooks.each do |hook|
          config = hook.sdk_init(config: config)
        end

        return config
      end

      {{if sorbetEnabled}}sig do
        params(
          hook_ctx: BeforeRequestHookContext,
          request: Faraday::Request
        ).returns(Faraday::Request)
      end{{end}}
      def before_request(hook_ctx:, request:)
        @before_request_hooks.each do |hook|
          request = hook.before_request(hook_ctx: hook_ctx, request: request)
        end

        request
      end

      {{if sorbetEnabled}}sig do
        params(
          hook_ctx: AfterSuccessHookContext,
          response: Faraday::Response
        ).returns(Faraday::Response)
      end{{end}}
      def after_success(hook_ctx:, response:)
        @after_success_hooks.each do |hook|
          response = hook.after_success(hook_ctx: hook_ctx, response: response)
        end

        response
      end

      {{if sorbetEnabled}}sig do
        params(
          error: T.nilable(StandardError),
          hook_ctx: AfterErrorHookContext,
          response: T.nilable(Faraday::Response)
        ).returns(T.nilable(Faraday::Response))
      end{{end}}
      def after_error(error:, hook_ctx:, response:)
        @after_error_hooks.each do |hook|
          response = hook.after_error(error: error, hook_ctx: hook_ctx, response: response)
        end

        response
      end
    end
  end
end
