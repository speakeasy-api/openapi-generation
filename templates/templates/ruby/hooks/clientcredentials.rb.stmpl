{{typedDirective}}
# frozen_string_literal: true

require 'digest'
require 'json'
require 'net/http'
require 'uri'
{{- if (hasClientCredentialsBasic) }}
require 'base64'
{{- end}}

require_relative './types'

module {{sanitizeModuleName .Global.Config.Module}}
  module SDKHooks
    class Credentials
      {{sorbetTSig}}

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      attr_reader :client_id

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      attr_reader :client_secret

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      attr_reader :token_url

      {{if sorbetEnabled}}sig { returns(T.nilable(T::Array[String])) }{{end}}
      attr_reader :scopes

      {{if sorbetEnabled}}sig { returns(T::Hash[String, String]) }{{end}}
      attr_reader :additional_properties

      {{if sorbetEnabled}}sig do
        params(
          client_id: String,
          client_secret: String,
          token_url: String,
          scopes: T.nilable(T::Array[String]),
          additional_properties: T::Hash[String, String]
        ).void
      end{{end}}
      def initialize(client_id:, client_secret:, token_url:, scopes: nil, additional_properties: {})
        @client_id = client_id
        @client_secret = client_secret
        @token_url = token_url
        @scopes = scopes
        @additional_properties = additional_properties
      end
    end

    class Session
      {{sorbetTSig}}

      {{if sorbetEnabled}}sig { returns(Credentials) }{{end}}
      attr_reader :credentials

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      attr_reader :token

      {{if sorbetEnabled}}sig { returns(T::Array[String]) }{{end}}
      attr_reader :scopes

      {{if sorbetEnabled}}sig { returns(T.nilable(Integer)) }{{end}}
      attr_reader :expires_at

      {{if sorbetEnabled}}sig do
        params(
          credentials: Credentials,
          token: String,
          scopes: T::Array[String],
          expires_at: T.nilable(Integer)
        ).void
      end{{end}}
      def initialize(credentials:, token:, scopes:, expires_at: nil)
        @credentials = credentials
        @token = token
        @scopes = scopes
        @expires_at = expires_at
      end
    end

    class ClientCredentialsHook < AbstractSDKHook

      {{sorbetTSig}}

      @global_lock = Mutex.new
      @client_locks = {}
      @sessions = {}

      class << self
        attr_reader :global_lock
        attr_accessor :client_locks, :sessions
      end

      {{if sorbetEnabled}}sig { override.params(config: SDKConfiguration).returns(SDKConfiguration) }{{end}}
      def sdk_init(config:)
        raise 'Client is required' if config.client.nil?

        @client = config.client
        config
      end

      {{if sorbetEnabled}}sig do
        override.params(
          hook_ctx: BeforeRequestHookContext,
          request: Faraday::Request
        ).returns(Faraday::Request)
      end{{end}}
      def before_request(hook_ctx:, request:)
        return request if hook_disabled?(hook_ctx)

        credentials = get_credentials(hook_ctx)
        return request if credentials.nil?

        session_key = get_session_key(credentials.client_id, credentials.client_secret)
        scopes = get_required_scopes(credentials, hook_ctx)
        session = get_existing_session(session_key, scopes)

        if session.nil?
          token_url = resolve_token_endpoint(hook_ctx.base_url, credentials.token_url)
          session = do_token_request(token_url, credentials, scopes)
          store_session(session_key, scopes, session)
        end

        request.headers['Authorization'] = "Bearer #{session.token}"
        request
      end

      {{if sorbetEnabled}}sig do
        override.params(
          error: T.nilable(StandardError),
          hook_ctx: AfterErrorHookContext,
          response: T.nilable(Faraday::Response)
        ).returns(T.nilable(Faraday::Response))
      end{{end}}
      def after_error(error:, hook_ctx:, response:)
        return response if hook_disabled?(hook_ctx)

        # We don't want to refresh the token if the error is not related to the token
        return response unless error.nil?

        credentials = get_credentials(hook_ctx)
        return response if credentials.nil?

        if !response.nil? && response.status == 401
          session_key = get_session_key(credentials.client_id, credentials.client_secret)
          scopes = get_required_scopes(credentials, hook_ctx)
          scope_key = get_scope_key(scopes)
          remove_session(session_key, scope_key)
        end

        response
      end

      private

      {{if sorbetEnabled}}sig { params(hook_ctx: HookContext).returns(T::Boolean) }{{end}}
      def hook_disabled?(hook_ctx)
        hook_ctx.oauth2_scopes.nil?
      end

{{$credentialAccess := getClientCredentialsSecurityAccess}}
      {{if sorbetEnabled}}sig { params(hook_ctx: HookContext).returns(T.nilable(Credentials)) }{{end}}
      def get_credentials(hook_ctx)
        source = hook_ctx.security_source
        return nil if source.nil?

        security = source.call

        {{templateClientCredentialsSecurityAccess $credentialAccess | indent 8 | trim}}
      end

{{range $access := $credentialAccess}}
{{- $id := $access.id}}{{if eq $id ""}}{{$id = "global"}}{{end}}
      {{if sorbetEnabled}}sig { params(security: T.untyped).returns(T.nilable(Credentials)) }{{end}}
      def {{sanitizePrivateMethodName (print "get_credentials_" $id )}}(security)
        {{templateClientCredentialsSecurityAccessFunction $access.securityType | indent 8 | trim}}
      end
{{end}}

      {{if sorbetEnabled}}sig { params(base_url: String, token_url: String).returns(String) }{{end}}
      def resolve_token_endpoint(base_url, token_url)
        parsed = URI.parse(token_url)
        return token_url if parsed.host

        base = base_url.chomp('/')
        URI.join("#{base}/", token_url).to_s
      end

      {{if sorbetEnabled}}sig { params(token_url: String, credentials: Credentials, scopes: T::Array[String]).returns(Session) }{{end}}
      def do_token_request(token_url, credentials, scopes)
        {{- if (hasClientCredentialsBasic) }}
        payload = {
          'grant_type' => 'client_credentials'
        }
        auth_header = "Basic #{Base64.strict_encode64("#{credentials.client_id}:#{credentials.client_secret}")}"
        {{- else}}
        payload = {
          'grant_type' => 'client_credentials',
          'client_id' => credentials.client_id,
          'client_secret' => credentials.client_secret
        }
        {{- end}}

        payload['scope'] = scopes.join(' ') unless scopes.empty?

        # Add additional properties to payload
        credentials.additional_properties.each do |key, value|
          payload[key] = value
        end

        {{- if (hasClientCredentialsBasic) }}
        response = @client.post(token_url) do |req|
          req.headers['Content-Type'] = 'application/x-www-form-urlencoded'
          req.headers['Authorization'] = auth_header
          req.body = URI.encode_www_form(payload)
        end
        {{- else}}
        response = @client.post(token_url) do |req|
          req.headers['Content-Type'] = 'application/x-www-form-urlencoded'
          req.body = URI.encode_www_form(payload)
        end
        {{- end}}

        raise "Unexpected status code #{response.status} from token endpoint" unless response.status >= 200 && response.status < 300

        response_data = JSON.parse(response.body)

        raise 'Unexpected token type from token endpoint' unless response_data.fetch('token_type', '').downcase == 'bearer'

        expires_at = nil
        if response_data.key?('expires_in')
          expires_at = Time.now.to_i + response_data['expires_in'].to_i
        end

        Session.new(
          credentials: credentials,
          token: response_data['access_token'],
          scopes: scopes,
          expires_at: expires_at
        )
      end

      {{if sorbetEnabled}}sig { params(client_id: String, client_secret: String).returns(String) }{{end}}
      def get_session_key(client_id, client_secret)
        Digest::MD5.hexdigest("#{client_id}:#{client_secret}")
      end

      {{if sorbetEnabled}}sig { params(credentials: Credentials, hook_ctx: HookContext).returns(T::Array[String]) }{{end}}
      def get_required_scopes(credentials, hook_ctx)
        {{- if sorbetEnabled}}
        return T.must(credentials.scopes) unless credentials.scopes.nil?
        {{- else}}
        return credentials.scopes unless credentials.scopes.nil?
        {{- end}}

        hook_ctx.oauth2_scopes || []
      end

      {{if sorbetEnabled}}sig { params(scopes: T::Array[String]).returns(String) }{{end}}
      def get_scope_key(scopes)
        return '' if scopes.empty?

        scopes.sort.join('&')
      end

      {{if sorbetEnabled}}sig { params(client_key: String, scopes: T::Array[String], session: Session).void }{{end}}
      def store_session(client_key, scopes, session)
        scope_key = get_scope_key(scopes)
        lock = get_client_lock(client_key)
        lock.synchronize do
          self.class.sessions[client_key] ||= {}
          self.class.sessions[client_key][scope_key] = session
        end
      end

      {{if sorbetEnabled}}sig { params(client_key: String, scope_key: String).void }{{end}}
      def remove_session(client_key, scope_key)
        lock = get_client_lock(client_key)
        lock.synchronize do
          if self.class.sessions.key?(client_key) && self.class.sessions[client_key].key?(scope_key)
            self.class.sessions[client_key].delete(scope_key)
            self.class.sessions.delete(client_key) if self.class.sessions[client_key].empty?
          end
        end
      end

      {{if sorbetEnabled}}sig { params(client_key: String, required_scopes: T::Array[String]).returns(T.nilable(Session)) }{{end}}
      def get_existing_session(client_key, required_scopes)
        scope_key = get_scope_key(required_scopes)
        expired_keys = []
        result = {{sorbetLet "nil" "T.untyped"}}

        lock = get_client_lock(client_key)
        lock.synchronize do
          return nil unless self.class.sessions.key?(client_key)

          client_sessions = self.class.sessions[client_key]

          # Check for exact scope match first
          if client_sessions.key?(scope_key)
            exact_match = client_sessions[scope_key]
            if token_expired?(exact_match.expires_at)
              expired_keys << scope_key
            else
              result = exact_match
            end
          end

          # If no exact match, look for a superset match
          if result.nil?
            found = {{sorbetLet "false" "T::Boolean"}}
            client_sessions.each do |key, session|
              if token_expired?(session.expires_at)
                expired_keys << key
              elsif !found && required_scopes?(session.scopes, required_scopes)
                result = session
                found = true
              end
            end
          end

          # Clean up expired sessions
          expired_keys.each { |key| client_sessions.delete(key) }

          # Clean up empty client sessions
          self.class.sessions.delete(client_key) if self.class.sessions.key?(client_key) && self.class.sessions[client_key].empty?
        end

        result
      end

      {{if sorbetEnabled}}sig { params(scopes: T::Array[String], required_scopes: T::Array[String]).returns(T::Boolean) }{{end}}
      def required_scopes?(scopes, required_scopes)
        required_scopes.all? { |scope| scopes.include?(scope) }
      end

      {{if sorbetEnabled}}sig { params(expires_at: T.nilable(Integer)).returns(T::Boolean) }{{end}}
      def token_expired?(expires_at)
        !expires_at.nil? && Time.now.to_i + 60 >= expires_at
      end

      {{if sorbetEnabled}}sig { params(client_key: String).returns(Mutex) }{{end}}
      def get_client_lock(client_key)
        self.class.global_lock.synchronize do
          self.class.client_locks[client_key] ||= Mutex.new
        end
      end
    end
  end
end
