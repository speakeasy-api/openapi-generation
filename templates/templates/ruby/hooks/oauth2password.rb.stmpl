{{typedDirective}}
# frozen_string_literal: true

require 'digest'
require 'json'
require 'net/http'
require 'uri'

require_relative './types'

module {{sanitizeModuleName .Global.Config.Module}}
  module SDKHooks
    class OAuth2AccessTokenCredentials
      {{sorbetTSig}}

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      attr_reader :access_token

      {{if sorbetEnabled}}sig { params(access_token: String).void }{{end}}
      def initialize(access_token:)
        @access_token = access_token
      end

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      def grant_type
        'access_token'
      end
    end

    class OAuth2PasswordCredentials
      {{sorbetTSig}}

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      attr_reader :token_endpoint

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      attr_reader :username

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      attr_reader :password

      {{if sorbetEnabled}}sig { returns(T.nilable(String)) }{{end}}
      attr_reader :client_id

      {{if sorbetEnabled}}sig { returns(T.nilable(String)) }{{end}}
      attr_reader :client_secret

      {{if sorbetEnabled}}sig do
        params(
          token_endpoint: String,
          username: String,
          password: String,
          client_id: T.nilable(String),
          client_secret: T.nilable(String)
        ).void
      end{{end}}
      def initialize(token_endpoint:, username:, password:, client_id: nil, client_secret: nil)
        @token_endpoint = token_endpoint
        @username = username
        @password = password
        @client_id = client_id
        @client_secret = client_secret
      end

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      def grant_type
        'password'
      end

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      def session_key
        Digest::MD5.hexdigest("#{@token_endpoint}:#{@username}:#{@client_id}")
      end
    end

    class OAuth2PasswordSession
      {{sorbetTSig}}

      {{if sorbetEnabled}}sig { returns(String) }{{end}}
      attr_reader :access_token

      {{if sorbetEnabled}}sig { returns(T::Array[String]) }{{end}}
      attr_reader :scopes

      {{if sorbetEnabled}}sig { returns(T.nilable(Integer)) }{{end}}
      attr_reader :expires_at

      {{if sorbetEnabled}}sig do
        params(
          access_token: String,
          scopes: T::Array[String],
          expires_at: T.nilable(Integer)
        ).void
      end{{end}}
      def initialize(access_token:, scopes:, expires_at: nil)
        @access_token = access_token
        @scopes = scopes
        @expires_at = expires_at
      end
    end

    class OAuth2PasswordHook < AbstractSDKHook

      {{sorbetTSig}}

      {{if sorbetEnabled}}sig { void }{{end}}
      def initialize
        @lock = Mutex.new
        @client_locks = {}
        @sessions = {}
      end

      {{if sorbetEnabled}}sig { override.params(config: SDKConfiguration).returns(SDKConfiguration) }{{end}}
      def sdk_init(config:)
        raise 'Client is required' if config.client.nil?

        @client = config.client
        config
      end

      {{if sorbetEnabled}}sig do
        override.params(
          hook_ctx: BeforeRequestHookContext,
          request: Faraday::Request
        ).returns(Faraday::Request)
      end{{end}}
      def before_request(hook_ctx:, request:)
        return request if hook_ctx.oauth2_scopes.nil?

        credentials = get_credentials(hook_ctx)
        return request if credentials.nil?

        # If user provided a pre-fetched access token, use it directly
        if credentials.is_a?(OAuth2AccessTokenCredentials)
          request.headers['Authorization'] = "Bearer #{credentials.access_token}"
          return request
        end

        # Otherwise fetch/cache token via credentials
        scopes = hook_ctx.oauth2_scopes || []
        session = get_existing_session(credentials.session_key, scopes)

        if session.nil?
          session = do_token_request(credentials, scopes)
          store_session(credentials.session_key, scopes, session)
        end

        request.headers['Authorization'] = "Bearer #{session.access_token}"
        request
      end

      {{if sorbetEnabled}}sig do
        override.params(
          error: T.nilable(StandardError),
          hook_ctx: AfterErrorHookContext,
          response: T.nilable(Faraday::Response)
        ).returns(T.nilable(Faraday::Response))
      end{{end}}
      def after_error(error:, hook_ctx:, response:)
        return response if hook_ctx.oauth2_scopes.nil?

        # We don't want to refresh the token if the error is not related to the token
        return response unless error.nil?

        credentials = get_credentials(hook_ctx)
        return response if credentials.nil?

        # Don't invalidate if user provided a pre-fetched token
        return response if credentials.is_a?(OAuth2AccessTokenCredentials)

        if !response.nil? && response.status == 401
          scopes = hook_ctx.oauth2_scopes || []
          scope_key = get_scope_key(scopes)
          remove_session(credentials.session_key, scope_key)
        end

        response
      end

      private

{{$credentialAccess := getOAuth2PasswordSecurityAccess}}
      {{if sorbetEnabled}}sig { params(hook_ctx: HookContext).returns(T.untyped) }{{end}}
      def get_credentials(hook_ctx)
        source = hook_ctx.security_source
        return nil if source.nil?

        security = source.call

        {{templateOAuth2PasswordSecurityAccess $credentialAccess | indent 8 | trim}}
      end

{{range $access := $credentialAccess}}
{{- $id := $access.id}}{{if eq $id ""}}{{$id = "global"}}{{end}}
      {{if sorbetEnabled}}sig { params(hook_ctx: HookContext, security: T.untyped).returns(T.untyped) }{{end}}
      def {{sanitizePrivateMethodName (print "get_credentials_" $id )}}(hook_ctx, security)
        {{templateOAuth2PasswordSecurityAccessFunction $access.securityType | indent 8 | trim}}
      end
{{end}}

      {{if sorbetEnabled}}sig { params(base_url: String, token_url: String).returns(String) }{{end}}
      def resolve_token_endpoint(base_url, token_url)
        parsed = URI.parse(token_url)
        return token_url if parsed.host

        base = base_url.chomp('/')
        URI.join("#{base}/", token_url).to_s
      end

      {{if sorbetEnabled}}sig { params(credentials: OAuth2PasswordCredentials, scopes: T::Array[String]).returns(OAuth2PasswordSession) }{{end}}
      def do_token_request(credentials, scopes)
        payload = {
          'grant_type' => 'password',
          'username' => credentials.username,
          'password' => credentials.password
        }

        payload['client_id'] = credentials.client_id unless credentials.client_id.nil?
        payload['client_secret'] = credentials.client_secret unless credentials.client_secret.nil?
        payload['scope'] = scopes.join(' ') unless scopes.empty?

        response = @client.post(credentials.token_endpoint) do |req|
          req.headers['Content-Type'] = 'application/x-www-form-urlencoded'
          req.body = URI.encode_www_form(payload)
        end

        unless response.status >= 200 && response.status < 300
          error_msg = nil
          begin
            error_data = JSON.parse(response.body)
            if error_data.is_a?(Hash)
              error_msg = error_data['error_description'] || error_data['error']
            end
          rescue JSON::ParserError
            # Non-JSON error response, fall back to generic message
          end
          raise error_msg || "Unexpected status code #{response.status} from token endpoint"
        end

        response_data = JSON.parse(response.body)

        raise response_data.fetch('error', 'Unknown error from token endpoint') if response_data.is_a?(Hash) && response_data.key?('error')
        raise 'Unexpected token type from token endpoint' unless response_data.fetch('token_type', '').downcase == 'bearer'

        expires_at = nil
        if response_data.key?('expires_in')
          expires_at = Time.now.to_i + response_data['expires_in'].to_i
        end

        OAuth2PasswordSession.new(
          access_token: response_data['access_token'],
          scopes: scopes,
          expires_at: expires_at
        )
      end

      {{if sorbetEnabled}}sig { params(scopes: T::Array[String]).returns(String) }{{end}}
      def get_scope_key(scopes)
        return '' if scopes.empty?

        scopes.sort.join('&')
      end

      {{if sorbetEnabled}}sig { params(session_key: String, scopes: T::Array[String], session: OAuth2PasswordSession).void }{{end}}
      def store_session(session_key, scopes, session)
        scope_key = get_scope_key(scopes)
        lock = get_client_lock(session_key)
        lock.synchronize do
          @sessions[session_key] ||= {}
          @sessions[session_key][scope_key] = session
        end
      end

      {{if sorbetEnabled}}sig { params(session_key: String, scope_key: String).void }{{end}}
      def remove_session(session_key, scope_key)
        lock = get_client_lock(session_key)
        lock.synchronize do
          if @sessions.key?(session_key) && @sessions[session_key].key?(scope_key)
            @sessions[session_key].delete(scope_key)
            @sessions.delete(session_key) if @sessions[session_key].empty?
          end
        end
      end

      {{if sorbetEnabled}}sig { params(session_key: String, required_scopes: T::Array[String]).returns(T.nilable(OAuth2PasswordSession)) }{{end}}
      def get_existing_session(session_key, required_scopes)
        scope_key = get_scope_key(required_scopes)
        expired_keys = []
        result = {{sorbetLet "nil" "T.untyped"}}

        lock = get_client_lock(session_key)
        lock.synchronize do
          return nil unless @sessions.key?(session_key)

          client_sessions = @sessions[session_key]

          # Check for exact scope match first
          if client_sessions.key?(scope_key)
            exact_match = client_sessions[scope_key]
            if token_expired?(exact_match.expires_at)
              expired_keys << scope_key
            else
              result = exact_match
            end
          end

          # If no exact match, look for a superset match
          if result.nil?
            found = {{sorbetLet "false" "T::Boolean"}}
            client_sessions.each do |key, session|
              if token_expired?(session.expires_at)
                expired_keys << key
              elsif !found && required_scopes.all? { |s| session.scopes.include?(s) }
                result = session
                found = true
              end
            end
          end

          # Clean up expired sessions
          expired_keys.each { |key| client_sessions.delete(key) }

          # Clean up empty session maps
          @sessions.delete(session_key) if @sessions.key?(session_key) && @sessions[session_key].empty?
        end

        result
      end

      {{if sorbetEnabled}}sig { params(expires_at: T.nilable(Integer)).returns(T::Boolean) }{{end}}
      def token_expired?(expires_at)
        !expires_at.nil? && Time.now.to_i + 60 >= expires_at
      end

      {{if sorbetEnabled}}sig { params(key: String).returns(Mutex) }{{end}}
      def get_client_lock(key)
        @lock.synchronize do
          @client_locks[key] ||= Mutex.new
        end
      end
    end
  end
end
