{{- if isFeatureUsed "jsonlResponses"}}
{{typedDirective}}
# frozen_string_literal: true

require 'stringio'
{{sorbetImport}}

module {{sanitizeModuleName .Global.Config.Module}}
  module Utils
    class JsonLStream
      include Enumerable
      {{sorbetTSig}}

      MESSAGE_BOUNDARIES = ["}\n", "}\r\n"].freeze

      {{if sorbetEnabled}}sig { params(response: Faraday::Response, decoder: T.proc.params(raw: String).returns(T.untyped), sdk_ref: T.untyped).void }{{end}}
      def initialize(response, decoder, sdk_ref: nil)
        @response = response
        @decoder = decoder
        @sdk_ref = sdk_ref
        @closed = false
      end

      {{if sorbetEnabled}}sig { override.params(block: T.nilable(T.proc.params(event: T.untyped).void)).returns(T.untyped) }{{end}}
      def each(&block)
        return enum_for(:each) unless block
        return if @closed

        stream_jsonl_events(&block)
      ensure
        close
      end

      {{if sorbetEnabled}}sig { void }{{end}}
      def close
        return if @closed

        @closed = true
        body = @response.env.body
        body.close if body.respond_to?(:close)
        thread = @response.env[:stream_thread]
        if thread&.alive?
          thread.kill
          thread.join(0.1)
        end
      end

      private

      {{if sorbetEnabled}}sig { params(block: T.proc.params(event: T.untyped).void).void }{{end}}
      def stream_jsonl_events(&block)
        buffer = {{sorbetLet "String.new(encoding: Encoding::BINARY)" "String"}}
        position = 0
        body = @response.env.body
        body = StringIO.new(body) if body.is_a?(String)

        read_chunks(body) do |chunk|
          chunk = chunk.b unless chunk.encoding == Encoding::BINARY
          buffer << chunk

          i = position
          while i < buffer.length
            seq = detect_boundary(buffer, i)
            if seq.nil?
              i += 1
              next
            end

            block_data = {{sorbetMust "buffer[position..i]"}}
            position = i + seq.length
            unless block_data.empty?
              event = @decoder.call(block_data.force_encoding('UTF-8'))
              yield event
            end
            i = position
          end

          if position.positive?
            buffer = {{sorbetMust "buffer[position..]"}}
            position = 0
          end
        end

        unless buffer.empty? && position.zero?
          remaining = {{sorbetMust "buffer[position..]"}}
          unless remaining.empty?
            event = @decoder.call(remaining.force_encoding('UTF-8'))
            yield event
          end
        end

        stream_error = @response.env[:stream_error]
        raise stream_error unless stream_error.nil?
      end

      {{if sorbetEnabled}}sig { params(body: T.untyped, block: T.proc.params(chunk: String).void).void }{{end}}
      def read_chunks(body, &block)
        if body.respond_to?(:each)
          body.each(&block)
        elsif body.respond_to?(:read)
          while (chunk = body.read(8192))
            block.call(chunk)
          end
        else
          block.call(body.to_s)
        end
      end

      {{if sorbetEnabled}}sig { params(buffer: String, pos: Integer).returns(T.nilable(String)) }{{end}}
      def detect_boundary(buffer, pos)
        return nil unless buffer[pos] == '}'

        MESSAGE_BOUNDARIES.each do |boundary|
          if buffer[pos, boundary.length] == boundary
            return boundary
          end
        end
        nil
      end
    end
  end
end
{{- end }}
