      attr_accessor :max_elapsed_time

      {{if sorbetEnabled}}sig { returns(T.nilable(::Integer)) }{{end}}
      attr_accessor :max_interval

      {{if sorbetEnabled}}sig do
        params(
          exponent: T.nilable(::Float),
          initial_interval: T.nilable(::Integer),
          max_elapsed_time: T.nilable(::Integer),
          max_interval: T.nilable(::Integer)
        ).void
      end{{end}}
      def initialize(exponent: nil, initial_interval: nil, max_elapsed_time: nil, max_interval: nil)
        @exponent = {{ sorbetLet "exponent" "T.nilable(::Float)" }}
        @initial_interval = {{ sorbetLet "initial_interval" "T.nilable(::Integer)" }}
        @max_elapsed_time = {{ sorbetLet "max_elapsed_time" "T.nilable(::Integer)" }}
        @max_interval = {{ sorbetLet "max_interval" "T.nilable(::Integer)" }}
      end
