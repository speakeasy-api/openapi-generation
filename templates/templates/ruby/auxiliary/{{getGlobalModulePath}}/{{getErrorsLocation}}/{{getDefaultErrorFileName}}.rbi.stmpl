{{- $responseFormat := getResponseFormat -}}
{{- $module := getModuleFQN (getScopePath "errors")}}
{{typedDirective}}
# frozen_string_literal: true

class {{$module}}::{{sanitizeClassName .Global.Config.DefaultErrorName}}
  extend ::Crystalline::MetadataFields::ClassMethods
end

class {{$module}}::{{sanitizeClassName .Global.Config.DefaultErrorName}}
  {{if eq $responseFormat "envelope-http"}}
  def request(); end
  def request=(request); end
  def response(); end
  def response=(response); end
  {{- else}}
  def body(); end
  def body=(body); end
  def raw_response(); end
  def raw_response=(raw_response); end
  {{- end}}
  def status_code(); end
  def status_code=(status_code); end
end
