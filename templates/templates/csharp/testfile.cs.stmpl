{{- recurse 1 -}}
{{- $testGroup := .Local.Name -}}
{{- $class := (getTestSimpleClassName $testGroup) -}}
#nullable enable
{{genTestFileImports .Local}}
{{- if not isCsharpV2}}
{{- /* v2 Tests.csproj excludes Newtonsoft at compile time. */}}
using Newtonsoft.Json;
{{- end}}
using System;
using System.Collections.Generic;
using System.Linq;
using System.Net;
using System.Numerics;
using System.Threading.Tasks;
using Xunit;

public class {{$class}}
{
{{- range .Local.Tests}}
{{templateString "test.cs.stmpl" (dict "TestGroup" $testGroup "Test" .)}}
{{- end}}
}
