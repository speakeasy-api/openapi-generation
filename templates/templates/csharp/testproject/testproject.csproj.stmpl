    <TargetFramework>{{getExecutableFramework}}</TargetFramework>
    <Nullable>enable</Nullable>
    <StartupObject>TestProject.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
{{templateSDKDependencies}}
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="{{getUsageSourceFilePath .Global.Config.TestProject.SourceDir}}"/>
  </ItemGroup>

</Project>
