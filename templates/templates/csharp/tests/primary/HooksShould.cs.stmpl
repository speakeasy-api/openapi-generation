using Xunit;
using Openapi;
using Openapi.Hooks;
using Openapi.Models.Shared;
using Openapi.Models.Operations;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using System.Net;

public class HooksShould
{
    [Fact]
    public async Task TestHooks()
    {
        CommonHelpers.RecordTest("test-hooks");

        var sdk = new SDK(serverUrl: Helpers.HttpBinUrl);

        var res = await sdk.Hooks.TestHooksAsync("someInitialValue");
        Assert.NotNull(res);
        Assert.Equal(HttpStatusCode.OK, res.HttpMeta.Response.StatusCode);
        Assert.Equal("overriddenParam", res.Res.Args.SomeParam);
        Assert.Equal("added by client", res.Res.Headers.ClientLevelHeader);
        Assert.Equal("some-key", res.Res.Headers.IdempotencyKey);
        Assert.Equal($"{Helpers.HttpBinUrl}/anything/hooks?someParam=overriddenParam", res.Res.Url);
    }

    [Fact]
    public async Task TestHooksAfterResponse()
    {
        CommonHelpers.RecordTest("test-hooks-after-response");

        var sdk = new SDK(serverUrl: Helpers.HttpBinUrl);

        var error = await Assert.ThrowsAsync<Exception>(
            async () => await sdk.Hooks.TestHooksAfterResponseAsync()
        );

        //   this error was raised from within SDKHooks.cs and is therefore wrapped in an
        //   error message to inform the client that their hook definition is incorrect
        Assert.Equal("An error occurred while calling AfterSuccessAsync hook.", error.Message);
        Assert.Equal("validation failed", error.InnerException?.Message);
    }

    [Fact]
    public async Task TestHooksError()
    {
        CommonHelpers.RecordTest("test-hooks-error");

        var sdk = new SDK(serverUrl: Helpers.HttpBinUrl);

        var error = await Assert.ThrowsAsync<Exception>(
            async () => await sdk.Hooks.TestHooksErrorAsync()
        );

        //   this error was returned normally by the AfterError hook and raised from inside the method
        //   it does not get wrapped with more context since it is directed at the end user.
        Assert.Equal("special test error case", error.Message);
    }

    [Fact]
    public async Task TestHooksAuthorizationHeaderModification()
    {
        CommonHelpers.RecordTest("hooks-authorization-header-modification");

        var sdk = new SDK(serverUrl: Helpers.HttpBinUrl, security: new Security() { ApiKeyAuth = "Bearer testToken" });

        var res = await sdk.Hooks.AuthorizationHeaderModificationAsync();

        Assert.NotNull(res);
        Assert.Equal(HttpStatusCode.OK, res.HttpMeta.Response.StatusCode);
        Assert.True(res.Token.Authenticated);
        Assert.Equal("testToken modified", res.Token.Token);
    }

    [Fact]
    public async Task TestHooksCustomUserAgent()
    {
        CommonHelpers.RecordTest("hooks-custom-user-agent");

        var sdk = new SDK(serverUrl: Helpers.HttpBinUrl);

        var res = await sdk.Hooks.HooksCustomUserAgentAsync();

        Assert.NotNull(res);
        Assert.Equal(HttpStatusCode.OK, res.HttpMeta.Response.StatusCode);
        var headers = res.CustomUserAgentEcho.Headers;
        Assert.Equal("acme-corp/{{.Global.Config.SDKVersion}} acme-corp/" + Environment.Version, headers["User-Agent"]);
        Assert.Equal("{{.Global.Config.GenVersion}}", headers["X-Test-Gen-Version"]);
        Assert.Equal("{{.Global.Config.DocVersion}}", headers["X-Test-Doc-Version"]);
        Assert.Equal("{{.Global.Config.SDKVersion}}", headers["X-Test-Init-Sdk-Version"]);
    }

    [Fact]
    public async Task TestClientCredentialsOptionSuccessfullyAuthenticates()
    {
        CommonHelpers.RecordTest("hooks-client-credentials-option-success");

        var log = new List<CommonHelpers.RequestLogEntry>();
        var sdk = new SDK(
            serverUrl: Helpers.HttpBinUrl,
            client: new CommonHelpers.RequestRecorderClient(log),
            security: new Security()
            {
                ClientCredentials= new SchemeClientCredentials()
                {
                    ClientID = "speakeasy-sdks",
                    ClientSecret = $"supersecret-{CommonHelpers.RandSeq(10)}",
{{- range $f := collectClientCredentialsAdditionalFields }}
                    {{ sanitizeFieldName (originalFieldName $f) }} = "",
{{- end }}
                }
            }
        );

        var res = await sdk.Hooks.AuthenticatedRequestGlobalSecurityAsync(null);
        Assert.NotNull(res);
        Assert.Equal(HttpStatusCode.OK, res.HttpMeta.Response.StatusCode);

        // The requested token is still valid, so it should be reused.
        res = await sdk.Hooks.AuthenticatedRequestGlobalSecurityAsync(null);
        Assert.NotNull(res);
        Assert.Equal(HttpStatusCode.OK, res.HttpMeta.Response.StatusCode);
        Assert.False(res.HttpMeta.Request.Headers.Contains("clientId"));
        Assert.False(res.HttpMeta.Request.Headers.Contains("clientSecret"));

        // Checking that only a single token request was made
        var tokenURL = "/clientcredentials/token?expires_in=90";
        var tokenRequests = log.Where(e => e.RequestUri?.PathAndQuery == tokenURL && e.RequestBody.Contains("scope=read+write")).ToList();
        Assert.Single(tokenRequests);
    }

    [Fact]
    public async Task TestClientCredentialsOptionSuccessfullyAuthenticatesWithAltTokenURL()
    {
        CommonHelpers.RecordTest("hooks-client-credentials-option-success-alt-token-url");

        var log = new List<CommonHelpers.RequestLogEntry>();
        var tokenURL = "/clientcredentials/alt/token";
        var sdk = new SDK(
            serverUrl: Helpers.HttpBinUrl,
            client: new CommonHelpers.RequestRecorderClient(log),
            security: new Security()
            {
                ClientCredentials = new SchemeClientCredentials()
                {
                    ClientID = "speakeasy-sdks",
                    ClientSecret = $"supersecret-{CommonHelpers.RandSeq(10)}",
                    TokenURL = tokenURL,
                    Scopes = new List<string> { "alt:one", ClientCredentialsOAuth2Scope.AltTwo.Value() },
{{- range $f := collectClientCredentialsAdditionalFields }}
                    {{ sanitizeFieldName (originalFieldName $f) }} = "",
{{- end }}
                }
            }
        );

        var res = await sdk.Hooks.AuthenticatedRequestGlobalSecurityAsync(null);
        Assert.NotNull(res);
        Assert.Equal(HttpStatusCode.OK, res.HttpMeta.Response.StatusCode);

        // The token received is already expired so another one should be requested.
        res = await sdk.Hooks.AuthenticatedRequestGlobalSecurityAsync(null);
        Assert.NotNull(res);
        Assert.Equal(HttpStatusCode.OK, res.HttpMeta.Response.StatusCode);

        var tokenRequests = log.Where(e => e.RequestUri?.PathAndQuery == tokenURL && e.RequestBody.Contains("scope=alt%3Aone+alt%3Atwo")).ToList();
        Assert.Equal(2, tokenRequests.Count());
    }

    [Fact]
    public void TestHooksAvailableOAuth2Scopes()
    {
        CommonHelpers.RecordTest("hooks-available-oauth2-scopes");

        // Enum -> String
        Assert.Equal("read", ClientCredentialsOAuth2Scope.Read.Value());
        Assert.Equal("models:read", OAuth2Scope.ModelsRead.Value());

        // String -> Enum
        // Note cannot use `"scope".ToEnum()` due to ambiguity with `Openapi.ServerSomethingExtension.ToEnum()`
        Assert.Equal(ClientCredentialsOAuth2Scope.Write, ClientCredentialsOAuth2ScopeExtension.ToEnum("write"));
        Assert.Equal(OAuth2Scope.StoreManage, OAuth2ScopeExtension.ToEnum("store_manage"));

        // Unknown values
        var ex = Assert.Throws<Exception>(() => OAuth2ScopeExtension.ToEnum("unknown"));
        Assert.Equal("Unknown value unknown for enum OAuth2Scope", ex.Message);
    }
}
