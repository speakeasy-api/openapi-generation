#nullable enable
using System.Collections.Generic;
using Newtonsoft.Json;
using No_Security.API.Models.Shared;
using No_Security.API.Utils;
using Xunit;

// Round-trip tests for `optionalNullableScope: writable-models`: only models the
// SDK can send carry OptionalNullable<T>. Response-only models keep plain T? and
// still read an explicit JSON null as null. The `all` scope is pinned by the
// primary variant tests.
public class OptionalNullableScopeShould
{
    [Fact]
    public void ResponseOnlyModel_KeepsPlainNullable()
    {
        var property = typeof(Paging).GetProperty(nameof(Paging.NextCursor))!;
        Assert.Equal(typeof(string), property.PropertyType);
    }

    [Fact]
    public void ResponseOnlyModel_ReadsExplicitNullUnderIgnoreSetting()
    {
        var paging = new Paging { NextCursor = "before" };
        JsonConvert.PopulateObject(
            "{\"next_cursor\": null}",
            paging,
            new JsonSerializerSettings { NullValueHandling = NullValueHandling.Ignore }
        );
        Assert.Null(paging.NextCursor);
    }

    [Fact]
    public void WritableModel_WrapsOptionalNullableFields()
    {
        var property = typeof(ObjectWithOptionalNullableFields).GetProperty(
            nameof(ObjectWithOptionalNullableFields.OptNullBool)
        )!;
        Assert.Equal(typeof(OptionalNullable<bool?>), property.PropertyType);

        var model = new ObjectWithOptionalNullableFields { OptNullBool = true };
        var json = JsonConvert.SerializeObject(model, Utilities.GetDefaultJsonSerializerSettings());
        Assert.Contains("\"optNullBool\":true", json);
        Assert.DoesNotContain("optNullArr", json);
    }

    [Fact]
    public void WritableModel_UnwrapsImplicitly()
    {
        var model = new ObjectWithOptionalNullableFields { OptNullBool = true };

        bool? set = model.OptNullBool;
        Assert.True(set);
        Assert.True(IsTrue(model.OptNullBool));

        List<string>? absent = model.OptNullArr;
        Assert.Null(absent);

        model.OptNullBool = null;
        bool? explicitNull = model.OptNullBool;
        Assert.Null(explicitNull);
        Assert.True(model.OptNullBool.IsNull);
    }

    // Both implicit conversions exist, so a wrapped field beside a bare T in a
    // conditional or an inferred generic argument is ambiguous; these are the
    // forms that compile.
    [Fact]
    public void WritableModel_DisambiguatesWithExplicitTypes()
    {
        var model = new ObjectWithOptionalNullableFields { OptNullBool = true };
        var flip = false;

        bool? viaCast = flip ? false : (bool?)model.OptNullBool;
        Assert.True(viaCast);

        bool? viaValue = flip ? false : model.OptNullBool.Value;
        Assert.True(viaValue);

        Assert.Equal<bool?>(true, model.OptNullBool);
        Assert.Equal(true, model.OptNullBool.ValueOrDefault);
    }

    private static bool IsTrue(bool? value) => value == true;
}
