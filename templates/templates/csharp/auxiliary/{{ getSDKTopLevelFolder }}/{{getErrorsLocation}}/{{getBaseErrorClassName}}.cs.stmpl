{{- $className := getBaseErrorClassName -}}
{{- $isErrorEnvelope := eq getResponseFormat "envelope-http"}}
#nullable enable
namespace {{getScopeNamespace "errors" true}}
{
    using System;
    using System.Net.Http;
    using System.Net.Http.Headers;

    /// <summary>
    /// Base Exception for API Errors.
    /// </summary>
    public class {{$className}} : Exception
    {
        /// <summary>
        /// Error Message
        /// </summary>
        public override string Message { get; }

    {{- if $isErrorEnvelope }}

        /// <summary>
        /// HTTP Request
        /// </summary>
        public HttpRequestMessage Request { get; }

        /// <summary>
        /// HTTP Response
        /// </summary>
        public HttpResponseMessage Response { get; }
    {{- else}}

        /// <summary>
        /// HTTP status code
        /// </summary>
        public int StatusCode { get; }

        /// <summary>
        /// HTTP headers
        /// </summary>
        public HttpResponseHeaders Headers { get; }

        /// <summary>
        /// HTTP content type
        /// </summary>
        public string? ContentType { get; }

        /// <summary>
        /// Raw response
        /// </summary>
        public HttpResponseMessage RawResponse { get; }
    {{- end}}

        /// <summary>
        /// HTTP response body
        /// </summary>
        public string Body { get; }

    {{- if $isErrorEnvelope }}

        public {{$className}}(
            string message,
            HttpRequestMessage request,
            HttpResponseMessage response,
            string body
        ) : this(message, request, response, body, null) {}

        public {{$className}}(
            string message,
            HttpRequestMessage request,
            HttpResponseMessage response,
            string body,
            Exception? innerException
        ) : base(message, innerException)
        {
            Message = $"{message.TrimEnd('.')}. Body: {body}.";
            Request = request;
            Response = response;
            Body = body;
        }
    {{- else}}

        public {{$className}}(
            string message,
            HttpResponseMessage rawResponse,
            string body
        ) : this(message, rawResponse, body, null) {}

        public {{$className}}(
            string message,
            HttpResponseMessage rawResponse,
            string body,
            Exception? innerException
        ) : base(message, innerException)
        {
            Message = message;
            RawResponse = rawResponse;
            StatusCode = (int)rawResponse.StatusCode;
            Headers = rawResponse.Headers;
            ContentType = rawResponse.Content{{if isNetstandard2}}?{{end}}.Headers.ContentType?.MediaType;
            Body = body;
        }
    {{- end}}

        /// <summary>
        /// Detailed Error Message
        /// </summary>
        public override string ToString()
        {
            var innerMessage = string.IsNullOrEmpty(InnerException?.Message) ? "" : $"\n{InnerException.Message}";
    {{- if $isErrorEnvelope}}
            return $"Status: {Response.StatusCode}. {Message}{innerMessage}";
    {{- else}}
            return $"Status: {StatusCode}. {Message}{innerMessage}";
    {{- end}}
        }

    }
}
