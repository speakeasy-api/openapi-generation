#nullable enable
namespace {{getScopeNamespace "utils"}}.Sse
{
    using System;
    using System.Collections.Generic;
    using System.IO;
    using System.Text;
    using System.Threading;
    using System.Threading.Tasks;
    using Newtonsoft.Json;
    using Newtonsoft.Json.Serialization;

{{- if schemaValidationLenient}}
    /// <summary>
    /// Internal signal that a frame could not be constructed
    /// and should be skipped without aborting the stream.
    /// </summary>
    internal sealed class SseFrameSkipException : Exception {}
{{- end}}

    /// <summary>
    /// Protocol-agnostic event stream reader with Task-based Next() method.
    /// This reader is loosely coupled with the parser, allowing for easy replacement
    /// of parsing logic for different streaming protocols beyond SSE.
    /// </summary>
    /// <typeparam name="T">The type of events to read from the stream.</typeparam>
    public class EventStream<T> : IDisposable, IAsyncDisposable, IAsyncEnumerable<T>
    {
        private readonly StreamReader _reader;
        private readonly SseStreamParser _parser;
        private readonly bool _dataRequired;
        private bool _disposed = false;
        private bool _streamEnded = false;

        /// <summary>
        /// Initializes a new instance of the EventStream class.
        /// The parser can be easily replaced to support different streaming protocols.
        /// </summary>
        /// <param name="stream">The stream containing event data.</param>
        /// <param name="sentinel">Optional sentinel value that indicates end of stream. eg: "[DONE]".</param>
        /// <param name="dataRequired">Whether to skip events without data lines.</param>
        /// <remarks>The caller retains ownership of <paramref name="stream"/>.</remarks>
        public EventStream(Stream stream, string? sentinel = null, bool dataRequired = true)
            : this(stream, sentinel, dataRequired, leaveOpen: true)
        {
        }

        internal EventStream(Stream stream, string? sentinel, bool dataRequired, bool leaveOpen)
        {
            if (stream == null)
                throw new ArgumentNullException(nameof(stream));

            _reader = new StreamReader(stream, Encoding.UTF8, {{if isNetstandard2}}detectEncodingFromByteOrderMarks: true, bufferSize: 1024, {{end}}leaveOpen: leaveOpen);
            _parser = new SseStreamParser(sentinel);
            _dataRequired = dataRequired;
        }

        /// <summary>
        /// Gets the next event data from the stream using the configured parser.
        /// Returns null when the stream has ended or a sentinel event is reached.
        /// </summary>
        {{if .Global.Config.EnableCancellationToken}}/// <param name="cancellationToken">Optional cancellation token to cancel the read operation.</param>
        {{end}}/// <returns>The next event data of type T, or null if the stream has ended.</returns>
        public async Task<T?> Next({{if .Global.Config.EnableCancellationToken}}CancellationToken? cancellationToken = null{{end}})
        {
            var (_, value) = await ReadNext({{if .Global.Config.EnableCancellationToken}}cancellationToken{{end}}).ConfigureAwait(false);
            return value;
        }

        private async Task<(bool HasValue, T? Value)> ReadNext({{if .Global.Config.EnableCancellationToken}}CancellationToken? cancellationToken = null{{end}})
        {
            if (_disposed || _streamEnded)
                return (false, default(T));

            try
            {
                string? line;
                while ((line = await _reader.ReadLineAsync({{if isReadLineAsyncCancellable}}cancellationToken ?? CancellationToken.None{{end}}).ConfigureAwait(false)) != null)
                {
                    var sseEvent = _parser.Parse(line);
                    if (sseEvent != null)
                    {
                        // Check for end of stream
                        if (sseEvent.IsEndOfStream)
                        {
                            _streamEnded = true;
                            return (false, default(T));
                        }

                        // Skip data-less events when data is required
                        if (_dataRequired && sseEvent.Data == null)
                        {
                            continue;
                        }

{{- if schemaValidationLenient}}

                        try
                        {
                            return (true, AsType(sseEvent));
                        }
                        catch (SseFrameSkipException)
                        {
                            continue;
                        }
{{- else}}

                        return (true, AsType(sseEvent));
{{- end}}
                    }
                }

                // If we reach here, the stream has ended
                // Check if the parser has any remaining data to process
                var finalEvent = _parser.Parse(null);
                if (finalEvent != null && !finalEvent.IsEndOfStream)
                {
                    // Skip data-less final events when data is required
                    if (_dataRequired && finalEvent.Data == null)
                    {
                        _streamEnded = true;
                        return (false, default(T));
                    }
                    _streamEnded = true;
{{- if schemaValidationLenient}}
                    try
                    {
                        return (true, AsType(finalEvent));
                    }
                    catch (SseFrameSkipException)
                    {
                        return (false, default(T));
                    }
{{- else}}
                    return (true, AsType(finalEvent));
{{- end}}
                }

                _streamEnded = true;
                return (false, default(T));
            }
        {{- if .Global.Config.EnableCancellationToken}}
            catch (OperationCanceledException)
            {
                _streamEnded = true;
                throw;
            }
        {{- end}}
            catch (Exception)
            {
                _streamEnded = true;
                return (false, default(T));
            }
        }


        /// <summary>
        /// Disposes the EventStream and releases its resources. SDK-owned response streams are closed;
        /// streams passed to the public constructor remain open.
        /// </summary>
        public void Dispose()
        {
            if (!_disposed)
            {
                _reader?.Dispose();
                _disposed = true;
            }
        }

        /// <summary>
        /// Converts a raw SSE event to the target type T.
        /// </summary>
        /// <param name="sseEvent">The raw SSE event with string data.</param>
        /// <returns>The deserialized data of type T.</returns>
        private static T? AsType(SseEvent sseEvent)
        {
            try
            {
                // First try to create JSON with the assumption that data is JSON
                var json = CreateEventJson(sseEvent, false);
                return ResponseBodyDeserializer.Deserialize<T>(json);
            }
{{- if schemaValidationLenient}}
  {{- /* Lenient mode catches every deserialization failure, not just JsonException:
         the generated union deserializer throws InvalidOperationException and other
         non-JsonException types on closed-union mismatches. */}}
            catch (Exception)
{{- else}}
            catch (JsonException)
{{- end}}
            {
                try
                {
                    // Retry with the assumption that data field is plain text
                    var json = CreateEventJson(sseEvent, true);
                    return ResponseBodyDeserializer.Deserialize<T>(json);
                }
                catch ({{if schemaValidationStrict}}JsonException ex{{else}}Exception{{end}})
                {
                    // Final fallback: if T is string, return the raw data
                    if (typeof(T) == typeof(string))
                    {
                        return (T)(object)(sseEvent.Data ?? string.Empty);
                    }
{{- if schemaValidationLenient}}
                    if (ResponseBodyDeserializer.TryConstructUnvalidated<T>(CreateEventJson(sseEvent, false), out var lenientFrame))
                    {
                        return lenientFrame;
                    }
                    throw new SseFrameSkipException();
{{- else}}
                    throw new InvalidOperationException(
                        $"Failed to deserialize SSE event (event={sseEvent.Event ?? "unknown"}) " +
                        $"as {typeof(T).Name}. Data: {Truncate(sseEvent.Data, 200)}", ex);
{{- end}}
                }
            }
        }

        /// <summary>
        /// Creates a JSON representation of the SSE event for deserialization.
        /// </summary>
        /// <param name="sseEvent">The raw SSE event.</param>
        /// <param name="dataIsPlainText">Whether to treat the data field as plain text.</param>
        /// <returns>JSON string representation of the event.</returns>
        private static string CreateEventJson(SseEvent sseEvent, bool dataIsPlainText)
        {
            object? dataValue;

            if (dataIsPlainText || string.IsNullOrWhiteSpace(sseEvent.Data))
            {
                dataValue = sseEvent.Data;
            }
            else
            {
                // Embed data as raw JSON, preserving null, objects, arrays, etc.
                // Using JRaw avoids the ?? fallback that conflates JSON null with parse failure,
                // and prevents NullValueHandling.Ignore from stripping data:null.
                dataValue = new Newtonsoft.Json.Linq.JRaw(sseEvent.Data);
            }

            var eventObject = new
            {
                Id = sseEvent.Id,
                Event = sseEvent.Event,
                Data = dataValue,
                Retry = sseEvent.Retry
            };

            return JsonConvert.SerializeObject(eventObject, new JsonSerializerSettings
            {
                ContractResolver = new CamelCasePropertyNamesContractResolver(),
                NullValueHandling = NullValueHandling.Ignore
            });
        }

        private static string Truncate(string? value, int maxLength)
        {
            if (value == null) return "(null)";
            return value.Length <= maxLength ? value : value.Substring(0, maxLength) + "...";
        }

        /// <summary>
        /// Indicates whether the event stream has been closed or the end of stream has been reached.
        /// </summary>
        /// <returns>true if the stream has been disposed or the end of the stream has been reached</returns>
        public bool IsClosed => _disposed || _streamEnded;

        /// <summary>
        /// Returns an enumerator that iterates asynchronously through the stream.
        /// </summary>
        /// <remarks>
        /// <c>await foreach</c> disposes this <see cref="EventStream{T}"/> when iteration completes or exits
        /// through <c>break</c>, cancellation, or an exception. After disposal, the stream
        /// cannot be resumed or replayed. Concurrent enumeration is not supported.
        /// </remarks>
{{- if .Global.Config.EnableCancellationToken}}
        /// <param name="cancellationToken">A <see cref="CancellationToken"/> that may be used to cancel the asynchronous iteration.</param>
{{- end}}
        /// <returns>An enumerator that can be used to iterate asynchronously through the stream.</returns>
        public async IAsyncEnumerator<T> GetAsyncEnumerator(CancellationToken cancellationToken = default)
        {
            try
            {
                while (!IsClosed)
                {
                    cancellationToken.ThrowIfCancellationRequested();
                    var (hasValue, value) = await ReadNext({{if .Global.Config.EnableCancellationToken}}cancellationToken{{end}}).ConfigureAwait(false);
                    if (!hasValue)
                    {
                        yield break;
                    }
                    yield return value!;
                }
            }
            finally
            {
                Dispose();
            }
        }

        /// <summary>
        /// Asynchronously releases all resources used by the EventStream.
        /// </summary>
        /// <returns>A task that represents the asynchronous dispose operation.</returns>
        public ValueTask DisposeAsync()
        {
            Dispose();
            return default;
        }
    }
}
