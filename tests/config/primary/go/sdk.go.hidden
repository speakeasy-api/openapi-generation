func (s *SDK) CustomHealthCheck(ctx context.Context) (bool, error) {
	res, err := s.Health.Check(ctx)
	if err != nil {
		return false, err
	}

	return res.HTTPMeta.Response.StatusCode == http.StatusOK, nil
}

