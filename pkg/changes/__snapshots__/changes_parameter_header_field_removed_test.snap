openapi: 3.0.0
info:
  title: Test API
  version: 1.0.0
paths:
  /users:
    get:
      operationId: getUser
      parameters:
        - name: X-Request-ID
          in: header
          schema:
            type: string
      responses:
        '200':
          description: Success
```

