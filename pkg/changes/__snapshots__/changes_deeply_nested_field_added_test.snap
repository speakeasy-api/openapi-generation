openapi: 3.0.0
info:
  title: Test API
  version: 1.0.0
paths:
  /users:
    post:
      operationId: createUser
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                profile:
                  type: object
                  properties:
                    personal:
                      type: object
                      properties:
                        details:
                          type: object
                          properties:
                            contact:
                              type: object
                              properties:
                                primary:
                                  type: object
                                  properties:
                                    email:
                                      type: string
                                    phone:
                                      type: string
