paths:
  /messages:
    get:
      operationId: getMessage
      responses:
        '200':
          description: Success
          content:
            application/json:
              schema:
                type: object
                properties:
                  content:
                    oneOf:
                      - $ref: '#/components/schemas/TextMessage'
                      - $ref: '#/components/schemas/ImageMessage'
                    discriminator:
                      propertyName: type
                      mapping:
                        text: '#/components/schemas/TextMessage'
                        image: '#/components/schemas/ImageMessage'
components:
  schemas:
    TextMessage:
      type: object
      properties:
        type:
          type: string
        text:
          type: string
    ImageMessage:
      type: object
      properties:
        type:
          type: string
        url:
          type: string
```

